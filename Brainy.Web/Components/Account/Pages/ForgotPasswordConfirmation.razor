@page "/Account/ForgotPasswordConfirmation"
@layout AuthLayout

<PageTitle>Check your email · Brainy</PageTitle>

<a class="auth-minibrand" href="/">
    <img class="auth-wordmark__logo" src="img/logo.png" alt="Brainy logo" />
    Brainy
</a>

<span class="auth-eyebrow">Account recovery</span>
<h2 class="auth-title">Check your email</h2>
<p class="auth-subtitle">
    If an account with that address exists, we've sent a link to reset your password.
</p>

<p class="auth-switch">
    <a href="Account/Login">Back to log in</a>
</p>
