@page "/Account/ResetPasswordConfirmation"
@layout AuthLayout

<PageTitle>Password reset · Brainy</PageTitle>

<a class="auth-minibrand" href="/">
    <img class="auth-wordmark__logo" src="img/logo.png" alt="Brainy logo" />
    Brainy
</a>

<span class="auth-eyebrow">Account recovery</span>
<h2 class="auth-title">Password reset</h2>
<p class="auth-subtitle">Your password has been reset. You can now log in with your new password.</p>

<p class="auth-switch">
    <a href="Account/Login">Log in</a>
</p>
