@page "/Account/Manage"
@* This page forces interactivity on an otherwise statically-rendered route (App.razor
   keeps /Account/* static by default so server-side form posts and HttpContext access
   keep working elsewhere under /Account), which makes it its own interactive island
   separate from MainLayout's — MainLayout's <MudPopoverProvider /> renders as inert
   static markup here and never registers, so MudSelect below has nothing to call and
   crashes the circuit. Prerendering is also disabled: with it on, this page's own
   provider (below) gets instantiated once during the static prerender pass and again on
   the interactive reconnect, and the second instance collides with the first's
   still-registered popover section subscription. Both parts together are needed. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]

@using Brainy.Application.DTOs.Billing
@using Brainy.Application.DTOs.DataImport
@using Brainy.Application.DTOs.Search
@using Brainy.Application.Interfaces.Services
@using Brainy.Data.Identity
@using Brainy.Domain.Enums
@using Brainy.Web.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity

@inject IDataExportService DataExportService
@inject IDataImportService DataImportService
@inject IArchiveRetentionService ArchiveRetentionService
@inject IUserTimeZoneService UserTimeZoneService
@inject IAnalyticsService AnalyticsService
@inject IUserDashboardPreferenceService DashboardPreferenceService
@inject IEntitlementService EntitlementService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IAccountDeletionService DeletionService
@inject NavigationManager Navigation

<PageTitle>Account and data — Brainy</PageTitle>

<MudPopoverProvider />

<main class="account-manage" aria-labelledby="account-manage-title">
    <header class="account-manage__header">
        <p class="account-manage__eyebrow">Account</p>
        <h1 id="account-manage-title">Account and data</h1>
        <p>Protect your sign-in, choose how Brainy interprets your calendar day, tune archive cleanup rules, and move your data safely.</p>
    </header>

    <MudPaper Class="account-manage__card" Elevation="0">
        <div class="account-manage__card-heading">
            <MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" aria-hidden="true" />
            <div>
                <h2>Plan and usage</h2>
                <p>Your current plan, what you're using against each limit, and what happens when you hit one.</p>
            </div>
        </div>

        @if (_planUsageError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                @_planUsageError
            </MudAlert>
        }
        else if (_planUsage is not null)
        {
            <div class="account-manage__meta-grid">
                <div>
                    <span class="account-manage__meta-label">Current plan</span>
                    <strong>@_planUsage.PlanDisplayName — @_planUsage.PlanPriceDescription</strong>
                </div>
                <div>
                    <span class="account-manage__meta-label">Active projects</span>
                    <strong>
                        @(_planUsage.MaxActiveProjects.HasValue
                            ? $"{_planUsage.ActiveProjectCount} / {_planUsage.MaxActiveProjects} used"
                            : $"{_planUsage.ActiveProjectCount} (unlimited)")
                    </strong>
                </div>
                <div>
                    <span class="account-manage__meta-label">AI features</span>
                    <strong>@(_planUsage.AiAllowance.AiAvailableOnPlan ? "Included" : "Not included on this plan")</strong>
                </div>
                <div>
                    <span class="account-manage__meta-label">AI allowance this period</span>
                    <strong>
                        @(!_planUsage.AiAllowance.AiAvailableOnPlan
                            ? "—"
                            : _planUsage.AiAllowance.Limit.HasValue
                                ? $"{_planUsage.AiAllowance.Used} / {_planUsage.AiAllowance.Limit} requests"
                                : $"{_planUsage.AiAllowance.Used} requests used (unlimited for now)")
                    </strong>
                </div>
            </div>

            @if (_planUsage.ProjectLimitReached)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="account-manage__notice">
                    You've reached your @_planUsage.PlanDisplayName plan's limit of @_planUsage.MaxActiveProjects active project(s).
                    Creating another project is blocked until you archive one or upgrade.
                    @if (_planUsage.ReadOnlyProjectCount > 0)
                    {
                        <text> @_planUsage.ReadOnlyProjectCount of your oldest project(s) are currently read-only for this reason — you can still view and export them.</text>
                    }
                </MudAlert>
            }
            else if (_planUsage.ReadOnlyProjectCount > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="account-manage__notice">
                    @_planUsage.ReadOnlyProjectCount project(s) are read-only because they exceed your plan's active-project limit.
                    Archive them or upgrade to edit them again.
                </MudAlert>
            }

            @if (_planUsage.AiAllowance.AiAvailableOnPlan && _planUsage.AiAllowance.PeriodResetsAtUtc.HasValue)
            {
                <p class="account-manage__status">AI allowance resets @_planUsage.AiAllowance.PeriodResetsAtUtc.Value.ToString("MMM d, yyyy") (UTC).</p>
            }

            <p class="account-manage__status">
                @(_planUsage.AiAllowance.BringYourOwnKeyAllowed
                    ? "Bringing your own AI provider key is supported as a configuration option and bypasses hosted usage entirely — contact us to set it up."
                    : "Bringing your own AI provider key is not available on this plan.")
            </p>

            @if (_planUsage.TrialEndsAtUtc.HasValue)
            {
                <p class="account-manage__status">Trial ends @_planUsage.TrialEndsAtUtc.Value.ToString("MMM d, yyyy") (UTC).</p>
            }
            @if (_planUsage.GracePeriodEndsAtUtc.HasValue)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="account-manage__notice">
                    A recent payment did not go through. Your Pro access continues until @_planUsage.GracePeriodEndsAtUtc.Value.ToString("MMM d, yyyy") (UTC); after that your plan reverts to Starter and any projects over the Starter limit become read-only.
                </MudAlert>
            }
            @if (_planUsage.PlanRenewsAtUtc.HasValue)
            {
                <p class="account-manage__status">Renews @_planUsage.PlanRenewsAtUtc.Value.ToString("MMM d, yyyy") (UTC).</p>
            }

            @if (_planUsage.Tier == PlanTier.Starter)
            {
                <div class="account-manage__actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/pricing">
                        See Pro plan details
                    </MudButton>
                    <span class="account-manage__status">There's no live checkout yet — this links to the pricing page. Contact us to upgrade.</span>
                </div>
            }
        }
    </MudPaper>

    <section class="account-manage__cluster" aria-label="Preferences and retention">
        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" aria-hidden="true" />
                <div>
                    <h2>Time zone</h2>
                    <p>Override the browser-detected time zone when you travel, plan in another region, or want a fixed calendar day.</p>
                </div>
            </div>

            @if (_timeZoneError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                    @_timeZoneError
                </MudAlert>
            }

            <div class="account-manage__settings-stack">
                <MudSelect T="string"
                           @bind-Value="_selectedTimeZoneId"
                           Label="Time zone"
                           Variant="Variant.Outlined"
                           Disabled="_savingTimeZone">
                    <MudSelectItem T="string" Value="@BrowserTimeZoneOptionValue">@GetBrowserTimeZoneOptionLabel()</MudSelectItem>
                    @foreach (var timeZone in TimeZoneOptions)
                    {
                        <MudSelectItem T="string" Value="@timeZone.Id">@timeZone.Label</MudSelectItem>
                    }
                </MudSelect>

                <div class="account-manage__meta-grid">
                    <div>
                        <span class="account-manage__meta-label">Effective time zone</span>
                        <strong>@_effectiveTimeZoneId</strong>
                    </div>
                    <div>
                        <span class="account-manage__meta-label">Mode</span>
                        <strong>@(_selectedTimeZoneId == BrowserTimeZoneOptionValue ? "Browser-detected" : "Manual override")</strong>
                    </div>
                </div>
            </div>

            <div class="account-manage__actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_savingTimeZone"
                           aria-busy="@_savingTimeZone.ToString().ToLowerInvariant()"
                           OnClick="SaveTimeZoneAsync">
                    @(_savingTimeZone ? "Saving time zone…" : "Save time zone")
                </MudButton>
                <span class="account-manage__status" role="status" aria-live="polite">@_timeZoneStatus</span>
            </div>
        </MudPaper>

        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.Insights" aria-hidden="true" />
                <div>
                    <h2>Privacy and analytics</h2>
                    <p>
                        Brainy records privacy-safe usage signals (like "a note was captured" or "a search
                        returned no results") to improve the product. It never records your note, task, or
                        output content, search text, or AI prompts and responses. See the
                        <MudLink Href="/data-dictionary" Target="_blank">full data dictionary</MudLink>
                        for exactly what is tracked, why, and for how long.
                    </p>
                </div>
            </div>

            <div class="account-manage__settings-stack">
                <MudSwitch T="bool"
                           Value="_analyticsEnabled"
                           ValueChanged="OnAnalyticsEnabledChangedAsync"
                           Color="Color.Primary"
                           Disabled="_savingAnalyticsConsent"
                           Label="@(_analyticsEnabled ? "Analytics on" : "Analytics off")" />
            </div>

            <div class="account-manage__actions">
                <span class="account-manage__status" role="status" aria-live="polite">@_analyticsConsentStatus</span>
            </div>
        </MudPaper>

        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" aria-hidden="true" />
                <div>
                    <h2>Starter Mode</h2>
                    <p>
                        Trims the navigation to Today, Inbox, Projects and Search so a new account can find its
                        footing. Advanced planning, analytics and AI surfaces stay one click away behind
                        "Show full navigation" — nothing is removed, only decluttered. Turn it off any time for
                        full access.
                    </p>
                </div>
            </div>

            <div class="account-manage__settings-stack">
                <MudSwitch T="bool"
                           Value="_starterModeEnabled"
                           ValueChanged="OnStarterModeChangedAsync"
                           Color="Color.Primary"
                           Disabled="_savingStarterMode"
                           Label="@(_starterModeEnabled ? "Starter Mode on" : "Starter Mode off")" />
            </div>

            <div class="account-manage__actions">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Disabled="_restartingOnboarding"
                           OnClick="RestartOnboardingAsync">
                    @(_restartingOnboarding ? "Restarting…" : "Replay the guided tour")
                </MudButton>
                <span class="account-manage__status" role="status" aria-live="polite">@_starterModeStatus</span>
            </div>
        </MudPaper>

        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" aria-hidden="true" />
                <div>
                    <h2>Archive retention</h2>
                    <p>Decide when archived items become eligible for manual cleanup. Leave a rule blank to keep that kind of item forever.</p>
                </div>
            </div>

            @if (_retentionError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                    @_retentionError
                </MudAlert>
            }

            <div class="account-manage__retention-grid">
                @foreach (var entityType in RetentionEntityTypes)
                {
                    var type = entityType;
                    <div class="account-manage__retention-card">
                        <div>
                            <h3>@GetRetentionTitle(type)</h3>
                            <p>@GetRetentionDescription(type)</p>
                        </div>

                        <MudNumericField T="int?"
                                         Value="@_retentionDays[type]"
                                         ValueChanged="value => OnRetentionDaysChanged(type, value)"
                                         Label="Days to keep"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         Disabled="@IsSavingRetention(type)" />

                        <div class="account-manage__retention-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Dark"
                                       Size="Size.Small"
                                       Disabled="@IsSavingRetention(type)"
                                       OnClick="() => SaveRetentionAsync(type)">
                                @(IsSavingRetention(type) ? "Saving…" : "Save")
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Disabled="@IsSavingRetention(type)"
                                       OnClick="() => ClearRetentionAsync(type)">
                                Keep forever
                            </MudButton>
                        </div>
                    </div>
                }
            </div>

            <span class="account-manage__status" role="status" aria-live="polite">@_retentionStatus</span>
        </MudPaper>
    </section>

    <MudPaper Class="account-manage__card" Elevation="0">
        <div class="account-manage__card-heading">
            <MudIcon Icon="@Icons.Material.Outlined.Password" aria-hidden="true" />
            <div>
                <h2>Change password</h2>
                <p>Use at least 10 characters. Brainy also requires upper- and lowercase letters, a number, and a symbol.</p>
            </div>
        </div>

        @if (_passwordError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                @_passwordError
            </MudAlert>
        }

        <div class="account-manage__password-fields">
            <MudTextField T="string"
                          @bind-Value="_currentPassword"
                          Label="Current password"
                          InputType="InputType.Password"
                          autocomplete="current-password"
                          Variant="Variant.Outlined"
                          Disabled="_changingPassword" />
            <MudTextField T="string"
                          @bind-Value="_newPassword"
                          Label="New password"
                          InputType="InputType.Password"
                          autocomplete="new-password"
                          Variant="Variant.Outlined"
                          Disabled="_changingPassword" />
            <MudTextField T="string"
                          @bind-Value="_confirmPassword"
                          Label="Confirm new password"
                          InputType="InputType.Password"
                          autocomplete="new-password"
                          Variant="Variant.Outlined"
                          Disabled="_changingPassword" />
        </div>

        <div class="account-manage__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_changingPassword"
                       aria-busy="@_changingPassword.ToString().ToLowerInvariant()"
                       OnClick="ChangePasswordAsync">
                @(_changingPassword ? "Changing password…" : "Change password")
            </MudButton>
            <span class="account-manage__status" role="status" aria-live="polite">@_passwordStatus</span>
        </div>
    </MudPaper>

    <section class="account-manage__cluster" aria-label="Import and export">
        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.Download" aria-hidden="true" />
                <div>
                    <h2>Export Brainy data</h2>
                    <p>
                        Creates a versioned JSON archive containing your notes, projects, tasks,
                        areas, resources, goals, outputs, relationships, preferences, and stored images.
                    </p>
                </div>
            </div>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="account-manage__notice">
                Images are included as base64 with SHA-256 checksums. Brainy's account credentials,
                password hashes, session tokens, configured AI provider keys, and application secrets
                are excluded. Content you authored is exported as stored, so a secret written in a note
                or source URL will still be present. Store the file securely.
            </MudAlert>

            @if (_exportError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                    @_exportError
                </MudAlert>
            }

            <div class="account-manage__actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.FileDownload"
                           Disabled="_exporting"
                           aria-busy="@_exporting.ToString().ToLowerInvariant()"
                           OnClick="ExportAsync">
                    @if (_exporting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Preparing export…</span>
                    }
                    else
                    {
                        <span>Download JSON export</span>
                    }
                </MudButton>

                <span class="account-manage__status" role="status" aria-live="polite">
                    @_exportStatus
                </span>
            </div>
        </MudPaper>

        <MudPaper Class="account-manage__card" Elevation="0">
            <div class="account-manage__card-heading">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" aria-hidden="true" />
                <div>
                    <h2>Import Brainy data</h2>
                    <p>Safely restore the parts of a Brainy export that this version can rebuild without broken ownership or missing relationships.</p>
                </div>
            </div>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="account-manage__notice">
                Every entity in a Brainy export is restored — areas, projects, resources, sources, notes and
                their tags/highlights/summaries/action items/relationships/images, tasks and their dependencies,
                outputs, ideas, goals and their milestones/activities, and archive retention rules. Re-importing
                the same export is safe: matching existing rows are reused rather than duplicated. Preview first
                to see exactly what will change before anything is written.
            </MudAlert>

            @if (_importError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                    @_importError
                </MudAlert>
            }

            @if (_previewResult is not null)
            {
                <MudAlert Severity="@GetPreviewSeverity()" Variant="Variant.Outlined" Class="account-manage__notice">
                    <div class="account-manage__import-summary">
                        <strong>Preview — nothing has been written yet</strong>
                        @RenderOutcomes(_previewResult.EntityOutcomes, _previewResult.UnsupportedEntities, _previewResult.Conflicts, _previewResult.IntegrityIssues)
                    </div>
                </MudAlert>
            }

            @if (_importResult is not null)
            {
                <MudAlert Severity="@GetResultSeverity()" Variant="Variant.Outlined" Class="account-manage__notice">
                    <div class="account-manage__import-summary">
                        <strong>Import complete</strong>
                        @RenderOutcomes(_importResult.EntityOutcomes, _importResult.UnsupportedEntities, _importResult.Conflicts, _importResult.IntegrityIssues)
                    </div>
                </MudAlert>
            }

            <div class="account-manage__import-picker">
                <InputFile OnChange="HandleImportFileSelected" accept=".json,application/json" disabled="@(_importing || _previewing)" />
                <span class="account-manage__status">@(_importFileName ?? "Choose a Brainy JSON export")</span>
            </div>

            <div class="account-manage__actions">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Preview"
                           Disabled="@(_previewing || _importing || _selectedImportFile is null)"
                           aria-busy="@_previewing.ToString().ToLowerInvariant()"
                           OnClick="PreviewImportAsync">
                    @(_previewing ? "Checking…" : "Preview import")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Publish"
                           Disabled="@(_importing || _previewing || _previewResult is null)"
                           aria-busy="@_importing.ToString().ToLowerInvariant()"
                           OnClick="ImportAsync">
                    @(_importing ? "Importing…" : "Confirm import")
                </MudButton>
                <span class="account-manage__status" role="status" aria-live="polite">@_importStatus</span>
            </div>
        </MudPaper>
    </section>

    <MudPaper Class="account-manage__card account-manage__danger" Elevation="0">
        <div class="account-manage__card-heading">
            <MudIcon Icon="@Icons.Material.Outlined.DeleteForever" Color="Color.Error" aria-hidden="true" />
            <div>
                <h2>Delete account</h2>
                <p>Permanently deletes your Brainy account, sign-in credentials, and all stored Brainy data.</p>
            </div>
        </div>

        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice">
            This cannot be undone. Download the JSON export above first if you may need any of your
            notes, projects, tasks, images, outputs, or settings later.
        </MudAlert>

        @if (_deletionError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="account-manage__notice" role="alert">
                @_deletionError
            </MudAlert>
        }

        <div class="account-manage__deletion-fields">
            <MudTextField T="string"
                          @bind-Value="_deletionPassword"
                          Label="Current password"
                          InputType="InputType.Password"
                          autocomplete="current-password"
                          Variant="Variant.Outlined"
                          Disabled="_deletingAccount" />
            <MudTextField T="string"
                          @bind-Value="_deletionConfirmation"
                          Label="Type DELETE MY ACCOUNT"
                          HelperText="The phrase is case-sensitive."
                          autocomplete="off"
                          Variant="Variant.Outlined"
                          Disabled="_deletingAccount" />
        </div>

        <div class="account-manage__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.DeleteForever"
                       Disabled="@(_deletingAccount || string.IsNullOrEmpty(_deletionPassword) || _deletionConfirmation != AccountDeletionService.ConfirmationPhrase)"
                       aria-busy="@_deletingAccount.ToString().ToLowerInvariant()"
                       OnClick="DeleteAccountAsync">
                @(_deletingAccount ? "Deleting account…" : "Permanently delete account")
            </MudButton>
        </div>
    </MudPaper>
</main>

<style>
    .account-manage { max-width: 1100px; margin: 0 auto; display: grid; gap: 1.5rem; }
    .account-manage__cluster { display: grid; gap: 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .account-manage__header h1 { margin: 0; font-family: var(--font-display); color: var(--ink); font-size: clamp(2rem, 5vw, 3rem); }
    .account-manage__header > p:last-child { margin: .5rem 0 0; color: var(--ink-soft); }
    .account-manage__eyebrow { margin: 0 0 .35rem; color: var(--clay); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .account-manage__card { padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(180deg, color-mix(in srgb, var(--paper-raised) 92%, white 8%), var(--paper-raised)) !important; }
    .account-manage__card-heading { display: flex; align-items: flex-start; gap: 1rem; }
    .account-manage__card-heading h2 { margin: 0 0 .4rem; font-family: var(--font-display); color: var(--ink); }
    .account-manage__card-heading p { margin: 0; color: var(--ink-soft); line-height: 1.6; }
    .account-manage__notice { margin-top: 1.25rem; }
    .account-manage__settings-stack { margin-top: 1.25rem; display: grid; gap: 1rem; }
    .account-manage__meta-grid { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 1rem; border-radius: 14px; background: color-mix(in srgb, var(--paper) 80%, transparent); border: 1px solid var(--line); }
    .account-manage__meta-label { display: block; margin-bottom: .2rem; color: var(--ink-soft); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .account-manage__retention-grid { margin-top: 1.25rem; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .account-manage__retention-card { display: grid; gap: .85rem; padding: 1rem; border-radius: 16px; background: color-mix(in srgb, var(--paper) 75%, transparent); border: 1px solid var(--line); }
    .account-manage__retention-card h3 { margin: 0; font-size: 1rem; color: var(--ink); }
    .account-manage__retention-card p { margin: .25rem 0 0; color: var(--ink-soft); font-size: .9rem; line-height: 1.5; }
    .account-manage__retention-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .account-manage__password-fields { margin-top: 1.25rem; display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .account-manage__deletion-fields { margin-top: 1.25rem; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .account-manage__import-picker { margin-top: 1.25rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
    .account-manage__import-summary ul { margin: .5rem 0 0; padding-left: 1.1rem; }
    .account-manage__import-summary li + li { margin-top: .25rem; }
    .account-manage__danger { border-color: var(--mud-palette-error); }
    .account-manage__actions { margin-top: 1.25rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .account-manage__status { color: var(--ink-soft); font-size: .875rem; }

    @@media (max-width: 900px) {
        .account-manage__cluster,
        .account-manage__retention-grid,
        .account-manage__meta-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .account-manage__password-fields,
        .account-manage__deletion-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private const string BrowserTimeZoneOptionValue = "__browser__";
    private const long MaxImportFileBytes = 50L * 1024 * 1024;
    private static readonly string[] RetentionEntityTypes = ["Project", "Area", "Resource", "Note"];
    private static readonly IReadOnlyList<TimeZoneOption> TimeZoneOptions = TimeZoneInfo.GetSystemTimeZones()
        .OrderBy(zone => zone.BaseUtcOffset)
        .ThenBy(zone => zone.Id, StringComparer.Ordinal)
        .Select(zone => new TimeZoneOption(zone.Id, $"{FormatOffset(zone.BaseUtcOffset)} {zone.Id} — {zone.DisplayName}"))
        .ToArray();

    private bool _exporting;
    private string? _exportError;
    private string? _exportStatus;
    private bool _importing;
    private bool _previewing;
    private string? _importError;
    private string? _importStatus;
    private DataImportPreviewDto? _previewResult;
    private DataImportResultDto? _importResult;
    private IBrowserFile? _selectedImportFile;
    private string? _importFileName;
    private bool _changingPassword;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private string? _passwordStatus;
    private bool _savingTimeZone;
    private string _selectedTimeZoneId = BrowserTimeZoneOptionValue;
    private string _effectiveTimeZoneId = "UTC";
    private string? _browserTimeZoneId;
    private string? _timeZoneError;
    private string? _timeZoneStatus;
    private Dictionary<string, int?> _retentionDays = RetentionEntityTypes.ToDictionary(type => type, _ => (int?)null);
    private Dictionary<string, bool> _savingRetention = RetentionEntityTypes.ToDictionary(type => type, _ => false);
    private string? _retentionError;
    private string? _retentionStatus;
    private bool _analyticsEnabled = true;
    private bool _savingAnalyticsConsent;
    private string? _analyticsConsentStatus;
    private PlanUsageSummaryDto? _planUsage;
    private string? _planUsageError;
    private bool _starterModeEnabled = true;
    private bool _savingStarterMode;
    private string? _starterModeStatus;
    private bool _restartingOnboarding;
    private bool _deletingAccount;
    private string _deletionPassword = string.Empty;
    private string _deletionConfirmation = string.Empty;
    private string? _deletionError;

    protected override async Task OnInitializedAsync()
    {
        await LoadRetentionAsync();
        await LoadTimeZoneAsync();
        _analyticsEnabled = await AnalyticsService.IsCurrentUserOptedInAsync();

        var preferences = await DashboardPreferenceService.GetOrCreateAsync();
        _starterModeEnabled = preferences.StarterModeEnabled;

        try
        {
            _planUsage = await EntitlementService.GetUsageSummaryAsync();
        }
        catch
        {
            _planUsageError = "Brainy could not load your plan and usage details. Try reloading this page.";
        }
    }

    private async Task OnStarterModeChangedAsync(bool value)
    {
        if (_savingStarterMode)
            return;

        _savingStarterMode = true;
        _starterModeStatus = null;

        try
        {
            await DashboardPreferenceService.SetStarterModeAsync(value);
            _starterModeEnabled = value;
            _starterModeStatus = value
                ? "Starter Mode is on. Navigation is trimmed to Today, Inbox, Projects and Search."
                : "Starter Mode is off. The full navigation is shown.";
        }
        catch
        {
            _starterModeStatus = "Could not save Starter Mode. Try again.";
        }
        finally
        {
            _savingStarterMode = false;
        }
    }

    private async Task RestartOnboardingAsync()
    {
        if (_restartingOnboarding)
            return;

        _restartingOnboarding = true;
        _starterModeStatus = null;

        try
        {
            await DashboardPreferenceService.ResetOnboardingAsync();
            _starterModeStatus = "The guided tour will show again next time you visit Today.";
        }
        catch
        {
            _starterModeStatus = "Could not restart the guided tour. Try again.";
        }
        finally
        {
            _restartingOnboarding = false;
        }
    }

    private async Task OnAnalyticsEnabledChangedAsync(bool value)
    {
        if (_savingAnalyticsConsent)
            return;

        _savingAnalyticsConsent = true;
        _analyticsConsentStatus = null;

        try
        {
            await AnalyticsService.SetCurrentUserOptedInAsync(value);
            _analyticsEnabled = value;
            _analyticsConsentStatus = value
                ? "Analytics tracking is on."
                : "Analytics tracking is off. Brainy will stop recording new usage events for your account.";
        }
        catch
        {
            _analyticsConsentStatus = "Brainy could not save your analytics preference. Try again.";
        }
        finally
        {
            _savingAnalyticsConsent = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var browserTimeZoneId = await JS.InvokeAsync<string>("window.brainyTimeZone.get");
            if (!string.IsNullOrWhiteSpace(browserTimeZoneId))
            {
                _browserTimeZoneId = browserTimeZoneId;
                if (_selectedTimeZoneId == BrowserTimeZoneOptionValue)
                {
                    _effectiveTimeZoneId = browserTimeZoneId;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore prerender/browser disconnects. UTC remains a safe fallback label.
        }
        catch
        {
            // Ignore browser detection failures here; the persisted server-side value still works.
        }
    }

    private async Task LoadRetentionAsync()
    {
        _retentionDays = RetentionEntityTypes.ToDictionary(type => type, _ => (int?)null);
        _savingRetention = RetentionEntityTypes.ToDictionary(type => type, _ => false);

        var rules = await ArchiveRetentionService.GetRulesAsync();
        foreach (var rule in rules)
        {
            if (_retentionDays.ContainsKey(rule.EntityType))
            {
                _retentionDays[rule.EntityType] = rule.RetentionDays;
            }
        }
    }

    private async Task LoadTimeZoneAsync()
    {
        _effectiveTimeZoneId = await UserTimeZoneService.GetTimeZoneIdAsync();
        _selectedTimeZoneId = await UserTimeZoneService.GetTimeZoneOverrideIdAsync() ?? BrowserTimeZoneOptionValue;
    }

    private async Task SaveTimeZoneAsync()
    {
        if (_savingTimeZone)
            return;

        _savingTimeZone = true;
        _timeZoneError = null;
        _timeZoneStatus = null;

        try
        {
            if (_selectedTimeZoneId == BrowserTimeZoneOptionValue)
            {
                var browserTimeZoneId = _browserTimeZoneId ?? _effectiveTimeZoneId;
                await UserTimeZoneService.SetTimeZoneIdAsync(browserTimeZoneId);
                _timeZoneStatus = $"Using browser-detected time zone ({browserTimeZoneId}).";
            }
            else
            {
                await UserTimeZoneService.SetTimeZoneOverrideAsync(_selectedTimeZoneId);
                _timeZoneStatus = $"Manual override saved for {_selectedTimeZoneId}.";
            }

            await LoadTimeZoneAsync();
        }
        catch (ArgumentException ex)
        {
            _timeZoneError = ex.Message;
        }
        catch
        {
            _timeZoneError = "Brainy could not save your time zone. Try again.";
        }
        finally
        {
            _savingTimeZone = false;
        }
    }

    private async Task SaveRetentionAsync(string entityType)
    {
        _retentionError = null;
        _retentionStatus = null;
        _savingRetention[entityType] = true;

        try
        {
            await ArchiveRetentionService.UpsertRuleAsync(entityType, _retentionDays[entityType]);
            _retentionStatus = $"{GetRetentionTitle(entityType)} retention saved.";
        }
        catch (Exception ex)
        {
            _retentionError = ex.Message;
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private async Task ClearRetentionAsync(string entityType)
    {
        _retentionError = null;
        _retentionStatus = null;
        _savingRetention[entityType] = true;

        try
        {
            await ArchiveRetentionService.DeleteRuleAsync(entityType);
            _retentionDays[entityType] = null;
            _retentionStatus = $"{GetRetentionTitle(entityType)} retention cleared.";
        }
        catch (Exception ex)
        {
            _retentionError = ex.Message;
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private void OnRetentionDaysChanged(string entityType, int? value) => _retentionDays[entityType] = value;

    private bool IsSavingRetention(string entityType) =>
        _savingRetention.TryGetValue(entityType, out var saving) && saving;

    private void HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        _selectedImportFile = e.File;
        _importFileName = _selectedImportFile?.Name;
        _importError = null;
        _importStatus = null;
        _previewResult = null;
        _importResult = null;
    }

    private async Task PreviewImportAsync()
    {
        if (_previewing || _importing || _selectedImportFile is null)
            return;

        _previewing = true;
        _importError = null;
        _importStatus = "Checking the export against your account without changing anything.";
        _previewResult = null;
        _importResult = null;

        try
        {
            await using var stream = _selectedImportFile.OpenReadStream(MaxImportFileBytes);
            _previewResult = await DataImportService.PreviewImportAsync(stream);
            _importStatus = $"Preview checked schema {_previewResult.SchemaVersion}. Review the plan, then confirm to write it.";
        }
        catch (InvalidOperationException ex)
        {
            _importError = ex.Message;
            _importStatus = null;
        }
        catch (IOException)
        {
            _importError = "The selected file could not be read. Choose the export again and retry.";
            _importStatus = null;
        }
        catch
        {
            _importError = "Brainy could not preview that file.";
            _importStatus = null;
        }
        finally
        {
            _previewing = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_importing || _previewing || _selectedImportFile is null || _previewResult is null)
            return;

        _importing = true;
        _importError = null;
        _importStatus = "Restoring your data inside a single transaction.";
        _importResult = null;

        try
        {
            await using var stream = _selectedImportFile.OpenReadStream(MaxImportFileBytes);
            _importResult = await DataImportService.ImportCurrentUserAsync(stream);
            _previewResult = null;
            _importStatus = $"Import committed schema {_importResult.SchemaVersion}.";
        }
        catch (InvalidOperationException ex)
        {
            _importError = ex.Message;
            _importStatus = null;
        }
        catch (IOException)
        {
            _importError = "The selected file could not be read. Choose the export again and retry.";
            _importStatus = null;
        }
        catch
        {
            _importError = "Brainy could not import that file. The transaction was rolled back, so no partial data was written.";
            _importStatus = null;
        }
        finally
        {
            _importing = false;
        }
    }

    private static bool HasWarnings(
        IReadOnlyList<DataImportEntityOutcomeDto> outcomes,
        IReadOnlyList<DataImportEntityCountDto> unsupported,
        IReadOnlyList<string> conflicts,
        IReadOnlyList<string> integrityIssues) =>
        outcomes.Any(o => o.Skipped > 0) || unsupported.Count > 0 || conflicts.Count > 0 || integrityIssues.Count > 0;

    private Severity GetPreviewSeverity() =>
        _previewResult is not null &&
        HasWarnings(_previewResult.EntityOutcomes, _previewResult.UnsupportedEntities, _previewResult.Conflicts, _previewResult.IntegrityIssues)
            ? Severity.Warning
            : Severity.Success;

    private Severity GetResultSeverity() =>
        _importResult is not null &&
        HasWarnings(_importResult.EntityOutcomes, _importResult.UnsupportedEntities, _importResult.Conflicts, _importResult.IntegrityIssues)
            ? Severity.Warning
            : Severity.Success;

    private static RenderFragment RenderOutcomes(
        IReadOnlyList<DataImportEntityOutcomeDto> outcomes,
        IReadOnlyList<DataImportEntityCountDto> unsupported,
        IReadOnlyList<string> conflicts,
        IReadOnlyList<string> integrityIssues) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "ul");
        foreach (var outcome in outcomes.Where(o => o.Created > 0 || o.Reused > 0 || o.Skipped > 0))
        {
            builder.OpenElement(sequence++, "li");
            builder.AddContent(sequence++,
                $"{outcome.EntityType}: {outcome.Created} to create, {outcome.Reused} reused/unchanged, {outcome.Skipped} skipped.");
            builder.CloseElement();
        }
        builder.CloseElement();

        if (unsupported.Count > 0)
        {
            builder.OpenElement(sequence++, "div");
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "account-manage__meta-label");
            builder.AddContent(sequence++, "Not imported (unsupported by design)");
            builder.CloseElement();
            builder.OpenElement(sequence++, "ul");
            foreach (var item in unsupported)
            {
                builder.OpenElement(sequence++, "li");
                builder.AddContent(sequence++, $"{item.EntityType}: {item.Count}");
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }

        if (conflicts.Count > 0)
        {
            builder.OpenElement(sequence++, "div");
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "account-manage__meta-label");
            builder.AddContent(sequence++, "Conflicts");
            builder.CloseElement();
            builder.OpenElement(sequence++, "ul");
            foreach (var conflict in conflicts)
            {
                builder.OpenElement(sequence++, "li");
                builder.AddContent(sequence++, conflict);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }

        if (integrityIssues.Count > 0)
        {
            builder.OpenElement(sequence++, "div");
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "account-manage__meta-label");
            builder.AddContent(sequence++, "Attachment integrity");
            builder.CloseElement();
            builder.OpenElement(sequence++, "ul");
            foreach (var issue in integrityIssues)
            {
                builder.OpenElement(sequence++, "li");
                builder.AddContent(sequence++, issue);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private string GetBrowserTimeZoneOptionLabel() =>
        string.IsNullOrWhiteSpace(_browserTimeZoneId)
            ? "Use browser-detected time zone"
            : $"Use browser-detected time zone ({_browserTimeZoneId})";

    private static string GetRetentionTitle(string entityType) => entityType switch
    {
        "Project" => "Projects",
        "Area" => "Areas",
        "Resource" => "Resources",
        _ => "Notes"
    };

    private static string GetRetentionDescription(string entityType) => entityType switch
    {
        "Project" => "Completed projects and their archived context.",
        "Area" => "Inactive responsibilities you still want on record.",
        "Resource" => "Reference material you no longer need in active views.",
        _ => "Archived notes kept for later recall."
    };

    private static string FormatOffset(TimeSpan offset)
    {
        var sign = offset < TimeSpan.Zero ? "-" : "+";
        var absolute = offset.Duration();
        return $"UTC{sign}{absolute:hh\\:mm}";
    }

    private sealed record TimeZoneOption(string Id, string Label);

    private async Task ChangePasswordAsync()
    {
        if (_changingPassword)
            return;

        _passwordError = null;
        _passwordStatus = null;
        if (string.IsNullOrEmpty(_currentPassword) || string.IsNullOrEmpty(_newPassword))
        {
            _passwordError = "Enter your current password and a new password.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _passwordError = "The new password and confirmation do not match.";
            return;
        }

        _changingPassword = true;
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authenticationState.User);
            if (user is null)
            {
                _passwordError = "Your sign-in session is no longer valid. Sign in again and retry.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, _currentPassword, _newPassword);
            if (!result.Succeeded)
            {
                _passwordError = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            _passwordStatus = "Password changed. Existing sessions will be asked to sign in again.";
        }
        catch
        {
            _passwordError = "Brainy could not change your password. Try again.";
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_exporting)
            return;

        _exporting = true;
        _exportError = null;
        _exportStatus = "Preparing your archive. Large image collections may take a moment.";

        try
        {
            var export = await DataExportService.ExportCurrentUserAsync();
            await using var contentStream = new MemoryStream(export.Content, writable: false);
            using var streamReference = new DotNetStreamReference(contentStream);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./dataExport.js");

            await module.InvokeVoidAsync(
                "downloadFileFromStream",
                export.FileName,
                export.ContentType,
                streamReference);

            _exportStatus = $"Export schema {export.SchemaVersion} downloaded.";
        }
        catch (JSDisconnectedException)
        {
            _exportError = "The browser connection closed before the download started. Reload this page and try again.";
            _exportStatus = null;
        }
        catch
        {
            _exportError = "Brainy could not prepare your export. Your data was not changed. Try again.";
            _exportStatus = null;
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (_deletingAccount)
            return;

        _deletionError = null;
        if (_deletionConfirmation != AccountDeletionService.ConfirmationPhrase)
        {
            _deletionError = $"Type {AccountDeletionService.ConfirmationPhrase} exactly to confirm.";
            return;
        }

        if (string.IsNullOrEmpty(_deletionPassword))
        {
            _deletionError = "Enter your current password.";
            return;
        }

        _deletingAccount = true;
        try
        {
            var result = await DeletionService.DeleteCurrentUserAsync(
                _deletionPassword,
                _deletionConfirmation);

            switch (result)
            {
                case AccountDeletionResult.Succeeded:
                    Navigation.NavigateTo("/Account/CompleteDeletion", forceLoad: true);
                    return;
                case AccountDeletionResult.InvalidPassword:
                    _deletionError = "The current password is incorrect.";
                    break;
                case AccountDeletionResult.InvalidConfirmation:
                    _deletionError = $"Type {AccountDeletionService.ConfirmationPhrase} exactly to confirm.";
                    break;
                case AccountDeletionResult.InvalidSession:
                    _deletionError = "Your sign-in session is no longer valid. Sign in again and retry.";
                    break;
            }
        }
        catch
        {
            _deletionError = "Brainy could not delete your account. No partial deletion was committed. Try again.";
        }
        finally
        {
            _deletionPassword = string.Empty;
            _deletingAccount = false;
        }
    }
}
