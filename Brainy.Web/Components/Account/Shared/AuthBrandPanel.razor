@* Left-hand brand canvas for the authentication experience. *@

<aside class="auth-brand">
    <svg class="auth-brand__art" viewBox="0 0 600 820" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <g>
            <line x1="80" y1="120" x2="220" y2="210" />
            <line x1="220" y1="210" x2="150" y2="360" />
            <line x1="220" y1="210" x2="400" y2="170" />
            <line x1="400" y1="170" x2="520" y2="280" />
            <line x1="150" y1="360" x2="300" y2="430" />
            <line x1="300" y1="430" x2="520" y2="280" />
            <line x1="300" y1="430" x2="240" y2="600" />
            <line x1="240" y1="600" x2="120" y2="690" />
            <line x1="240" y1="600" x2="430" y2="650" />
            <line x1="430" y1="650" x2="520" y2="280" />
            <line x1="430" y1="650" x2="500" y2="760" />
            <line x1="80" y1="120" x2="150" y2="360" />
        </g>
        <g>
            <circle class="node" cx="80" cy="120" r="4" />
            <circle class="node node--accent" cx="220" cy="210" r="6" />
            <circle class="node" cx="400" cy="170" r="4" />
            <circle class="node node--clay" cx="520" cy="280" r="6.5" />
            <circle class="node" cx="150" cy="360" r="4" />
            <circle class="node node--accent" cx="300" cy="430" r="5.5" />
            <circle class="node" cx="240" cy="600" r="4" />
            <circle class="node" cx="120" cy="690" r="3.5" />
            <circle class="node node--clay" cx="430" cy="650" r="5.5" />
            <circle class="node" cx="500" cy="760" r="3.5" />
        </g>
    </svg>

    <a class="auth-wordmark" href="/">
        <img class="auth-wordmark__logo" src="img/logo.png" alt="Brainy logo" />
        Brainy
    </a>

    <div class="auth-hero">
        <span class="auth-hero__eyebrow">Your second brain</span>
        <h1 class="auth-hero__title">Turn scattered notes into <em>knowledge you reuse</em>.</h1>
        <p class="auth-hero__lead">
            Capture fast, organize close to action, distill what matters, and turn
            what you know into real output.
        </p>
        <ul class="auth-code">
            <li>Capture</li>
            <li>Organize</li>
            <li>Distill</li>
            <li>Express</li>
        </ul>
    </div>

    <p class="auth-brand__footer">Built on the PARA method &amp; the CODE workflow.</p>
</aside>
