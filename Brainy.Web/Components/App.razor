<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1d1812" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Brainy" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="_content/Heron.MudCalendar/Heron.MudCalendar.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["brainy-design.css"]" />
    <link rel="stylesheet" href="@Assets["Brainy.Web.styles.css"]" />
    <ImportMap />
    <link rel="manifest" href="@Assets["manifest.webmanifest"]" />
    <link rel="icon" type="image/png" href="img/logo.png" />
    <link rel="apple-touch-icon" href="@Assets["icons/apple-touch-icon.png"]" />
    <script>
        // Runs before first paint: apply the persisted theme to avoid a flash.
        // 'brainy' is the default theme and has no data-theme attribute; every
        // other theme (e.g. 'minimal', 'dracula') sets data-theme to its key.
        window.brainyTheme = {
            key: 'brainy-theme',
            setTheme: function (theme) {
                if (theme && theme !== 'brainy') {
                    document.documentElement.setAttribute('data-theme', theme);
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
                try { localStorage.setItem(this.key, theme || 'brainy'); } catch { }
            },
            getTheme: function () {
                try { return localStorage.getItem(this.key) || 'brainy'; } catch { return 'brainy'; }
            }
        };
        var brainyStoredTheme = window.brainyTheme.getTheme();
        if (brainyStoredTheme && brainyStoredTheme !== 'brainy') {
            document.documentElement.setAttribute('data-theme', brainyStoredTheme);
        }
        window.brainyTimeZone = {
            get: function () {
                try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; }
                catch { return 'UTC'; }
            }
        };
    </script>
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script type="module" src="_content/Heron.MudCalendar/Heron.MudCalendar.min.js"></script>
    <script src="@Assets["noteEditor.js"]"></script>
    <script src="@Assets["brainyHelp.js"]"></script>
    <script src="@Assets["brainySearch.js"]"></script>
    <script src="@Assets["brainyCapture.js"]"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('service-worker.js').catch(() => { });
            });
        }
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account/Identity pages opt out of interactive routing and must render
    // statically so server-side form posts and HttpContext access keep working.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
