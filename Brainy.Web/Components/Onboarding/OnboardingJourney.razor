@* ─────────────────────────────────────────────────────────────────────────────
   OnboardingJourney — guided, dismissible first-run journey (issue #294).
   A non-modal floating panel (not a blocking dialog) that walks a new user
   through one real capture -> areas -> process -> next action -> current focus
   loop, using their own real data (never synthetic sample rows). Every step is
   skippable and the current step is persisted so the journey resumes where
   the user left off.

   Capture stays first on purpose: the first step asks for almost nothing and
   returns something real, so the user gets a win before being asked to set
   anything up. Structure (areas) is introduced at step 2, the moment it is
   actually needed to give that capture a home.
───────────────────────────────────────────────────────────────────────────── *@
@implements IDisposable

@using Brainy.Application.Analytics
@using Brainy.Application.Common
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.DTOs.Templates
@using Brainy.Application.Interfaces.Identity
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Common
@using Brainy.Domain.Enums

@inject IUserDashboardPreferenceService PreferenceService
@inject IAnalyticsService AnalyticsService
@inject ICurrentUserService CurrentUser
@inject INoteService NoteService
@inject IProjectService ProjectService
@inject IProjectTemplateService ProjectTemplateService
@inject IAreaService AreaService
@inject ITaskService TaskService
@inject OnboardingJourneyLauncher Launcher
@inject IStringLocalizer<OnboardingJourney> L

@if (_visible)
{
    <div class="ob-journey" role="region" aria-label="@L["RegionLabel"]">
        @if (_minimized)
        {
            <button type="button" class="ob-journey__chip" @onclick="() => _minimized = false"
                    aria-label="@L["ResumeLabel"]">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                <span>@L["ResumeChip", _step + 1, TotalSteps]</span>
            </button>
        }
        else
        {
            <div class="ob-journey__card">
                <div class="ob-journey__head">
                    <span class="ob-journey__head-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                    </span>
                    <div class="ob-journey__head-text">
                        <span class="ob-journey__eyebrow">@L["Eyebrow"]</span>
                        <span class="ob-journey__step-count">@L["StepCount", _step + 1, TotalSteps]</span>
                    </div>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                   aria-label="@L["MinimizeLabel"]"
                                   OnClick="() => _minimized = true" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   aria-label="@L["DismissLabel"]"
                                   OnClick="DismissAsync" />
                </div>

                <div class="ob-journey__dots" role="tablist" aria-label="@L["ProgressLabel"]">
                    @for (var i = 0; i < TotalSteps; i++)
                    {
                        var idx = i;
                        var state = idx == _step ? "ob-journey__dot--active" : idx < _step ? "ob-journey__dot--done" : "";
                        <span class="ob-journey__dot @state" role="tab" aria-selected="@(idx == _step)" aria-label="@L["StepLabel", idx + 1]"></span>
                    }
                </div>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-2">@_error</MudAlert>
                }

                <div class="ob-journey__body" @key="_step">
                    @switch (_step)
                    {
                        case StepIntro:
                            <h3 class="ob-journey__title">@L["IntroTitle"]</h3>
                            <p class="ob-journey__copy">@L["IntroBody"]</p>
                            break;

                        case StepCapture:
                            <h3 class="ob-journey__title">@L["CaptureTitle"]</h3>
                            <p class="ob-journey__copy">@L["CaptureBody"]</p>
                            <MudTextField T="string" @bind-Value="_captureText" Label="@L["CaptureField"]"
                                          Variant="Variant.Outlined" Lines="3" Immediate="true"
                                          aria-label="@L["CaptureField"]" />
                            break;

                        case StepAreas:
                            <h3 class="ob-journey__title">@L["AreasTitle"]</h3>
                            <p class="ob-journey__copy">@L["AreasBody"]</p>
                            @if (_areas.Count > 0)
                            {
                                <p class="ob-journey__hint">@L["AreasExisting", string.Join(", ", _areas.Select(a => a.Name))]</p>
                            }
                            <div class="ob-journey__chips" role="group" aria-label="@L["AreasSuggestionsLabel"]">
                                @foreach (var suggestion in AreaSuggestions)
                                {
                                    var key = suggestion.Key;
                                    var name = L[$"AreaSuggestion{key}"].Value;
                                    var picked = _selectedSuggestions.Contains(key);
                                    var already = HasArea(name);
                                    <button type="button"
                                            class="ob-journey__chip-option @(picked ? "ob-journey__chip-option--on" : "")"
                                            disabled="@already"
                                            aria-pressed="@picked"
                                            @onclick="() => ToggleSuggestion(key)">
                                        <span aria-hidden="true">@suggestion.Emoji</span>
                                        <span>@name</span>
                                    </button>
                                }
                            </div>
                            <MudTextField T="string" @bind-Value="_customAreaName" Label="@L["AreasCustomField"]"
                                          Variant="Variant.Outlined" Class="mt-2" aria-label="@L["AreasCustomField"]" />
                            break;

                        case StepProject:
                            <h3 class="ob-journey__title">@L["ProjectTitle"]</h3>
                            <p class="ob-journey__copy">@L["ProjectBody"]</p>
                            @if (_projects.Count > 0)
                            {
                                <MudSelect T="Guid?" @bind-Value="_selectedProjectId" Label="@L["ProjectField"]" Variant="Variant.Outlined">
                                    @foreach (var project in _projects)
                                    {
                                        <MudSelectItem T="Guid?" Value="@project.Id">@project.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <p class="ob-journey__hint">@L["ProjectNoneHint"]</p>
                                @if (_areas.Count > 0)
                                {
                                    <MudSelect T="Guid?" @bind-Value="_selectedAreaId" Label="@L["ProjectAreaField"]" Variant="Variant.Outlined" Class="mb-2">
                                        @foreach (var area in _areas)
                                        {
                                            <MudSelectItem T="Guid?" Value="@area.Id">@area.Emoji @area.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                @if (_projectTemplates.Count > 0)
                                {
                                    <MudSelect T="Guid?" @bind-Value="_selectedTemplateId" Label="@L["ProjectTemplateField"]" Variant="Variant.Outlined" Class="mb-2">
                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["ProjectTemplateBlank"]</MudSelectItem>
                                        @foreach (var template in _projectTemplates)
                                        {
                                            <MudSelectItem T="Guid?" Value="@template.Id">@template.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                <MudTextField T="string" @bind-Value="_newProjectName" Label="@L["ProjectNameField"]" Variant="Variant.Outlined" />
                            }
                            break;

                        case StepTask:
                            <h3 class="ob-journey__title">@L["TaskTitle"]</h3>
                            <p class="ob-journey__copy">@L["TaskBody"]</p>
                            <MudTextField T="string" @bind-Value="_taskTitle" Label="@L["TaskField"]" Variant="Variant.Outlined"
                                          aria-label="@L["TaskField"]" />
                            break;

                        case StepFocus:
                            <h3 class="ob-journey__title">@L["FocusTitle"]</h3>
                            <p class="ob-journey__copy">@L["FocusBody"]</p>
                            break;

                        case StepWrapUp:
                            <h3 class="ob-journey__title">@L["WrapTitle"]</h3>
                            <p class="ob-journey__copy">@((MarkupString)L["WrapBody"].Value)</p>
                            <TodayWeekTasksHubExplainer />
                            break;
                    }
                </div>

                <div class="ob-journey__actions">
                    @if (_step > StepIntro && _step < TotalSteps - 1)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SkipStepAsync">@L["SkipStep"]</MudButton>
                    }
                    @if (_step == StepIntro)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="DismissAsync">@L["SkipTour"]</MudButton>
                    }
                    <MudSpacer />
                    @if (_step > StepIntro)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => GoToStepAsync(_step - 1)">@L["Back"]</MudButton>
                    }
                    @switch (_step)
                    {
                        case StepIntro:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => GoToStepAsync(StepCapture)">@L["Start"]</MudButton>
                            break;
                        case StepCapture:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="SubmitCaptureAsync">@L["ActionCapture"]</MudButton>
                            break;
                        case StepAreas:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="CreateAreasAsync">@L["ActionCreateAreas"]</MudButton>
                            break;
                        case StepProject:
                            @if (_projects.Count > 0)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="ProcessIntoExistingProjectAsync">@L["ActionProcess"]</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="CreateProjectAndProcessAsync">@L["ActionCreateAndProcess"]</MudButton>
                            }
                            break;
                        case StepTask:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="CreateTaskAsync">@L["ActionCreateTask"]</MudButton>
                            break;
                        case StepFocus:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy" OnClick="SetFocusAsync">@L["ActionMakeFocus"]</MudButton>
                            break;
                        case StepWrapUp:
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="FinishAsync">@L["ActionDone"]</MudButton>
                            break;
                    }
                </div>
            </div>
        }
    </div>

    <style>
        .ob-journey {
            position: fixed;
            left: 2rem;
            bottom: 2rem;
            z-index: 999;
            max-width: 380px;
        }

        .ob-journey__chip {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1rem;
            border: 1px solid var(--line, var(--mud-palette-lines-default));
            border-radius: 999px;
            background: var(--paper-raised, var(--mud-palette-surface));
            color: var(--clay, #c0561d);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.12));
        }

        .ob-journey__card {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 1.1rem 1.2rem;
            border-radius: 16px;
            border: 1px solid var(--line, var(--mud-palette-lines-default));
            background: var(--paper-raised, var(--mud-palette-surface));
            box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,0.16));
        }

        .ob-journey__head {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .ob-journey__head-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 10px;
            background: var(--clay-soft, rgba(192, 86, 29, 0.12));
            color: var(--clay, #c0561d);
            flex-shrink: 0;
        }

        .ob-journey__head-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .ob-journey__eyebrow {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink-faint, var(--mud-palette-text-disabled));
        }

        .ob-journey__step-count {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--ink-soft, var(--mud-palette-text-secondary));
        }

        .ob-journey__dots {
            display: flex;
            gap: 0.35rem;
        }

        .ob-journey__dot {
            height: 5px;
            flex: 1;
            border-radius: 999px;
            background: var(--line, var(--mud-palette-lines-default));
        }

        .ob-journey__dot--done { background: var(--clay-ring, #d98a4f); }
        .ob-journey__dot--active { background: var(--clay, #c0561d); }

        .ob-journey__title {
            margin: 0 0 0.3rem;
            font-family: var(--font-display, inherit);
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--ink, var(--mud-palette-text-primary));
        }

        .ob-journey__copy {
            margin: 0 0 0.6rem;
            font-size: 0.86rem;
            line-height: 1.5;
            color: var(--ink-soft, var(--mud-palette-text-secondary));
        }

        .ob-journey__hint {
            margin: 0 0 0.5rem;
            font-size: 0.82rem;
            color: var(--ink-faint, var(--mud-palette-text-disabled));
        }

        .ob-journey__chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .ob-journey__chip-option {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            border: 1px solid var(--line, var(--mud-palette-lines-default));
            background: transparent;
            color: var(--ink-soft, var(--mud-palette-text-secondary));
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }

        .ob-journey__chip-option:hover:not(:disabled) {
            border-color: var(--clay-ring, #d98a4f);
        }

        .ob-journey__chip-option:focus-visible {
            outline: 3px solid var(--clay-ring, #d98a4f);
            outline-offset: 2px;
        }

        .ob-journey__chip-option--on {
            border-color: var(--clay, #c0561d);
            background: var(--clay-soft, rgba(192, 86, 29, 0.12));
            color: var(--clay, #c0561d);
        }

        .ob-journey__chip-option:disabled {
            opacity: 0.55;
            cursor: default;
        }

        .ob-journey__actions {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            flex-wrap: wrap;
        }

        @@media (max-width: 600px) {
            .ob-journey {
                left: 1rem;
                right: 1rem;
                bottom: 1rem;
                max-width: none;
            }
        }
    </style>
}

@code {
    // Named rather than bare integers because these indices are persisted per user in
    // UserDashboardPreference.OnboardingStep — a step inserted in the middle shifts every
    // index after it, and a bare "case 3:" gives no hint that it did.
    private const int StepIntro = 0;
    private const int StepCapture = 1;
    private const int StepAreas = 2;
    private const int StepProject = 3;
    private const int StepTask = 4;
    private const int StepFocus = 5;
    private const int StepWrapUp = 6;
    private const int TotalSteps = 7;

    /// <summary>
    /// The starter areas offered at <see cref="StepAreas"/>. Deliberately a short, broad
    /// list: enough that most people recognise two or three of their own life divisions,
    /// few enough that picking is not itself a chore. Names are resolved through the
    /// localizer (key <c>AreaSuggestion{Key}</c>) so the created area is named in the
    /// user's own language.
    /// </summary>
    private static readonly (string Key, string Emoji)[] AreaSuggestions =
    [
        ("Work", "\U0001F4BC"),
        ("Personal", "\U0001F331"),
        ("Health", "\U0001F3C3"),
        ("Finances", "\U0001F4B0"),
        ("Learning", "\U0001F4DA"),
        ("Home", "\U0001F3E1"),
        ("Family", "\U0001F465"),
        ("SideProject", "\U0001F680"),
    ];

    private bool _visible;
    private bool _minimized;
    private bool _busy;
    private int _step;
    private string? _error;

    private string _captureText = string.Empty;
    private Guid? _noteId;

    private IReadOnlyList<AreaDto> _areas = [];
    private readonly HashSet<string> _selectedSuggestions = [];
    private string _customAreaName = string.Empty;

    private IReadOnlyList<ProjectDto> _projects = [];
    private IReadOnlyList<ProjectTemplateDto> _projectTemplates = [];
    private Guid? _selectedProjectId;
    private Guid? _selectedAreaId;
    private Guid? _selectedTemplateId;
    private string _newProjectName = string.Empty;
    private Guid? _projectId;

    private string _taskTitle = string.Empty;
    private Guid? _taskId;

    protected override async Task OnInitializedAsync()
    {
        Launcher.OnRestartRequested += RestartAsync;

        try
        {
            var preferences = await PreferenceService.GetOrCreateAsync();
            if (preferences.OnboardingCompleted || preferences.OnboardingDismissed)
            {
                _visible = false;
                return;
            }

            _visible = true;
            _step = Math.Clamp(preferences.OnboardingStep, 0, TotalSteps - 1);
            await LoadWorkspaceAsync();
        }
        catch
        {
            _visible = false;
        }
    }

    public void Dispose() => Launcher.OnRestartRequested -= RestartAsync;

    /// <summary>
    /// Reopens the journey from the start at a page's request (Today's empty state).
    /// Clears the in-memory answers too, so a replay does not silently reuse the note,
    /// project or task from the run the user abandoned.
    /// </summary>
    private async Task RestartAsync()
    {
        try
        {
            await PreferenceService.ResetOnboardingAsync();
        }
        catch
        {
            // Showing the journey again matters more than recording that we did; an
            // unpersisted reset simply means it will not resume after a reload.
        }

        _step = StepIntro;
        _error = null;
        _minimized = false;
        _visible = true;
        _captureText = string.Empty;
        _noteId = null;
        _selectedSuggestions.Clear();
        _customAreaName = string.Empty;
        _selectedProjectId = null;
        _selectedAreaId = null;
        _selectedTemplateId = null;
        _newProjectName = string.Empty;
        _projectId = null;
        _taskTitle = string.Empty;
        _taskId = null;

        await LoadWorkspaceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadWorkspaceAsync()
    {
        try
        {
            _projects = await ProjectService.GetAllNonArchivedAsync();
            if (_selectedProjectId is null && _projects.Count > 0)
                _selectedProjectId = _projects[0].Id;
        }
        catch
        {
            _projects = [];
        }

        await LoadAreasAsync();

        try
        {
            // Seeds the built-in starter templates on first access for a brand-new user,
            // which is precisely the moment this runs.
            _projectTemplates = await ProjectTemplateService.GetAllAsync();
        }
        catch
        {
            _projectTemplates = [];
        }
    }

    private async Task LoadAreasAsync()
    {
        try
        {
            _areas = await AreaService.GetAllActiveAsync();
            if (_selectedAreaId is null && _areas.Count > 0)
                _selectedAreaId = _areas[0].Id;
        }
        catch
        {
            _areas = [];
        }
    }

    private bool HasArea(string name) =>
        _areas.Any(area => string.Equals(area.Name, name, StringComparison.OrdinalIgnoreCase));

    private void ToggleSuggestion(string key)
    {
        if (!_selectedSuggestions.Remove(key))
            _selectedSuggestions.Add(key);
    }

    private async Task GoToStepAsync(int step)
    {
        step = Math.Clamp(step, 0, TotalSteps - 1);
        _step = step;
        _error = null;
        try
        {
            await PreferenceService.SetOnboardingStepAsync(step);
        }
        catch
        {
            // Resumability is a convenience, not a correctness requirement — a failed
            // persist here should not block the user from moving through the journey.
        }
    }

    private Task SkipStepAsync() => GoToStepAsync(_step + 1);

    private async Task TrackStepCompletedAsync(int completedStep)
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null)
            return;

        await AnalyticsService.TrackAsync(
            userId,
            AnalyticsEvents.OnboardingStepCompleted,
            new Dictionary<string, object?> { ["step"] = completedStep });
    }

    private async Task SubmitCaptureAsync()
    {
        if (string.IsNullOrWhiteSpace(_captureText))
        {
            _error = L["ErrorCaptureEmpty"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var title = _captureText.Length > 120 ? _captureText[..120] : _captureText;
            var note = await NoteService.CreateAsync(new CreateNoteDto(Title: title, Content: _captureText));
            _noteId = note.Id;
            await TrackStepCompletedAsync(StepCapture);
            await GoToStepAsync(StepAreas);
        }
        catch
        {
            _error = L["ErrorCaptureFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Creates the areas the user picked, then moves on. Areas the user already has are
    /// left alone — their chip is disabled — so resuming the journey after a break, or
    /// replaying it later, never produces a second "Work".
    /// </summary>
    private async Task CreateAreasAsync()
    {
        var wanted = new List<(string Name, string Emoji)>();

        foreach (var (key, emoji) in AreaSuggestions)
        {
            if (!_selectedSuggestions.Contains(key))
                continue;

            var name = L[$"AreaSuggestion{key}"].Value;
            if (!HasArea(name))
                wanted.Add((name, emoji));
        }

        var custom = _customAreaName.Trim();
        if (custom.Length > 0 &&
            !HasArea(custom) &&
            !wanted.Any(area => string.Equals(area.Name, custom, StringComparison.OrdinalIgnoreCase)))
        {
            wanted.Add((custom, AreaEmojiDefaults.DefaultEmoji));
        }

        _busy = true;
        _error = null;
        try
        {
            foreach (var (name, emoji) in wanted)
                await AreaService.CreateAsync(new CreateAreaDto(name, Emoji: emoji));

            _selectedSuggestions.Clear();
            _customAreaName = string.Empty;
            _selectedAreaId = null;
            await LoadAreasAsync();

            await TrackStepCompletedAsync(StepAreas);
            await GoToStepAsync(StepProject);
        }
        catch
        {
            _error = L["ErrorAreasFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ProcessIntoExistingProjectAsync()
    {
        if (_noteId is null || _selectedProjectId is null)
        {
            _error = L["ErrorPickProject"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await NoteService.ProcessNoteAsync(new ProcessNoteDto(
                _noteId.Value, ParaCategory.Project, NoteStatus.Active, ProjectId: _selectedProjectId));
            _projectId = _selectedProjectId;
            await TrackStepCompletedAsync(StepProject);
            await GoToStepAsync(StepTask);
        }
        catch
        {
            _error = L["ErrorProcessFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateProjectAndProcessAsync()
    {
        var projectName = _newProjectName.Trim();
        if (projectName.Length == 0 && _selectedTemplateId is null)
        {
            _error = L["ErrorProjectNameEmpty"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // The areas step is skippable, so a user can still arrive here with none.
            // Fall back to a single catch-all area rather than blocking the journey.
            var areaId = _selectedAreaId;
            if (areaId is null)
            {
                var fallback = await AreaService.CreateAsync(new CreateAreaDto(L["AreaFallbackName"].Value));
                areaId = fallback.Id;
                await LoadAreasAsync();
            }

            ProjectDto project;
            if (_selectedTemplateId is Guid templateId)
            {
                project = await ProjectTemplateService.InstantiateAsync(new InstantiateProjectTemplateDto(
                    templateId,
                    Name: projectName.Length > 0 ? projectName : null,
                    AreaId: areaId));
            }
            else
            {
                project = await ProjectService.CreateAsync(new CreateProjectDto(projectName, areaId.Value));
            }

            _projectId = project.Id;

            if (_noteId is not null)
            {
                await NoteService.ProcessNoteAsync(new ProcessNoteDto(
                    _noteId.Value, ParaCategory.Project, NoteStatus.Active, ProjectId: project.Id));
            }

            await TrackStepCompletedAsync(StepProject);
            await GoToStepAsync(StepTask);
        }
        catch (PlanEntitlementDeniedException ex)
        {
            // A plan limit is a real, actionable answer — not the generic failure below.
            _error = ex.Message;
        }
        catch
        {
            _error = L["ErrorProjectFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_taskTitle))
        {
            _error = L["ErrorTaskEmpty"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (_projectId is null)
            {
                _projects = await ProjectService.GetAllNonArchivedAsync();
                _projectId = _projects.Count > 0 ? _projects[0].Id : null;
            }

            if (_projectId is null)
            {
                _error = L["ErrorNeedProject"];
                return;
            }

            var task = await TaskService.CreateAsync(new CreateTaskDto(_projectId.Value, _taskTitle.Trim()));
            _taskId = task.Id;
            await TrackStepCompletedAsync(StepTask);
            await GoToStepAsync(StepFocus);
        }
        catch
        {
            _error = L["ErrorTaskFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetFocusAsync()
    {
        if (_taskId is null)
        {
            _error = L["ErrorNeedTask"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await TaskService.SetCurrentTaskAsync(_taskId.Value);
            await TrackStepCompletedAsync(StepFocus);
            await GoToStepAsync(StepWrapUp);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAsync()
    {
        try
        {
            await PreferenceService.CompleteOnboardingAsync();
        }
        catch
        {
            // Best-effort: the user still gets to close the journey even if the
            // completion flag fails to persist; it will simply resume on next load.
        }

        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is not null)
            await AnalyticsService.TrackAsync(userId, AnalyticsEvents.OnboardingCompleted);

        _visible = false;
    }

    private async Task DismissAsync()
    {
        try
        {
            await PreferenceService.DismissOnboardingAsync();
        }
        catch
        {
            // Best-effort: dismissing locally still hides the journey for this session
            // even if the flag fails to persist.
        }

        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is not null)
        {
            await AnalyticsService.TrackAsync(
                userId,
                AnalyticsEvents.OnboardingSkipped,
                new Dictionary<string, object?> { ["step"] = _step });
        }

        _visible = false;
    }
}
