@using Brainy.Application.DTOs.Notes
@using Brainy.Web.Components.Pages.Inbox
@using Brainy.Web.Themes
@inherits LayoutComponentBase
@implements IDisposable

@inject IDialogService DialogService
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime

<MudThemeProvider Theme="_currentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="brainy-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <a href="/" class="brainy-appbar__brand">
            <img class="brainy-appbar__logo" src="img/logo.png" alt="Brainy logo" />
            <span class="brainy-appbar__name">Brainy</span>
        </a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <GlobalSearchBar />
                <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-2">
                    <MudMenuItem OnClick="() => SetThemeAsync(false)">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Small" />
                            <span>Brainy Theme</span>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem OnClick="() => SetThemeAsync(true)">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.FormatPaint" Size="Size.Small" />
                            <span>Minimal</span>
                        </div>
                    </MudMenuItem>
                </MudMenu>
                <div class="brainy-user">
                    <span class="brainy-user__avatar">@GetInitials(context.User.Identity?.Name)</span>
                    <span class="brainy-user__email d-none d-sm-flex">@context.User.Identity?.Name</span>
                </div>
                <form action="Account/Logout" method="post" class="brainy-logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="Account/Login" />
                    <button type="submit" class="brainy-logout-btn" title="Log out">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        <span class="d-none d-sm-inline">Log out</span>
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login" Variant="Variant.Text">
                    Log in
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="brainy-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
            @Body
        </MudContainer>

        <div class="layout-fab">
            <MudFab Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Add"
                    Label="Capture"
                    Size="Size.Medium"
                    OnClick="OpenQuickCaptureAsync" />
        </div>
    </MudMainContent>
</MudLayout>

<style>
    .layout-fab {
        position: fixed;
        right: 2rem;
        bottom: 2rem;
        z-index: 1000;
    }

    .layout-fab .mud-fab {
        box-shadow: var(--shadow-md);
    }

    @@media (max-width: 600px) {
        .layout-fab {
            right: 1rem;
            bottom: 1rem;
        }
    }
</style>

@code {
    private bool _drawerOpen = true;
    private MudTheme _currentTheme = AppThemes.BrainyTheme;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        UpdateTheme();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore the persisted theme (the head script has already set the
            // data-theme attribute, so only the MudTheme needs syncing here).
            var isMinimal = await GetPersistedThemeAsync();
            if (isMinimal != ThemeService.IsMinimalTheme)
            {
                ThemeService.IsMinimalTheme = isMinimal;
            }
            else
            {
                await ApplyThemeToDomAsync();
            }
        }
    }

    private async Task<bool> GetPersistedThemeAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("window.brainyTheme.getTheme");
        }
        catch (Exception)
        {
            return false;
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        UpdateTheme();
        InvokeAsync(StateHasChanged);
        _ = ApplyThemeToDomAsync();
    }

    private void UpdateTheme()
    {
        _currentTheme = ThemeService.IsMinimalTheme ? AppThemes.MinimalTheme : AppThemes.BrainyTheme;
    }

    private async Task SetThemeAsync(bool isMinimal)
    {
        ThemeService.IsMinimalTheme = isMinimal;
        await ApplyThemeToDomAsync();
    }

    private async Task ApplyThemeToDomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.brainyTheme.setTheme", ThemeService.IsMinimalTheme);
        }
        catch (Exception)
        {
            // Ignored if JS is not available (e.g., during pre-rendering)
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OpenQuickCaptureAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<QuickCaptureDialog>("Quick Capture", options);
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return char.ToUpperInvariant(name.TrimStart()[0]).ToString();
    }
}
