@using Brainy.Application.DTOs.Tasks
@using Brainy.Domain.Enums

@* ─────────────────────────────────────────────────────────────────────────────
   TasksNeedingAttentionWidget — shows tasks that need immediate attention.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-widget td-section">
    <div class="td-section-head">
        <h2 id="attention-tasks-heading" class="td-section-label td-section-label--overdue">Needs Attention</h2>
        <span class="td-section-count">@Tasks.Count task@(Tasks.Count == 1 ? "" : "s")</span>
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       aria-label="@(_collapsed ? "Expand tasks needing attention" : "Collapse tasks needing attention")"
                       aria-expanded="@(_collapsed ? "false" : "true")"
                       aria-controls="attention-tasks"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        <div id="attention-tasks">
        @if (Tasks.Count == 0)
        {
            <p class="td-empty">Nothing needs immediate attention — you're on top of it!</p>
        }
        else
        {
            @foreach (var t in Tasks)
            {
                <div class="td-task @PriorityClass(t.Priority)">
                    <div class="td-task-body">
                        <h3 class="td-task-title">@t.Title</h3>
                        <div class="td-task-meta">
                            <span class="td-task-project">@t.ProjectName</span>
                            @foreach (var reason in GetReasons(t))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@reason.Color" Variant="Variant.Filled">
                                    @reason.Label
                                </MudChip>
                            }
                        </div>
                        @if (_rescheduleTaskId == t.Id)
                        {
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.6rem;flex-wrap:wrap;">
                                <MudDatePicker @bind-Date="_rescheduleDate"
                                               Label="New due date"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               ShowToolbar="false"
                                               Clearable="true"
                                                />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(!_rescheduleDate.HasValue)"
                                           OnClick="@(() => ApplyReschedule(t.Id))">Apply</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="CancelReschedule">Cancel</MudButton>
                            </div>
                        }
                    </div>
                    <MudTooltip Text="Reschedule">
                        <MudIconButton Icon="@Icons.Material.Outlined.EditCalendar"
                                       Size="Size.Small"
                                       Color="@(_rescheduleTaskId == t.Id ? Color.Primary : Color.Default)"
                                       aria-label="@($"Reschedule {t.Title}")"
                                       aria-expanded="@(_rescheduleTaskId == t.Id ? "true" : "false")"
                                       OnClick="@(() => ToggleReschedule(t.Id, t.DueDate))" />
                    </MudTooltip>
                    <MudTooltip Text="Mark complete">
                        <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                       Size="Size.Small" Color="Color.Success"
                                       aria-label="@($"Mark {t.Title} complete")"
                                       OnClick="() => OnComplete.InvokeAsync(t.Id)" />
                    </MudTooltip>
                </div>
            }
        }
        </div>
    }
</div>

@code {
    /// <summary>Tasks needing attention.</summary>
    [Parameter] public IReadOnlyList<TasksHubTaskDto> Tasks { get; set; } = [];

    /// <summary>Raised with the task ID when the user marks a task complete.</summary>
    [Parameter] public EventCallback<Guid> OnComplete { get; set; }

    /// <summary>Raised when the user picks a new due date inline. Provides the task ID and chosen date.</summary>
    [Parameter] public EventCallback<(Guid TaskId, DateTime? NewDate)> OnReschedule { get; set; }

    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;
    private Guid? _rescheduleTaskId;
    private DateTime? _rescheduleDate;

    protected override void OnInitialized() => _collapsed = Collapsed;

    private void ToggleReschedule(Guid taskId, DateTime? currentDate)
    {
        if (_rescheduleTaskId == taskId) { _rescheduleTaskId = null; _rescheduleDate = null; }
        else { _rescheduleTaskId = taskId; _rescheduleDate = currentDate; }
    }

    private async Task ApplyReschedule(Guid taskId)
    {
        await OnReschedule.InvokeAsync((taskId, _rescheduleDate));
        _rescheduleTaskId = null;
        _rescheduleDate = null;
    }

    private void CancelReschedule() { _rescheduleTaskId = null; _rescheduleDate = null; }

    private record AttentionReason(string Label, Color Color);

    private static IReadOnlyList<AttentionReason> GetReasons(TasksHubTaskDto t)
    {
        var today = DateTime.UtcNow.Date;
        var reasons = new List<AttentionReason>();

        if (t.DueDate.HasValue)
        {
            if (t.DueDate.Value.Date < today)
                reasons.Add(new AttentionReason("Overdue", Color.Error));
            else if (t.DueDate.Value.Date == today)
                reasons.Add(new AttentionReason("Due Today", Color.Warning));
        }

        if (t.Priority == TaskPriority.Critical)
            reasons.Add(new AttentionReason("Critical", Color.Error));

        return reasons;
    }

    private static string PriorityClass(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "td-task--critical",
        TaskPriority.High     => "td-task--high",
        TaskPriority.Medium   => "td-task--medium",
        _                     => "td-task--low",
    };
}


