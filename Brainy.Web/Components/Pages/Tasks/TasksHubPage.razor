@page "/tasks-hub"
@attribute [Authorize]
@using Brainy.Application.DTOs
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Tasks
@inject ITasksHubService TasksHubService
@inject ITaskService TaskService
@inject IProjectService ProjectService
@inject ISnackbar Snackbar
@inject IUserTimeZoneService UserTimeZoneService

<PageTitle>Tasks Hub · Brainy</PageTitle>

<style>

    /* ── Page Layout ── */
    .td-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .td-layout {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* ── Top Dashboard Area ── */
    .td-top-dashboard {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        position: relative;
        overflow: hidden;
        padding: clamp(1.25rem, 3vw, 2rem);
        background:
            radial-gradient(circle at 92% 0%, rgba(192, 86, 29, 0.12), transparent 28%),
            var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 20px;
        box-shadow: 0 12px 32px rgba(38, 32, 27, 0.05);
    }

    .td-top-dashboard::before {
        content: '';
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        background: linear-gradient(180deg, var(--clay, #c0561d), #e5a66f);
    }

    .td-header-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
    }

    .td-hero {
        margin-bottom: 0;
        max-width: 680px;
    }

    .td-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .td-greeting {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 600;
        line-height: 0.95;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0;
    }

    .td-hero-title-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .td-hero-description {
        max-width: 620px;
        margin: 0.85rem 0 0;
        color: var(--mud-palette-text-secondary);
        font-size: 1rem;
        line-height: 1.55;
    }

    .td-header-summary {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.5rem;
        max-width: 420px;
    }

    .td-header-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 34px;
        padding: 0.4rem 0.75rem;
        color: var(--mud-palette-text-secondary);
        background: color-mix(in srgb, var(--mud-palette-surface) 82%, transparent);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .td-header-pill::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--clay, #c0561d);
        box-shadow: 0 0 0 4px rgba(192, 86, 29, 0.1);
    }

    .td-header-pill--attention {
        color: #9a3412;
        border-color: rgba(234, 88, 12, 0.25);
        background: rgba(255, 247, 237, 0.92);
    }

    .td-header-pill--attention::before {
        background: #ea580c;
        box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.11);
    }

    .td-header-pill--healthy {
        color: #166534;
        border-color: rgba(22, 163, 74, 0.22);
        background: rgba(240, 253, 244, 0.92);
    }

    .td-header-pill--healthy::before {
        background: #16a34a;
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.1);
    }

    .td-sidebar-widgets {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .td-sidebar-widgets > * {
        min-width: 0;
    }

    @@media (min-width: 1000px) {
        .td-sidebar-widgets {
            grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
            align-items: stretch;
        }
    }

    .th-status-overview {
        min-width: 0;
        padding: 0.15rem 0;
    }

    .th-overview-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.9rem;
    }

    .th-overview-caption {
        color: var(--mud-palette-text-disabled);
        font-size: 0.78rem;
        font-weight: 500;
    }

    @@media (max-width: 760px) {
        .td-header-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 1.25rem;
        }

        .td-header-summary {
            justify-content: flex-start;
        }
    }

    /* ── Main Area ── */
    .td-loading-state {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .th-search-wrap {
        margin-bottom: 2.5rem;
    }

    .th-search-results {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px dashed var(--mud-palette-lines-default);
    }

    /* ── Widget Sections Grid ── */
    .td-sections { 
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem; 
    }

    @@media (min-width: 1200px) {
        .td-sections {
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }
    }

    .td-section { 
        animation: td-fade-up 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; 
    }

    @@keyframes td-fade-up {
        from { opacity: 0; transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .td-section:nth-child(1) { animation-delay: 0.05s; }
    .td-section:nth-child(2) { animation-delay: 0.10s; }
    .td-section:nth-child(3) { animation-delay: 0.15s; }
    .td-section:nth-child(4) { animation-delay: 0.20s; }
    .td-section:nth-child(5) { animation-delay: 0.25s; }
    .td-section:nth-child(6) { animation-delay: 0.30s; }

    /* ── Widget Sub-components styling ── */
    .td-section-head {
        display: flex;
        align-items: baseline;
        gap: 0.65rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .td-section-label {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin: 0;
    }

    .td-section-label--overdue { color: #d32f2f; }

    .td-section-count { 
        font-size: 0.72rem; 
        color: var(--mud-palette-text-disabled); 
        font-weight: 500;
    }

    /* ── Task Items ── */
    .td-task {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        margin-bottom: 0.65rem;
        position: relative;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .td-task::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 4px;
        opacity: 0.85;
        border-radius: 12px 0 0 12px;
    }

    .td-task--critical::before { background: #d32f2f; }
    .td-task--high::before     { background: #ed6c02; }
    .td-task--medium::before   { background: #fbc02d; }
    .td-task--low::before      { background: #388e3c; }
    
    .td-task--overdue { 
        border-color: rgba(211, 47, 47, 0.25); 
        background: rgba(211, 47, 47, 0.02); 
    }

    .td-task:hover { 
        border-color: rgba(192, 86, 29, 0.35); 
        box-shadow: 0 4px 12px rgba(192, 86, 29, 0.08); 
        transform: translateY(-2px);
    }

    .td-task-body { flex: 1; min-width: 0; }

    .td-task-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
        line-height: 1.2;
    }

    .td-task-meta {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-top: 0.35rem;
        font-size: 0.72rem;
        color: var(--mud-palette-text-secondary);
        font-weight: 500;
    }

    .td-task-project {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.5rem;
        background: var(--mud-palette-table-lines);
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .td-task-due { font-variant-numeric: tabular-nums; }
    .td-task-due--overdue { color: #d32f2f; font-weight: 700; }

    .td-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
    }

    .td-empty {
        padding: 1.25rem 1rem;
        font-size: 0.85rem;
        color: var(--mud-palette-text-disabled);
        font-style: italic;
        text-align: center;
        background: var(--mud-palette-table-lines);
        border-radius: 8px;
        border: 1px dashed var(--mud-palette-lines-default);
    }

    .td-skeleton {
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(90deg, var(--mud-palette-surface) 25%, var(--mud-palette-lines-default) 50%, var(--mud-palette-surface) 75%);
        background-size: 200% 100%;
        animation: td-shimmer 1.5s ease infinite;
        margin-bottom: 0.5rem;
    }

    /* ── th- classes for the stat cards and health rows ── */

    .th-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.75rem;
    }

    .th-stat-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        min-height: 94px;
        padding: 0.9rem 1rem;
        background: color-mix(in srgb, var(--mud-palette-table-lines) 64%, transparent);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        gap: 0.65rem;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .th-stat-card:hover { 
        box-shadow: 0 4px 12px rgba(192, 86, 29, 0.05);
        transform: translateY(-2px);
    }

    .th-stat-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }

    .th-stat-value {
        font-family: var(--font-display);
        font-size: 2.15rem;
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-secondary);
    }

    .th-stat--todo       { color: var(--mud-palette-text-disabled); }
    .th-stat--inprogress { color: var(--clay, #c0561d); }
    .th-stat--waiting    { color: #f57f17; }
    .th-stat--done       { color: #388e3c; }

    .th-health-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 0.65rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        transition: border-color 0.2s;
    }
    
    .th-health-row:hover {
        border-color: var(--mud-palette-lines-default);
    }

    .th-health-label {
        flex: 1;
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        font-weight: 500;
    }

    .th-health-stack {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    /* ── Filter Bar ── */
    .th-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: flex-end;
        padding: 1rem 1.25rem;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .th-filter-bar-fields {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: flex-end;
        flex: 1;
    }

    .th-filter-bar-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        padding-bottom: 2px;
    }

    /* ── Bulk Toolbar ── */
    .th-bulk-toolbar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        background: rgba(192, 86, 29, 0.06);
        border: 1px solid rgba(192, 86, 29, 0.25);
    }

    /* ── Filtered Results Section ── */
    .th-filtered-section {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px dashed var(--mud-palette-lines-default);
    }
</style>
<AuthorizeView>
    <Authorized>
<div class="td-page">
    <div class="td-layout">

        @* ── Top Dashboard Area ── *@
        <section class="td-top-dashboard">
            <div class="td-header-row">
                <div class="td-hero">
                    <p class="td-eyebrow">Task management</p>
                    <div class="td-hero-title-row">
                        <h1 id="tasks-hub-title" class="td-greeting">Tasks Hub</h1>
                        <PageHelpButton Guide="HelpGuide" />
                    </div>
                    <p class="td-hero-description">
                        See the state of your project work, catch tasks that need a decision,
                        and narrow your focus from one place.
                    </p>
                </div>
                @if (!_loading && _loadError is null)
                {
                    <div class="td-header-summary" aria-label="Task hub summary">
                        <span class="td-header-pill">
                            @ActiveTaskCount active task@(ActiveTaskCount == 1 ? "" : "s")
                        </span>
                        @if (HealthSignalCount > 0)
                        {
                            <span class="td-header-pill td-header-pill--attention">
                                @HealthSignalCount health signal@(HealthSignalCount == 1 ? "" : "s")
                            </span>
                        }
                        else
                        {
                            <span class="td-header-pill td-header-pill--healthy">Health checks clear</span>
                        }
                    </div>
                }
            </div>

            @if (!_loading && _loadError is null)
            {
                <div class="td-sidebar-widgets">
                    @* ── Status summary strip ── *@
                    <section class="th-status-overview" aria-labelledby="task-status-overview-heading">
                        <div class="th-overview-head">
                            <h2 id="task-status-overview-heading" class="td-section-label">Workflow snapshot</h2>
                            <span class="th-overview-caption">Where your tasks are now</span>
                        </div>
                        <TaskStatusSummaryWidget Summary="_aggregate!.StatusSummary" />
                    </section>

                    @* ── Task Health ── *@
                    <TaskHealthWidget OverdueCount="_aggregate!.OverdueTasks.Count"
                                      StaleCount="_aggregate!.StaleTasks.Count"
                                      WithoutDueDateCount="_aggregate!.WithoutDueDateTasks.Count" />
                </div>
            }
        </section>

        @* ── Main Content: Search, Diagnostics & Grouped Tasks ── *@
        <section class="td-main" aria-labelledby="tasks-hub-title" aria-busy="@(_loading ? "true" : "false")">
            @if (_loading)
            {
                <div class="td-loading-state" role="status" aria-live="polite">
                    <div class="td-skeleton"></div>
                    <div class="td-skeleton" style="width:85%;"></div>
                    <div class="td-skeleton" style="width:70%;"></div>
                    <p>Loading Tasks Hub…</p>
                </div>
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
                    <MudText Typo="Typo.body1">@_loadError</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryInitialLoadAsync" Class="mt-2">
                        Try again
                    </MudButton>
                </MudAlert>
            }
            else
            {
                @* ── Search bar ── *@
                <div class="th-search-wrap">
                    <MudTextField @bind-Value="_searchTerm"
                                  Label="Search tasks"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  DebounceInterval="350"
                                  OnDebounceIntervalElapsed="HandleSearch" />
                </div>

                @if (_projectLoadError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" role="status">
                        <MudText Typo="Typo.body2">@_projectLoadError</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" OnClick="LoadProjectsAsync">
                            Retry project filter
                        </MudButton>
                    </MudAlert>
                }

                @* ── Filter bar ── *@
                <div class="th-filter-bar">
                    <div class="th-filter-bar-fields">
                        <MudSelect T="TaskItemStatus?" @bind-Value="_filterStatus"
                                   Label="Status" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true"
                                   Style="min-width:130px;">
                            <MudSelectItem T="TaskItemStatus?" Value="@null">All</MudSelectItem>
                            <MudSelectItem T="TaskItemStatus?" Value="@((TaskItemStatus?)TaskItemStatus.Todo)">Todo</MudSelectItem>
                            <MudSelectItem T="TaskItemStatus?" Value="@((TaskItemStatus?)TaskItemStatus.InProgress)">In Progress</MudSelectItem>
                            <MudSelectItem T="TaskItemStatus?" Value="@((TaskItemStatus?)TaskItemStatus.Waiting)">Waiting</MudSelectItem>
                            <MudSelectItem T="TaskItemStatus?" Value="@((TaskItemStatus?)TaskItemStatus.Done)">Done</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="TaskPriority?" @bind-Value="_filterMinPriority"
                                   Label="Min Priority" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true"
                                   Style="min-width:140px;">
                            <MudSelectItem T="TaskPriority?" Value="@null">All</MudSelectItem>
                            <MudSelectItem T="TaskPriority?" Value="@((TaskPriority?)TaskPriority.Critical)">Critical only</MudSelectItem>
                            <MudSelectItem T="TaskPriority?" Value="@((TaskPriority?)TaskPriority.High)">High+</MudSelectItem>
                            <MudSelectItem T="TaskPriority?" Value="@((TaskPriority?)TaskPriority.Medium)">Medium+</MudSelectItem>
                            <MudSelectItem T="TaskPriority?" Value="@((TaskPriority?)TaskPriority.Low)">All priorities</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="Guid?" @bind-Value="_filterProjectId"
                                   Label="Project" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true"
                                   Style="min-width:160px;">
                            <MudSelectItem T="Guid?" Value="@null">All projects</MudSelectItem>
                            @foreach (var p in _projects)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)p.Id)">@p.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <div style="flex: 1; max-width: 150px;">
                            <MudDatePicker @bind-Date="_filterDueAfter"
                                           Label="Due from"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           ShowToolbar="false"
                                           Clearable="true" />
                        </div>

                        <div style="flex: 1; max-width: 150px;">
                            <MudDatePicker @bind-Date="_filterDueBefore"
                                           Label="Due to"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           ShowToolbar="false"
                                           Clearable="true" />
                        </div>

                        <MudSelect T="TaskComplexity?" @bind-Value="_filterComplexity"
                                   Label="Complexity" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true"
                                   Style="min-width:140px;">
                            <MudSelectItem T="TaskComplexity?" Value="@null">All sizes</MudSelectItem>
                            <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.XS)">XS</MudSelectItem>
                            <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.S)">S</MudSelectItem>
                            <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.M)">M</MudSelectItem>
                            <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.L)">L</MudSelectItem>
                            <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.XL)">XL</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div class="th-filter-bar-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.FilterList"
                                   OnClick="ApplyFiltersAsync">Apply Filters</MudButton>
                        @if (AnyFiltersSet || _filtersApplied)
                        {
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.FilterListOff"
                                       OnClick="ClearFilters">Clear</MudButton>
                        }
                    </div>
                </div>

                @* ── Search results ── *@
                @if (_searchResults is not null)
                {
                    <section class="td-section th-search-results" aria-labelledby="task-search-results-heading">
                        <div class="td-section-head">
                            <h2 id="task-search-results-heading" class="td-section-label">Search Results</h2>
                            <span class="td-section-count">@_searchResults.TotalCount result@(_searchResults.TotalCount == 1 ? "" : "s")</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small" Style="margin-left:auto;"
                                           aria-label="Clear task search results"
                                           OnClick="ClearSearch" />
                        </div>
                        @if (_searchResults.Items.Count == 0)
                        {
                            <p class="td-empty">No tasks match your search.</p>
                        }
                        else
                        {
                            @foreach (var t in _searchResults.Items)
                            {
                                <div class="td-task @PriorityClass(t.Priority)">
                                    <div class="td-task-body">
                                        <h3 class="td-task-title">@t.Title</h3>
                                        <div class="td-task-meta">
                                            <span class="td-task-project">@t.ProjectName</span>
                                            <MudChip T="string" Size="Size.Small" Color="@PriorityColor(t.Priority)" Variant="Variant.Outlined">
                                                @t.Priority.ToString()
                                            </MudChip>
                                            @if (t.Complexity.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                                         Style="font-family: var(--font-display);font-weight:600;">
                                                    @t.Complexity.Value.ToString()
                                                </MudChip>
                                            }
                                            @if (t.DueDate.HasValue)
                                            {
                                                <span class="td-task-due">Due @t.DueDate.Value.ToString("MMM d")</span>
                                            }
                                        </div>
                                        @if (_rescheduleTaskId == t.Id)
                                        {
                                            <div id="@($"hub-reschedule-{t.Id}")" style="display:flex;align-items:center;gap:0.5rem;margin-top:0.6rem;flex-wrap:wrap;">
                                                <div style="flex: 1; max-width: 180px;">
                                                    <MudDatePicker @bind-Date="_rescheduleDate"
                                                                   Label="New due date"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   ShowToolbar="false"
                                                                   Clearable="true" />
                                                </div>
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                           Disabled="@(!_rescheduleDate.HasValue)"
                                                           OnClick="@(() => HandleRescheduleApply(t.Id))">Apply</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                           OnClick="CancelInlineReschedule">Cancel</MudButton>
                                            </div>
                                        }
                                    </div>
                                    <MudTooltip Text="Reschedule">
                                        <MudIconButton Icon="@Icons.Material.Outlined.EditCalendar"
                                                       Size="Size.Small"
                                                       Color="@(_rescheduleTaskId == t.Id ? Color.Primary : Color.Default)"
                                                       aria-label="@($"Reschedule {t.Title}")"
                                                       aria-expanded="@(_rescheduleTaskId == t.Id ? "true" : "false")"
                                                       aria-controls="@($"hub-reschedule-{t.Id}")"
                                                       OnClick="@(() => ToggleInlineReschedule(t.Id, t.DueDate))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Mark complete">
                                        <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                                       Size="Size.Small" Color="Color.Success"
                                                       aria-label="@($"Mark {t.Title} complete")"
                                                       OnClick="() => HandleCompleted(t.Id)" />
                                    </MudTooltip>
                                </div>
                            }
                        }
                    </section>
                }
                else if (_filtersApplied && _filteredResults is not null)
                {
                    @* ── Filtered results with checkboxes + bulk actions ── *@
                    <section class="th-filtered-section" aria-labelledby="filtered-tasks-heading">

                        @* Bulk actions toolbar — visible only when items are selected *@
                        @if (_selectedTaskIds.Count > 0)
                        {
                            <div class="th-bulk-toolbar" role="region" aria-label="Bulk task actions">
                                <MudText Typo="Typo.body2" Style="font-weight:700;">
                                    @_selectedTaskIds.Count selected
                                </MudText>
                                <MudSpacer />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Outlined.CheckCircle"
                                           OnClick="BulkCompleteAsync">Complete</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Outlined.EditCalendar"
                                           aria-expanded="@(_bulkReschedulePanelOpen ? "true" : "false")"
                                           aria-controls="bulk-reschedule-panel"
                                           OnClick="ToggleBulkReschedulePanel">Reschedule</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Outlined.Archive"
                                           OnClick="BulkArchiveAsync">Archive</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="DeselectAll">
                                    Deselect all
                                </MudButton>
                            </div>

                            @if (_bulkReschedulePanelOpen)
                            {
                                <div id="bulk-reschedule-panel" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1.1rem;background:var(--mud-palette-surface);border:1px solid var(--mud-palette-primary);border-radius:12px;margin-bottom:1rem;flex-wrap:wrap;">
                                    <div style="flex: 1; max-width: 220px;">
                                        <MudDatePicker @bind-Date="_bulkRescheduleDate"
                                                       Label="New due date for all selected"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       ShowToolbar="false"
                                                       Clearable="true" />
                                    </div>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="@(!_bulkRescheduleDate.HasValue)"
                                               OnClick="BulkRescheduleAsync">Apply to @_selectedTaskIds.Count task@(_selectedTaskIds.Count == 1 ? "" : "s")</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="CancelBulkReschedule">Cancel</MudButton>
                                </div>
                            }
                        }

                        @* Header with select-all ── *@
                        <div class="td-section-head">
                            <MudCheckBox T="bool"
                                         aria-label="@($"Select all {_filteredResults.Items.Count} filtered tasks")"
                                         Value="@(_filteredResults.Items.Count > 0 && _selectedTaskIds.Count == _filteredResults.Items.Count)"
                                         ValueChanged="ToggleSelectAll"
                                         Size="Size.Small"
                                         Style="margin-right:0.25rem;" />
                            <h2 id="filtered-tasks-heading" class="td-section-label">Filtered Results</h2>
                            <span class="td-section-count">@_filteredResults.TotalCount result@(_filteredResults.TotalCount == 1 ? "" : "s")</span>
                        </div>

                        @if (_filteredResults.Items.Count == 0)
                        {
                            <p class="td-empty">No tasks match the current filters.</p>
                        }
                        else
                        {
                            @foreach (var t in _filteredResults.Items)
                            {
                                var isSelected = _selectedTaskIds.Contains(t.Id);
                                <div class="td-task @PriorityClass(t.Priority) @(IsOverdue(t) ? "td-task--overdue" : "")">
                                    <MudCheckBox T="bool" Value="@isSelected"
                                                 aria-label="@($"Select task {t.Title}")"
                                                 ValueChanged="@(v => ToggleTaskSelection(t.Id, v))"
                                                 Size="Size.Small" />
                                    <div class="td-task-body">
                                        <h3 class="td-task-title">@t.Title</h3>
                                        <div class="td-task-meta">
                                            <span class="td-task-project">@t.ProjectName</span>
                                            <MudChip T="string" Size="Size.Small" Color="@PriorityColor(t.Priority)" Variant="Variant.Outlined">
                                                @t.Priority.ToString()
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(t.Status)" Variant="Variant.Filled">
                                                @StatusLabel(t.Status)
                                            </MudChip>
                                            @if (t.Complexity.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                                         Style="font-family: var(--font-display);font-weight:600;">
                                                    @t.Complexity.Value.ToString()
                                                </MudChip>
                                            }
                                            @if (t.DueDate.HasValue)
                                            {
                                                <span class="td-task-due @(IsOverdue(t) ? "td-task-due--overdue" : "")">
                                                    Due @t.DueDate.Value.ToString("MMM d")
                                                </span>
                                            }
                                        </div>
                                        @if (_rescheduleTaskId == t.Id)
                                        {
                                            <div id="@($"hub-reschedule-{t.Id}")" style="display:flex;align-items:center;gap:0.5rem;margin-top:0.6rem;flex-wrap:wrap;">
                                                <div style="flex: 1; max-width: 180px;">
                                                    <MudDatePicker @bind-Date="_rescheduleDate"
                                                                   Label="New due date"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   ShowToolbar="false"
                                                                   Clearable="true" />
                                                </div>
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                           Disabled="@(!_rescheduleDate.HasValue)"
                                                           OnClick="@(() => HandleRescheduleApply(t.Id))">Apply</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                           OnClick="CancelInlineReschedule">Cancel</MudButton>
                                            </div>
                                        }
                                    </div>
                                    <MudTooltip Text="Reschedule">
                                        <MudIconButton Icon="@Icons.Material.Outlined.EditCalendar"
                                                       Size="Size.Small"
                                                       Color="@(_rescheduleTaskId == t.Id ? Color.Primary : Color.Default)"
                                                       aria-label="@($"Reschedule {t.Title}")"
                                                       aria-expanded="@(_rescheduleTaskId == t.Id ? "true" : "false")"
                                                       aria-controls="@($"hub-reschedule-{t.Id}")"
                                                       OnClick="@(() => ToggleInlineReschedule(t.Id, t.DueDate))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Mark complete">
                                        <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                                       Size="Size.Small" Color="Color.Success"
                                                       aria-label="@($"Mark {t.Title} complete")"
                                                       OnClick="@(() => HandleCompleted(t.Id))" />
                                    </MudTooltip>
                                </div>
                            }
                        }
                    </section>
                }
                else
                {
                    @* ── Widget Sections Grid ── *@
                    <div class="td-sections">
                        <TasksNeedingAttentionWidget Tasks="_aggregate!.NeedingAttentionTasks"
                                                     Today="_today"
                                                     OnComplete="HandleCompleted"
                                                     OnReschedule="HandleWidgetRescheduleAsync" />

                        <OverdueTasksWidget Tasks="_aggregate!.OverdueTasks"
                                            Today="_today"
                                            OnComplete="HandleCompleted"
                                            OnReschedule="HandleWidgetRescheduleAsync" />

                        <HighPriorityTasksWidget Tasks="_aggregate!.HighPriorityTasks"
                                                 OnComplete="HandleCompleted"
                                                 OnReschedule="HandleWidgetRescheduleAsync" />

                        <TasksOnHoldWidget Tasks="_aggregate!.OnHoldTasks"
                                           OnResume="HandleResume"
                                           OnReschedule="HandleWidgetRescheduleAsync" />

                        <TasksWithoutDueDateWidget Tasks="_aggregate!.WithoutDueDateTasks"
                                                   OnReschedule="HandleWidgetRescheduleAsync" />

                        <MyTasksWidget Tasks="_aggregate!.ActiveTasks"
                                       OnComplete="HandleCompleted"
                                       OnReschedule="HandleWidgetRescheduleAsync"
                                       Collapsed="true" />
                    </div>
                }
            }
        </section>
    </div>
</div>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "tasks-hub",
        PageTitle = "Tasks Hub",
        Tagline = "One command center for active project work",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.TaskAlt,
                Lead = "Tasks Hub gathers active tasks from across your projects so you can see what needs action without opening every project.",
                Points =
                [
                    "Search tasks across projects and clear the results when you are done.",
                    "Filter tasks by status, priority, project, or due date range.",
                    "Review My Tasks, High-Priority, Overdue, Needing Attention, On Hold and No Due Date groups.",
                    "Use Task Health and Status Summary to spot bottlenecks.",
                    "Complete or reschedule tasks directly from the hub without opening the full editor.",
                    "Use bulk actions to complete, reschedule, or archive multiple tasks at once."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In a Second Brain, tasks stay connected to project outcomes; the hub surfaces active work so actionability stays ahead of storage.",
                Points =
                [
                    "PARA keeps tasks anchored to Projects, not floating in a generic checklist.",
                    "Health and due-date views show what needs a decision next.",
                    "Archived tasks stay out of active views so old context does not add noise."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use Search tasks to find a specific task across active projects.",
                    "Use the filter bar to narrow by status, priority, project, or due date, then Apply Filters.",
                    "In the filtered list, check tasks to select them and use bulk actions.",
                    "Click the calendar icon on any task row to reschedule inline — pick a date and press Apply.",
                    "Scan Status Summary and Task Health before choosing what to act on.",
                    "Work through Needing Attention, Overdue, High-Priority, On Hold, No Due Date and My Tasks."
                ]
            }
        ]
    };

    // ── Core state ──────────────────────────────────────────────────────────

    private bool _loading = true;
    private DateTime _today = DateTime.Today;
    private string? _loadError;
    private string? _projectLoadError;
    private TasksHubAggregateDto? _aggregate;

    // ── Search ───────────────────────────────────────────────────────────────

    private string _searchTerm = string.Empty;
    private PagedResult<TasksHubTaskDto>? _searchResults;

    // ── Filter bar ──────────────────────────────────────────────────────────

    private TaskItemStatus? _filterStatus;
    private TaskPriority?   _filterMinPriority;
    private TaskComplexity? _filterComplexity;
    private Guid?           _filterProjectId;
    private DateTime?       _filterDueAfter;
    private DateTime?       _filterDueBefore;
    private IReadOnlyList<ProjectDto> _projects = [];
    private PagedResult<TasksHubTaskDto>? _filteredResults;
    private bool _filtersApplied;

    private int ActiveTaskCount =>
        _aggregate is null
            ? 0
            : _aggregate.StatusSummary.TodoCount
              + _aggregate.StatusSummary.InProgressCount
              + _aggregate.StatusSummary.WaitingCount;

    private int HealthSignalCount =>
        _aggregate is null
            ? 0
            : _aggregate.OverdueTasks.Count
              + _aggregate.StaleTasks.Count
              + _aggregate.WithoutDueDateTasks.Count;

    // ── Bulk selection ───────────────────────────────────────────────────────

    private HashSet<Guid> _selectedTaskIds = [];
    private DateTime?     _bulkRescheduleDate;
    private bool          _bulkReschedulePanelOpen;

    // ── Inline reschedule (page-level: search results + filtered results) ────

    private Guid?     _rescheduleTaskId;
    private DateTime? _rescheduleDate;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // DbContext is not thread-safe — run sequentially.
        await LoadAsync();
        await LoadProjectsAsync();
    }

    // ── Data loading ─────────────────────────────────────────────────────────

    private async Task LoadAsync()
    {
        _today = (await UserTimeZoneService.GetUserTodayAsync()).Date;
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            _aggregate = await TasksHubService.GetHubAggregateAsync();
        }
        catch
        {
            _aggregate = null;
            _loadError = "Brainy could not load Tasks Hub. Your data was not changed.";
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadProjectsAsync()
    {
        _projectLoadError = null;

        try
        {
            _projects = await ProjectService.GetAllNonArchivedAsync();
        }
        catch
        {
            _projects = [];
            _projectLoadError = "Project filter options are temporarily unavailable. Other task views remain usable.";
        }
    }

    private async Task RetryInitialLoadAsync()
    {
        await LoadAsync();
        await LoadProjectsAsync();
    }

    // ── Search ───────────────────────────────────────────────────────────────

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _searchResults = null;
            StateHasChanged();
            return;
        }

        try
        {
            _searchResults = await TasksHubService.SearchTasksAsync(_searchTerm.Trim());
        }
        catch
        {
            Snackbar.Add("Search failed.", Severity.Error);
        }

        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm    = string.Empty;
        _searchResults = null;
        StateHasChanged();
    }

    // ── Filters ──────────────────────────────────────────────────────────────

    private bool AnyFiltersSet =>
        _filterStatus.HasValue || _filterMinPriority.HasValue ||
        _filterProjectId.HasValue || _filterDueAfter.HasValue || _filterDueBefore.HasValue ||
        _filterComplexity.HasValue;

    private async Task ApplyFiltersAsync()
    {
        try
        {
            var filter = new TasksHubFilterDto(
                ProjectId:   _filterProjectId,
                Status:      _filterStatus,
                MinPriority: _filterMinPriority,
                DueAfter:    _filterDueAfter,
                DueBefore:   _filterDueBefore,
                Complexity:  _filterComplexity);

            _filteredResults = await TasksHubService.GetFilteredTasksAsync(filter);
            _filtersApplied  = true;
            _selectedTaskIds.Clear();
            _bulkReschedulePanelOpen = false;
        }
        catch
        {
            Snackbar.Add("Could not apply filters.", Severity.Error);
        }

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _filterStatus        = null;
        _filterMinPriority   = null;
        _filterComplexity    = null;
        _filterProjectId     = null;
        _filterDueAfter      = null;
        _filterDueBefore     = null;
        _filteredResults     = null;
        _filtersApplied      = false;
        _selectedTaskIds.Clear();
        _bulkReschedulePanelOpen = false;
        StateHasChanged();
    }

    // ── Bulk selection ───────────────────────────────────────────────────────

    private void ToggleSelectAll(bool selected)
    {
        if (selected)
            _selectedTaskIds = _filteredResults?.Items.Select(t => t.Id).ToHashSet() ?? [];
        else
            _selectedTaskIds.Clear();
    }

    private void ToggleTaskSelection(Guid taskId, bool selected)
    {
        if (selected) _selectedTaskIds.Add(taskId);
        else          _selectedTaskIds.Remove(taskId);
    }

    private void DeselectAll() { _selectedTaskIds.Clear(); _bulkReschedulePanelOpen = false; }

    private void ToggleBulkReschedulePanel() => _bulkReschedulePanelOpen = !_bulkReschedulePanelOpen;

    private void CancelBulkReschedule() { _bulkReschedulePanelOpen = false; _bulkRescheduleDate = null; }

    // ── Bulk actions ─────────────────────────────────────────────────────────

    private async Task BulkCompleteAsync()
    {
        if (_selectedTaskIds.Count == 0) return;
        try
        {
            var count = await TasksHubService.BulkOperationAsync(
                new BulkTaskOperationDto([.. _selectedTaskIds], NewStatus: TaskItemStatus.Done));
            Snackbar.Add($"{count} task{(count == 1 ? "" : "s")} completed.", Severity.Success);
            _selectedTaskIds.Clear();
            await LoadAsync();
            await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not complete tasks.", Severity.Error);
        }
    }

    private async Task BulkRescheduleAsync()
    {
        if (_selectedTaskIds.Count == 0 || !_bulkRescheduleDate.HasValue) return;
        try
        {
            var count = await TasksHubService.BulkOperationAsync(
                new BulkTaskOperationDto([.. _selectedTaskIds], NewDueDate: _bulkRescheduleDate));
            Snackbar.Add($"{count} task{(count == 1 ? "" : "s")} rescheduled.", Severity.Success);
            _bulkReschedulePanelOpen = false;
            _bulkRescheduleDate      = null;
            _selectedTaskIds.Clear();
            await LoadAsync();
            await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not reschedule tasks.", Severity.Error);
        }
    }

    private async Task BulkArchiveAsync()
    {
        if (_selectedTaskIds.Count == 0) return;
        try
        {
            var count = await TasksHubService.BulkOperationAsync(
                new BulkTaskOperationDto([.. _selectedTaskIds], Archive: true));
            Snackbar.Add($"{count} task{(count == 1 ? "" : "s")} archived.", Severity.Success);
            _selectedTaskIds.Clear();
            await LoadAsync();
            await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not archive tasks.", Severity.Error);
        }
    }

    // ── Inline reschedule (page-level) ───────────────────────────────────────

    private void ToggleInlineReschedule(Guid taskId, DateTime? currentDate)
    {
        if (_rescheduleTaskId == taskId) { _rescheduleTaskId = null; _rescheduleDate = null; }
        else { _rescheduleTaskId = taskId; _rescheduleDate = currentDate; }
    }

    private void CancelInlineReschedule() { _rescheduleTaskId = null; _rescheduleDate = null; }

    private async Task HandleRescheduleApply(Guid taskId)
    {
        await HandleReschedule(taskId, _rescheduleDate);
        _rescheduleTaskId = null;
        _rescheduleDate   = null;
    }

    /// <summary>
    /// Bridge method used as a method group for all widget OnReschedule EventCallback bindings.
    /// Named-tuple EventCallbacks cannot be inferred by the Razor compiler from inline lambdas.
    /// </summary>
    private Task HandleWidgetRescheduleAsync((Guid TaskId, DateTime? NewDate) args) =>
        HandleReschedule(args.TaskId, args.NewDate);

    /// <summary>
    /// Persists a new due date for a single task. Called by both widget callbacks and inline
    /// pickers in the search/filter result lists.
    /// </summary>
    private async Task HandleReschedule(Guid taskId, DateTime? newDate)
    {
        try
        {
            var task = FindTask(taskId);
            if (task is null) { Snackbar.Add("Task not found.", Severity.Error); return; }

            await TaskService.UpdateAsync(new UpdateTaskDto(
                task.Id, task.Title, task.Description, task.Status, task.Priority, newDate));

            Snackbar.Add("Due date updated.", Severity.Success);
            await LoadAsync();
            if (!string.IsNullOrWhiteSpace(_searchTerm)) await HandleSearch();
            if (_filtersApplied) await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not reschedule task.", Severity.Error);
        }
    }

    // ── Complete / Resume ────────────────────────────────────────────────────

    private async Task HandleCompleted(Guid taskId)
    {
        try
        {
            await TaskService.CompleteAsync(taskId);
            Snackbar.Add("Task completed.", Severity.Success);
            await LoadAsync();
            if (!string.IsNullOrWhiteSpace(_searchTerm)) await HandleSearch();
            if (_filtersApplied) await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not complete task.", Severity.Error);
        }
    }

    private async Task HandleResume(Guid taskId)
    {
        try
        {
            var task = _aggregate!.OnHoldTasks.First(t => t.Id == taskId);
            await TaskService.UpdateAsync(new UpdateTaskDto(
                task.Id, task.Title, task.Description,
                TaskItemStatus.InProgress, task.Priority, task.DueDate));
            Snackbar.Add("Task resumed.", Severity.Success);
            await LoadAsync();
            if (_filtersApplied) await ApplyFiltersAsync();
        }
        catch
        {
            Snackbar.Add("Could not resume task.", Severity.Error);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    /// <summary>
    /// Looks up a task DTO from filtered results, search results, or the aggregate — in that order.
    /// This ensures reschedule works even when Done tasks are shown in the filtered view.
    /// </summary>
    private TasksHubTaskDto? FindTask(Guid id)
    {
        if (_filteredResults is not null)
        {
            var found = _filteredResults.Items.FirstOrDefault(t => t.Id == id);
            if (found is not null) return found;
        }

        if (_searchResults is not null)
        {
            var found = _searchResults.Items.FirstOrDefault(t => t.Id == id);
            if (found is not null) return found;
        }

        if (_aggregate is null) return null;

        return _aggregate.ActiveTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.HighPriorityTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.OverdueTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.NeedingAttentionTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.WithoutDueDateTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.OnHoldTasks.FirstOrDefault(t => t.Id == id)
            ?? _aggregate.StaleTasks.FirstOrDefault(t => t.Id == id);
    }

    private bool IsOverdue(TasksHubTaskDto t) =>
        t.DueDate.HasValue && t.DueDate.Value.Date < _today.Date;

    private static Color PriorityColor(TaskPriority p) => p switch
    {
        TaskPriority.Critical => Color.Error,
        TaskPriority.High     => Color.Warning,
        TaskPriority.Medium   => Color.Info,
        _                     => Color.Default,
    };

    private static Color StatusColor(TaskItemStatus s) => s switch
    {
        TaskItemStatus.InProgress => Color.Primary,
        TaskItemStatus.Waiting    => Color.Warning,
        TaskItemStatus.Done       => Color.Success,
        _                         => Color.Default,
    };

    private static string StatusLabel(TaskItemStatus s) => s switch
    {
        TaskItemStatus.InProgress => "In Progress",
        TaskItemStatus.Waiting    => "Waiting",
        TaskItemStatus.Done       => "Done",
        _                         => "Todo",
    };

    private static string PriorityClass(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "td-task--critical",
        TaskPriority.High     => "td-task--high",
        TaskPriority.Medium   => "td-task--medium",
        _                     => "td-task--low",
    };
}
