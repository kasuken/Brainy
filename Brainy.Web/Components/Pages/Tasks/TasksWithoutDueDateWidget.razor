@using Brainy.Application.DTOs.Tasks
@using Brainy.Domain.Enums

@* ─────────────────────────────────────────────────────────────────────────────
   TasksWithoutDueDateWidget — tasks without a scheduled due date.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-widget td-section">
    <div class="td-section-head">
        <span class="td-section-label" style="color:var(--ink-soft);">No Due Date</span>
        <span class="td-section-count">@Tasks.Count task@(Tasks.Count == 1 ? "" : "s")</span>
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        @if (Tasks.Count == 0)
        {
            <p class="td-empty">Every task has a due date — great planning!</p>
        }
        else
        {
            @foreach (var t in Tasks)
            {
                <div class="td-task @PriorityClass(t.Priority)">
                    <div class="td-task-body">
                        <p class="td-task-title">@t.Title</p>
                        <div class="td-task-meta">
                            <span class="td-task-project">@t.ProjectName</span>
                            <MudChip T="string" Size="Size.Small" Color="@PriorityColor(t.Priority)" Variant="Variant.Outlined">
                                @t.Priority.ToString()
                            </MudChip>
                        </div>
                        @if (_rescheduleTaskId == t.Id)
                        {
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.6rem;flex-wrap:wrap;">
                                <MudDatePicker @bind-Date="_rescheduleDate"
                                               Label="Due date"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               ShowToolbar="false"
                                               Clearable="true"
                                                />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(!_rescheduleDate.HasValue)"
                                           OnClick="@(() => ApplyReschedule(t.Id))">Apply</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="CancelReschedule">Cancel</MudButton>
                            </div>
                        }
                    </div>
                    <MudTooltip Text="Set due date">
                        <MudIconButton Icon="@Icons.Material.Outlined.CalendarToday"
                                       Size="Size.Small"
                                       Color="@(_rescheduleTaskId == t.Id ? Color.Primary : Color.Default)"
                                       OnClick="@(() => ToggleReschedule(t.Id, t.DueDate))" />
                    </MudTooltip>
                </div>
            }
        }
    }
</div>

@code {
    /// <summary>Tasks without a due date.</summary>
    [Parameter] public IReadOnlyList<TasksHubTaskDto> Tasks { get; set; } = [];

    /// <summary>Raised when the user picks a due date inline. Provides the task ID and chosen date.</summary>
    [Parameter] public EventCallback<(Guid TaskId, DateTime? NewDate)> OnReschedule { get; set; }

    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;
    private Guid? _rescheduleTaskId;
    private DateTime? _rescheduleDate;

    protected override void OnInitialized() => _collapsed = Collapsed;

    private void ToggleReschedule(Guid taskId, DateTime? currentDate)
    {
        if (_rescheduleTaskId == taskId) { _rescheduleTaskId = null; _rescheduleDate = null; }
        else { _rescheduleTaskId = taskId; _rescheduleDate = currentDate; }
    }

    private async Task ApplyReschedule(Guid taskId)
    {
        await OnReschedule.InvokeAsync((taskId, _rescheduleDate));
        _rescheduleTaskId = null;
        _rescheduleDate = null;
    }

    private void CancelReschedule() { _rescheduleTaskId = null; _rescheduleDate = null; }

    private static Color PriorityColor(TaskPriority p) => p switch
    {
        TaskPriority.Critical => Color.Error,
        TaskPriority.High     => Color.Warning,
        TaskPriority.Medium   => Color.Info,
        _                     => Color.Default,
    };

    private static string PriorityClass(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "td-task--critical",
        TaskPriority.High     => "td-task--high",
        TaskPriority.Medium   => "td-task--medium",
        _                     => "td-task--low",
    };
}


