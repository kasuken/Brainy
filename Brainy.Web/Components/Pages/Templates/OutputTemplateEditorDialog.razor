@using Brainy.Application.DTOs.Templates
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject IOutputTemplateService OutputTemplateService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(TemplateId.HasValue ? "Edit output template" : "New output template")</MudText>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTextField @bind-Value="_name" Label="Template name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="mb-3" MaxLength="200" Required="true" />

            <MudTextField @bind-Value="_titlePattern" Label="Output title pattern" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="mb-3" MaxLength="200" Required="true"
                          HelperText="Use {Date} or {Year} to include the instantiation date." />

            <MudSelect T="OutputType" @bind-Value="_type" Label="Type" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var t in Enum.GetValues<OutputType>())
                {
                    <MudSelectItem Value="@t">@t</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="OutputTemplateSourceSelectionMode" @bind-Value="_sourceSelection" Label="Default source selection"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@OutputTemplateSourceSelectionMode.None">None</MudSelectItem>
                <MudSelectItem Value="@OutputTemplateSourceSelectionMode.ActiveProjectNotes">
                    Active notes of the project supplied at creation
                </MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_contentScaffold" Label="Content structure" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="8" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save Template</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid? TemplateId { get; set; }

    private bool _loading = true;
    private string _name = "";
    private string _titlePattern = "";
    private string _contentScaffold = "";
    private OutputType _type = OutputType.Report;
    private OutputTemplateSourceSelectionMode _sourceSelection = OutputTemplateSourceSelectionMode.None;
    private byte[]? _rowVersion;

    protected override async Task OnInitializedAsync()
    {
        if (TemplateId.HasValue)
        {
            var template = await OutputTemplateService.GetByIdAsync(TemplateId.Value);
            if (template is not null)
            {
                _name = template.Name;
                _titlePattern = template.TitlePattern;
                _contentScaffold = template.ContentScaffold;
                _type = template.Type;
                _sourceSelection = template.DefaultSourceSelection;
                _rowVersion = template.RowVersion;
            }
        }

        _loading = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_titlePattern))
        {
            Snackbar.Add("A template name and output title pattern are required.", Severity.Warning);
            return;
        }

        try
        {
            if (TemplateId.HasValue)
            {
                var updated = await OutputTemplateService.UpdateAsync(new UpdateOutputTemplateDto(
                    TemplateId.Value, _name.Trim(), _titlePattern.Trim(), _type, _contentScaffold, _sourceSelection, _rowVersion));
                MudDialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var created = await OutputTemplateService.CreateAsync(new CreateOutputTemplateDto(
                    _name.Trim(), _titlePattern.Trim(), _type, _contentScaffold, _sourceSelection));
                MudDialog.Close(DialogResult.Ok(created));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
