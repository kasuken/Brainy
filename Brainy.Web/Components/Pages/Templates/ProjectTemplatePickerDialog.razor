@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Templates
@using Brainy.Application.Interfaces.Services
@inject IProjectTemplateService ProjectTemplateService
@inject IAreaService AreaService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New project from template</MudText>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (_templates.Count == 0)
        {
            <MudText Typo="Typo.body2">No project templates yet. Create one from the Templates page first.</MudText>
        }
        else
        {
            <MudSelect T="Guid" @bind-Value="_selectedTemplateId" Label="Template" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var t in _templates)
                {
                    <MudSelectItem Value="@t.Id">@t.Name</MudSelectItem>
                }
            </MudSelect>

            @if (SelectedTemplate is not null)
            {
                <MudTextField @bind-Value="_name"
                              Label="Project name (optional override)"
                              Placeholder="@SelectedTemplate.ProjectNamePattern"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" MaxLength="200" />

                <MudSelect T="Guid?" @bind-Value="_areaId" Label="Area" Required="true" Variant="Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter"
                           Error="@(_showAreaError)" ErrorText="Choose an area for the new project.">
                    @foreach (var area in _areas)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)area.Id)">@area.Emoji @area.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(SelectedTemplate is null)" OnClick="CreateAsync">
            Create Project
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Optionally opens the dialog with a specific template pre-selected (e.g. the "Use" action on the Templates page).</summary>
    [Parameter]
    public Guid? PreselectedTemplateId { get; set; }

    private List<ProjectTemplateDto> _templates = [];
    private List<AreaDto> _areas = [];
    private bool _loading = true;
    private Guid _selectedTemplateId;
    private Guid? _areaId;
    private string _name = "";
    private bool _showAreaError;

    private ProjectTemplateDto? SelectedTemplate => _templates.FirstOrDefault(t => t.Id == _selectedTemplateId);

    protected override async Task OnInitializedAsync()
    {
        _templates = (await ProjectTemplateService.GetAllAsync()).ToList();
        _areas = (await AreaService.GetAllActiveAsync()).ToList();
        if (_templates.Count > 0)
        {
            var initial = PreselectedTemplateId.HasValue
                ? _templates.FirstOrDefault(t => t.Id == PreselectedTemplateId.Value) ?? _templates[0]
                : _templates[0];
            _selectedTemplateId = initial.Id;
            _areaId = initial.DefaultAreaId;
        }
        _loading = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateAsync()
    {
        if (SelectedTemplate is null) return;

        if (_areaId is null)
        {
            _showAreaError = true;
            return;
        }
        _showAreaError = false;

        try
        {
            var project = await ProjectTemplateService.InstantiateAsync(new InstantiateProjectTemplateDto(
                SelectedTemplate.Id,
                Name: string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
                AreaId: _areaId));

            MudDialog.Close(DialogResult.Ok(project));
        }
        catch (Exception ex)
        {
            // Includes PlanEntitlementDeniedException: instantiation is subject to the
            // same active-project limit as a hand-made project, and its message is
            // already the normal upgrade-plan copy — show it as-is rather than a
            // silent failure.
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
