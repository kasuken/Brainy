@using Brainy.Application.DTOs.Outputs
@using Brainy.Application.DTOs.Templates
@using Brainy.Application.Interfaces.Services
@inject IOutputTemplateService OutputTemplateService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New output from template</MudText>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (_templates.Count == 0)
        {
            <MudText Typo="Typo.body2">No output templates yet. Create one from the Templates page first.</MudText>
        }
        else
        {
            <MudSelect T="Guid" @bind-Value="_selectedTemplateId" Label="Template" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var t in _templates)
                {
                    <MudSelectItem Value="@t.Id">@t.Name</MudSelectItem>
                }
            </MudSelect>

            @if (SelectedTemplate is not null)
            {
                <MudTextField @bind-Value="_title"
                              Label="Output title (optional override)"
                              Placeholder="@SelectedTemplate.TitlePattern"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="500" Class="mb-2" />

                @if (SelectedTemplate.DefaultSourceSelection == Brainy.Domain.Enums.OutputTemplateSourceSelectionMode.ActiveProjectNotes && ProjectId is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        This template pre-selects a project's active notes as sources, but no project was supplied here — it will be created with no sources.
                    </MudAlert>
                }
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(SelectedTemplate is null)" OnClick="CreateAsync">
            Create Output
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Optional project the created output should be linked to (and, when the
    /// template calls for it, whose active notes are pre-selected as sources).</summary>
    [Parameter]
    public Guid? ProjectId { get; set; }

    /// <summary>Optionally opens the dialog with a specific template pre-selected (e.g. the "Use" action on the Templates page).</summary>
    [Parameter]
    public Guid? PreselectedTemplateId { get; set; }

    private List<OutputTemplateDto> _templates = [];
    private bool _loading = true;
    private Guid _selectedTemplateId;
    private string _title = "";

    private OutputTemplateDto? SelectedTemplate => _templates.FirstOrDefault(t => t.Id == _selectedTemplateId);

    protected override async Task OnInitializedAsync()
    {
        _templates = (await OutputTemplateService.GetAllAsync()).ToList();
        if (_templates.Count > 0)
        {
            _selectedTemplateId = PreselectedTemplateId.HasValue && _templates.Any(t => t.Id == PreselectedTemplateId.Value)
                ? PreselectedTemplateId.Value
                : _templates[0].Id;
        }
        _loading = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateAsync()
    {
        if (SelectedTemplate is null) return;

        try
        {
            var output = await OutputTemplateService.InstantiateAsync(new InstantiateOutputTemplateDto(
                SelectedTemplate.Id,
                Title: string.IsNullOrWhiteSpace(_title) ? null : _title.Trim(),
                ProjectId: ProjectId));

            MudDialog.Close(DialogResult.Ok(output));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
