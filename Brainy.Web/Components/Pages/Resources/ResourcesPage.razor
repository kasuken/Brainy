@page "/resources"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Resources
@using Brainy.Application.Interfaces.Services
@inject IResourceService ResourceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Resources — Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    .rep-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .rep-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .rep-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .rep-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: rep-fade-up 0.4s ease both;
    }

    @@keyframes rep-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .rep-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .rep-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .rep-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }

    .rep-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .rep-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
    }

    .rep-filter-label {
        width: 100%;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .rep-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .rep-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .rep-chip--on {
        background: rgba(251, 192, 45, 0.1);
        border-color: rgba(251, 192, 45, 0.3);
        color: #e5a400; /* Darkened mustard for contrast */
    }

    /* ── Main Area ── */
    .rep-main {
        animation: rep-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .rep-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    @@keyframes rep-card-in {
        from { opacity: 0; transform: translateY(15px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Resource Card ── */
    .rep-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .rep-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
        border-color: rgba(251, 192, 45, 0.35);
    }

    .rep-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: var(--mud-palette-lines-default);
        transition: background 0.3s ease, opacity 0.3s ease;
        opacity: 0.5;
    }

    .rep-card:hover::before {
        background: #fbc02d;
        opacity: 1;
    }

    .rep-card--archived {
        opacity: 0.7;
    }
    
    .rep-card--archived:hover::before {
        background: var(--mud-palette-text-disabled);
    }

    .rep-card-actions {
        display: flex;
        gap: 0.25rem;
        position: absolute;
        top: 1rem; right: 1rem;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .rep-card:hover .rep-card-actions {
        opacity: 1;
    }

    .rep-action-btn {
        background: var(--mud-palette-background);
        border: 1px solid var(--mud-palette-lines-default);
        color: var(--mud-palette-text-secondary);
        width: 32px; height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .rep-action-btn:hover {
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border-color: var(--mud-palette-text-primary);
    }

    .rep-action-btn--delete:hover {
        color: #d32f2f;
        border-color: #d32f2f;
    }

    .rep-card-header {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        padding-right: 4rem; /* skip actions overlap */
    }

    .rep-card-icon {
        color: var(--mud-palette-text-disabled);
        margin-top: 2px;
    }

    .rep-card:hover .rep-card-icon {
        color: #e5a400;
    }

    .rep-card-title {
        font-family: 'Fraunces', serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin: 0;
        line-height:1.2;
    }

    .rep-card-topic {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #8a6a1c;
        background: rgba(205,154,58,0.15);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        margin-bottom: 0.85rem;
        align-self: flex-start;
    }

    .rep-card-desc {
        font-size: 0.9rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 1rem;
        line-height: 1.5;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .rep-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-bottom: 1.25rem;
    }
    
    .rep-tag {
        font-size: 0.7rem;
        font-weight: 500;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        background: var(--mud-palette-table-lines);
        color: var(--mud-palette-text-secondary);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .rep-card-meta {
        font-size: 0.75rem;
        color: var(--mud-palette-text-disabled);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 500;
        letter-spacing: 0.02em;
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-top: 0.85rem;
        margin-top: auto;
    }
</style>

<div class="rep-page">
    <div class="rep-layout">

        @* ── Sidebar ── *@
        <aside class="rep-sidebar">
            <p class="rep-eyebrow">Library</p>
            <h1 class="rep-title">Resources</h1>
            <p class="rep-meta">@(_resources?.Count ?? 0) @(_showArchived ? "archived resources total" : "resources total") · @(_filtered?.Count ?? 0) shown</p>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Large"
                       Class="mb-6"
                       Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                       FullWidth="true"
                       OnClick="OpenCreateDialog">
                New Resource
            </MudButton>

            <div class="rep-widget">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search resources…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@(() => ApplyFilter())"
                              OnKeyUp="@(() => ApplyFilter())"    
                              Class="mb-5" />

                <div class="rep-filter-label">Topics</div>
                <div class="rep-filter-group">
                    <button type="button"
                            class="rep-chip @(_selectedTopic is null ? "rep-chip--on" : "")"
                            @onclick="ClearTopicFilter">
                        All Topics
                    </button>
                    @foreach (var topic in TopicOptions)
                    {
                        <button type="button"
                                class="rep-chip @(_selectedTopic == topic ? "rep-chip--on" : "")"
                                @onclick="() => ToggleTopic(topic)">
                            @topic
                        </button>
                    }
                </div>

                <div class="rep-filter-label">Status</div>
                <div class="rep-filter-group">
                    <button type="button"
                            class="rep-chip @(_showArchived ? "rep-chip--on" : "")"
                            @onclick="ToggleArchived">
                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Style="font-size:.85rem; margin-right:4px;" />
                        Show Archived
                    </button>
                </div>

                <div class="rep-filter-label">Sort By</div>
                <div class="rep-filter-group" style="margin-bottom:0;">
                    @foreach (var opt in SortOptions)
                    {
                        <button class="rep-chip @(_sortBy == opt ? "rep-chip--on" : "")"
                                @onclick="() => SetSort(opt)">
                            @opt
                            @if (_sortBy == opt)
                            {
                                <span style="opacity:0.7; font-size:0.7rem;">@(_sortAsc ? "↑" : "↓")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="rep-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Loading resources…</p>
                </div>
            }
            else if (_filtered is { Count: 0 })
            {
                <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                    <MudIcon Icon="@Icons.Material.Outlined.CollectionsBookmark" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                    <h2 style="font-family: 'Fraunces', serif; font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                        @EmptyTitle
                    </h2>
                    <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                        @EmptySubtitle
                    </p>
                    @if ((_resources?.Count ?? 0) == 0 && !_showArchived)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Create your first resource
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <div class="rep-grid">
                    @for (int i = 0; i < (_filtered?.Count ?? 0); i++)
                    {
                        var r = _filtered![i];
                        var idx = i;
                        <div class="rep-card @(r.IsArchived ? "rep-card--archived" : "")" 
                             style="animation-delay:@(idx * 35)ms; animation: rep-card-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;"
                             @onclick="() => OpenDetail(r.Id)">
                             
                            <div class="rep-card-actions">
                                <button class="rep-action-btn" title="Edit" @onclick="() => OpenEditDialog(r)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                </button>
                                @if (r.IsArchived)
                                {
                                    <button class="rep-action-btn" title="Restore" @onclick="() => ConfirmRestore(r.Id, r.Name)" @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Outlined.RestorePage" Size="Size.Small" />
                                    </button>
                                }
                                else
                                {
                                    <button class="rep-action-btn" title="Archive" @onclick="() => ConfirmArchive(r.Id, r.Name)" @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" />
                                    </button>
                                }
                                <button class="rep-action-btn rep-action-btn--delete" title="Delete" @onclick="() => ConfirmDelete(r.Id, r.Name)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
                                </button>
                            </div>
                            
                            <div class="rep-card-header">
                                @if (r.IsArchived)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Medium" Class="rep-card-icon" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Medium" Class="rep-card-icon" />
                                }
                                <div style="display:flex; flex-direction:column; gap:0.2rem;">
                                    <h3 class="rep-card-title">@r.Name</h3>
                                    @if (!string.IsNullOrWhiteSpace(r.Topic))
                                    {
                                        <span class="rep-card-topic">@r.Topic</span>
                                    }
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(r.Description))
                            {
                                <p class="rep-card-desc">@(r.Description.Length > 120 ? r.Description[..120] + "…" : r.Description)</p>
                            }
                            else
                            {
                                <div style="flex:1;"></div>
                            }
                            
                            @if (r.Tags.Count > 0)
                            {
                                <div class="rep-card-tags">
                                    @foreach (var tag in r.Tags)
                                    {
                                        <span class="rep-tag">@tag</span>
                                    }
                                </div>
                            }
                            
                            <div class="rep-card-meta">
                                <span style="display:flex; align-items:center; gap:0.35rem;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                                    Updated @r.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                </span>
                                @if (r.Tags.Count > 0)
                                {
                                    <span>🏷️ @r.Tags.Count</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    private bool _loading = true;
    private List<ResourceDto>? _resources;
    private List<ResourceDto>? _filtered;

    private string _searchText = "";
    private string? _selectedTopic;
    private bool _showArchived;
    private string _sortBy = "Name";
    private bool _sortAsc = true;

    private static readonly string[] SortOptions = ["Name", "Topic", "Created", "Updated"];

    private IReadOnlyList<string> TopicOptions =>
        (_resources ?? [])
            .Select(static r => r.Topic?.Trim())
            .Where(static topic => !string.IsNullOrWhiteSpace(topic))
            .Cast<string>()
            .GroupBy(static topic => topic, StringComparer.OrdinalIgnoreCase)
            .Select(static group => group.First())
            .OrderBy(static topic => topic)
            .ToList();

    private string EmptyTitle =>
        (_resources?.Count ?? 0) == 0
            ? (_showArchived ? "No archived resources" : "No resources yet")
            : "Nothing matches";

    private string EmptySubtitle =>
        (_resources?.Count ?? 0) == 0
            ? (_showArchived
                ? "Archived resources will appear here when you store them away."
                : "Resources help you collect domains, references, and subjects worth revisiting.")
            : "Try broadening your search, choosing another topic, or clearing filters.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var result = _showArchived
                ? await ResourceService.GetAllArchivedAsync()
                : await ResourceService.GetAllActiveAsync();

            _resources = result.ToList();

            if (_selectedTopic is not null &&
                !_resources.Any(r => string.Equals(r.Topic, _selectedTopic, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedTopic = null;
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            _resources = [];
            _filtered = [];
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _searchText = "";
        ApplyFilter();
    }

    private void ClearTopicFilter()
    {
        _selectedTopic = null;
        ApplyFilter();
    }

    private void ToggleTopic(string topic)
    {
        _selectedTopic = string.Equals(_selectedTopic, topic, StringComparison.OrdinalIgnoreCase)
            ? null
            : topic;

        ApplyFilter();
    }

    private async Task ToggleArchived()
    {
        _showArchived = !_showArchived;
        await LoadAsync();
    }

    private void SetSort(string option)
    {
        if (_sortBy == option)
        {
            _sortAsc = !_sortAsc;
        }
        else
        {
            _sortBy = option;
            _sortAsc = option is "Updated" ? false : true;
        }

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<ResourceDto> query = _resources ?? [];

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(r =>
                r.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (r.Topic?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(_selectedTopic))
        {
            query = query.Where(r => string.Equals(r.Topic, _selectedTopic, StringComparison.OrdinalIgnoreCase));
        }

        query = _sortBy switch
        {
            "Topic" => _sortAsc
                ? query.OrderBy(r => r.Topic ?? string.Empty).ThenBy(r => r.Name)
                : query.OrderByDescending(r => r.Topic ?? string.Empty).ThenBy(r => r.Name),
            "Created" => _sortAsc
                ? query.OrderBy(r => r.CreatedAtUtc)
                : query.OrderByDescending(r => r.CreatedAtUtc),
            "Updated" => _sortAsc
                ? query.OrderBy(r => r.UpdatedAtUtc)
                : query.OrderByDescending(r => r.UpdatedAtUtc),
            _ => _sortAsc
                ? query.OrderBy(r => r.Name)
                : query.OrderByDescending(r => r.Name),
        };

        _filtered = query.ToList();
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/resources/{id}");

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ResourceEditorDialog>();
        parameters.Add(x => x.ResourceId, null);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ResourceEditorDialog>("New Resource", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(ResourceDto resource)
    {
        var parameters = new DialogParameters<ResourceEditorDialog>();
        parameters.Add(x => x.ResourceId, resource.Id);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ResourceEditorDialog>("Edit Resource", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmArchive(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Archive resource",
            $"Archive \"{name}\"? It will be hidden from active resource views.",
            yesText: "Archive",
            cancelText: "Cancel");

        if (box != true)
        {
            return;
        }

        try
        {
            await ResourceService.ArchiveAsync(id);
            Snackbar.Add($"\"{name}\" archived.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmRestore(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Restore resource",
            $"Restore \"{name}\" to active resources?",
            yesText: "Restore",
            cancelText: "Cancel");

        if (box != true)
        {
            return;
        }

        try
        {
            await ResourceService.RestoreAsync(id);
            Snackbar.Add($"\"{name}\" restored.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDelete(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Delete resource",
            $"Permanently delete \"{name}\"? This cannot be undone.",
            yesText: "Delete",
            noText: "Cancel");

        if (box != true)
        {
            return;
        }

        try
        {
            await ResourceService.DeleteAsync(id);
            Snackbar.Add($"\"{name}\" deleted.", Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}

