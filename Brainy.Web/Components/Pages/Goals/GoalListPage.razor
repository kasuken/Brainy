@page "/goals"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@attribute [Authorize]
@inject IGoalService GoalService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Goals — Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    .gp-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .gp-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .gp-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .gp-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: gp-fade-up 0.4s ease both;
    }

    @@keyframes gp-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .gp-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .gp-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .gp-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }
    
    .gp-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .gp-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .gp-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
    }

    .gp-filter-label {
        width: 100%;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .gp-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .gp-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .gp-chip--on {
        background: rgba(192, 86, 29, 0.1);
        border-color: rgba(192, 86, 29, 0.3);
        color: var(--clay, #c0561d);
    }
    
    .gp-chip-dot {
        width: 6px; height: 6px; border-radius: 50%;
    }

    /* ── Main Area ── */
    .gp-main {
        animation: gp-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .gp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    @@keyframes gp-card-in {
        from { opacity: 0; transform: translateY(15px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Goal Card ── */
    .gp-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .gp-status--planned { background: var(--mud-palette-table-lines); color: var(--mud-palette-text-secondary); }
    .gp-status--active { background: rgba(111,122,90,.14); color: #4a5c38; border: 1px solid rgba(111,122,90,.3); }
    .gp-status--achieved { background: rgba(251,192,45,.15); color: #8a6a1c; border: 1px solid rgba(251,192,45,.4); }
    .gp-status--abandoned { background: rgba(211,47,47,.1); color: #d32f2f; border: 1px solid rgba(211,47,47,.3); }

    .gp-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 14px;
        padding: 1.5rem;
        text-align: left;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .gp-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
        border-color: rgba(192, 86, 29, 0.25);
    }
    
    .gp-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--mud-palette-lines-default), var(--mud-palette-lines-default));
        transition: opacity 0.3s ease;
        opacity: 0.7;
    }
    
    .gp-card:hover::before {
        background: linear-gradient(90deg, #ed6c02, #fbc02d);
        opacity: 1;
    }

    .gp-card-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }

    .gp-card-title {
        font-family: 'Fraunces', serif;
        font-size: 1.45rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin: 0 0 0.5rem;
        line-height: 1.25;
    }

    .gp-card-desc {
        font-size: 0.9rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 1.5rem;
        line-height: 1.5;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Progress */
    .gp-progress {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
    }
    .gp-progress-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }
    .gp-progress-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }
    .gp-progress-pct {
        font-family: 'Fraunces', serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--clay, #c0561d);
    }
    .gp-progress-track {
        height: 6px;
        background: var(--mud-palette-table-lines);
        border-radius: 999px;
        overflow: hidden;
    }
    .gp-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #ed6c02, #fbc02d);
        border-radius: 999px;
        transition: width 0.5s ease;
        min-width: 4px;
    }

    /* Meta */
    .gp-card-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    
    .gp-meta-item {
        font-size: 0.75rem;
        color: var(--mud-palette-text-disabled);
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }
</style>

<div class="gp-page">
    <div class="gp-layout">

        @* ── Sidebar ── *@
        <aside class="gp-sidebar">
            <p class="gp-eyebrow">North-Star Ledger</p>
            <h1 class="gp-title">Goals</h1>
            <p class="gp-meta">@(_goals.Count) goals total · @(_filtered.Count) shown</p>

            <div class="gp-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Large"
                           Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                           FullWidth="true"
                           OnClick="OpenCreateDialogAsync">
                    New Goal
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Insights"
                           Size="Size.Large"
                           Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                           FullWidth="true"
                           OnClick="@(() => Nav.NavigateTo("/goals/metrics"))">
                    Metrics Dashboard
                </MudButton>
            </div>

            <div class="gp-widget">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search goals…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@(() => ApplyFilters())"
                              OnKeyUp="@(() => ApplyFilters())"    
                              Class="mb-5" />

                <div class="gp-filter-label">Status</div>
                <div class="gp-filter-group">
                    @foreach (var status in StatusFilters)
                    {
                        <button class="gp-chip @(IsStatusActive(status) ? "gp-chip--on" : "")"
                                type="button"
                                @onclick="() => ToggleStatusFilter(status)">
                            <span class="gp-chip-dot" style="background:@StatusColor(status)"></span>
                            @StatusLabel(status)
                        </button>
                    }
                </div>
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="gp-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Loading goals…</p>
                </div>
            }
            else if (_filtered.Count == 0)
            {
                <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                    <MudIcon Icon="@Icons.Material.Outlined.Flag" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                    <h2 style="font-family: 'Fraunces', serif; font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                        @(_goals.Count == 0 ? "No goals yet" : "Nothing matches")
                    </h2>
                    <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                        @(_goals.Count == 0
                            ? "Create a goal to turn long-range intent into visible progress."
                            : "Try clearing filters or broadening your search.")
                    </p>
                    @if (_goals.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialogAsync">
                            Create first goal
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <div class="gp-grid">
                    @for (var i = 0; i < _filtered.Count; i++)
                    {
                        var goal = _filtered[i];
                        <button class="gp-card" type="button" style="animation-delay:@(i * 35)ms; animation: gp-card-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;" @onclick="() => OpenDetail(goal.Id)">
                            
                            <div class="gp-card-header">
                                <span class="gp-badge gp-status--@goal.Status.ToString().ToLowerInvariant()">
                                    @StatusLabel(goal.Status)
                                </span>
                                @if (!string.IsNullOrWhiteSpace(goal.AreaName))
                                {
                                    <span class="gp-badge" style="background: var(--mud-palette-table-lines); color: var(--mud-palette-text-secondary); border: 1px solid var(--mud-palette-lines-default);">
                                        @goal.AreaName
                                    </span>
                                }
                            </div>

                            <h2 class="gp-card-title">@goal.Title</h2>

                            @if (!string.IsNullOrWhiteSpace(goal.Description))
                            {
                                <p class="gp-card-desc">@goal.Description</p>
                            }

                            <div class="gp-progress">
                                <div class="gp-progress-row">
                                    <span class="gp-progress-label">Progress</span>
                                    <span class="gp-progress-pct">@goal.ProgressPercent%</span>
                                </div>
                                <div class="gp-progress-track">
                                    <div class="gp-progress-fill" style="width:@goal.ProgressPercent%"></div>
                                </div>
                            </div>

                            <div class="gp-card-meta">
                                <span class="gp-meta-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.Flag" Size="Size.Small" />
                                    @(goal.TargetDate?.ToString("MMM d, yyyy") ?? "No target date")
                                </span>
                                <span class="gp-meta-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" />
                                    @goal.CompletedMilestones / @goal.TotalMilestones milestones
                                </span>
                            </div>
                        </button>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    private static readonly GoalStatus[] StatusFilters =
        [GoalStatus.Planned, GoalStatus.Active, GoalStatus.Achieved, GoalStatus.Abandoned];

    private bool _loading = true;
    private string _searchText = "";
    private List<GoalDto> _goals = [];
    private List<GoalDto> _filtered = [];
    private readonly HashSet<GoalStatus> _activeStatusFilters = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await GoalService.GetAllNonArchivedAsync();
        _goals = result.Where(goal => !goal.IsArchived && goal.Status != GoalStatus.Archived).ToList();
        ApplyFilters();
        _loading = false;
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        _searchText = "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<GoalDto> query = _goals;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(goal => goal.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        if (_activeStatusFilters.Count > 0)
        {
            query = query.Where(goal => _activeStatusFilters.Contains(goal.Status));
        }

        _filtered = query
            .OrderBy(goal => goal.Status)
            .ThenBy(goal => goal.TargetDate ?? DateTime.MaxValue)
            .ThenBy(goal => goal.Title)
            .ToList();
    }

    private void ToggleStatusFilter(GoalStatus status)
    {
        if (!_activeStatusFilters.Remove(status))
        {
            _activeStatusFilters.Add(status);
        }

        ApplyFilters();
    }

    private bool IsStatusActive(GoalStatus status) => _activeStatusFilters.Contains(status);

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/goals/{id}");

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<GoalEditorDialog>();
        parameters.Add(x => x.GoalId, null);

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<GoalEditorDialog>("New Goal", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is GoalDto goal)
        {
            Snackbar.Add($"\"{goal.Title}\" created.", Severity.Success);
        }

        await LoadAsync();
    }

    private static string StatusLabel(GoalStatus status) => status switch
    {
        GoalStatus.Planned => "Planned",
        GoalStatus.Active => "Active",
        GoalStatus.Achieved => "Achieved",
        GoalStatus.Abandoned => "Abandoned",
        GoalStatus.Archived => "Archived",
        _ => status.ToString()
    };

    private static string StatusColor(GoalStatus status) => status switch
    {
        GoalStatus.Active => "#4a5c38",
        GoalStatus.Achieved => "#2f7247",
        GoalStatus.Abandoned => "#665a49",
        _ => "#9a9180"
    };
}



