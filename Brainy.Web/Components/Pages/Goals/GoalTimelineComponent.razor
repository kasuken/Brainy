@using Brainy.Application.DTOs.Goals
@using Brainy.Domain.Enums

@if (_mergedEntries.Count == 0)
{
    <div class="goal-timeline goal-timeline--empty">
        <span class="goal-timeline__empty-icon">⋯</span>
        <span>No activity to display yet.</span>
    </div>
}
else
{
    <div class="goal-timeline">
        @foreach (var entry in _mergedEntries)
        {
            <div class="goal-timeline__item @(entry.IsComplete ? "goal-timeline__item--done" : null)">
                <div class="goal-timeline__rail">
                    <span class="goal-timeline__node">
                        <span class="goal-timeline__icon">@entry.Icon</span>
                    </span>
                </div>
                <div class="goal-timeline__content">
                    <div class="goal-timeline__topline">
                        <h4 class="goal-timeline__title">@entry.Title</h4>
                        <span class="goal-timeline__state">@entry.Badge</span>
                    </div>
                    <p class="goal-timeline__date">@entry.SortDate.ToLocalTime().ToString("MMMM d, yyyy")</p>
                    @if (!string.IsNullOrWhiteSpace(entry.Detail))
                    {
                        <p class="goal-timeline__detail">@entry.Detail</p>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
.goal-timeline {
    display: flex;
    flex-direction: column;
    gap: .9rem;
}

.goal-timeline--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 120px;
    border-radius: 16px;
    border: 1px dashed var(--line);
    color: var(--ink-faint);
    background: rgba(255,255,255,.28);
}

.goal-timeline__empty-icon {
    color: var(--clay);
    font-size: 1.2rem;
}

.goal-timeline__item {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: .85rem;
}

.goal-timeline__rail {
    position: relative;
    display: flex;
    justify-content: center;
}

.goal-timeline__rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -1.1rem;
    width: 2px;
    background: var(--line);
}

.goal-timeline__item:last-child .goal-timeline__rail::before {
    bottom: .2rem;
}

.goal-timeline__node {
    position: relative;
    z-index: 1;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin-top: .18rem;
    border: 2px solid var(--line-strong);
    background: var(--paper-raised);
    box-shadow: 0 0 0 4px rgba(255,255,255,.65);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .7rem;
    line-height: 1;
}

.goal-timeline__icon { pointer-events: none; }

.goal-timeline__content {
    padding: .9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper-raised);
}

.goal-timeline__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .75rem;
    flex-wrap: wrap;
}

.goal-timeline__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--ink);
}

.goal-timeline__state {
    font-size: .7rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 700;
}

.goal-timeline__date {
    margin: .35rem 0 0;
    color: var(--ink-soft);
    font-size: .84rem;
}

.goal-timeline__detail {
    margin: .2rem 0 0;
    color: var(--ink-faint);
    font-size: .78rem;
    font-style: italic;
}

.goal-timeline__item--done .goal-timeline__node {
    border-color: #2f7247;
    background: #3c915d;
    box-shadow: 0 0 0 4px rgba(60,145,93,.16);
    color: #fff;
}

.goal-timeline__item--done .goal-timeline__content {
    border-color: rgba(60,145,93,.26);
    background: linear-gradient(180deg, rgba(60,145,93,.08), transparent), var(--paper-raised);
}

.goal-timeline__item--done .goal-timeline__state {
    color: #2f7247;
}
</style>

@code {
    [Parameter] public IReadOnlyList<GoalMilestoneDto> Milestones { get; set; } = [];
    [Parameter] public IReadOnlyList<GoalActivityDto> Activities { get; set; } = [];

    private sealed record TimelineEntry(
        DateTime SortDate,
        string Icon,
        string Title,
        string Badge,
        string? Detail,
        bool IsComplete);

    private IReadOnlyList<TimelineEntry> _mergedEntries = [];

    protected override void OnParametersSet() => RebuildEntries();

    private void RebuildEntries()
    {
        var entries = new List<TimelineEntry>();

        foreach (var m in Milestones)
        {
            var sortDate = m.CompletedAtUtc ?? m.CreatedAtUtc;
            entries.Add(new TimelineEntry(
                SortDate:   sortDate,
                Icon:       m.IsCompleted ? "⭐" : "◎",
                Title:      m.Title,
                Badge:      m.IsCompleted ? "Milestone Completed" : "Milestone",
                Detail:     null,
                IsComplete: m.IsCompleted));
        }

        foreach (var a in Activities)
        {
            entries.Add(new TimelineEntry(
                SortDate:   a.CreatedAtUtc,
                Icon:       ActivityIcon(a.ActivityType),
                Title:      a.Description,
                Badge:      ActivityBadge(a.ActivityType),
                Detail:     BuildDetail(a),
                IsComplete: a.ActivityType is GoalActivityType.Archived));
        }

        _mergedEntries = entries
            .OrderBy(e => e.SortDate)
            .ThenBy(e => e.Badge)
            .ToList();
    }

    private static string ActivityIcon(GoalActivityType type) => type switch
    {
        GoalActivityType.Created          => "🎯",
        GoalActivityType.StatusChanged    => "🔄",
        GoalActivityType.TitleEdited      => "✏️",
        GoalActivityType.DescriptionEdited => "✏️",
        GoalActivityType.TargetDateChanged => "📅",
        GoalActivityType.MilestoneAdded   => "⭐",
        GoalActivityType.MilestoneCompleted => "⭐",
        GoalActivityType.Archived         => "📁",
        _                                 => "·",
    };

    private static string ActivityBadge(GoalActivityType type) => type switch
    {
        GoalActivityType.Created           => "Created",
        GoalActivityType.StatusChanged     => "Status",
        GoalActivityType.TitleEdited       => "Edit",
        GoalActivityType.DescriptionEdited => "Edit",
        GoalActivityType.TargetDateChanged => "Date",
        GoalActivityType.MilestoneAdded    => "Milestone",
        GoalActivityType.MilestoneCompleted => "Milestone",
        GoalActivityType.Archived          => "Archived",
        _                                  => "",
    };

    private static string? BuildDetail(GoalActivityDto a)
    {
        if (a.OldValue is null && a.NewValue is null) return null;
        return a.ActivityType switch
        {
            GoalActivityType.StatusChanged => $"{a.OldValue} → {a.NewValue}",
            _                              => null,
        };
    }
}
