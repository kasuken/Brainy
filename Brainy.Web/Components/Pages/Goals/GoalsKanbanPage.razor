@page "/goals/kanban"
@using Brainy.Application.Common
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IGoalService GoalService
@inject IAreaService AreaService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IUserTimeZoneService UserTimeZoneService

<PageTitle>Goals Kanban — Brainy</PageTitle>

<div class="goals-kanban-page">
    <div class="goals-kanban-header">
        <div>
            <div class="goals-kanban-title-row">
                <h1 class="goals-kanban-header__title">Goals Kanban</h1>
                <PageHelpButton Guide="HelpGuide" />
            </div>
            <MudText Typo="Typo.body1" Class="goals-kanban-header__subtitle">
                @_filteredGoals.Count goals across @_lanes.Count lanes
            </MudText>
        </div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ViewList"
                   OnClick="NavigateToListView">
            List View
        </MudButton>
    </div>

    <MudPaper Class="goals-kanban-toolbar" Elevation="0">
        <div class="goals-kanban-toolbar__group">
            <MudText Typo="Typo.overline" Class="goals-kanban-toolbar__label">Status</MudText>
            <MudChipSet T="string"
                        SelectionMode="SelectionMode.SingleSelection"
                        SelectedValue="@_selectedStatusFilter"
                        SelectedValueChanged="OnStatusFilterChanged"
                        Class="goals-kanban-toolbar__chips">
                @foreach (var filter in _statusFilters)
                {
                    <MudChip T="string"
                             Value="@filter.Key"
                             Color="@filter.Color"
                             Variant="Variant.Outlined"
                             Class="goals-kanban-toolbar__chip">
                        @filter.Label
                    </MudChip>
                }
            </MudChipSet>
        </div>

        <div class="goals-kanban-toolbar__group goals-kanban-toolbar__group--search">
            <MudTextField T="string"
                          Value="@_searchText"
                          ValueChanged="OnSearchChanged"
                          Immediate="true"
                          Placeholder="Search goals..."
                          aria-label="Search goals board"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Clearable="true"
                          Class="goals-kanban-toolbar__search" />
        </div>

        <div class="goals-kanban-toolbar__group goals-kanban-toolbar__group--toggle">
            <MudSwitch T="bool"
                       Value="@_showArchived"
                       ValueChanged="OnShowArchivedChanged"
                       Color="Color.Primary"
                       Label="Show Archived" />
        </div>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="goals-kanban-state" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1">Loading goals board...</MudText>
        </MudPaper>
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            Goals board could not be loaded. Check your connection and try again.
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync" Class="ml-2">Retry</MudButton>
        </MudAlert>
    }
    else if (_filteredGoals.Count == 0)
    {
        <MudPaper Class="goals-kanban-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.TrackChanges" Size="Size.Large" />
            <MudText Typo="Typo.h6">No goals match the current filters.</MudText>
            <MudText Typo="Typo.body2">Try another status, search term, or include archived goals.</MudText>
        </MudPaper>
    }
    else
    {
        <MudDropContainer T="GoalDto"
                          Items="@_filteredGoals"
                          Class="kanban-board"
                          ItemsSelector="@((goal, zone) => GetGoalZone(goal) == zone)"
                          ItemDropped="OnGoalDropped">
            <ChildContent>
                @foreach (var lane in _lanes)
                {
                    <MudPaper Class="@GetLaneClass(lane)" Elevation="0">
                        <div class="kanban-lane__header">
                            <div>
                                <h2 class="kanban-lane__title">@lane.Name</h2>
                                @if (lane.IsArchived)
                                {
                                    <div class="kanban-lane__sub">Archived area</div>
                                }
                            </div>
                            <MudChip T="string"
                                     Color="Color.Primary"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @GetGoalCount(lane.Identifier)
                            </MudChip>
                        </div>

                        <MudDropZone T="GoalDto"
                                     Identifier="@lane.Identifier"
                                     Class="kanban-dropzone"
                                     AllowReorder="false" />
                    </MudPaper>
                }
            </ChildContent>
            <ItemRenderer>
                <GoalKanbanCard Goal="context"
                                Today="_today"
                                Areas="_areas"
                                OnCardClicked="NavigateToGoal"
                                OnAreaChanged="areaId => MoveGoalAsync(context, areaId)" />
            </ItemRenderer>
        </MudDropContainer>
    }
</div>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "goals-kanban",
        PageTitle = "Goals Kanban",
        Tagline = "See goal ownership and area alignment as a movable board",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.ViewKanban,
                Lead = "This board groups goals into area lanes so you can see where outcomes are anchored.",
                Points =
                [
                    "Drag a goal card between lanes to change its linked Area, including No Area.",
                    "Use status chips, search, and Show Archived to control which goals are on the board.",
                    "Open a card to move from board planning into the goal detail view."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "Goals give your Second Brain direction by showing which responsibilities support the outcomes that matter.",
                Points =
                [
                    "Projects are short-term, deadline-driven work; Areas are ongoing responsibilities that sustain goals.",
                    "Moving a goal to an Area clarifies where that outcome belongs in your PARA system.",
                    "Keep actionability high by reviewing lanes for overloaded or unowned goals."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Choose a Status chip to view all goals or focus on planned, active, achieved, or abandoned work.",
                    "Search goals by title, description, or area name.",
                    "Turn on Show Archived when you need historical context from archived goals.",
                    "Drag a goal card into another Area lane, or No Area, to update its placement.",
                    "Select List View to return to the goals list, or open a card for detail."
                ]
            }
        ]
    };

    private const string NoAreaIdentifier = "no-area";

    private readonly List<StatusFilterOption> _statusFilters =
    [
        new("all", "All", Color.Default),
        new("planned", "Planned", Color.Warning),
        new("active", "Active", Color.Info),
        new("achieved", "Achieved", Color.Success),
        new("abandoned", "Abandoned", Color.Error)
    ];

    private List<GoalDto> _activeGoals = [];
    private List<GoalDto> _archivedGoals = [];
    private List<GoalDto> _filteredGoals = [];
    private List<KanbanLane> _lanes = [];
    private List<AreaDto> _areas = [];
    private DateTime _today = DateTime.Today;
    private bool _loading = true;
    private string? _loadError;
    private bool _showArchived;
    private bool _archivedLoaded;
    private string _searchText = string.Empty;
    private string _selectedStatusFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _today = (await UserTimeZoneService.GetUserTodayAsync()).Date;
        _loading = true;
        _loadError = null;

        try
        {
            var activeGoals = await GoalService.GetAllNonArchivedAsync();
            var activeAreas = await AreaService.GetAllActiveAsync();
            var archivedAreas = await AreaService.GetAllArchivedAsync();

            _areas = activeAreas
                .Concat(archivedAreas.Where(archived => activeAreas.All(active => active.Id != archived.Id)))
                .OrderBy(area => area.IsArchived)
                .ThenBy(area => area.Name)
                .ToList();

            _activeGoals = activeGoals.OrderBy(goal => goal.TargetDate ?? DateTime.MaxValue)
                                               .ThenBy(goal => goal.Title)
                                               .ToList();

            _lanes = BuildLanes(activeAreas, archivedAreas);
            RefreshFilteredGoals();
        }
        catch
        {
            Snackbar.Add("Unable to load the goals board.", Severity.Error);
            _loadError = "Unable to reach goals and areas.";
            _filteredGoals = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnsureArchivedGoalsLoadedAsync()
    {
        if (_archivedLoaded)
        {
            return;
        }

        try
        {
            _archivedGoals = (await GoalService.GetAllArchivedAsync())
                .OrderBy(goal => goal.TargetDate ?? DateTime.MaxValue)
                .ThenBy(goal => goal.Title)
                .ToList();

            _archivedLoaded = true;
        }
        catch
        {
            Snackbar.Add("Unable to load archived goals.", Severity.Error);
            _showArchived = false;
        }
    }

    private List<KanbanLane> BuildLanes(IReadOnlyList<AreaDto> activeAreas, IReadOnlyList<AreaDto> archivedAreas)
    {
        var lanes = activeAreas
            .Select(area => new KanbanLane(area.Id.ToString(), area.Name, area.IsArchived))
            .Concat(archivedAreas
                .Where(area => activeAreas.All(active => active.Id != area.Id))
                .Select(area => new KanbanLane(area.Id.ToString(), area.Name, area.IsArchived)))
            .OrderBy(lane => lane.IsArchived)
            .ThenBy(lane => lane.Name)
            .ToList();

        lanes.Insert(0, new KanbanLane(NoAreaIdentifier, "No Area", false));

        return lanes;
    }

    private void RefreshFilteredGoals()
    {
        IEnumerable<GoalDto> query = _activeGoals;

        if (_showArchived)
        {
            query = query.Concat(_archivedGoals);
        }

        if (_selectedStatusFilter != "all" && TryParseStatus(_selectedStatusFilter, out var selectedStatus))
        {
            query = query.Where(goal => goal.Status == selectedStatus);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(goal =>
                goal.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(goal.Description)
                    && goal.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(goal.AreaName)
                    && goal.AreaName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredGoals = query
            .OrderBy(goal => GetGoalZone(goal) == NoAreaIdentifier ? 0 : 1)
            .ThenBy(goal => goal.TargetDate ?? DateTime.MaxValue)
            .ThenBy(goal => goal.Title)
            .ToList();
    }

    private static bool TryParseStatus(string filter, out GoalStatus status)
        => Enum.TryParse(filter, true, out status);

    private string GetGoalZone(GoalDto goal)
        => goal.AreaId?.ToString() ?? NoAreaIdentifier;

    private int GetGoalCount(string identifier)
        => _filteredGoals.Count(goal => GetGoalZone(goal) == identifier);

    private async Task OnGoalDropped(MudItemDropInfo<GoalDto> dropInfo)
    {
        if (dropInfo.Item is null)
        {
            return;
        }

        var newAreaId = dropInfo.DropzoneIdentifier == NoAreaIdentifier
            ? (Guid?)null
            : Guid.TryParse(dropInfo.DropzoneIdentifier, out var parsedAreaId)
                ? parsedAreaId
                : null;

        await MoveGoalAsync(dropInfo.Item, newAreaId);
    }

    private async Task MoveGoalAsync(GoalDto goal, Guid? newAreaId)
    {
        if (goal.AreaId == newAreaId)
        {
            return;
        }

        try
        {
            var updatedGoal = await GoalService.UpdateAsync(new UpdateGoalDto(
                goal.Id,
                goal.Title,
                newAreaId,
                goal.Description,
                goal.TargetDate,
                goal.Status,
                RowVersion: goal.RowVersion));

            ReplaceGoal(updatedGoal);
            RefreshFilteredGoals();
            Snackbar.Add($"Moved '{updatedGoal.Title}' to {GetLaneName(newAreaId)}.", Severity.Success);
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("Unable to move the goal. Try again.", Severity.Error);
        }
    }

    private void ReplaceGoal(GoalDto updatedGoal)
    {
        var collection = updatedGoal.IsArchived ? _archivedGoals : _activeGoals;
        var index = collection.FindIndex(goal => goal.Id == updatedGoal.Id);

        if (index >= 0)
        {
            collection[index] = updatedGoal;
            return;
        }

        _activeGoals.RemoveAll(goal => goal.Id == updatedGoal.Id);
        _archivedGoals.RemoveAll(goal => goal.Id == updatedGoal.Id);

        if (updatedGoal.IsArchived)
        {
            _archivedGoals.Add(updatedGoal);
        }
        else
        {
            _activeGoals.Add(updatedGoal);
        }
    }

    private string GetLaneName(Guid? areaId)
        => areaId.HasValue
            ? _lanes.FirstOrDefault(lane => lane.Identifier == areaId.Value.ToString())?.Name ?? "area"
            : "No Area";

    private static string GetLaneClass(KanbanLane lane)
        => lane.IsArchived ? "kanban-lane kanban-lane--archived" : "kanban-lane";

    private void NavigateToListView()
        => NavigationManager.NavigateTo("/goals");

    private void NavigateToGoal(GoalDto goal)
        => NavigationManager.NavigateTo($"/goals/{goal.Id}");

    private Task OnSearchChanged(string? value)
    {
        _searchText = value ?? string.Empty;
        RefreshFilteredGoals();
        return Task.CompletedTask;
    }

    private Task OnStatusFilterChanged(string value)
    {
        _selectedStatusFilter = string.IsNullOrWhiteSpace(value) ? "all" : value;
        RefreshFilteredGoals();
        return Task.CompletedTask;
    }

    private async Task OnShowArchivedChanged(bool value)
    {
        _showArchived = value;

        if (_showArchived)
        {
            await EnsureArchivedGoalsLoadedAsync();
        }

        RefreshFilteredGoals();
    }

    private sealed record KanbanLane(string Identifier, string Name, bool IsArchived);
    private sealed record StatusFilterOption(string Key, string Label, Color Color);
}

<style>
    .goals-kanban-page {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 1rem 0 1.5rem;
    }

    .goals-kanban-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .goals-kanban-header__title {
        margin: 0;
        font-size: clamp(1.75rem, 4vw, 3rem);
        font-family: var(--font-display);
        color: var(--ink);
    }

    .goals-kanban-title-row {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .goals-kanban-header__subtitle {
        color: var(--ink-soft);
    }

    .goals-kanban-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(240px, 1fr) auto;
        gap: 1rem;
        padding: 1rem;
        border-radius: 22px;
        border: 1px solid var(--line);
        background:
            linear-gradient(135deg, rgba(252, 250, 244, 0.96) 0%, rgba(236, 227, 211, 0.88) 100%);
        box-shadow: var(--shadow-sm);
    }

    .goals-kanban-toolbar__group {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        min-width: 0;
    }

    .goals-kanban-toolbar__group--search {
        justify-content: flex-end;
    }

    .goals-kanban-toolbar__group--toggle {
        justify-content: center;
        align-items: flex-end;
    }

    .goals-kanban-toolbar__label {
        color: var(--ink-faint);
        letter-spacing: .08em;
    }

    .goals-kanban-toolbar__chips {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .goals-kanban-toolbar__chip {
        font-weight: 700;
        letter-spacing: .02em;
    }

    .goals-kanban-toolbar__search {
        max-width: 420px;
    }

    .goals-kanban-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        min-height: 260px;
        padding: 2rem;
        border-radius: 24px;
        border: 1px dashed var(--line-strong);
        background: rgba(252, 250, 244, 0.78);
        color: var(--ink-soft);
        text-align: center;
    }

    .kanban-board {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        overflow-x: auto;
        padding-bottom: .5rem;
    }

    .kanban-lane {
        display: flex;
        flex-direction: column;
        min-width: 280px;
        width: 280px;
        border-radius: 24px;
        border: 1px solid var(--line);
        background:
            linear-gradient(180deg, rgba(236, 227, 211, 0.9) 0%, rgba(252, 250, 244, 0.92) 100%);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .kanban-lane--archived {
        opacity: .86;
    }

    .kanban-lane__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: .95rem 1rem;
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.3);
    }

    .kanban-lane__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ink);
    }

    .kanban-lane__sub {
        margin-top: .15rem;
        font-size: .74rem;
        color: var(--ink-faint);
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .kanban-dropzone {
        display: flex;
        flex-direction: column;
        gap: .75rem;
        min-height: 200px;
        padding: 1rem;
        background-image: linear-gradient(180deg, rgba(192, 86, 29, 0.03) 0%, rgba(192, 86, 29, 0) 35%);
    }

    @@media (max-width: 960px) {
        .goals-kanban-toolbar {
            grid-template-columns: 1fr;
        }

        .goals-kanban-toolbar__group--toggle {
            align-items: flex-start;
        }
    }

    @@media (max-width: 720px) {
        .goals-kanban-header {
            flex-direction: column;
            align-items: stretch;
        }

        .kanban-lane {
            min-width: min(86vw, 320px);
            width: min(86vw, 320px);
        }
    }
</style>
