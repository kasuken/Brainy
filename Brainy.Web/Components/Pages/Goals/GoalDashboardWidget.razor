@using Brainy.Application.DTOs.Goals
@using Brainy.Domain.Enums

@* Reusable goal summary widget — shows progress, target date, remaining milestones, related projects *@

<MudPaper Class="goal-dashboard-widget"
          Elevation="0"
          role="button"
          tabindex="0"
          Style="@($"--goal-widget-accent:{StatusAccent(Goal.Status)}")"
          @onclick="HandleNavigateAsync">
    <div class="goal-dashboard-widget__rail"></div>

    <div class="goal-dashboard-widget__header">
        <div class="goal-dashboard-widget__title-wrap">
            <h3 class="goal-dashboard-widget__title">@Goal.Title</h3>
            <div class="goal-dashboard-widget__badges">
                <span class="goal-dashboard-widget__badge goal-dashboard-widget__badge--status">
                    @StatusLabel(Goal.Status)
                </span>
                @if (!string.IsNullOrWhiteSpace(Goal.AreaName))
                {
                    <span class="goal-dashboard-widget__badge goal-dashboard-widget__badge--area">@Goal.AreaName</span>
                }
            </div>
        </div>

        @if (Goal.TargetDate.HasValue)
        {
            <div class="goal-dashboard-widget__date">
                <span class="goal-dashboard-widget__eyebrow">Target date</span>
                <strong>@Goal.TargetDate.Value.ToString("MMM d, yyyy")</strong>
            </div>
        }
    </div>

    <div class="goal-dashboard-widget__progress">
        <div class="goal-dashboard-widget__progress-meta">
            <span>Progress</span>
            <strong>@Goal.ProgressPercent%</strong>
        </div>
        <MudProgressLinear Class="goal-dashboard-widget__bar"
                           Color="@StatusColor(Goal.Status)"
                           Rounded="true"
                           Size="Size.Small"
                           Value="@Goal.ProgressPercent" />
    </div>

    <div class="goal-dashboard-widget__footer">
        <span>@Goal.CompletedMilestones/@Goal.TotalMilestones milestones</span>
        <span>@RemainingMilestonesText</span>
    </div>
</MudPaper>

<style>
    .goal-dashboard-widget {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.15rem 1.2rem 1.1rem 1.35rem;
        border-radius: 20px;
        border: 1px solid color-mix(in srgb, var(--goal-widget-accent) 26%, var(--line));
        background:
            radial-gradient(circle at top right, color-mix(in srgb, var(--goal-widget-accent) 12%, transparent), transparent 34%),
            linear-gradient(180deg, rgba(255,255,255,.62), rgba(248,244,236,.96)),
            var(--paper-raised);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        overflow: hidden;
    }

    .goal-dashboard-widget:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: color-mix(in srgb, var(--goal-widget-accent) 42%, var(--line));
    }

    .goal-dashboard-widget__rail {
        position: absolute;
        inset: 0 auto 0 0;
        width: 5px;
        background: linear-gradient(180deg, var(--goal-widget-accent), color-mix(in srgb, var(--goal-widget-accent) 65%, white));
    }

    .goal-dashboard-widget__header,
    .goal-dashboard-widget__progress-meta,
    .goal-dashboard-widget__footer {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .goal-dashboard-widget__title {
        margin: 0 0 .45rem;
        font-family: var(--font-display);
        font-size: 1.15rem;
        line-height: 1.15;
        color: var(--ink);
    }

    .goal-dashboard-widget__badges {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

    .goal-dashboard-widget__badge {
        display: inline-flex;
        align-items: center;
        padding: .22rem .58rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .goal-dashboard-widget__badge--status {
        background: color-mix(in srgb, var(--goal-widget-accent) 12%, white);
        color: color-mix(in srgb, var(--goal-widget-accent) 74%, black);
    }

    .goal-dashboard-widget__badge--area {
        background: rgba(160,120,32,.10);
        color: #7a5c0e;
    }

    .goal-dashboard-widget__date {
        min-width: 120px;
        text-align: right;
        color: var(--ink-soft);
    }

    .goal-dashboard-widget__eyebrow {
        display: block;
        margin-bottom: .18rem;
        font-size: .66rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-faint);
    }

    .goal-dashboard-widget__progress {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

    .goal-dashboard-widget__progress-meta {
        align-items: center;
        font-size: .8rem;
        color: var(--ink-soft);
    }

    .goal-dashboard-widget__bar {
        --mud-palette-primary: var(--goal-widget-accent);
    }

    .goal-dashboard-widget__footer {
        font-size: .78rem;
        color: var(--ink-faint);
        align-items: center;
        flex-wrap: wrap;
    }

    @@media (max-width: 640px) {
        .goal-dashboard-widget__header {
            flex-direction: column;
        }

        .goal-dashboard-widget__date {
            min-width: 0;
            text-align: left;
        }
    }
</style>

@code {
    [Parameter] public GoalDto Goal { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnNavigate { get; set; }

    private string RemainingMilestonesText
        => Goal.TotalMilestones == 0
            ? "No milestones yet"
            : $"{Math.Max(Goal.TotalMilestones - Goal.CompletedMilestones, 0)} remaining";

    private Task HandleNavigateAsync() => OnNavigate.InvokeAsync(Goal.Id);

    private static string StatusLabel(GoalStatus status) => status switch
    {
        GoalStatus.Planned => "Planned",
        GoalStatus.Active => "Active",
        GoalStatus.Achieved => "Achieved",
        GoalStatus.Abandoned => "Abandoned",
        GoalStatus.Archived => "Archived",
        _ => status.ToString()
    };

    private static string StatusAccent(GoalStatus status) => status switch
    {
        GoalStatus.Planned => "#9c7a35",
        GoalStatus.Active => "#2f6f61",
        GoalStatus.Achieved => "#5f7d3f",
        GoalStatus.Abandoned => "#9f4f40",
        GoalStatus.Archived => "#7d7466",
        _ => "#c0561d"
    };

    private static Color StatusColor(GoalStatus status) => status switch
    {
        GoalStatus.Planned => Color.Warning,
        GoalStatus.Active => Color.Info,
        GoalStatus.Achieved => Color.Success,
        GoalStatus.Abandoned => Color.Error,
        GoalStatus.Archived => Color.Dark,
        _ => Color.Primary
    };
}
