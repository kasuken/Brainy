@page "/notes/create"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

@using Brainy.Application.DTOs.Notes
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Markdig

@inject INoteService NoteService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>New Note – Brainy</PageTitle>

<div class="note-editor">

    @* ── Header ── *@
    <header class="note-editor__header">

        <button type="button" class="note-editor__back-btn"
                @onclick="NavigateBackAsync" aria-label="Back to notes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7" />
            </svg>
        </button>

        <div class="note-editor__header-content">
            <p class="note-editor__eyebrow">New Note</p>
            <input type="text"
                   id="note-title-input"
                   class="note-editor__title-input @(_titleError ? "invalid" : "")"
                   placeholder="Untitled note…"
                   value="@_model.Title"
                   @oninput="OnTitleInput"
                   maxlength="500"
                   aria-label="Note title"
                   aria-required="true"
                   autocomplete="off"
                   spellcheck="true" />
            @if (_titleError)
            {
                <span class="note-editor__title-error" role="alert">Title is required</span>
            }
        </div>

        <div class="note-editor__header-actions">
            @if (_saved)
            {
                <span class="note-editor__saved-badge" aria-live="polite">Saved</span>
            }
            else if (_isDirty)
            {
                <span class="note-editor__unsaved-badge" aria-live="polite">
                    <span class="note-editor__unsaved-dot" aria-hidden="true"></span>
                    Unsaved
                </span>
            }
            <button type="button"
                    class="note-editor__save-btn"
                    @onclick="SaveAsync"
                    disabled="@_saving"
                    aria-label="Save note">
                @if (_saving)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Inherit"
                                         Style="width:15px;height:15px;" />
                    <span>Saving…</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                        <polyline points="7 3 7 8 15 8" />
                    </svg>
                    <span>Save note</span>
                }
            </button>
        </div>

    </header>

    @* ── Body ── *@
    <div class="note-editor__body">

        @* Main editor *@
        <div class="note-editor__main">

            @* Toolbar *@
            <div class="note-editor__toolbar">
                <div class="note-editor__tabs" role="tablist" aria-label="Editor mode">
                    <button type="button" role="tab"
                            class="note-editor__tab @(_activeTab == "write" ? "active" : "")"
                            aria-selected="@(_activeTab == "write")"
                            @onclick='() => _activeTab = "write"'>Write</button>
                    <button type="button" role="tab"
                            class="note-editor__tab @(_activeTab == "preview" ? "active" : "")"
                            aria-selected="@(_activeTab == "preview")"
                            @onclick='() => _activeTab = "preview"'>Preview</button>
                </div>

                @if (_activeTab == "write")
                {
                    <div class="note-editor__format-tools" role="toolbar" aria-label="Markdown formatting">
                        <button type="button" class="note-editor__tool" title="Bold"
                                @onclick='() => InsertMarkdownAsync("**", "**", "bold text")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                                <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                            </svg>
                        </button>
                        <button type="button" class="note-editor__tool" title="Italic"
                                @onclick='() => InsertMarkdownAsync("*", "*", "italic text")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="4" x2="10" y2="4" />
                                <line x1="14" y1="20" x2="5" y2="20" />
                                <line x1="15" y1="4" x2="9" y2="20" />
                            </svg>
                        </button>
                        <button type="button" class="note-editor__tool" title="Heading 2"
                                @onclick='() => InsertMarkdownAsync("## ", "", "Heading")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12h16M4 6v12M20 6v12" />
                            </svg>
                        </button>
                        <span class="note-editor__tool-divider" aria-hidden="true"></span>
                        <button type="button" class="note-editor__tool" title="Blockquote"
                                @onclick='() => InsertMarkdownAsync("> ", "", "quoted text")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" />
                                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
                            </svg>
                        </button>
                        <button type="button" class="note-editor__tool note-editor__tool--mono" title="Inline code"
                                @onclick='() => InsertMarkdownAsync("`", "`", "code")'>
                            &lt;/&gt;
                        </button>
                        <span class="note-editor__tool-divider" aria-hidden="true"></span>
                        <button type="button" class="note-editor__tool" title="Bullet list"
                                @onclick='() => InsertMarkdownAsync("- ", "", "list item")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="9" y1="6" x2="20" y2="6" />
                                <line x1="9" y1="12" x2="20" y2="12" />
                                <line x1="9" y1="18" x2="20" y2="18" />
                                <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none" />
                                <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none" />
                                <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none" />
                            </svg>
                        </button>
                        <button type="button" class="note-editor__tool" title="Numbered list"
                                @onclick='() => InsertMarkdownAsync("1. ", "", "list item")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="10" y1="6" x2="21" y2="6" />
                                <line x1="10" y1="12" x2="21" y2="12" />
                                <line x1="10" y1="18" x2="21" y2="18" />
                                <path d="M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" />
                            </svg>
                        </button>
                        <button type="button" class="note-editor__tool" title="Link"
                                @onclick='() => InsertMarkdownAsync("[", "](https://)", "link text")'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

            @* Content *@
            @if (_activeTab == "write")
            {
                <textarea id="note-content-area"
                          class="note-editor__textarea"
                          placeholder="Start writing… Markdown is supported."
                          aria-label="Note content"
                          @oninput="OnContentInput">@_model.Content</textarea>
            }
            else
            {
                <div class="note-editor__preview markdown-body" role="article" aria-label="Rendered preview">
                    @RenderMarkdown()
                </div>
            }

        </div>

        @* Sidebar *@
        <aside class="note-editor__sidebar" aria-label="Note properties">

            <div class="note-editor__sidebar-section">
                <h3 class="note-editor__sidebar-heading">PARA Category</h3>
                <MudSelect T="ParaCategory"
                           Value="_model.ParaCategory"
                           ValueChanged="OnParaCategoryChanged"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft">
                    @foreach (var cat in Enum.GetValues<ParaCategory>())
                    {
                        <MudSelectItem Value="cat">
                            <span class="note-editor__select-option">
                                <span class="note-editor__select-dot"
                                      style="background:@CategoryDotColor(cat)"></span>
                                @cat.ToString()
                            </span>
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="note-editor__sidebar-section">
                <h3 class="note-editor__sidebar-heading">Markdown tips</h3>
                <p class="note-editor__sidebar-tip">
                    Use <strong>Write</strong> to author with Markdown, then
                    <strong>Preview</strong> to see it rendered.
                </p>
                <p class="note-editor__sidebar-tip">
                    New notes land in your <strong>Inbox</strong> — process
                    them to move into your second brain.
                </p>
            </div>

        </aside>

    </div>
</div>

@code {
    private sealed class NoteFormModel
    {
        public string Title   { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public ParaCategory ParaCategory { get; set; } = ParaCategory.Project;
    }

    private readonly NoteFormModel _model = new();
    private string _activeTab = "write";
    private bool _isDirty;
    private bool _saved;
    private bool _titleError;
    private bool _saving;
    private IDisposable? _locationChangingHandler;

    private static readonly MarkdownPipeline _pipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _locationChangingHandler = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!_isDirty) return;

        var confirmed = await DialogService.ShowMessageBox(
            "Unsaved Changes",
            "You have unsaved changes that will be lost. Leave anyway?",
            yesText: "Leave", cancelText: "Stay");

        if (confirmed != true)
            context.PreventNavigation();
    }

    private void MarkDirty()
    {
        _saved = false;
        if (_isDirty) return;
        _isDirty = true;
        _ = JS.InvokeVoidAsync("brainyNoteEditor.addBeforeunloadWarning");
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        _model.Title = e.Value?.ToString() ?? string.Empty;
        _titleError  = string.IsNullOrWhiteSpace(_model.Title);
        MarkDirty();
    }

    private void OnContentInput(ChangeEventArgs e)
    {
        _model.Content = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
    }

    private void OnParaCategoryChanged(ParaCategory value)
    {
        _model.ParaCategory = value;
        MarkDirty();
    }

    private async Task InsertMarkdownAsync(string prefix, string suffix, string placeholder)
    {
        var newValue = await JS.InvokeAsync<string?>(
            "brainyNoteEditor.insertMarkdown",
            "note-content-area", prefix, suffix, placeholder);

        if (newValue is not null)
        {
            _model.Content = newValue;
            MarkDirty();
        }
    }

    private async Task SaveAsync()
    {
        _titleError = string.IsNullOrWhiteSpace(_model.Title);
        if (_titleError)
        {
            Snackbar.Add("Please enter a title for the note.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var note = await NoteService.CreateAsync(new CreateNoteDto(
                _model.Title,
                _model.Content,
                _model.ParaCategory));

            _isDirty = false;
            _saved   = true;
            await JS.InvokeVoidAsync("brainyNoteEditor.removeBeforeunloadWarning");

            Snackbar.Add("Note created.", Severity.Success);
            Nav.NavigateTo($"/notes/{note.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task NavigateBackAsync()
    {
        if (_isDirty)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Unsaved Changes",
                "You have unsaved changes that will be lost. Leave anyway?",
                yesText: "Leave", cancelText: "Stay");

            if (confirmed != true) return;
        }
        Nav.NavigateTo("/notes");
    }

    private MarkupString RenderMarkdown()
    {
        if (string.IsNullOrWhiteSpace(_model.Content))
            return new MarkupString(
                "<p class='note-editor__preview-empty'>Nothing to preview yet — switch to <strong>Write</strong> to add content.</p>");

        return new MarkupString(Markdown.ToHtml(_model.Content, _pipeline));
    }

    private static string CategoryDotColor(ParaCategory cat) => cat switch
    {
        ParaCategory.Project  => "#c0561d",
        ParaCategory.Area     => "#6f7a5a",
        ParaCategory.Resource => "#2196f3",
        ParaCategory.Archive  => "#9a9180",
        _                     => "#9a9180"
    };

    public void Dispose()
    {
        _locationChangingHandler?.Dispose();
        _ = JS.InvokeVoidAsync("brainyNoteEditor.removeBeforeunloadWarning");
    }
}
