@page "/search"
@rendermode InteractiveServer
@attribute [Authorize]
@namespace Brainy.Web.Components.Pages

@using Brainy.Application.DTOs.Search
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Notes
@using Microsoft.AspNetCore.Components

@inject ISearchService SearchService
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Search – Brainy</PageTitle>

<div class="search-page">

    @* ── Hero search bar ── *@
    <div class="search-hero">
        <div class="search-hero__title-row">
            <h1 class="search-hero__heading mb-1">Search your knowledge</h1>
            <PageHelpButton Guide="HelpGuide" />
        </div>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-5">
            Find active notes, outputs, projects, tasks, areas, resources, ideas, and goals.
        </MudText>

        <div class="search-input-wrap">
            <MudTextField @bind-Value="_query"
                          Placeholder="Type to search…"
                          aria-label="Search your knowledge"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="RunSearchAsync"
                          Variant="Variant.Outlined"
                          Class="search-input"
                          TextChanged="OnTextChanged" />
        </div>

        @if (_hasSearched && _results.Count > 0)
        {
            <div class="search-filter-group mt-4">
            <div class="search-filter-bar" aria-label="Filter search results by type">
                @foreach (var option in TypeFilterOptions.Where(option => option.Type == "All" || GetFilterCount(option.Type) > 0))
                {
                    var isActive = _typeFilter == option.Type;
                    <button type="button"
                            class="search-filter-chip @(isActive ? "search-filter-chip--active" : null)"
                            aria-pressed="@isActive"
                            @onclick="() => SetTypeFilter(option.Type)">
                        <MudIcon Icon="@option.Icon" Class="search-filter-chip__icon" />
                        @option.Label
                        <span class="search-filter-chip__badge">@GetFilterCount(option.Type)</span>
                    </button>
                }
            </div>

            @if (AvailableTags.Count > 0)
            {
                <div class="search-filter-group__row">
                    <span class="search-filter-group__label">Tags</span>
                    <div class="search-filter-bar" aria-label="Filter search results by tag">
                        <button type="button"
                                class="search-filter-chip @(_tagFilter is null ? "search-filter-chip--active" : null)"
                                aria-pressed="@(_tagFilter is null)"
                                @onclick="ClearTagFilter">
                            All tags
                            <span class="search-filter-chip__badge">@TypeScopedResults.Count()</span>
                        </button>

                        @foreach (var tag in AvailableTags)
                        {
                            var isActive = string.Equals(_tagFilter, tag.Name, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="search-filter-chip @(isActive ? "search-filter-chip--active" : null)"
                                    aria-pressed="@isActive"
                                    @onclick="() => SetTagFilter(tag.Name)">
                                #@tag.Name
                                <span class="search-filter-chip__badge">@tag.Count</span>
                            </button>
                        }
                    </div>
                </div>
            }
            </div>
        }
    </div>

    @* ── Results area ── *@
    <div class="search-results-area">

        @if (_searching)
        {
            <div class="search-state search-state--loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Searching…</MudText>
            </div>
        }
        else if (_searchError)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                Search could not be completed. Check your connection and try again.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RunSearchAsync" Class="ml-2">Retry</MudButton>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_query) && _results.Count == 0 && _hasSearched)
        {
            <div class="search-state">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                         Class="search-state__icon mud-secondary-text" />
                <MudText Typo="Typo.h6" GutterBottom="true">No results for "@_query"</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Try shorter terms, different keywords, or check your spelling.
                </MudText>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(_query) && !_hasSearched)
        {
            <div class="search-state search-state--idle">
                <MudIcon Icon="@Icons.Material.Outlined.AutoStories"
                         Class="search-state__icon mud-secondary-text" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Start typing to search across your active second brain.
                </MudText>
            </div>
        }
        else if (VisibleResultsCount == 0 && _results.Count > 0)
        {
            <div class="search-state">
                <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff"
                         Class="search-state__icon mud-secondary-text" />
                <MudText Typo="Typo.h6" GutterBottom="true">No loaded results match the current filters</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Clear a filter or load more results to keep exploring matches for "@_lastQuery".
                </MudText>
            </div>

            @if (HasMoreResults)
            {
                <div class="search-load-more">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="LoadMoreAsync"
                               Disabled="_loadingMore">
                        @if (_loadingMore)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                            <text>Loading…</text>
                        }
                        else
                        {
                            <text>Load more</text>
                        }
                    </MudButton>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Loaded @_results.Count of @_totalCount total matches.
                    </MudText>
                </div>
            }
        }
        else if (VisibleResultsCount > 0)
        {
            <div class="search-meta mb-4">
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                    @if (HasActiveClientFilters)
                    {
                        <text>Showing <strong>@VisibleResultsCount</strong> visible result@(VisibleResultsCount == 1 ? "" : "s") from <strong>@_results.Count</strong> loaded for <em>"@_lastQuery"</em>.</text>
                    }
                    else if (HasMoreResults)
                    {
                        <text>Showing <strong>@_results.Count</strong> of <strong>@_totalCount</strong> result@( _totalCount == 1 ? "" : "s") for <em>"@_lastQuery"</em>.</text>
                    }
                    else
                    {
                        <text><strong>@VisibleResultsCount</strong> result@(VisibleResultsCount == 1 ? "" : "s") for <em>"@_lastQuery"</em>.</text>
                    }
                </MudText>
            </div>

            @foreach (var option in TypeFilterOptions.Skip(1).Where(option => ShowSection(option.Type)))
            {
                var groupResults = ResultsFor(option.Type).ToList();
                if (groupResults.Count > 0)
                {
                    <section class="search-results-section" aria-labelledby="@($"search-section-{option.Type}")">
                        <div class="search-results-section__head">
                            <h2 id="@($"search-section-{option.Type}")" class="search-results-section__title">@option.Label</h2>
                            <span class="search-results-section__count">@groupResults.Count</span>
                        </div>

                        <div class="search-results-list">
                        @foreach (var result in groupResults)
                        {
                            @if (result.ResultType == "Note")
                            {
                                <button type="button" class="search-card search-card--button" @onclick="() => OpenNote(result.Id)">
                                <div class="search-card__header">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="CategoryColor(result.ParaCategory)"
                                             Variant="Variant.Outlined"
                                             Class="search-card__badge">
                                        @result.ParaCategory
                                    </MudChip>

                                    @if (result.Relevance == 2)
                                    {
                                        <span class="search-card__relevance-pill">Title match</span>
                                    }

                                    <MudSpacer />

                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        <UserLocalTime Utc="result.UpdatedAtUtc" />
                                    </MudText>
                                </div>

                                <MudText Typo="Typo.subtitle1" Class="search-card__title">
                                    @HighlightTitle(result.Title, _lastQuery)
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(result.ContentSnippet))
                                {
                                    <p class="search-card__snippet">
                                        @if (!string.IsNullOrWhiteSpace(result.SnippetSource))
                                        {
                                            <span class="search-card__snippet-source">@result.SnippetSource:</span>
                                        }
                                        @HighlightSnippet(result.ContentSnippet, _lastQuery)
                                    </p>
                                }
                                </button>
                            }
                            else
                            {
                                <a class="search-card search-card--link" href="@BuildResultUrl(result)">
                                    <div class="search-card__header">
                                        <MudChip T="string" Size="Size.Small" Color="@ResultTypeColor(result)"
                                                 Variant="Variant.Outlined" Class="search-card__badge">
                                            @ResultTypeLabel(result)
                                        </MudChip>
                                        @if (result.OutputStatus.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="OutputStatusColor(result.OutputStatus.Value)"
                                                     Variant="Variant.Filled" Class="search-card__badge">
                                                @result.OutputStatus
                                            </MudChip>
                                        }
                                        @if (result.Relevance == 2)
                                        {
                                            <span class="search-card__relevance-pill">Title match</span>
                                        }
                                        <MudSpacer />
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            <UserLocalTime Utc="result.UpdatedAtUtc" />
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.subtitle1" Class="search-card__title">
                                        @HighlightTitle(result.Title, _lastQuery)
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(result.ContentSnippet))
                                    {
                                        <p class="search-card__snippet">
                                            @if (!string.IsNullOrWhiteSpace(result.SnippetSource))
                                            {
                                                <span class="search-card__snippet-source">@result.SnippetSource:</span>
                                            }
                                            @HighlightSnippet(result.ContentSnippet, _lastQuery)
                                        </p>
                                    }
                                </a>
                            }
                        }
                        </div>
                    </section>
                }
            }

            @if (HasMoreResults)
            {
                <div class="search-load-more">
                    <MudButton Variant="Variant.Outlined"
                              Color="Color.Primary"
                              OnClick="LoadMoreAsync"
                              Disabled="_loadingMore">
                        @if (_loadingMore)
                        {
                           <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                           <text>Loading…</text>
                        }
                        else
                        {
                           <text>Load more</text>
                        }
                    </MudButton>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Loaded @_results.Count of @_totalCount total matches.
                    </MudText>
                </div>
            }
        }

    </div>

</div>

<style>
    /* ── Page layout ── */
    .search-page {
        max-width: 780px;
        margin: 0 auto;
    }

    /* ── Hero ── */
    .search-hero {
        text-align: center;
        padding: 2.5rem 0 2rem;
    }

    .search-hero__heading {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.5px;
    }

    .search-hero__title-row {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .search-input-wrap {
        position: relative;
        max-width: 620px;
        margin: 0 auto;
    }

    .search-input {
        font-size: 1.05rem;
    }

    .search-input .mud-input-root {
        border-radius: 16px !important;
        background: var(--mud-palette-surface);
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        transition: box-shadow 0.2s ease;
    }

    .search-input .mud-input-root:hover,
    .search-input .mud-input-root:focus-within {
        box-shadow: 0 4px 20px rgba(192,86,29,0.18);
    }

    /* ── State screens ── */
    .search-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
        text-align: center;
        gap: 0.5rem;
    }

    .search-state__icon {
        font-size: 3.5rem !important;
        width: 3.5rem !important;
        height: 3.5rem !important;
        margin-bottom: 0.75rem;
        opacity: 0.55;
    }

    /* ── Meta line ── */
    .search-meta {
        padding: 0 0.25rem;
    }

    /* ── Type filter chips ── */
    .search-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0 0.1rem;
    }

    .search-filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .search-filter-group__row {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .search-filter-group__label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);
        padding-left: 0.1rem;
    }

    .search-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        cursor: pointer;
        border: 1.5px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-secondary);
        transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
        white-space: nowrap;
    }

    .search-filter-chip:hover {
        border-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary);
        box-shadow: 0 1px 6px rgba(192,86,29,0.12);
    }

    .search-filter-chip--active {
        background: var(--mud-palette-primary);
        border-color: var(--mud-palette-primary);
        color: #fff !important;
        box-shadow: 0 2px 8px rgba(192,86,29,0.22);
    }

    .search-filter-chip__icon {
        font-size: 0.9rem !important;
        width: 0.9rem !important;
        height: 0.9rem !important;
        opacity: 0.85;
    }

    .search-filter-chip__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.3em;
        padding: 0 0.3em;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        background: rgba(0,0,0,0.12);
        margin-left: 0.1rem;
    }

    .search-filter-chip--active .search-filter-chip__badge {
        background: rgba(255,255,255,0.28);
    }

    /* ── Result sections ── */
    .search-results-section + .search-results-section {
        margin-top: 1.5rem;
    }

    .search-results-section__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .75rem;
    }

    .search-results-section__title {
        margin: 0;
        font-size: .76rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--ink-faint);
    }

    .search-results-section__count,
    .search-card__goal-area {
        font-size: .72rem;
        color: var(--ink-faint);
    }

    /* ── Result cards ── */
    .search-results-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .search-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 14px;
        padding: 1.1rem 1.3rem;
        cursor: pointer;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.15s ease;
    }

    .search-card--link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .search-card--button {
        display: block;
        width: 100%;
        font: inherit;
        text-align: left;
        color: inherit;
    }

    .search-card:focus-visible,
    .search-filter-chip:focus-visible {
        outline: 3px solid var(--clay-ring);
        outline-offset: 2px;
    }

    .search-card:hover {
        border-color: var(--mud-palette-primary);
        box-shadow: 0 4px 16px rgba(192,86,29,0.12);
        transform: translateY(-1px);
    }

    .search-card__header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .search-card__badge {
        font-size: 0.72rem !important;
    }

    .search-card__relevance-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(192, 86, 29, 0.12);
        color: #c0561d;
        letter-spacing: 0.02em;
    }

    .search-card__title {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin-bottom: 0.35rem;
        line-height: 1.35;
    }

    .search-card__snippet {
        font-size: 0.875rem;
        color: var(--mud-palette-text-secondary);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .search-card__snippet-source {
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-right: 0.45rem;
    }

    .search-load-more {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        margin-top: 1.5rem;
        padding-bottom: 1rem;
    }

    /* Highlighted match terms */
    .search-highlight {
        background: rgba(205, 154, 58, 0.28);
        color: #7a5800;
        border-radius: 3px;
        padding: 0 2px;
        font-weight: 600;
    }
</style>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "search",
        PageTitle = "Search",
        Tagline = "Retrieve the right note, goal, or output when you need it",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Search,
                Lead = "Search helps you retrieve knowledge fast across notes, outputs, projects, tasks, areas, resources, ideas, and goals.",
                Points =
                [
                    "Find any entity by title or content.",
                    "Use type and tag filter chips to narrow results quickly.",
                    "Use relevance hints, dates, categories, and status chips to pick the right result."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "A trustworthy Second Brain pays off when you can retrieve what you captured and reuse it in real work.",
                Points =
                [
                    "Search reduces the time between remembering something exists and using it.",
                    "Fast retrieval keeps knowledge actionable instead of buried in storage.",
                    "Result context helps you choose the right item without opening everything."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Type a word or phrase in the search box; results update after a short pause.",
                    "Use the type filter chips to focus on a specific entity type.",
                    "If matching notes have tags, use the tag chips to narrow the list further.",
                    "Scan title-match badges, PARA category chips, statuses, and dates to judge relevance.",
                    "Click a card to navigate to the entity.",
                    "Clear the search box to reset the page."
                ]
            }
        ]
    };

    // ── Filter chip definitions: (type key, label, icon) ────────────────────
    private static readonly (string Type, string Label, string Icon)[] TypeFilterOptions =
    [
        ("All",      "All",       Icons.Material.Outlined.SelectAll),
        ("Note",     "Notes",     Icons.Material.Outlined.StickyNote2),
        ("Output",   "Outputs",   Icons.Material.Outlined.Output),
        ("Project",  "Projects",  Icons.Material.Outlined.AccountTree),
        ("Task",     "Tasks",     Icons.Material.Outlined.TaskAlt),
        ("Area",     "Areas",     Icons.Material.Outlined.Landscape),
        ("Resource", "Resources", Icons.Material.Outlined.LibraryBooks),
        ("Idea",     "Ideas",     Icons.Material.Outlined.Lightbulb),
        ("Goal",     "Goals",     Icons.Material.Outlined.Flag),
    ];

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private string _query = string.Empty;
    private string _lastQuery = string.Empty;
    private string _typeFilter = "All";
    private string? _tagFilter;
    private List<SearchResultDto> _results = [];
    private bool _searching;
    private bool _loadingMore;
    private bool _hasSearched;
    private int _currentPage;
    private int _totalCount;
    private const int PageSize = 20;
    // CS0414 suppressed: Blazor's Razor compiler reads this field in BuildRenderTree;
    // Roslyn's data-flow analysis does not track template-side reads.
#pragma warning disable CS0414
    private bool _searchError;
#pragma warning restore CS0414

    protected override async Task OnParametersSetAsync()
    {
        var queryTerm = Query?.Trim();
        if (string.IsNullOrWhiteSpace(queryTerm) ||
            string.Equals(queryTerm, _lastQuery, StringComparison.Ordinal))
            return;

        _query = queryTerm;
        await RunSearchAsync();
    }

    private IEnumerable<SearchResultDto> TypeScopedResults =>
        _typeFilter == "All"
            ? _results
            : _results.Where(result => result.ResultType == _typeFilter);

    private IEnumerable<SearchResultDto> ResultsFor(string type) =>
        ApplyTagFilter(_results.Where(result => result.ResultType == type));

    private int GetFilterCount(string type) => type switch
    {
        "All"      => ApplyTagFilter(_results).Count(),
        _          => ResultsFor(type).Count(),
    };

    private int VisibleResultsCount => GetFilterCount(_typeFilter);
    private bool HasActiveClientFilters => _typeFilter != "All" || !string.IsNullOrWhiteSpace(_tagFilter);
    private bool HasMoreResults => _results.Count < _totalCount;

    private IReadOnlyList<(string Name, int Count)> AvailableTags =>
        TypeScopedResults
            .SelectMany(result => result.Tags ?? [])
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .GroupBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .Select(group => (Name: group.First(), Count: group.Count()))
            .OrderBy(group => group.Item1, StringComparer.OrdinalIgnoreCase)
            .ToList();

    /// <summary>Returns true when the section for the given type should be rendered.</summary>
    private bool ShowSection(string type) =>
        (_typeFilter == "All" || _typeFilter == type) && ResultsFor(type).Any();

    private Task OnTextChanged(string value)
    {
        _query = value;
        if (string.IsNullOrWhiteSpace(value))
            ResetSearchState();

        return Task.CompletedTask;
    }

    private async Task RunSearchAsync()
    {
        var term = _query?.Trim() ?? string.Empty;
        await SearchPageAsync(resetResults: true);
    }

    private async Task LoadMoreAsync()
    {
        if (!HasMoreResults || _loadingMore)
            return;

        await SearchPageAsync(resetResults: false);
    }

    private async Task SearchPageAsync(bool resetResults)
    {
        var term = _query?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(term))
        {
            ResetSearchState();
            return;
        }

        if (resetResults)
        {
            _searching = true;
            _hasSearched = true;
        }
        else
        {
            _loadingMore = true;
        }

        _searchError = false;
        StateHasChanged();

        try
        {
            var nextPage = resetResults ? 1 : _currentPage + 1;
            var page = await SearchService.SearchAsync(term, page: nextPage, pageSize: PageSize);

            _currentPage = page.Page;
            _totalCount = page.TotalCount;

            if (resetResults)
            {
                _results = page.Items.ToList();
            }
            else
            {
                _results.AddRange(page.Items);
            }

            if (_typeFilter != "All" && !_results.Any(result => result.ResultType == _typeFilter))
                _typeFilter = "All";

            EnsureTagFilterIsAvailable();
            _lastQuery = term;
        }
        catch (Exception)
        {
            _searchError = true;
            if (resetResults)
            {
                _results = [];
                _totalCount = 0;
                _currentPage = 0;
            }
        }
        finally
        {
            _searching = false;
            _loadingMore = false;
            StateHasChanged();
        }
    }

    private async Task OpenNote(Guid id)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, id }
        };
        var options = new DialogOptions
        {
            MaxWidth         = MaxWidth.Large,
            FullWidth        = true,
            BackdropClick    = false,
            CloseOnEscapeKey = false,
            CloseButton      = false,
        };
        await DialogService.ShowAsync<NoteEditorDialog>("", parameters, options);
    }

    private void SetTypeFilter(string type)
    {
        _typeFilter = type;
        EnsureTagFilterIsAvailable();
    }

    private void SetTagFilter(string tag) => _tagFilter = tag;

    private void ClearTagFilter() => _tagFilter = null;

    private IEnumerable<SearchResultDto> ApplyTagFilter(IEnumerable<SearchResultDto> results) =>
        string.IsNullOrWhiteSpace(_tagFilter)
            ? results
            : results.Where(result => (result.Tags ?? []).Contains(_tagFilter, StringComparer.OrdinalIgnoreCase));

    private void EnsureTagFilterIsAvailable()
    {
        if (string.IsNullOrWhiteSpace(_tagFilter))
            return;

        if (!AvailableTags.Any(tag => string.Equals(tag.Name, _tagFilter, StringComparison.OrdinalIgnoreCase)))
            _tagFilter = null;
    }

    private void ResetSearchState()
    {
        _results = [];
        _hasSearched = false;
        _searchError = false;
        _searching = false;
        _loadingMore = false;
        _typeFilter = "All";
        _tagFilter = null;
        _lastQuery = string.Empty;
        _currentPage = 0;
        _totalCount = 0;
    }

    private static string BuildResultUrl(SearchResultDto result) => result.ResultType switch
    {
        "Output"   => $"/outputs/{result.Id}",
        "Project"  => $"/projects/{result.Id}",
        "Task"     => result.ProjectId.HasValue ? $"/projects/{result.ProjectId.Value}" : "/tasks-hub",
        "Area"     => $"/areas/{result.Id}",
        "Resource" => $"/resources/{result.Id}",
        "Idea"     => $"/ideas/{result.Id}",
        "Goal"     => $"/goals/{result.Id}",
        _          => "/search",
    };

    private static string ResultTypeLabel(SearchResultDto result) =>
        result.ResultType == "Output" && result.OutputType.HasValue
            ? result.OutputType.Value.ToString()
            : result.ResultType;

    private static Color ResultTypeColor(SearchResultDto result) => result.ResultType switch
    {
        "Output"   => Color.Secondary,
        "Project"  => Color.Primary,
        "Task"     => Color.Success,
        "Area"     => Color.Tertiary,
        "Resource" => Color.Info,
        "Idea"     => Color.Warning,
        "Goal"     => Color.Primary,
        _           => Color.Default,
    };

    private static Color CategoryColor(ParaCategory category) => category switch
    {
        ParaCategory.Project  => Color.Primary,
        ParaCategory.Area     => Color.Tertiary,
        ParaCategory.Resource => Color.Info,
        ParaCategory.Archive  => Color.Default,
        _                     => Color.Default
    };

    private static Color OutputStatusColor(OutputStatus status) => status switch
    {
        OutputStatus.Draft    => Color.Default,
        OutputStatus.InReview => Color.Warning,
        OutputStatus.Ready    => Color.Info,
        OutputStatus.Published => Color.Success,
        OutputStatus.Archived  => Color.Dark,
        _ => Color.Default
    };

    /// <summary>Returns a RenderFragment that wraps matched text in a highlight span.</summary>
    private static RenderFragment HighlightTitle(string title, string query) =>
        builder => RenderHighlighted(builder, title, query);

    private static RenderFragment HighlightSnippet(string snippet, string query) =>
        builder => RenderHighlighted(builder, snippet, query);

    private static void RenderHighlighted(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        string text,
        string term)
    {
        if (string.IsNullOrWhiteSpace(term))
        {
            builder.AddContent(0, text);
            return;
        }

        var seq = 0;
        var idx = 0;
        while (idx < text.Length)
        {
            var pos = text.IndexOf(term, idx, StringComparison.OrdinalIgnoreCase);
            if (pos < 0)
            {
                builder.AddContent(seq++, text[idx..]);
                break;
            }
            if (pos > idx)
                builder.AddContent(seq++, text[idx..pos]);

            builder.OpenElement(seq++, "mark");
            builder.AddAttribute(seq++, "class", "search-highlight");
            builder.AddContent(seq++, text[pos..(pos + term.Length)]);
            builder.CloseElement();

            idx = pos + term.Length;
        }
    }
