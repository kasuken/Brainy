@page "/search"
@rendermode InteractiveServer
@attribute [Authorize]
@namespace Brainy.Web.Components.Pages

@using Brainy.Application.DTOs.Search
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums

@inject ISearchService SearchService
@inject IGoalService GoalService
@inject NavigationManager Nav

<PageTitle>Search – Brainy</PageTitle>

<div class="search-page">

    @* ── Hero search bar ── *@
    <div class="search-hero">
        <div class="search-hero__title-row">
            <MudText Typo="Typo.h4" Class="search-hero__heading mb-1">
                Search your knowledge
            </MudText>
            <PageHelpButton Guide="HelpGuide" />
        </div>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-5">
            Find notes and goals by title or content — results ordered by relevance.
        </MudText>

        <div class="search-input-wrap">
            <MudTextField @bind-Value="_query"
                          Placeholder="Type to search…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="RunSearchAsync"
                          Variant="Variant.Outlined"
                          Class="search-input"
                          TextChanged="OnTextChanged" />
        </div>
    </div>

    @* ── Results area ── *@
    <div class="search-results-area">

        @if (_searching)
        {
            <div class="search-state search-state--loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Searching…</MudText>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_query) && TotalResults == 0 && _hasSearched)
        {
            <div class="search-state">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                         Class="search-state__icon mud-secondary-text" />
                <MudText Typo="Typo.h6" GutterBottom="true">No results for "@_query"</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Try shorter terms, different keywords, or check your spelling.
                </MudText>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(_query) && !_hasSearched)
        {
            <div class="search-state search-state--idle">
                <MudIcon Icon="@Icons.Material.Outlined.AutoStories"
                         Class="search-state__icon mud-secondary-text" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Start typing to search across your notes and goals.
                </MudText>
            </div>
        }
        else if (TotalResults > 0)
        {
            <div class="search-meta mb-4">
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                    <strong>@TotalResults</strong> result@(TotalResults == 1 ? "" : "s")
                    for <em>"@_lastQuery"</em>
                </MudText>
            </div>

            @if (NoteResults.Any())
            {
                <div class="search-results-section">
                    <div class="search-results-section__head">
                        <span class="search-results-section__title">Notes</span>
                        <span class="search-results-section__count">@NoteResults.Count()</span>
                    </div>

                    <div class="search-results-list">
                        @foreach (var result in NoteResults)
                        {
                            <div class="search-card" @onclick="() => OpenNote(result.Id)">

                                <div class="search-card__header">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="CategoryColor(result.ParaCategory)"
                                             Variant="Variant.Outlined"
                                             Class="search-card__badge">
                                        @result.ParaCategory
                                    </MudChip>

                                    @if (result.Relevance == 2)
                                    {
                                        <span class="search-card__relevance-pill">Title match</span>
                                    }

                                    <MudSpacer />

                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @result.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                    </MudText>
                                </div>

                                <MudText Typo="Typo.subtitle1" Class="search-card__title">
                                    @HighlightTitle(result.Title, _lastQuery)
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(result.ContentSnippet))
                                {
                                    <p class="search-card__snippet">
                                        @HighlightSnippet(result.ContentSnippet, _lastQuery)
                                    </p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (OutputResults.Any())
            {
                <div class="search-results-section">
                    <div class="search-results-section__head">
                        <span class="search-results-section__title">Outputs</span>
                        <span class="search-results-section__count">@OutputResults.Count()</span>
                    </div>

                    <div class="search-results-list">
                        @foreach (var result in OutputResults)
                        {
                            <a class="search-card search-card--link" href="@($"/outputs/{result.Id}")">

                                <div class="search-card__header">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Secondary"
                                             Variant="Variant.Outlined"
                                             Class="search-card__badge">
                                        @result.OutputType
                                    </MudChip>

                                    @if (result.OutputStatus.HasValue)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="OutputStatusColor(result.OutputStatus.Value)"
                                                 Variant="Variant.Filled"
                                                 Class="search-card__badge">
                                            @result.OutputStatus
                                        </MudChip>
                                    }

                                    @if (result.Relevance == 2)
                                    {
                                        <span class="search-card__relevance-pill">Title match</span>
                                    }

                                    <MudSpacer />

                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @result.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                    </MudText>
                                </div>

                                <MudText Typo="Typo.subtitle1" Class="search-card__title">
                                    @HighlightTitle(result.Title, _lastQuery)
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(result.ContentSnippet))
                                {
                                    <p class="search-card__snippet">
                                        @HighlightSnippet(result.ContentSnippet, _lastQuery)
                                    </p>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            @if (_goalResults.Count > 0)
            {
                <div class="search-results-section">
                    <div class="search-results-section__head">
                        <span class="search-results-section__title">Goals</span>
                        <span class="search-results-section__count">@_goalResults.Count</span>
                    </div>

                    <div class="search-results-list">
                        @foreach (var goal in _goalResults)
                        {
                            <a class="search-card search-card--link" href="@($"/goals/{goal.Id}")">
                                <div class="search-card__header">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GoalStatusColor(goal.Status)"
                                             Variant="Variant.Outlined"
                                             Class="search-card__badge">
                                        @goal.Status
                                    </MudChip>

                                    @if (!string.IsNullOrWhiteSpace(goal.AreaName))
                                    {
                                        <span class="search-card__goal-area">@goal.AreaName</span>
                                    }

                                    <MudSpacer />

                                    @if (goal.TargetDate.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @goal.TargetDate.Value.ToString("MMM d, yyyy")
                                        </MudText>
                                    }
                                </div>

                                <MudText Typo="Typo.subtitle1" Class="search-card__title">
                                    @HighlightTitle(goal.Title, _lastQuery)
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(goal.Description))
                                {
                                    <p class="search-card__snippet">
                                        @HighlightSnippet(goal.Description, _lastQuery)
                                    </p>
                                }
                            </a>
                        }
                    </div>
                </div>
            }
        }

    </div>

</div>

<style>
    /* ── Page layout ── */
    .search-page {
        max-width: 780px;
        margin: 0 auto;
    }

    /* ── Hero ── */
    .search-hero {
        text-align: center;
        padding: 2.5rem 0 2rem;
    }

    .search-hero__heading {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.5px;
    }

    .search-hero__title-row {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .search-input-wrap {
        position: relative;
        max-width: 620px;
        margin: 0 auto;
    }

    .search-input {
        font-size: 1.05rem;
    }

    .search-input .mud-input-root {
        border-radius: 16px !important;
        background: var(--mud-palette-surface);
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        transition: box-shadow 0.2s ease;
    }

    .search-input .mud-input-root:hover,
    .search-input .mud-input-root:focus-within {
        box-shadow: 0 4px 20px rgba(192,86,29,0.18);
    }

    /* ── State screens ── */
    .search-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
        text-align: center;
        gap: 0.5rem;
    }

    .search-state__icon {
        font-size: 3.5rem !important;
        width: 3.5rem !important;
        height: 3.5rem !important;
        margin-bottom: 0.75rem;
        opacity: 0.55;
    }

    /* ── Meta line ── */
    .search-meta {
        padding: 0 0.25rem;
    }

    /* ── Type filter chips ── */
    .search-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0 0.1rem;
    }

    .search-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        cursor: pointer;
        border: 1.5px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-secondary);
        transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
        white-space: nowrap;
    }

    .search-filter-chip:hover {
        border-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary);
        box-shadow: 0 1px 6px rgba(192,86,29,0.12);
    }

    .search-filter-chip--active {
        background: var(--mud-palette-primary);
        border-color: var(--mud-palette-primary);
        color: #fff !important;
        box-shadow: 0 2px 8px rgba(192,86,29,0.22);
    }

    .search-filter-chip__icon {
        font-size: 0.9rem !important;
        width: 0.9rem !important;
        height: 0.9rem !important;
        opacity: 0.85;
    }

    .search-filter-chip__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.3em;
        padding: 0 0.3em;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        background: rgba(0,0,0,0.12);
        margin-left: 0.1rem;
    }

    .search-filter-chip--active .search-filter-chip__badge {
        background: rgba(255,255,255,0.28);
    }

    /* ── Result sections ── */
    .search-results-section + .search-results-section {
        margin-top: 1.5rem;
    }

    .search-results-section__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .75rem;
    }

    .search-results-section__title {
        font-size: .76rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--ink-faint);
    }

    .search-results-section__count,
    .search-card__goal-area {
        font-size: .72rem;
        color: var(--ink-faint);
    }

    /* ── Result cards ── */
    .search-results-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .search-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 14px;
        padding: 1.1rem 1.3rem;
        cursor: pointer;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.15s ease;
    }

    .search-card--link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .search-card:hover {
        border-color: var(--mud-palette-primary);
        box-shadow: 0 4px 16px rgba(192,86,29,0.12);
        transform: translateY(-1px);
    }

    .search-card__header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .search-card__badge {
        font-size: 0.72rem !important;
    }

    .search-card__relevance-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(192, 86, 29, 0.12);
        color: #c0561d;
        letter-spacing: 0.02em;
    }

    .search-card__title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin-bottom: 0.35rem;
        line-height: 1.35;
    }

    .search-card__snippet {
        font-size: 0.875rem;
        color: var(--mud-palette-text-secondary);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Highlighted match terms */
    .search-highlight {
        background: rgba(205, 154, 58, 0.28);
        color: #7a5800;
        border-radius: 3px;
        padding: 0 2px;
        font-weight: 600;
    }
</style>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "search",
        PageTitle = "Search",
        Tagline = "Retrieve the right note, goal, or output when you need it",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Search,
                Lead = "Search helps you retrieve knowledge fast across notes, outputs, projects, tasks, areas, resources, ideas, and goals.",
                Points =
                [
                    "Find any entity by title or content.",
                    "Use type filter chips to narrow results to a specific entity type.",
                    "Use relevance hints, dates, categories, and status chips to pick the right result."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "A trustworthy Second Brain pays off when you can retrieve what you captured and reuse it in real work.",
                Points =
                [
                    "Search reduces the time between remembering something exists and using it.",
                    "Fast retrieval keeps knowledge actionable instead of buried in storage.",
                    "Result context helps you choose the right item without opening everything."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Type a word or phrase in the search box; results update after a short pause.",
                    "Use the type filter chips to focus on a specific entity type.",
                    "Scan title-match badges, PARA category chips, statuses, and dates to judge relevance.",
                    "Click a card to navigate to the entity.",
                    "Clear the search box to reset the page."
                ]
            }
        ]
    };

    // ── Filter chip definitions: (type key, label, icon) ────────────────────
    private static readonly (string Type, string Label, string Icon)[] TypeFilterOptions =
    [
        ("All",      "All",       Icons.Material.Outlined.SelectAll),
        ("Note",     "Notes",     Icons.Material.Outlined.StickyNote2),
        ("Output",   "Outputs",   Icons.Material.Outlined.Output),
        ("Project",  "Projects",  Icons.Material.Outlined.AccountTree),
        ("Task",     "Tasks",     Icons.Material.Outlined.TaskAlt),
        ("Area",     "Areas",     Icons.Material.Outlined.Landscape),
        ("Resource", "Resources", Icons.Material.Outlined.LibraryBooks),
        ("Idea",     "Ideas",     Icons.Material.Outlined.Lightbulb),
        ("Goal",     "Goals",     Icons.Material.Outlined.Flag),
    ];

    private string _query = string.Empty;
    private string _lastQuery = string.Empty;
    private string _typeFilter = "All";
    private IReadOnlyList<SearchResultDto> _results = [];
    private IReadOnlyList<GoalDto> _goalResults = [];
    private bool _searching;
    private bool _hasSearched;
    // CS0414 suppressed: Blazor's Razor compiler reads this field in BuildRenderTree;
    // Roslyn's data-flow analysis does not track template-side reads.
#pragma warning disable CS0414
    private bool _searchError;
#pragma warning restore CS0414

    private IEnumerable<SearchResultDto> NoteResults     => _results.Where(r => r.ResultType == "Note");
    private IEnumerable<SearchResultDto> OutputResults   => _results.Where(r => r.ResultType == "Output");
    private IEnumerable<SearchResultDto> ProjectResults  => _results.Where(r => r.ResultType == "Project");
    private IEnumerable<SearchResultDto> TaskResults     => _results.Where(r => r.ResultType == "Task");
    private IEnumerable<SearchResultDto> AreaResults     => _results.Where(r => r.ResultType == "Area");
    private IEnumerable<SearchResultDto> ResourceResults => _results.Where(r => r.ResultType == "Resource");
    private IEnumerable<SearchResultDto> IdeaResults     => _results.Where(r => r.ResultType == "Idea");

    /// <summary>Returns true when the section for the given type should be rendered.</summary>
    private bool ShowSection(string type) => _typeFilter == "All" || _typeFilter == type;

    private int GetFilterCount(string type) => type switch
    {
        "All"      => _results.Count + _goalResults.Count,
        "Goal"     => _goalResults.Count,
        _          => _results.Count(r => r.ResultType == type),
    };

    private int TotalResults => GetFilterCount(_typeFilter);

    private Task OnTextChanged(string value)
    {
        _query = value;
        if (string.IsNullOrWhiteSpace(value))
        {
            _results = [];
            _goalResults = [];
            _hasSearched = false;
            _searchError = false;
            _typeFilter = "All";
        }

        return Task.CompletedTask;
    }

    private async Task RunSearchAsync()
    {
        var term = _query?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(term))
        {
            _results = [];
            _goalResults = [];
            _hasSearched = false;
            _searchError = false;
            _typeFilter = "All";
            return;
        }

        _searching = true;
        _hasSearched = true;
        _searchError = false;
        StateHasChanged();

        try
        {
            _results = await SearchService.SearchAsync(term);
            var goals = await GoalService.GetAllNonArchivedAsync();
            _goalResults = goals
                .Where(goal =>
                    goal.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (goal.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) == true))
                .OrderBy(goal => goal.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(goal => goal.TargetDate ?? DateTime.MaxValue)
                .ThenBy(goal => goal.Title)
                .ToList();
            _lastQuery = term;
        }
        catch (Exception)
        {
            _searchError = true;
            _results = [];
            _goalResults = [];
        }
        finally
        {
            _searching = false;
            StateHasChanged();
        }
    }

    private void OpenNote(Guid id) => Nav.NavigateTo($"/notes/{id}");

    private static Color CategoryColor(ParaCategory category) => category switch
    {
        ParaCategory.Project  => Color.Primary,
        ParaCategory.Area     => Color.Tertiary,
        ParaCategory.Resource => Color.Info,
        ParaCategory.Archive  => Color.Default,
        _                     => Color.Default
    };

    private static Color GoalStatusColor(GoalStatus status) => status switch
    {
        GoalStatus.Planned => Color.Warning,
        GoalStatus.Active => Color.Info,
        GoalStatus.Achieved => Color.Success,
        GoalStatus.Abandoned => Color.Error,
        GoalStatus.Archived => Color.Dark,
        _ => Color.Default
    };

    private static Color OutputStatusColor(OutputStatus status) => status switch
    {
        OutputStatus.Draft    => Color.Default,
        OutputStatus.InReview => Color.Warning,
        OutputStatus.Ready    => Color.Info,
        OutputStatus.Published => Color.Success,
        OutputStatus.Archived  => Color.Dark,
        _ => Color.Default
    };

    /// <summary>Returns a RenderFragment that wraps matched text in a highlight span.</summary>
    private static RenderFragment HighlightTitle(string title, string query) =>
        builder => RenderHighlighted(builder, title, query);

    private static RenderFragment HighlightSnippet(string snippet, string query) =>
        builder => RenderHighlighted(builder, snippet, query);

    private static void RenderHighlighted(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        string text,
        string term)
    {
        if (string.IsNullOrWhiteSpace(term))
        {
            builder.AddContent(0, text);
            return;
        }

        var seq = 0;
        var idx = 0;
        while (idx < text.Length)
        {
            var pos = text.IndexOf(term, idx, StringComparison.OrdinalIgnoreCase);
            if (pos < 0)
            {
                builder.AddContent(seq++, text[idx..]);
                break;
            }
            if (pos > idx)
                builder.AddContent(seq++, text[idx..pos]);

            builder.OpenElement(seq++, "mark");
            builder.AddAttribute(seq++, "class", "search-highlight");
            builder.AddContent(seq++, text[pos..(pos + term.Length)]);
            builder.CloseElement();

            idx = pos + term.Length;
        }
    }
}
