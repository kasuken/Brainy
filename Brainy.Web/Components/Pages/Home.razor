@page "/"
@attribute [Authorize]
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.DTOs.Today
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Dashboard
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Today
@using Brainy.Web.Components.Pages.Calendar
@using Brainy.Web.Components.Pages.Projects
@inject ITodayService TodayService
@inject ITaskService TaskService
@inject ITodayNotificationService NotificationService
@inject IUserDashboardPreferenceService PreferenceService
@inject IProjectPrioritizationService ProjectPrioritizationService
@inject IProjectService ProjectService
@inject IGoalService GoalService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Today · Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    /* ── Page Layout ── */
    .td-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .td-layout {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    /* ── Top Dashboard Area ── */
    .td-top-dashboard {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .td-header-row {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    @@media (min-width: 768px) {
        .td-header-row {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
        }
    }

    .td-hero {
        margin-bottom: 0;
    }

    .td-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .td-greeting {
        font-family: 'Fraunces', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .td-hero-title-row {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .td-date {
        font-size: 0.95rem;
        color: var(--mud-palette-text-secondary);
        font-weight: 500;
    }

    .td-nav {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .td-nav-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.85rem;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 999px;
        background: var(--mud-palette-surface);
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        text-decoration: none;
        transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }

    .td-nav-chip-primary {
        color: var(--clay, #c0561d);
        border-color: var(--clay, #c0561d);
        background: rgba(192, 86, 29, 0.04);
    }

    .td-nav-chip:hover { 
        border-color: var(--clay, #c0561d); 
        color: var(--clay, #c0561d); 
        background: rgba(192, 86, 29, 0.04); 
        box-shadow: 0 2px 8px rgba(192, 86, 29, 0.05);
    }

    .td-sidebar-widgets {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @@media (min-width: 768px) {
        .td-sidebar-widgets {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (min-width: 1200px) {
        .td-sidebar-widgets {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .td-sidebar-widgets > :first-child {
            grid-column: span 1;
        }
    }

    .td-priority-projects {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .td-projects-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    /* ── Main Area ── */
    .td-loading-state {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .td-notifications {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .td-quick-actions-wrap {
        margin-bottom: 2.5rem;
    }

    /* ── Widget Sections Grid ── */
    .td-sections { 
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem; 
    }

    @@media (min-width: 1200px) {
        .td-sections {
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }
    }

    .td-section { 
        animation: td-fade-up 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; 
    }

    @@keyframes td-fade-up {
        from { opacity: 0; transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .td-section:nth-child(1) { animation-delay: 0.05s; }
    .td-section:nth-child(2) { animation-delay: 0.10s; }
    .td-section:nth-child(3) { animation-delay: 0.15s; }
    .td-section:nth-child(4) { animation-delay: 0.20s; }
    .td-section:nth-child(5) { animation-delay: 0.25s; }
    .td-section:nth-child(6) { animation-delay: 0.30s; }

    /* ── Widget Sub-components styling ── */
    .td-section-head {
        display: flex;
        align-items: baseline;
        gap: 0.65rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .td-section-label {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }

    .td-section-label--overdue { color: #d32f2f; }
    .td-section-label--today   { color: var(--clay, #c0561d); }
    .td-section-label--focus   { color: #4e342e; }
    .td-section-label--week    { color: #f57f17; }
    .td-section-label--next    { color: #388e3c; }

    @@media (min-width: 1200px) {
        .td-section--inprogress { grid-column: 1 / -1; }
    }

    .td-section-count { 
        font-size: 0.72rem; 
        color: var(--mud-palette-text-disabled); 
        font-weight: 500;
    }

    /* ── Task Items ── */
    .td-task {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        margin-bottom: 0.65rem;
        position: relative;
        overflow: hidden;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .td-task::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 4px;
        opacity: 0.85;
    }

    .td-task--critical::before { background: #d32f2f; }
    .td-task--high::before     { background: #ed6c02; }
    .td-task--medium::before   { background: #fbc02d; }
    .td-task--low::before      { background: #388e3c; }
    
    .td-task--overdue { 
        border-color: rgba(211, 47, 47, 0.25); 
        background: rgba(211, 47, 47, 0.02); 
    }

    .td-task:hover { 
        border-color: rgba(192, 86, 29, 0.35); 
        box-shadow: 0 4px 12px rgba(192, 86, 29, 0.08); 
        transform: translateY(-2px);
    }

    .td-task-body { flex: 1; min-width: 0; }

    .td-task-title {
        font-family: 'Fraunces', serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
        line-height: 1.2;
    }

    .td-task-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 0.35rem;
        font-size: 0.72rem;
        color: var(--mud-palette-text-secondary);
        font-weight: 500;
        min-width: 0;
    }

    .td-task-project {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.5rem;
        background: var(--mud-palette-table-lines);
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .td-task-due { font-variant-numeric: tabular-nums; }
    .td-task-due--overdue { color: #d32f2f; font-weight: 700; }

    .td-empty {
        padding: 1rem;
        font-size: 0.85rem;
        color: var(--mud-palette-text-disabled);
        font-style: italic;
        text-align: center;
        background: rgba(0,0,0,0.02);
        border-radius: 8px;
        border: 1px dashed var(--mud-palette-lines-default);
    }

    .td-skeleton {
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(90deg, var(--mud-palette-surface) 25%, var(--mud-palette-lines-default) 50%, var(--mud-palette-surface) 75%);
        background-size: 200% 100%;
        animation: td-shimmer 1.5s ease infinite;
        margin-bottom: 0.5rem;
    }

    @@keyframes td-shimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>
<div class="td-page">
    <div class="td-layout">

        @* ── Top Dashboard Area ── *@
        <section class="td-top-dashboard">
            <div class="td-header-row">
                <div class="td-hero">
                    <p class="td-eyebrow">Daily briefing</p>
                    <div class="td-hero-title-row">
                        <h1 class="td-greeting">Today</h1>
                        <PageHelpButton Guide="HelpGuide" />
                    </div>
                    <p class="td-date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                </div>

                <nav class="td-nav">
                    <button class="td-nav-chip td-nav-chip-primary" @onclick="OpenAddTaskDialogAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" /> New Task
                    </button>
                    <a class="td-nav-chip" href="/inbox">
                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Small" /> Inbox
                    </a>
                    <a class="td-nav-chip" href="/projects">
                        <MudIcon Icon="@Icons.Material.Outlined.FolderSpecial" Size="Size.Small" /> Projects
                    </a>
                    <a class="td-nav-chip" href="/notes">
                        <MudIcon Icon="@Icons.Material.Outlined.Notes" Size="Size.Small" /> Notes
                    </a>
                    <a class="td-nav-chip" href="/archives">
                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" /> Archives
                    </a>
                </nav>
            </div>

            @if (!_loading)
            {
                <div class="td-sidebar-widgets">
                    @* ── Current focus ── *@
                    <CurrentTaskWidget Task="_aggregate?.CurrentTask"
                                       OnChanged="LoadAsync" />

                    @* ── Daily snapshot strip ── *@
                    <DailyFocusSummaryWidget Aggregate="_aggregate" />
                </div>
            }
        </section>

        @* ── Main Content: Execution view ── *@
        <main class="td-main">
            @if (_loading)
            {
                <div class="td-loading-state">
                    <div class="td-skeleton"></div>
                    <div class="td-skeleton" style="width:85%;"></div>
                    <div class="td-skeleton" style="width:70%;"></div>
                </div>
            }
            else
            {
                @* ── Notification bar ── *@
                @* @if (_notifications.Count > 0)
                {
                    <div class="td-notifications">
                        @foreach (var n in _notifications)
                        {
                            <MudAlert Severity="@NotificationSeverity(n.Kind)"
                                      Dense="true"
                                      Variant="Variant.Outlined">
                                @n.Message
                            </MudAlert>
                        }
                    </div>
                } *@

                @* ── Quick actions toolbar ── *@
                @* Removed quick actions per design update *@

                @* ── Task sections ── *@
                <div class="td-sections">

                    <InProgressWidget Tasks="_aggregate?.InProgress ?? []"
                                      OnComplete="HandleCompleted"
                                      OnEdit="OpenEditTaskDialogAsync" />

                    <OverdueWidget Tasks="_aggregate?.Overdue ?? []"
                                   OnComplete="HandleCompleted"
                                   OnEdit="OpenEditTaskDialogAsync" />

                    <GoalDeadlineWidget OverdueGoals="_overdueGoals"
                                        DueSoonGoals="_dueSoonGoals" />

                    <DueTodayWidget Tasks="_aggregate?.DueToday ?? []"
                                    OnComplete="HandleCompleted"
                                    OnEdit="OpenEditTaskDialogAsync" />

                    <HighPriorityProjectWorkWidget Tasks="_aggregate?.HighPriorityWork ?? []"
                                                   OnComplete="HandleCompleted"
                                                   OnEdit="OpenEditTaskDialogAsync" />

                    <DueThisWeekWidget Tasks="_aggregate?.DueThisWeek ?? []"
                                       OnComplete="HandleCompleted"
                                       OnEdit="OpenEditTaskDialogAsync" />

                    <NextTasksWidget Tasks="_aggregate?.NextTasks ?? []"
                                     OnEdit="OpenEditTaskDialogAsync" />

                    @* Empty state — only shown when there is truly nothing to act on *@
                    @if ((_aggregate?.CurrentTask == null)
                         && !(_aggregate?.InProgress?.Any() ?? false)
                         && !(_aggregate?.Overdue?.Any() ?? false)
                         && !(_aggregate?.DueToday?.Any() ?? false)
                         && !(_aggregate?.HighPriorityWork?.Any() ?? false)
                         && !(_aggregate?.DueThisWeek?.Any() ?? false)
                         && !(_aggregate?.NextTasks?.Any() ?? false))
                    {
                        <EmptyTodayExperience />
                    }

                </div>

                @* ── Priority projects (Bottom) ── *@
                @if (_prioritizedProjects.Count > 0)
                {
                    <div style="margin-top: 3.5rem;">
                        <div class="td-section-head">
                            <span class="td-section-label" style="color:var(--ink-soft);">Priority Projects</span>
                            <span class="td-section-count">@_prioritizedProjects.Count project@(_prioritizedProjects.Count == 1 ? "" : "s")</span>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
                            @foreach (var p in _prioritizedProjects)
                            {
                                <ProjectSummaryCard Project="p" Compact="false" OnNavigate="OpenProject" />
                            }
                        </div>
                    </div>
                }
            }
        </main>
    </div>
</div>
@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "today",
        PageTitle = "Today",
        Tagline = "Your daily command center for focused project work",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Today,
                Lead = "Today keeps active execution in view: what to focus on now, what is due or overdue, and what should be handled next.",
                Points =
                [
                    "Track your Current focus alongside a daily snapshot and Inbox reminder.",
                    "See every task marked In Progress at the top of the execution flow.",
                    "Review overdue, due today, due this week, and next tasks in one execution flow.",
                    "See high-priority project work, priority projects, and goal deadlines before they drift.",
                    "Use quick actions to add a task, process the Inbox, or create a note."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In BASB, Today turns organized knowledge into action instead of another place to store things.",
                Points =
                [
                    "Tasks stay tied to projects so you see the outcome behind the work.",
                    "The screen favors next actions, deadlines, and focus over browsing stored notes.",
                    "Archived projects and tasks stay out of Today because this screen is for active execution."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Start with Current focus: mark it complete, clear it, switch tasks, or set the suggested task as focus.",
                    "Use notifications and the Overdue section to clear anything already slipping.",
                    "Work Due Today and High-priority project work before moving to lower-pressure items.",
                    "Plan Due This Week and Next Tasks so upcoming work is visible early.",
                    "Use New Task, Process Inbox, or New Note from quick actions when work needs to be captured."
                ]
            }
        ]
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string DisplayName { get; set; } = "there";
    private bool _loading = true;

    private TodayAggregateDto? _aggregate;
    private IReadOnlyList<TodayNotificationDto> _notifications = [];
    private IReadOnlyList<ProjectSummaryDto> _prioritizedProjects = [];
    private IReadOnlyList<GoalDto> _overdueGoals = [];
    private IReadOnlyList<GoalDto> _dueSoonGoals = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var name = state.User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(name))
            {
                var at = name.IndexOf('@');
                DisplayName = at > 0 ? name[..at] : name;
            }
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        _aggregate = await TodayService.GetTodayAggregateAsync();
        _notifications = await NotificationService.GetNotificationsAsync();
        _prioritizedProjects = await ProjectPrioritizationService.GetPrioritizedProjectsAsync(5);
        _overdueGoals = await GoalService.GetOverdueAsync();
        _dueSoonGoals = await GoalService.GetDueSoonAsync();

        _loading = false;
        StateHasChanged();
    }

    private async Task HandleCompleted(Guid taskId)
    {
        try
        {
            await TaskService.CompleteAsync(taskId);
            Snackbar.Add("Task completed.", Severity.Success);
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("Could not complete task.", Severity.Error);
        }
    }

    private async Task OpenAddTaskDialogAsync()
    {
        try
        {
            var projects = await ProjectService.GetAllNonArchivedAsync();
            if (projects.Count == 0)
            {
                Snackbar.Add("Create a project first to add tasks.", Severity.Info);
                return;
            }

            var parameters = new DialogParameters<QuickTaskDialog>
            {
                { d => d.SelectedDate, DateTime.Today },
                { d => d.Projects, projects }
            };

            var dialog = await DialogService.ShowAsync<QuickTaskDialog>(
                "New Task",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Task created.", Severity.Success);
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not open task dialog: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditTaskDialogAsync(TodayTaskItemDto task)
    {
        try
        {
            var parameters = new DialogParameters<TaskEditorDialog>
            {
                { d => d.TaskId, task.Id },
                { d => d.ProjectId, task.ProjectId }
            };

            var dialog = await DialogService.ShowAsync<TaskEditorDialog>(
                "Edit Task",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Task updated.", Severity.Success);
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not open edit dialog: {ex.Message}", Severity.Error);
        }
    }

    private void OpenProject(Guid id) => Nav.NavigateTo($"/projects/{id}");

    private static Severity NotificationSeverity(TodayNotificationKind kind) => kind switch
    {
        TodayNotificationKind.OverdueTasks => Severity.Warning,
        TodayNotificationKind.DueToday     => Severity.Warning,
        _                                  => Severity.Info,
    };
}
