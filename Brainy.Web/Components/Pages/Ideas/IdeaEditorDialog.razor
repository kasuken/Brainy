@using Brainy.Application.Common
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Ideas
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject IIdeaService IdeaService
@inject IAreaService AreaService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-family:var(--font-display)">
            @(IdeaId.HasValue ? "Edit Idea" : "New Idea")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <div class="ied-fields">
                <MudTextField @bind-Value="_title" Label="Title" Required="true"
                              RequiredError="Title is required"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudTextField @bind-Value="_description" Label="Description"
                              Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudSelect @bind-Value="_areaId" Label="Area"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var area in _areas)
                    {
                        <MudSelectItem Value="@((Guid?)area.Id)">@area.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="_priority" Label="Priority"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (IdeaPriority p in Enum.GetValues<IdeaPriority>())
                    {
                        <MudSelectItem Value="@p">@p.ToString()</MudSelectItem>
                    }
                </MudSelect>

                @if (IdeaId.HasValue)
                {
                    <MudSelect @bind-Value="_status" Label="Status"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Disabled="_status == IdeaStatus.Committed"
                               HelperText="@(_status == IdeaStatus.Committed ? "Committed ideas cannot be edited here; manage the linked project instead." : null)">
                        @foreach (IdeaStatus s in Enum.GetValues<IdeaStatus>())
                        {
                            @if (s != IdeaStatus.Committed || _status == IdeaStatus.Committed)
                            {
                                <MudSelectItem Value="@s">@FormatStatus(s)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                }
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="!_valid || _saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IdeaId.HasValue ? "Save changes" : "Create idea")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
.ied-fields { display: flex; flex-direction: column; gap: .85rem; padding-top: .25rem; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid? IdeaId { get; set; }

    private MudForm _form = null!;
    private bool _valid;
    private bool _saving;

    private string _title = "";
    private string? _description;
    private Guid? _areaId;
    private IdeaPriority _priority = IdeaPriority.Medium;
    private IdeaStatus _status = IdeaStatus.Captured;
    private byte[]? _rowVersion;
    private string? _research;
    private string? _competitors;
    private string? _notes;
    private string? _targetUserAndProblem;
    private string? _suitabilityReason;
    private string? _evidence;
    private string? _validationExperiment;
    private string? _replacedCommitment;

    private List<AreaDto> _areas = [];

    protected override async Task OnInitializedAsync()
    {
        var areas = await AreaService.GetAllActiveAsync();
        _areas = areas.ToList();

        if (IdeaId.HasValue)
        {
            var dto = await IdeaService.GetDetailAsync(IdeaId.Value);
            if (dto is not null)
            {
                _title       = dto.Title;
                _description = dto.Description;
                _areaId      = dto.AreaId;
                _priority    = dto.Priority;
                _status      = dto.Status;
                _rowVersion  = dto.RowVersion;
                _research = dto.Research;
                _competitors = dto.Competitors;
                _notes = dto.Notes;
                _targetUserAndProblem = dto.TargetUserAndProblem;
                _suitabilityReason = dto.SuitabilityReason;
                _evidence = dto.Evidence;
                _validationExperiment = dto.ValidationExperiment;
                _replacedCommitment = dto.ReplacedCommitment;
            }
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_valid) return;

        _saving = true;
        try
        {
            if (IdeaId.HasValue)
            {
                await IdeaService.UpdateAsync(new UpdateIdeaDto(
                    IdeaId.Value, _title, _description, _areaId,
                    _priority, _status,
                    _research, _competitors, _notes,
                    _targetUserAndProblem, _suitabilityReason, _evidence,
                    _validationExperiment, _replacedCommitment,
                    RowVersion: _rowVersion));
            }
            else
            {
                await IdeaService.CreateAsync(new CreateIdeaDto(_title, _description, _areaId, _priority));
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatStatus(IdeaStatus status) => status switch
    {
        IdeaStatus.Committed => "Committed",
        _ => status.ToString()
    };
}
