@using Brainy.Application.DTOs.Projects

<MudDialog Class="citd-dialog">
    <TitleContent>
        <div class="citd__title">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="citd__title-icon" />
            <span>Convert to Task</span>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="citd__body">
            <p class="citd__hint">
                A new task will be created from this idea's title and description.
                Select which project the task should belong to.
            </p>

            <MudSelect T="Guid"
                       @bind-Value="_selectedProjectId"
                       Label="Project"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Placeholder="Choose a project…"
                       AnchorOrigin="Origin.BottomLeft"
                       Class="citd__select">
                @foreach (var project in Projects)
                {
                    <MudSelectItem T="Guid" Value="project.Id">@project.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="citd__btn-cancel">Cancel</MudButton>
        <MudButton OnClick="Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_selectedProjectId == Guid.Empty"
                   StartIcon="@Icons.Material.Filled.AssignmentTurnedIn"
                   Class="citd__btn-confirm">
            Create Task
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .citd__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--ink);
    }

    .citd__title-icon { color: var(--clay); }

    .citd__body {
        padding: 0.25rem 0 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .citd__hint {
        font-family: var(--font-body);
        font-size: 0.875rem;
        color: var(--ink-soft);
        margin: 0;
    }

    .citd__select { width: 100%; }

    .citd__btn-cancel { color: var(--ink-soft) !important; }

    .citd__btn-confirm {
        background: var(--clay) !important;
        color: #fff !important;
    }

    .citd__btn-confirm:hover { background: var(--clay-deep) !important; }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Non-archived projects the user can assign the task to.</summary>
    [Parameter] public IReadOnlyList<ProjectDto> Projects { get; set; } = [];

    private Guid _selectedProjectId;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_selectedProjectId));
    private void Cancel()  => MudDialog.Cancel();
}
