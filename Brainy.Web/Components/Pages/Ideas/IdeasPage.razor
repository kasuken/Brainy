@page "/ideas"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.Common
@using Brainy.Application.DTOs.Ideas
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject IIdeaService IdeaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Ideas — Brainy</PageTitle>

<style>

    .ip-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .ip-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .ip-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .ip-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: ip-fade-up 0.4s ease both;
    }

    @@keyframes ip-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .ip-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .ip-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .ip-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .ip-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }

    .ip-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .ip-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
    }

    .ip-filter-label {
        width: 100%;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .ip-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ip-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .ip-chip--on {
        background: rgba(192, 86, 29, 0.1);
        border-color: rgba(192, 86, 29, 0.3);
        color: var(--clay, #c0561d);
    }

    /* ── Main Area ── */
    .ip-main {
        animation: ip-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    /* Table styling */
    .ip-table-wrapper {
        border-radius: 14px;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.02);
    }
    
    .ip-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    
    .ip-table th {
        padding: 1rem 1.25rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--mud-palette-text-disabled);
        font-weight: 800;
        border-bottom: 2px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-table-lines);
    }
    
    .ip-table td {
        padding: 1.5rem 1.25rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        vertical-align: top;
    }
    
    .ip-row {
        transition: background 0.2s ease;
        position: relative;
    }
    
    .ip-row:hover {
        background: rgba(192, 86, 29, 0.02);
    }

    .ip-row:last-child td {
        border-bottom: none;
    }

    .ip-row-title {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin: 0 0 0.5rem;
        line-height: 1.2;
    }
    
    .ip-row-desc {
        color: var(--mud-palette-text-secondary);
        font-size: 0.95rem;
        line-height: 1.5;
        max-width: 50ch;
        margin: 0;
    }

    .ip-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }
    
    .ip-badge-area {
        background: var(--mud-palette-table-lines);
        color: var(--mud-palette-text-secondary);
        border: 1px solid var(--mud-palette-lines-default);
    }
    
    .ip-priority--high { color: #d32f2f; background: rgba(211, 47, 47, 0.1); border: 1px solid rgba(211, 47, 47, 0.2); }
    .ip-priority--medium { color: #ed6c02; background: rgba(237, 108, 2, 0.1); border: 1px solid rgba(237, 108, 2, 0.2); }
    .ip-priority--low { color: var(--mud-palette-text-secondary); background: var(--mud-palette-table-lines); border: 1px solid var(--mud-palette-lines-default); }

    .ip-status--captured { background: var(--mud-palette-table-lines); color: var(--mud-palette-text-secondary); }
    .ip-status--evaluating { background: rgba(205,154,58,.18); color: #7a5c0e; }
    .ip-status--incubated { background: rgba(111,122,90,.14); color: #4a5c38; }
    .ip-status--committed { background: rgba(192,86,29,.10); color: var(--clay-deep, #c0561d); }
    .ip-status--rejected { background: rgba(176,58,24,.10); color: #b03a18; }
    .ip-status--shipped { background: rgba(58,123,205,.14); color: #1a5aa0; }

    .ip-project-link {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--clay, #c0561d);
        text-decoration: none;
        transition: opacity 0.15s;
    }
    .ip-project-link:hover { opacity: 0.7; text-decoration: underline; }

    .ip-actions {
        display: flex;
        gap: 0.4rem;
        opacity: 0;
        transition: opacity 0.2s;
    }
    
    .ip-row:hover .ip-actions {
        opacity: 1;
    }
    
    .ip-btn-action {
        width: 36px; height: 36px;
        border-radius: 8px;
        border: 1px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
        display: flex; align-items: center; justify-content: center;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .ip-btn-action:hover {
        color: var(--mud-palette-text-primary);
        border-color: var(--mud-palette-text-primary);
    }
    
    .ip-btn-action--convert {
        color: var(--clay, #c0561d);
        border-color: rgba(192, 86, 29, 0.3);
    }
    .ip-btn-action--convert:hover {
        background: var(--clay, #c0561d);
        color: white;
        border-color: var(--clay, #c0561d);
    }
    
    .ip-btn-action--delete:hover {
        border-color: #d32f2f;
        color: #d32f2f;
    }
</style>

<div class="ip-page">
    <div class="ip-layout">

        @* ── Sidebar ── *@
        <aside class="ip-sidebar">
            <p class="ip-eyebrow">Inspiration</p>
            <div class="ip-title-row">
                <h1 class="ip-title">Ideas</h1>
                <PageHelpButton Guide="HelpGuide" />
            </div>
            <p class="ip-meta">@(_ideas?.Count ?? 0) ideas total · @(_filtered?.Count ?? 0) shown</p>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Large"
                       Class="mb-6"
                       Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                       FullWidth="true"
                       OnClick="OpenCreateDialog">
                New Idea
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Insights"
                       Size="Size.Large"
                       Class="mb-6"
                       Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                       FullWidth="true"
                       OnClick='() => Nav.NavigateTo("/ideas/dashboard")'>
                Idea Dashboard
            </MudButton>

            <div class="ip-widget">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search ideas…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@(() => ApplyFilter())"
                              OnKeyUp="@(() => ApplyFilter())"    
                              Class="mb-5" />

                <div class="ip-filter-label">Priority</div>
                <div class="ip-filter-group">
                    @foreach (IdeaPriority p in Enum.GetValues<IdeaPriority>())
                    {
                        <button class="ip-chip @(_priorityFilter == p ? "ip-chip--on" : "")"
                                @onclick="() => SetPriorityFilter(p)">
                            @p.ToString()
                        </button>
                    }
                </div>

                @if (!_showArchived)
                {
                    <div class="ip-filter-label">Status</div>
                    <div class="ip-filter-group">
                        @foreach (IdeaStatus s in Enum.GetValues<IdeaStatus>())
                        {
                            <button class="ip-chip @(_statusFilter == s ? "ip-chip--on" : "")"
                                    @onclick="() => SetStatusFilter(s)">
                                @FormatStatus(s)
                            </button>
                        }
                    </div>
                }

                <div class="ip-filter-label">View</div>
                <div class="ip-filter-group" style="margin-bottom:0;">
                    <button class="ip-chip @(_showArchived ? "ip-chip--on" : "")"
                            @onclick="ToggleArchived">
                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Style="font-size:.85rem; margin-right:4px;" />
                        Show Archived
                    </button>
                </div>
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="ip-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Loading ideas…</p>
                </div>
            }
            else if (_filtered is { Count: 0 })
            {
                <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                    <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                    <h2 style="font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                        @(_ideas?.Count == 0 ? "No ideas yet" : "Nothing matches")
                    </h2>
                    <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                        @(_ideas?.Count == 0
                            ? "Capture every spark — great projects start as a single idea."
                            : "Try broadening your search or clearing filters.")
                    </p>
                    @if (_ideas?.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Capture your first idea
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <div class="ip-table-wrapper">
                    <table class="ip-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Area</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th style="text-align:right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var idea in _filtered ?? [])
                            {
                                <tr class="ip-row">
                                    <td>
                                        <div class="ip-row-title">@idea.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(idea.Description))
                                        {
                                            <p class="ip-row-desc">
                                                @(idea.Description!.Length > 100
                                                    ? idea.Description[..100] + "…"
                                                    : idea.Description)
                                            </p>
                                        }
                                        <div style="margin-top:0.75rem; color:var(--mud-palette-text-disabled); font-size:0.75rem;">
                                            <UserLocalTime Utc="idea.UpdatedAtUtc" />
                                        </div>
                                    </td>
                                    <td>
                                        <span class="ip-badge ip-badge-area">@(idea.AreaName ?? "—")</span>
                                    </td>
                                    <td>
                                        <span class="ip-badge ip-priority--@idea.Priority.ToString().ToLowerInvariant()">
                                            @idea.Priority.ToString()
                                        </span>
                                    </td>
                                    <td>
                                        <span class="ip-badge ip-status--@idea.Status.ToString().ToLowerInvariant()">
                                            @FormatStatus(idea.Status)
                                        </span>
                                        @if (idea.Status == IdeaStatus.Committed && idea.CommittedProjectId.HasValue)
                                        {
                                            <a href="@($"/projects/{idea.CommittedProjectId}")" class="ip-project-link">
                                                <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                                                View project
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        <div class="ip-actions" style="justify-content:flex-end;">
                                            <!-- Edit -->
                                            <button class="ip-btn-action" title="Edit" @onclick="() => OpenEditDialog(idea)">
                                                <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                            </button>

                                            <!-- Commit to Project -->
                                            @if (!idea.IsArchived && idea.Status != IdeaStatus.Committed)
                                            {
                                                <button class="ip-btn-action ip-btn-action--convert" title="Commit to Project"
                                                        @onclick="() => OpenCommitDialogAsync(idea)">
                                                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                                                </button>
                                            }

                                            <!-- Archive / Restore -->
                                            @if (idea.IsArchived)
                                            {
                                                <button class="ip-btn-action" title="Restore"
                                                        @onclick="() => ConfirmRestore(idea)">
                                                    <MudIcon Icon="@Icons.Material.Outlined.RestorePage" Size="Size.Small" />
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="ip-btn-action" title="Archive"
                                                        @onclick="() => ConfirmArchive(idea)">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" />
                                                </button>
                                            }

                                            <!-- Delete -->
                                            <button class="ip-btn-action ip-btn-action--delete" title="Delete"
                                                    @onclick="() => ConfirmDelete(idea)">
                                                <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>
    </div>
</div>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "ideas",
        PageTitle = "Ideas",
        Tagline = "Capture sparks of inspiration before they disappear",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.EmojiObjects,
                Lead = "Ideas is your incubator for raw inspiration — the sparks that might become projects, outputs, or useful reference later.",
                Points =
                [
                    "Create quick ideas without forcing them into a project too early.",
                    "Scan each idea's area, priority, status, and last update date.",
                    "Filter the list so the best sparks are easy to revisit and develop."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "Capture inspiration freely; an idea is raw material to incubate and later turn into projects or outputs.",
                Points =
                [
                    "Treat capture as low-friction collecting, not commitment.",
                    "Use priority and status to decide which ideas deserve attention now.",
                    "Archive or reject ideas that no longer support actionability."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Click New Idea to capture a fresh spark.",
                    "Use Search ideas to find matching idea text.",
                    "Select Priority or Status chips to narrow the active list.",
                    "Turn on Show Archived when you need to review or restore old ideas.",
                    "Use row actions to edit, archive, restore, delete, or convert a promising idea to a project."
                ]
            }
        ]
    };

    private bool _loading = true;
    private List<IdeaDto>? _ideas;
    private List<IdeaDto>? _filtered;

    private string _searchText = "";
    private bool _showArchived;
    private IdeaPriority? _priorityFilter;
    private IdeaStatus? _statusFilter;

    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _loading = true;
        StateHasChanged();

        IReadOnlyList<IdeaDto> result;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            result = await IdeaService.SearchAsync(_searchText, cancellationToken);
        }
        else if (_showArchived)
        {
            result = await IdeaService.GetAllArchivedAsync(cancellationToken);
        }
        else
        {
            result = await IdeaService.GetAllActiveAsync(cancellationToken);
        }

        _ideas = result.ToList();
        ApplyFilter();
        _loading = false;
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            await LoadAsync(token);
        }
        catch (OperationCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchText = "";
        await LoadAsync();
    }

    private async Task ToggleArchived()
    {
        _showArchived = !_showArchived;
        _statusFilter = null;
        await LoadAsync();
    }

    private void SetPriorityFilter(IdeaPriority priority)
    {
        _priorityFilter = _priorityFilter == priority ? null : priority;
        ApplyFilter();
    }

    private void SetStatusFilter(IdeaStatus status)
    {
        _statusFilter = _statusFilter == status ? null : status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<IdeaDto> q = _ideas ?? [];

        // Text search is handled server-side via SearchAsync; skip client-side text filter.

        if (_priorityFilter.HasValue)
            q = q.Where(i => i.Priority == _priorityFilter.Value);

        if (_statusFilter.HasValue)
            q = q.Where(i => i.Status == _statusFilter.Value);

        _filtered = q.ToList();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<IdeaEditorDialog>();
        parameters.Add(x => x.IdeaId, null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<IdeaEditorDialog>("New Idea", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialog(IdeaDto idea)
    {
        var parameters = new DialogParameters<IdeaEditorDialog>();
        parameters.Add(x => x.IdeaId, idea.Id);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<IdeaEditorDialog>("Edit Idea", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmArchive(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Archive idea",
            $"Archive \"{idea.Title}\"? It will be hidden from active views.",
            yesText: "Archive", cancelText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.ArchiveAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" archived.", Severity.Info);
            await LoadAsync();
        }
    }

    private async Task ConfirmRestore(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Restore idea",
            $"Restore \"{idea.Title}\" to active ideas?",
            yesText: "Restore", cancelText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.RestoreAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" restored.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDelete(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete idea",
            $"Permanently delete \"{idea.Title}\"? This cannot be undone.",
            yesText: "Delete", noText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                await IdeaService.DeleteAsync(idea.Id, idea.RowVersion);
                Snackbar.Add($"\"{idea.Title}\" deleted.", Severity.Warning);
                await LoadAsync();
            }
            catch (ConcurrencyConflictException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
                await LoadAsync();
            }
        }
    }

    private async Task OpenCommitDialogAsync(IdeaDto idea)
    {
        var parameters = new DialogParameters<CommitIdeaToProjectDialog>
        {
            { dialog => dialog.IdeaId, idea.Id }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<CommitIdeaToProjectDialog>(
            "Commit to Project",
            parameters,
            options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add($"\"{idea.Title}\" committed to a project.", Severity.Success);
            await LoadAsync();
        }
    }

    /// <summary>Returns a CSS key for the status badge class.</summary>
    private static string StatusCssKey(IdeaStatus status) => status switch
    {
        IdeaStatus.Captured   => "captured",
        IdeaStatus.Evaluating => "evaluating",
        IdeaStatus.Incubated  => "incubated",
        IdeaStatus.Committed  => "committed",
        IdeaStatus.Rejected   => "rejected",
        IdeaStatus.Shipped    => "shipped",
        _                     => "captured"
    };

    /// <summary>Returns a human-readable label for an idea status.</summary>
    private static string FormatStatus(IdeaStatus status) => status.ToString();
}
