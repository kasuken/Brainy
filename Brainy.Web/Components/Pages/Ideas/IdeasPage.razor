@page "/ideas"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Ideas
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject IIdeaService IdeaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Ideas — Brainy</PageTitle>

<div class="idea-page">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <div class="idea-header">
        <div class="idea-header__text">
            <h1 class="idea-header__title">Ideas</h1>
            <p class="idea-header__sub">
                @(_ideas?.Count ?? 0) ideas · @(_filtered?.Count ?? 0) shown
            </p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="idea-header__new"
                   OnClick="OpenCreateDialog">
            New Idea
        </MudButton>
    </div>

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <div class="idea-toolbar">
        <div class="idea-search">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Class="idea-search__icon" />
            <input class="idea-search__input"
                   placeholder="Search ideas…"
                   value="@_searchText"
                   @oninput="OnSearchInput" />
            @if (!string.IsNullOrEmpty(_searchText))
            {
                <button class="idea-search__clear" @onclick="ClearSearch">✕</button>
            }
        </div>

        <div class="idea-filters">
            <span class="idea-filter-label">Priority</span>
            @foreach (IdeaPriority p in Enum.GetValues<IdeaPriority>())
            {
                <button class="idea-chip @(_priorityFilter == p ? "idea-chip--on" : "")"
                        @onclick="() => SetPriorityFilter(p)">
                    @p.ToString()
                </button>
            }

            @if (!_showArchived)
            {
                <span class="idea-filter-sep">|</span>
                <span class="idea-filter-label">Status</span>
                @foreach (IdeaStatus s in Enum.GetValues<IdeaStatus>().Where(s => s != IdeaStatus.Archived))
                {
                    <button class="idea-chip @(_statusFilter == s ? "idea-chip--on" : "")"
                            @onclick="() => SetStatusFilter(s)">
                        @FormatStatus(s)
                    </button>
                }
            }
        </div>

        <div class="idea-sort-row">
            <button class="idea-chip @(_showArchived ? "idea-chip--on" : "")"
                    @onclick="ToggleArchived">
                <MudIcon Icon="@Icons.Material.Outlined.Archive" Style="font-size:.85rem" />
                Show Archived
            </button>
        </div>
    </div>

    <!-- ── Content ──────────────────────────────────────────────────────── -->
    @if (_loading)
    {
        <div class="idea-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <span class="idea-loading__text">Loading ideas…</span>
        </div>
    }
    else if (_filtered is { Count: 0 })
    {
        <div class="idea-empty">
            <div class="idea-empty__glyph">✦</div>
            <p class="idea-empty__title">
                @(_ideas?.Count == 0 ? "No ideas yet" : "Nothing matches")
            </p>
            <p class="idea-empty__sub">
                @(_ideas?.Count == 0
                    ? "Capture every spark — great projects start as a single idea."
                    : "Try broadening your search or clearing filters.")
            </p>
            @if (_ideas?.Count == 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    Capture your first idea
                </MudButton>
            }
        </div>
    }
    else
    {
        <div class="idea-table-wrap">
            <table class="idea-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Area</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var idea in _filtered ?? [])
                    {
                        <tr class="idea-row">
                            <td>
                                <div class="idea-row__title">@idea.Title</div>
                                @if (!string.IsNullOrWhiteSpace(idea.Description))
                                {
                                    <div class="idea-row__desc">
                                        @(idea.Description!.Length > 80
                                            ? idea.Description[..80] + "…"
                                            : idea.Description)
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="idea-row__area">@(idea.AreaName ?? "—")</span>
                            </td>
                            <td>
                                <span class="idea-badge idea-badge--@idea.Priority.ToString().ToLowerInvariant()">
                                    @idea.Priority.ToString()
                                </span>
                            </td>
                            <td>
                                <span class="idea-badge idea-badge--status-@StatusCssKey(idea.Status)">
                                    @FormatStatus(idea.Status)
                                </span>
                            </td>
                            <td>
                                <span class="idea-row__date">
                                    @idea.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                </span>
                            </td>
                            <td>
                                <div class="idea-row__actions">
                                    <!-- Edit -->
                                    <button class="idea-action-btn" title="Edit"
                                            @onclick="() => OpenEditDialog(idea)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>

                                    <!-- Convert to Project (only for active, non-converted ideas) -->
                                    @if (!idea.IsArchived && idea.Status != IdeaStatus.ConvertedToProject)
                                    {
                                        <button class="idea-action-btn idea-action-btn--convert" title="Convert to Project"
                                                @onclick="() => ConfirmConvert(idea)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                <polyline points="22 4 12 14.01 9 11.01"/>
                                            </svg>
                                        </button>
                                    }

                                    <!-- Archive / Restore -->
                                    @if (idea.IsArchived)
                                    {
                                        <button class="idea-action-btn idea-action-btn--restore" title="Restore"
                                                @onclick="() => ConfirmRestore(idea)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="1 4 1 10 7 10"/>
                                                <path d="M3.51 15a9 9 0 1 0 .49-4.5"/>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="idea-action-btn idea-action-btn--archive" title="Archive"
                                                @onclick="() => ConfirmArchive(idea)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="21 8 21 21 3 21 3 8"/>
                                                <rect x="1" y="3" width="22" height="5"/>
                                                <line x1="10" y1="12" x2="14" y2="12"/>
                                            </svg>
                                        </button>
                                    }

                                    <!-- Delete -->
                                    <button class="idea-action-btn idea-action-btn--delete" title="Delete"
                                            @onclick="() => ConfirmDelete(idea)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14H6L5 6"/>
                                            <path d="M10 11v6M14 11v6"/>
                                            <path d="M9 6V4h6v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Ideas page — "Archival Mind" design system
   ═══════════════════════════════════════════════════════════════════════════ */

.idea-page {
    font-family: var(--font-body);
    padding-bottom: 3rem;
}

/* Header */
.idea-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}
.idea-header__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 .15rem;
    letter-spacing: -.02em;
    line-height: 1;
}
.idea-header__sub {
    font-size: .8rem;
    color: var(--ink-faint);
    margin: 0;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.idea-header__new {
    flex-shrink: 0;
}

/* Toolbar */
.idea-toolbar {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    margin-bottom: 1.75rem;
    padding: 1rem 1.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
}

/* Search */
.idea-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: .5rem;
}
.idea-search__icon {
    color: var(--ink-faint);
    font-size: 1.1rem !important;
    flex-shrink: 0;
}
.idea-search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: .95rem;
    color: var(--ink);
    outline: none;
    padding: .25rem 0;
    border-bottom: 1.5px solid var(--line);
    transition: border-color .2s;
}
.idea-search__input:focus { border-bottom-color: var(--clay); }
.idea-search__input::placeholder { color: var(--ink-faint); }
.idea-search__clear {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-faint);
    font-size: .85rem;
    padding: .15rem .3rem;
    border-radius: 4px;
    transition: color .15s;
}
.idea-search__clear:hover { color: var(--clay); }

/* Filter row */
.idea-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem;
}
.idea-filter-label {
    font-size: .7rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
    margin-right: .2rem;
}
.idea-filter-sep {
    color: var(--line-strong);
    margin: 0 .2rem;
    font-size: .85rem;
}

/* Chips */
.idea-chip {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .28rem .7rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: transparent;
    font-family: var(--font-body);
    font-size: .78rem;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color .15s, background .15s, color .15s;
}
.idea-chip:hover {
    border-color: var(--clay);
    color: var(--clay);
}
.idea-chip--on {
    border-color: var(--clay);
    background: color-mix(in srgb, var(--clay) 10%, transparent);
    color: var(--clay);
    font-weight: 600;
}

/* Sort / archive row */
.idea-sort-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem;
    border-top: 1px solid var(--line);
    padding-top: .65rem;
}

/* Loading / empty */
.idea-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 5rem 0;
}
.idea-loading__text { color: var(--ink-faint); font-size: .9rem; }

.idea-empty {
    text-align: center;
    padding: 5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
}
.idea-empty__glyph {
    font-size: 3.5rem;
    line-height: 1;
    opacity: .18;
    color: var(--clay);
    font-family: var(--font-display);
}
.idea-empty__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink);
    margin: 0;
    font-weight: 500;
}
.idea-empty__sub { color: var(--ink-faint); font-size: .9rem; margin: 0; max-width: 40ch; }

/* Table */
.idea-table-wrap {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}
.idea-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
}
.idea-table th {
    font-size: .7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--ink-faint);
    padding: .75rem 1rem;
    text-align: left;
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
}
.idea-table td {
    padding: .75rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
}
.idea-table tbody tr:last-child td { border-bottom: none; }
.idea-table tbody tr { transition: background .15s; }
.idea-table tbody tr:hover { background: var(--paper-sunk); }

.idea-row__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: .95rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
}
.idea-table tbody tr:hover .idea-row__title { color: var(--clay); }
.idea-row__desc {
    font-size: .78rem;
    color: var(--ink-faint);
    margin-top: .15rem;
    line-height: 1.4;
}
.idea-row__area {
    font-size: .82rem;
    color: var(--ink-soft);
    white-space: nowrap;
}
.idea-row__date {
    font-size: .8rem;
    color: var(--ink-faint);
    white-space: nowrap;
}

/* Priority / Status badges */
.idea-badge {
    display: inline-flex;
    align-items: center;
    padding: .18rem .6rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .03em;
    text-transform: uppercase;
    white-space: nowrap;
}

/* Priority */
.idea-badge--low      { background: var(--paper-sunk); color: var(--ink-soft); }
.idea-badge--medium   { background: color-mix(in srgb, #0ea5e9 12%, transparent); color: #0369a1; }
.idea-badge--high     { background: color-mix(in srgb, #f59e0b 12%, transparent); color: #92400e; }
.idea-badge--critical { background: color-mix(in srgb, #ef4444 12%, transparent); color: #b91c1c; }

/* Status */
.idea-badge--status-captured   { background: var(--paper-sunk); color: var(--ink-soft); }
.idea-badge--status-researching { background: color-mix(in srgb, #0ea5e9 12%, transparent); color: #0369a1; }
.idea-badge--status-validating  { background: color-mix(in srgb, #f59e0b 12%, transparent); color: #92400e; }
.idea-badge--status-planned     { background: color-mix(in srgb, var(--clay) 12%, transparent); color: var(--clay); }
.idea-badge--status-rejected    { background: color-mix(in srgb, #ef4444 12%, transparent); color: #b91c1c; }
.idea-badge--status-converted   { background: color-mix(in srgb, #22c55e 12%, transparent); color: #15803d; }
.idea-badge--status-archived    { background: var(--paper-sunk); color: var(--ink-faint); }

/* Row action buttons */
.idea-row__actions {
    display: flex;
    gap: .2rem;
    opacity: 0;
    transition: opacity .15s;
    justify-content: flex-end;
}
.idea-table tbody tr:hover .idea-row__actions { opacity: 1; }

.idea-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    cursor: pointer;
    color: var(--ink-soft);
    transition: background .15s, color .15s, border-color .15s;
    flex-shrink: 0;
}
.idea-action-btn svg { width: 14px; height: 14px; }
.idea-action-btn:hover           { background: var(--paper-sunk); color: var(--ink); border-color: var(--line-strong); }
.idea-action-btn--convert:hover  { color: #15803d; border-color: #15803d; }
.idea-action-btn--archive:hover  { color: var(--clay); border-color: var(--clay); }
.idea-action-btn--restore:hover  { color: var(--sage); border-color: var(--sage); }
.idea-action-btn--delete:hover   { color: #b03a18; border-color: #b03a18; }

@@media (max-width: 640px) {
    .idea-toolbar { padding: .85rem 1rem; }
    .idea-table th:nth-child(2),
    .idea-table td:nth-child(2),
    .idea-table th:nth-child(5),
    .idea-table td:nth-child(5) { display: none; }
    .idea-row__actions { opacity: 1; }
}
</style>

@code {
    private bool _loading = true;
    private List<IdeaDto>? _ideas;
    private List<IdeaDto>? _filtered;

    private string _searchText = "";
    private bool _showArchived;
    private IdeaPriority? _priorityFilter;
    private IdeaStatus? _statusFilter;

    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _loading = true;
        StateHasChanged();

        IReadOnlyList<IdeaDto> result;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            result = await IdeaService.SearchAsync(_searchText, cancellationToken);
        }
        else if (_showArchived)
        {
            result = await IdeaService.GetAllArchivedAsync(cancellationToken);
        }
        else
        {
            result = await IdeaService.GetAllActiveAsync(cancellationToken);
        }

        _ideas = result.ToList();
        ApplyFilter();
        _loading = false;
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            await LoadAsync(token);
        }
        catch (OperationCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchText = "";
        await LoadAsync();
    }

    private async Task ToggleArchived()
    {
        _showArchived = !_showArchived;
        _statusFilter = null;
        await LoadAsync();
    }

    private void SetPriorityFilter(IdeaPriority priority)
    {
        _priorityFilter = _priorityFilter == priority ? null : priority;
        ApplyFilter();
    }

    private void SetStatusFilter(IdeaStatus status)
    {
        _statusFilter = _statusFilter == status ? null : status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<IdeaDto> q = _ideas ?? [];

        // Text search is handled server-side via SearchAsync; skip client-side text filter.

        if (_priorityFilter.HasValue)
            q = q.Where(i => i.Priority == _priorityFilter.Value);

        if (_statusFilter.HasValue)
            q = q.Where(i => i.Status == _statusFilter.Value);

        _filtered = q.ToList();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<IdeaEditorDialog>();
        parameters.Add(x => x.IdeaId, null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<IdeaEditorDialog>("New Idea", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialog(IdeaDto idea)
    {
        var parameters = new DialogParameters<IdeaEditorDialog>();
        parameters.Add(x => x.IdeaId, idea.Id);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<IdeaEditorDialog>("Edit Idea", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmArchive(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Archive idea",
            $"Archive \"{idea.Title}\"? It will be hidden from active views.",
            yesText: "Archive", cancelText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.ArchiveAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" archived.", Severity.Info);
            await LoadAsync();
        }
    }

    private async Task ConfirmRestore(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Restore idea",
            $"Restore \"{idea.Title}\" to active ideas?",
            yesText: "Restore", cancelText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.RestoreAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" restored.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDelete(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete idea",
            $"Permanently delete \"{idea.Title}\"? This cannot be undone.",
            yesText: "Delete", noText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.DeleteAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" deleted.", Severity.Warning);
            await LoadAsync();
        }
    }

    private async Task ConfirmConvert(IdeaDto idea)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Convert to Project",
            $"Convert \"{idea.Title}\" into a new project?",
            yesText: "Convert", cancelText: "Cancel");

        if (confirmed == true)
        {
            await IdeaService.ConvertToProjectAsync(idea.Id);
            Snackbar.Add($"\"{idea.Title}\" converted to a project.", Severity.Success);
            await LoadAsync();
        }
    }

    /// <summary>Returns a CSS key for the status badge class.</summary>
    private static string StatusCssKey(IdeaStatus status) => status switch
    {
        IdeaStatus.Captured           => "captured",
        IdeaStatus.Researching        => "researching",
        IdeaStatus.Validating         => "validating",
        IdeaStatus.Planned            => "planned",
        IdeaStatus.Rejected           => "rejected",
        IdeaStatus.ConvertedToProject => "converted",
        IdeaStatus.Archived           => "archived",
        _                             => "captured"
    };

    /// <summary>Returns a human-readable label for an idea status.</summary>
    private static string FormatStatus(IdeaStatus status) => status switch
    {
        IdeaStatus.ConvertedToProject => "Converted",
        _ => status.ToString()
    };
}
