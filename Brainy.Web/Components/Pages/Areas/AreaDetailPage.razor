@page "/areas/{AreaId:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Ideas
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject IAreaService AreaService
@inject IProjectService ProjectService
@inject INoteService NoteService
@inject IIdeaService IdeaService
@inject ITaskService TaskService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IUserTimeZoneService UserTimeZoneService

<PageTitle>@(_detail?.Name ?? "Area") — Brainy</PageTitle>

@if (_loading)
{
    <div class="area-loading">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_detail is null)
{
    <div class="area-notfound">
        <span class="area-notfound__glyph">◈</span>
        <p class="area-notfound__title">Area not found</p>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick='() => Nav.NavigateTo("/areas")'>
            Back to Areas
        </MudButton>
    </div>
}
else
{
    <!-- ── Header ──────────────────────────────────────────────────── -->
    <div class="area-header">
        <div class="area-breadcrumb">
            <button type="button" class="area-back" @onclick='() => Nav.NavigateTo("/areas")'>
                <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
                Areas
            </button>
            <span class="area-breadcrumb__sep">›</span>
            <span class="area-breadcrumb__current">@_detail.Emoji @_detail.Name</span>
        </div>

        <div class="area-title-row">
            <div class="area-title-block">
                <div class="area-title-top">
                    <h1 class="area-title">@_detail.Emoji @_detail.Name</h1>
                    <PageHelpButton Guide="HelpGuide" />
                    @if (_detail.IsArchived)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                 Class="area-archived-chip">
                            Archived
                        </MudChip>
                    }
                </div>
            </div>
            <div class="area-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Size="Size.Small" OnClick="OpenEditDialogAsync">
                    Edit
                </MudButton>
                @if (_detail.IsArchived)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Unarchive"
                               Size="Size.Small" OnClick="ConfirmRestoreAsync">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Archive"
                               Size="Size.Small" OnClick="ConfirmArchiveAsync">
                        Archive
                    </MudButton>
                }
            </div>
        </div>
    </div>

    <!-- ── Dashboard Summary Strip ──────────────────────────────── -->
    <div class="area-stats">
        <div class="area-stat-tile">
            <span class="area-stat-tile__value @(_detail.ActiveProjectCount > 0 ? "area-stat-tile__value--clay" : "")">
                @_detail.ActiveProjectCount
            </span>
            <span class="area-stat-tile__label">Active Projects</span>
        </div>
        <div class="area-stat-tile">
            <span class="area-stat-tile__value @(_detail.OpenTaskCount > 0 ? "area-stat-tile__value--red" : "")">
                @_detail.OpenTaskCount
            </span>
            <span class="area-stat-tile__label">Open Tasks</span>
        </div>
        <div class="area-stat-tile">
            <span class="area-stat-tile__value @(_overdueTaskCount > 0 ? "area-stat-tile__value--red" : "")">
                @_overdueTaskCount
            </span>
            <span class="area-stat-tile__label">Overdue</span>
        </div>
        <div class="area-stat-tile">
            <span class="area-stat-tile__value @(_detail.RecentNoteCount > 0 ? "area-stat-tile__value--sage" : "")">
                @_detail.RecentNoteCount
            </span>
            <span class="area-stat-tile__label">Notes</span>
        </div>
        <div class="area-stat-tile">
            <span class="area-stat-tile__value @(_areaIdeas.Count > 0 ? "area-stat-tile__value--clay" : "")">
                @_areaIdeas.Count
            </span>
            <span class="area-stat-tile__label">Ideas</span>
        </div>
    </div>

    <!-- ── Purpose & Description ────────────────────────────────── -->
    @if (!string.IsNullOrWhiteSpace(_detail.Purpose) || !string.IsNullOrWhiteSpace(_detail.Description))
    {
        <div class="area-section area-section--meta">
            @if (!string.IsNullOrWhiteSpace(_detail.Purpose))
            {
                <div class="area-purpose">
                    <span class="area-meta-label">Purpose</span>
                    <p class="area-purpose__text">@_detail.Purpose</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_detail.Description))
            {
                <p class="area-description">@_detail.Description</p>
            }
        </div>
    }

    <!-- ── Related Projects ─────────────────────────────────────── -->
    <div class="area-section">
        <div class="area-section-head">
            <div class="area-section-head__left">
                <h2 class="area-section-title">Projects</h2>
                @if (_linkedProjects.Count > 0)
                {
                    <span class="area-count-badge">@_linkedProjects.Count</span>
                }
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.DriveFileMove"
                       Size="Size.Small"
                       OnClick="ToggleLinkProjectPicker"
                       aria-expanded="@_showLinkProjectPicker"
                       aria-controls="area-project-picker"
                       Disabled="_savingProjectLink">
                Assign Project
            </MudButton>
        </div>

        @if (_showLinkProjectPicker)
        {
            <div id="area-project-picker" class="area-picker-panel">
                <MudSelect T="Guid?" @bind-Value="_selectedProjectId"
                           Label="Select a project"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft"
                           Placeholder="Choose project to assign…">
                    @foreach (var p in _availableProjects)
                    {
                        <MudSelectItem T="Guid?" Value="p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
                <div class="area-picker-panel__actions">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="ToggleLinkProjectPicker">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_selectedProjectId is null || _savingProjectLink)"
                               OnClick="LinkProjectAsync">
                        @if (_savingProjectLink)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Assign
                    </MudButton>
                </div>
                @if (_availableProjects.Count == 0)
                {
                    <p class="area-picker-empty">No other non-archived projects are available to assign to this area.</p>
                }
            </div>
        }

        @if (_linkedProjects.Count == 0)
        {
            <div class="area-empty">
                <span class="area-empty__icon">📂</span>
                <p>No projects assigned to this area yet.</p>
            </div>
        }
        else
        {
            <div class="area-list">
                @foreach (var project in _linkedProjects)
                {
                    <div class="area-row">
                        <div class="area-row__info">
                            <a class="area-row__name" href="/projects/@project.Id">@project.Name</a>
                            <div class="area-row__badges">
                                <span class="area-badge area-badge--status area-status--@project.Status.ToString().ToLower()">
                                    @ProjectStatusLabel(project.Status)
                                </span>
                                <span class="area-badge area-badge--priority area-priority--@project.Priority.ToString().ToLower()">
                                    @PriorityLabel(project.Priority)
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ── Open Tasks ───────────────────────────────────────────── -->
    <div class="area-section">
        <div class="area-section-head">
            <div class="area-section-head__left">
                <h2 class="area-section-title">Open Tasks</h2>
                @if (_areaTasks.Count > 0)
                {
                    <span class="area-count-badge">@_areaTasks.Count</span>
                }
            </div>
        </div>

        @if (_linkedProjects.Count == 0)
        {
            <div class="area-empty">
                <span class="area-empty__icon">✅</span>
                <p>Assign a project to this area to see its open tasks here.</p>
            </div>
        }
        else if (_areaTasks.Count == 0)
        {
            <div class="area-empty">
                <span class="area-empty__icon">✅</span>
                <p>No open tasks across this area's projects — all caught up!</p>
            </div>
        }
        else
        {
            <div class="area-list">
                @foreach (var row in _areaTasks)
                {
                    <div class="area-row">
                        <div class="area-row__info">
                            <a class="area-row__name" href="/projects/@row.ProjectId">@row.Item.Title</a>
                            <div class="area-row__badges">
                                <span class="area-badge area-badge--status area-status--@row.Item.Status.ToString().ToLower()">
                                    @TaskStatusLabel(row.Item.Status)
                                </span>
                                <span class="area-badge area-badge--priority area-priority--@row.Item.Priority.ToString().ToLower()">
                                    @TaskPriorityLabel(row.Item.Priority)
                                </span>
                                <span class="area-badge area-badge--project">@row.ProjectName</span>
                                @if (row.Item.DueDate.HasValue)
                                {
                                    <span class="area-badge area-badge--due @(IsOverdue(row.Item) ? "area-badge--overdue" : "")">
                                        @(IsOverdue(row.Item) ? "Overdue " : "Due ")@row.Item.DueDate.Value.ToString("MMM d")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ── Related Ideas ────────────────────────────────────────── -->
    <div class="area-section">
        <div class="area-section-head">
            <div class="area-section-head__left">
                <h2 class="area-section-title">Ideas</h2>
                @if (_areaIdeas.Count > 0)
                {
                    <span class="area-count-badge">@_areaIdeas.Count</span>
                }
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.EmojiObjects"
                       Size="Size.Small"
                       OnClick='() => Nav.NavigateTo("/ideas")'>
                View All Ideas
            </MudButton>
        </div>

        @if (_areaIdeas.Count == 0)
        {
            <div class="area-empty">
                <span class="area-empty__icon">💡</span>
                <p>No ideas linked to this area yet.</p>
            </div>
        }
        else
        {
            <div class="area-list">
                @foreach (var idea in _areaIdeas)
                {
                    <div class="area-row">
                        <div class="area-row__info">
                            <a class="area-row__name" href="/ideas/@idea.Id">@idea.Title</a>
                            <div class="area-row__badges">
                                <span class="area-badge area-badge--status area-status--@idea.Status.ToString().ToLower()">
                                    @idea.Status.ToString()
                                </span>
                                <span class="area-badge area-badge--priority area-priority--@idea.Priority.ToString().ToLower()">
                                    @idea.Priority.ToString()
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ── Related Notes ────────────────────────────────────────── -->
    <div class="area-section">
        <div class="area-section-head">
            <div class="area-section-head__left">
                <h2 class="area-section-title">Notes</h2>
                @if (_linkedNotes.Count > 0)
                {
                    <span class="area-count-badge">@_linkedNotes.Count</span>
                }
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Link"
                       Size="Size.Small"
                       OnClick="ToggleLinkNotePicker"
                       aria-expanded="@_showLinkNotePicker"
                       aria-controls="area-note-picker"
                       Disabled="_savingNoteLink">
                Link Note
            </MudButton>
        </div>

        @if (_showLinkNotePicker)
        {
            <div id="area-note-picker" class="area-picker-panel">
                <MudSelect T="Guid?" @bind-Value="_selectedNoteId"
                           Label="Select a note"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft"
                           Placeholder="Choose note to link…">
                    @foreach (var n in _availableNotes)
                    {
                        <MudSelectItem T="Guid?" Value="n.Id">@n.Title</MudSelectItem>
                    }
                </MudSelect>
                <div class="area-picker-panel__actions">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="ToggleLinkNotePicker">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_selectedNoteId is null || _savingNoteLink)"
                               OnClick="LinkNoteAsync">
                        @if (_savingNoteLink)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Link
                    </MudButton>
                </div>
                @if (_availableNotes.Count == 0)
                {
                    <p class="area-picker-empty">No unlinked notes available to add.</p>
                }
            </div>
        }

        @if (_linkedNotes.Count == 0)
        {
            <div class="area-empty">
                <span class="area-empty__icon">📝</span>
                <p>No notes linked to this area yet.</p>
            </div>
        }
        else
        {
            <div class="area-list">
                @foreach (var note in _linkedNotes)
                {
                    <div class="area-row">
                        <div class="area-row__info">
                            <a class="area-row__name" href="/notes">@note.Title</a>
                            <div class="area-row__badges">
                                <span class="area-badge area-badge--para area-para--@note.ParaCategory.ToString().ToLower()">
                                    @ParaCategoryLabel(note.ParaCategory)
                                </span>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.LinkOff"
                                       Size="Size.Small"
                                       title="Unlink note"
                                       Color="Color.Default"
                                       Class="area-row__unlink"
                                       OnClick="() => UnlinkNoteAsync(note.Id, note.Title)" />
                    </div>
                }
            </div>
        }
    </div>

    <!-- ── Metadata footer ─────────────────────────────────────── -->
    <div class="area-meta-footer">
        <span>Created <UserLocalTime Utc="_detail.CreatedAtUtc" /></span>
        <span class="area-meta-footer__sep">•</span>
        <span>Updated <UserLocalTime Utc="_detail.UpdatedAtUtc" /></span>
        @if (_detail.IsArchived && _detail.ArchivedAtUtc.HasValue)
        {
            <span class="area-meta-footer__sep">•</span>
            <span>Archived <UserLocalTime Utc="_detail.ArchivedAtUtc" /></span>
        }
    </div>
}

<!-- Archive confirmation -->
<MudMessageBox @ref="_archiveMsgBox" Title="Archive Area?" CancelText="Cancel">
    <MessageContent>
        Brainy can archive <strong>@_detail?.Name</strong> only after its active projects, resources, goals, notes, ideas, and outputs are archived or reassigned. You can restore the area later.
    </MessageContent>
    <YesButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled">Archive</MudButton>
    </YesButton>
</MudMessageBox>

<!-- Restore confirmation -->
<MudMessageBox @ref="_restoreMsgBox" Title="Restore Area?" CancelText="Cancel">
    <MessageContent>
        Restore <strong>@_detail?.Name</strong> back to active areas?
    </MessageContent>
    <YesButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled">Restore</MudButton>
    </YesButton>
</MudMessageBox>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Area Detail page — "Living Archive" workspace style
   ═══════════════════════════════════════════════════════════════════════════ */

/* Loading / not-found */
.area-loading, .area-notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 6rem 1rem;
}
.area-notfound__glyph {
    font-size: 3rem;
    opacity: .15;
    font-family: var(--font-display);
    color: var(--clay);
}
.area-notfound__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink);
    margin: 0;
}

/* Breadcrumb */
.area-breadcrumb {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin-bottom: 1rem;
    font-size: .8rem;
    color: var(--ink-faint);
}
.area-back {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--clay);
    font-family: var(--font-body);
    font-size: .8rem;
    font-weight: 600;
    padding: 0;
    transition: opacity .15s;
}
.area-back:hover { opacity: .7; }
.area-breadcrumb__sep { color: var(--line-strong); }
.area-breadcrumb__current { color: var(--ink-soft); }

/* Header */
.area-header { margin-bottom: 1.5rem; }

.area-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
}
.area-title-block { flex: 1; min-width: 0; }
.area-title-top {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
}
.area-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    margin: 0;
    letter-spacing: -.02em;
    line-height: 1.15;
}
.area-archived-chip { flex-shrink: 0; }
.area-actions {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    flex-shrink: 0;
}

/* Stats strip */
.area-stats {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-bottom: 1.75rem;
}
.area-stat-tile {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: .9rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: .2rem;
    min-width: 110px;
    box-shadow: var(--shadow-sm);
}
.area-stat-tile__value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1;
}
.area-stat-tile__value--clay  { color: var(--clay); }
.area-stat-tile__value--red   { color: #b03a18; }
.area-stat-tile__value--sage  { color: var(--sage); }
.area-stat-tile__label {
    font-size: .7rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
}

/* Section */
.area-section {
    margin-bottom: 2rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    background: var(--paper-raised);
}
.area-section--meta {
    background: var(--clay-soft);
    border-color: rgba(192,86,29,.18);
}
.area-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
}
.area-section-head__left {
    display: flex;
    align-items: center;
    gap: .5rem;
}
.area-section-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
}
.area-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 .4rem;
    border-radius: 999px;
    background: var(--clay-soft);
    color: var(--clay-deep);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .02em;
}

/* Purpose block */
.area-meta-label {
    display: block;
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--clay);
    margin-bottom: .3rem;
}
.area-purpose {
    padding: .6rem .85rem;
    border-left: 3px solid var(--clay);
    background: rgba(255,255,255,.55);
    border-radius: 0 8px 8px 0;
    margin-bottom: .75rem;
}
.area-purpose__text {
    font-size: .9rem;
    color: var(--ink);
    margin: 0;
    line-height: 1.6;
}
.area-description {
    font-size: .88rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
}

/* Row list */
.area-list { display: flex; flex-direction: column; gap: .4rem; }
.area-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .65rem .85rem;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color .15s, box-shadow .15s;
}
.area-row:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
.area-row__info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: .65rem;
    flex-wrap: wrap;
}
.area-row__name {
    font-size: .9rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color .15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
}
.area-row__name:hover { color: var(--clay); text-decoration: underline; }
.area-row__badges { display: flex; flex-wrap: wrap; gap: .3rem; }
.area-row__unlink { flex-shrink: 0; opacity: .35; transition: opacity .15s; }
.area-row:hover .area-row__unlink { opacity: 1; }

/* Badges */
.area-badge {
    display: inline-flex;
    align-items: center;
    padding: .15rem .55rem;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}

/* Status badges */
.area-status--notstarted { background: var(--paper-sunk); color: var(--ink-soft); }
.area-status--active     { background: rgba(111,122,90,.14); color: #4a5c38; }
.area-status--waiting    { background: rgba(205,154,58,.14); color: #7a5c0e; }
.area-status--completed  { background: rgba(192,86,29,.10); color: var(--clay-deep); }
.area-status--archived   { background: var(--paper-sunk); color: var(--ink-faint); }
.area-status--captured   { background: var(--paper-sunk); color: var(--ink-soft); }
.area-status--evaluating { background: rgba(205,154,58,.18); color: #7a5c0e; }
.area-status--incubated  { background: rgba(111,122,90,.18); color: #4a5c38; }
.area-status--committed  { background: rgba(111,122,90,.25); color: #354a28; }
.area-status--rejected   { background: rgba(176,58,24,.10); color: #b03a18; }
.area-status--shipped    { background: rgba(58,123,205,.14); color: #1a5aa0; }

/* Priority badges */
.area-priority--critical { color: #b03a18; background: rgba(176,58,24,.10); }
.area-priority--high     { color: #d4722a; background: rgba(212,114,42,.10); }
.area-priority--medium   { color: #a07820; background: rgba(160,120,32,.10); }
.area-priority--low      { color: var(--sage); background: rgba(111,122,90,.10); }

/* Task status badges (Todo / InProgress / Done reuse the palette above) */
.area-status--todo       { background: var(--paper-sunk); color: var(--ink-soft); }
.area-status--inprogress { background: rgba(58,123,205,.14); color: #1a5aa0; }
.area-status--done       { background: rgba(111,122,90,.14); color: #4a5c38; }

/* Neutral project / due-date badges */
.area-badge--project {
    background: var(--paper-sunk);
    color: var(--ink-faint);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
}
.area-badge--due {
    background: var(--paper-sunk);
    color: var(--ink-faint);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
}
.area-badge--overdue { background: rgba(176,58,24,.12); color: #b03a18; }

/* PARA category badges */
.area-para--project  { background: rgba(192,86,29,.10); color: var(--clay-deep); }
.area-para--area     { background: rgba(111,122,90,.14); color: #4a5c38; }
.area-para--resource { background: rgba(205,154,58,.14); color: #7a5c0e; }
.area-para--archive  { background: var(--paper-sunk); color: var(--ink-faint); }

/* Metadata footer */
.area-meta-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    padding: .5rem .2rem 1.5rem;
    font-size: .78rem;
    color: var(--ink-faint);
}
.area-meta-footer__sep { color: var(--line-strong); }

/* Empty state */
.area-empty {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--ink-faint);
    font-size: .9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
}
.area-empty__icon { font-size: 2rem; opacity: .4; }
.area-empty p { margin: 0; }

/* Inline picker panel */
.area-picker-panel {
    background: var(--paper-sunk);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: .9rem 1rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: .65rem;
}
.area-picker-panel__actions {
    display: flex;
    justify-content: flex-end;
    gap: .5rem;
}
.area-picker-empty {
    font-size: .8rem;
    color: var(--ink-faint);
    margin: 0;
    font-style: italic;
}

@@media (max-width: 640px) {
    .area-title-row  { flex-direction: column; }
    .area-actions    { flex-direction: row; flex-wrap: wrap; }
    .area-stats      { gap: .5rem; }
    .area-stat-tile  { min-width: calc(50% - .375rem); }
    .area-row__name  { max-width: 180px; }
}
</style>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "area-detail",
        PageTitle = "Area Detail",
        Tagline = "Keep one ongoing responsibility connected to its projects, ideas, and notes",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Category,
                Lead = "Use this detail view to manage one area's standards, active project context, ideas, and supporting notes.",
                Points =
                [
                    "Review its purpose, description, active project count, open/overdue task count, note count, and idea count.",
                    "Assign projects to keep time-bound outcomes connected to the responsibility they support.",
                    "Scan the Open Tasks list to see what's still outstanding across every project in this area, with overdue work called out.",
                    "Link notes and browse related ideas so area context stays reusable."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In PARA, an Area is an ongoing responsibility to maintain over time with no deadline — unlike Projects, areas hold standards, not outcomes.",
                Points =
                [
                    "Use the area to preserve standards, reference context, and recurring responsibilities.",
                    "Keep project work time-bound, then let completed outcomes enrich the area over time.",
                    "Review linked material periodically so the area supports active decisions."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use Edit to update the area name, purpose, or description.",
                    "Use Archive or Restore to move the responsibility in or out of active views.",
                    "Click Assign Project, choose a project, and confirm Assign to connect current outcomes.",
                    "Review Ideas or use View All Ideas to jump to the idea workspace.",
                    "Click Link Note, choose an unlinked note, and confirm Link; use the unlink icon to remove stale note connections."
                ]
            }
        ]
    };

    [Parameter] public Guid AreaId { get; set; }

    private bool _loading = true;
    private AreaDetailDto? _detail;

    private List<ProjectSummaryDto>  _linkedProjects    = [];
    private List<ProjectSummaryDto>  _availableProjects = [];
    private List<NoteDto>            _linkedNotes       = [];
    private List<NoteDto>            _availableNotes    = [];
    private IReadOnlyList<IdeaDto>   _areaIdeas         = [];
    private List<AreaTaskRow>        _areaTasks         = [];
    private int                      _overdueTaskCount;

    /// <summary>An open task paired with the name of the project it belongs to, for display in the Area's task list.</summary>
    private sealed record AreaTaskRow(TaskItemDto Item, string ProjectName, Guid ProjectId);

    // Link project picker state
    private bool   _showLinkProjectPicker;
    private Guid?  _selectedProjectId;
    private bool   _savingProjectLink;

    // Link note picker state
    private bool   _showLinkNotePicker;
    private Guid?  _selectedNoteId;
    private bool   _savingNoteLink;

    // Confirmation dialogs
    private MudMessageBox _archiveMsgBox = null!;
    private MudMessageBox _restoreMsgBox = null!;
    private DateTime _today = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _today = (await UserTimeZoneService.GetUserTodayAsync()).Date;
        _loading = true;
        StateHasChanged();

        _detail = await AreaService.GetDetailAsync(AreaId);

        if (_detail is not null)
        {
            var allProjects = await ProjectService.GetProjectSummariesAsync();
            _linkedProjects    = [.. allProjects.Where(p => p.AreaId == AreaId)];
            _availableProjects = [.. allProjects.Where(p => p.AreaId != AreaId && !p.IsArchived)];

            // Archived notes belong to Archives only — they must not surface in this
            // active area view, nor be offered as link candidates.
            var activeNotes = (await NoteService.GetAllAsync())
                .Where(n => !n.IsArchived && n.Status != NoteStatus.Archived)
                .ToList();
            _linkedNotes    = [.. activeNotes.Where(n => n.AreaId == AreaId)];
            _availableNotes = [.. activeNotes.Where(n => n.AreaId is null)];

            _areaIdeas = await IdeaService.GetByAreaAsync(AreaId);

            // Aggregate open (non-Done, non-Archived) top-level tasks across every project
            // linked to this area. Sequential awaits are required: TaskService shares a scoped
            // DbContext that does not support concurrent operations.
            var openTasks = new List<AreaTaskRow>();
            foreach (var project in _linkedProjects)
            {
                var tasks = await TaskService.GetByProjectAsync(project.Id);
                openTasks.AddRange(tasks
                    .Where(t => t.Status is not (TaskItemStatus.Done or TaskItemStatus.Archived))
                    .Select(t => new AreaTaskRow(t, project.Name, project.Id)));
            }

            _areaTasks = [.. openTasks
                .OrderByDescending(r => IsOverdue(r.Item))
                .ThenByDescending(r => r.Item.Priority)
                .ThenBy(r => r.Item.DueDate ?? DateTime.MaxValue)
                .ThenBy(r => r.Item.Title)];
            _overdueTaskCount = _areaTasks.Count(r => IsOverdue(r.Item));
        }

        _loading = false;
    }

    // ── Edit dialog ────────────────────────────────────────────────────────

    private async Task OpenEditDialogAsync()
    {
        var parameters = new DialogParameters<AreaEditorDialog>
        {
            { x => x.AreaId, AreaId }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog   = await DialogService.ShowAsync<AreaEditorDialog>("Edit Area", parameters, options);
        var result   = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    // ── Archive / Restore ──────────────────────────────────────────────────

    private async Task ConfirmArchiveAsync()
    {
        bool? confirmed = await _archiveMsgBox.ShowAsync();
        if (confirmed is not true) return;

        try
        {
            await AreaService.ArchiveAsync(AreaId);
            Snackbar.Add("Area archived.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmRestoreAsync()
    {
        bool? confirmed = await _restoreMsgBox.ShowAsync();
        if (confirmed is not true) return;

        try
        {
            await AreaService.RestoreAsync(AreaId);
            Snackbar.Add("Area restored.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ── Project linking ────────────────────────────────────────────────────

    private void ToggleLinkProjectPicker()
    {
        _showLinkProjectPicker = !_showLinkProjectPicker;
        _selectedProjectId = null;
    }

    private async Task LinkProjectAsync()
    {
        if (_selectedProjectId is null) return;

        _savingProjectLink = true;
        try
        {
            await AreaService.LinkProjectAsync(AreaId, _selectedProjectId.Value);
            Snackbar.Add("Project assigned to this area.", Severity.Success);
            _showLinkProjectPicker = false;
            _selectedProjectId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingProjectLink = false;
        }
    }

    // ── Note linking ───────────────────────────────────────────────────────

    private void ToggleLinkNotePicker()
    {
        _showLinkNotePicker = !_showLinkNotePicker;
        _selectedNoteId = null;
    }

    private async Task LinkNoteAsync()
    {
        if (_selectedNoteId is null) return;

        _savingNoteLink = true;
        try
        {
            await AreaService.LinkNoteAsync(AreaId, _selectedNoteId.Value);
            Snackbar.Add("Note linked.", Severity.Success);
            _showLinkNotePicker = false;
            _selectedNoteId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingNoteLink = false;
        }
    }

    private async Task UnlinkNoteAsync(Guid noteId, string noteTitle)
    {
        try
        {
            await AreaService.UnlinkNoteAsync(noteId);
            Snackbar.Add($"Unlinked \"{noteTitle}\" from area.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ── Display helpers ────────────────────────────────────────────────────

    private static string ProjectStatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.NotStarted => "Not Started",
        ProjectStatus.Active     => "Active",
        ProjectStatus.Blocked    => "Blocked",
        ProjectStatus.Parked     => "Parked",
        ProjectStatus.Completed  => "Completed",
        ProjectStatus.Archived   => "Archived",
        _                        => s.ToString()
    };

    private bool IsOverdue(TaskItemDto t) =>
        t.DueDate.HasValue && t.DueDate.Value.Date < _today.Date && t.Status != TaskItemStatus.Done;

    private static string TaskStatusLabel(TaskItemStatus s) => s switch
    {
        TaskItemStatus.Todo       => "To Do",
        TaskItemStatus.InProgress => "In Progress",
        TaskItemStatus.Waiting    => "Waiting",
        TaskItemStatus.Done       => "Done",
        TaskItemStatus.Archived   => "Archived",
        _                         => s.ToString()
    };

    private static string TaskPriorityLabel(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "Critical",
        TaskPriority.High     => "High",
        TaskPriority.Medium   => "Medium",
        TaskPriority.Low      => "Low",
        _                     => p.ToString()
    };

    private static string PriorityLabel(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "Critical",
        ProjectPriority.High     => "High",
        ProjectPriority.Medium   => "Medium",
        ProjectPriority.Low      => "Low",
        _                        => p.ToString()
    };

    private static string ParaCategoryLabel(ParaCategory c) => c switch
    {
        ParaCategory.Project  => "Project",
        ParaCategory.Area     => "Area",
        ParaCategory.Resource => "Resource",
        ParaCategory.Archive  => "Archive",
        _                     => c.ToString()
    };
}
