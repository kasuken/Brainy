@page "/areas"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.Interfaces.Services
@inject IAreaService AreaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Areas — Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    .ap-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .ap-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .ap-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .ap-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: ap-fade-up 0.4s ease both;
    }

    @@keyframes ap-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .ap-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .ap-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .ap-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }

    .ap-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .ap-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
    }

    .ap-filter-label {
        width: 100%;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .ap-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ap-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .ap-chip--on {
        background: rgba(192, 86, 29, 0.1);
        border-color: rgba(192, 86, 29, 0.3);
        color: var(--clay, #ed6c02);
    }

    /* ── Main Area ── */
    .ap-main {
        animation: ap-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .ap-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    @@keyframes ap-card-in {
        from { opacity: 0; transform: translateY(15px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Area Card ── */
    .ap-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .ap-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
        border-color: rgba(237, 108, 2, 0.25);
    }

    .ap-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: var(--mud-palette-lines-default);
        transition: background 0.3s ease, opacity 0.3s ease;
        opacity: 0.5;
    }

    .ap-card:hover::before {
        background: #ed6c02;
        opacity: 1;
    }

    .ap-card--archived {
        opacity: 0.7;
    }
    
    .ap-card--archived:hover::before {
        background: var(--mud-palette-text-disabled);
    }

    .ap-card-actions {
        display: flex;
        gap: 0.25rem;
        position: absolute;
        top: 1rem; right: 1rem;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .ap-card:hover .ap-card-actions {
        opacity: 1;
    }

    .ap-action-btn {
        background: var(--mud-palette-background);
        border: 1px solid var(--mud-palette-lines-default);
        color: var(--mud-palette-text-secondary);
        width: 32px; height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .ap-action-btn:hover {
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border-color: var(--mud-palette-text-primary);
    }

    .ap-action-btn--delete:hover {
        color: #d32f2f;
        border-color: #d32f2f;
    }

    .ap-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        padding-right: 4rem; /* keep away from actions */
    }

    .ap-card-icon {
        color: var(--mud-palette-text-disabled);
    }

    .ap-card:hover .ap-card-icon {
        color: #ed6c02;
    }

    .ap-card-title {
        font-family: 'Fraunces', serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin: 0;
        line-height:1.2;
    }

    .ap-card-desc {
        font-size: 0.9rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 1.5rem;
        line-height: 1.5;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ap-card-meta {
        font-size: 0.75rem;
        color: var(--mud-palette-text-disabled);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }
</style>

<div class="ap-page">
    <div class="ap-layout">

        @* ── Sidebar ── *@
        <aside class="ap-sidebar">
            <p class="ap-eyebrow">Portfolio</p>
            <h1 class="ap-title">Areas</h1>
            <p class="ap-meta">@(_areas?.Count ?? 0) areas total · @(_filtered?.Count ?? 0) shown</p>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Large"
                       Class="mb-6"
                       Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                       FullWidth="true"
                       OnClick="OpenCreateDialog">
                New Area
            </MudButton>

            <div class="ap-widget">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search areas…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@(() => ApplyFilter())"
                              OnKeyUp="@(() => ApplyFilter())"    
                              Class="mb-5" />

                <div class="ap-filter-label">Status</div>
                <div class="ap-filter-group">
                    <button class="ap-chip @(_showArchived ? "ap-chip--on" : "")"
                            @onclick="ToggleArchived">
                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Style="font-size:.85rem" />
                        Show Archived
                    </button>
                </div>

                <div class="ap-filter-label">Sort By</div>
                <div class="ap-filter-group" style="margin-bottom:0;">
                    @foreach (var opt in SortOptions)
                    {
                        <button class="ap-chip @(_sortBy == opt ? "ap-chip--on" : "")"
                                @onclick="() => SetSort(opt)">
                            @opt
                            @if (_sortBy == opt)
                            {
                                <span style="opacity:0.7; font-size:0.7rem;">@(_sortAsc ? "↑" : "↓")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="ap-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Loading areas…</p>
                </div>
            }
            else if (_filtered is { Count: 0 })
            {
                <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderSpecial" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                    <h2 style="font-family: 'Fraunces', serif; font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                        @(_areas?.Count == 0 ? "No areas yet" : "Nothing matches")
                    </h2>
                    <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                        @(_areas?.Count == 0
                            ? "Areas represent ongoing responsibilities — health, finances, work."
                            : "Try broadening your search or clearing filters.")
                    </p>
                    @if (_areas?.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Create your first area
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <div class="ap-grid">
                    @for (int i = 0; i < (_filtered?.Count ?? 0); i++)
                    {
                        var a = _filtered![i];
                        var idx = i;
                        <div class="ap-card @(a.IsArchived ? "ap-card--archived" : "")" 
                             style="animation-delay:@(idx * 35)ms; animation: ap-card-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;"
                             @onclick="() => OpenDetail(a.Id)">
                             
                            <div class="ap-card-actions">
                                <button class="ap-action-btn" title="Edit" @onclick="() => OpenEditDialog(a)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                </button>
                                @if (a.IsArchived)
                                {
                                    <button class="ap-action-btn" title="Restore" @onclick="() => ConfirmRestore(a.Id, a.Name)" @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Outlined.RestorePage" Size="Size.Small" />
                                    </button>
                                }
                                else
                                {
                                    <button class="ap-action-btn" title="Archive" @onclick="() => ConfirmArchive(a.Id, a.Name)" @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" />
                                    </button>
                                }
                                <button class="ap-action-btn ap-action-btn--delete" title="Delete" @onclick="() => ConfirmDelete(a.Id, a.Name)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
                                </button>
                            </div>
                            
                            <div class="ap-card-header">
                                @if (a.IsArchived)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Medium" Class="ap-card-icon" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Size="Size.Medium" Class="ap-card-icon" />
                                }
                                <h3 class="ap-card-title">@a.Name</h3>
                            </div>
                            <p class="ap-card-desc">@(string.IsNullOrWhiteSpace(a.Description) ? "No description" : a.Description)</p>
                            
                            <div class="ap-card-meta">
                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                                <span>Updated @a.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    private bool _loading = true;
    private List<AreaDto>? _areas;
    private List<AreaDto>? _filtered;

    private string _searchText = "";
    private bool _showArchived;
    private string _sortBy = "Name";
    private bool _sortAsc = true;

    private static readonly string[] SortOptions = ["Name", "Created"];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = _showArchived
            ? await AreaService.GetAllArchivedAsync()
            : await AreaService.GetAllActiveAsync();
        _areas = result.ToList();
        ApplyFilter();
        _loading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _searchText = "";
        ApplyFilter();
    }

    private async Task ToggleArchived()
    {
        _showArchived = !_showArchived;
        await LoadAsync();
    }

    private void ApplyFilter()
    {
        IEnumerable<AreaDto> q = _areas ?? [];

        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(a =>
                a.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (a.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Purpose?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));

        q = _sortBy switch
        {
            "Created" => _sortAsc
                ? q.OrderBy(a => a.CreatedAtUtc)
                : q.OrderByDescending(a => a.CreatedAtUtc),
            _ => _sortAsc
                ? q.OrderBy(a => a.Name)
                : q.OrderByDescending(a => a.Name),
        };

        _filtered = q.ToList();
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/areas/{id}");

    private void SetSort(string option)
    {
        if (_sortBy == option) _sortAsc = !_sortAsc;
        else { _sortBy = option; _sortAsc = true; }
        ApplyFilter();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<AreaEditorDialog>();
        parameters.Add(x => x.AreaId, null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AreaEditorDialog>("New Area", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialog(AreaDto area)
    {
        var parameters = new DialogParameters<AreaEditorDialog>();
        parameters.Add(x => x.AreaId, area.Id);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AreaEditorDialog>("Edit Area", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmArchive(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Archive area",
            $"Archive \"{name}\"? It will be hidden from active views.",
            yesText: "Archive", cancelText: "Cancel");

        if (box == true)
        {
            await AreaService.ArchiveAsync(id);
            Snackbar.Add($"\"{name}\" archived.", Severity.Info);
            await LoadAsync();
        }
    }

    private async Task ConfirmRestore(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Restore area",
            $"Restore \"{name}\" to active areas?",
            yesText: "Restore", cancelText: "Cancel");

        if (box == true)
        {
            await AreaService.RestoreAsync(id);
            Snackbar.Add($"\"{name}\" restored.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ConfirmDelete(Guid id, string name)
    {
        var box = await DialogService.ShowMessageBox(
            "Delete area",
            $"Permanently delete \"{name}\"? This cannot be undone.",
            yesText: "Delete", noText: "Cancel");

        if (box == true)
        {
            await AreaService.DeleteAsync(id);
            Snackbar.Add($"\"{name}\" deleted.", Severity.Warning);
            await LoadAsync();
        }
    }
}

