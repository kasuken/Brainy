    private Task<IEnumerable<NoteDto>> SearchNotesAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_allNotes.Take(10).AsEnumerable());

        var results = _allNotes
            .Where(n => n.Title.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(10);

        return Task.FromResult(results);
    }

    private async Task AddSelectedNoteAsync()
    {
        if (_selectedNote is null) return;

        _addingNote = true;
        try
        {
            await OutputService.AddSourceNoteAsync(Id, _selectedNote.Id);
            Snackbar.Add($"\"{_selectedNote.Title}\" added as source.", Severity.Success);
            _selectedNote = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _addingNote = false;
        }
    }

