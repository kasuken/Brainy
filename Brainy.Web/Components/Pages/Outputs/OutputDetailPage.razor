@page "/outputs/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Outputs
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Security
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IOutputService OutputService
@inject INoteService NoteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_detail?.Title ?? "Output") — Brainy</PageTitle>

@if (_loading)
{
    <div class="od-loading">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_detail is null)
{
    <div class="od-notfound">
        <span class="od-notfound__glyph">◈</span>
        <p class="od-notfound__title">Output not found</p>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick='() => Nav.NavigateTo("/outputs")'>
            Back to Outputs
        </MudButton>
    </div>
}
else
{
    <!-- ── Header ──────────────────────────────────────────────────── -->
    <div class="od-header">
        <div class="od-breadcrumb">
            <button type="button" class="od-back" @onclick='() => Nav.NavigateTo("/outputs")'>
                <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
                Outputs
            </button>
            <span class="od-breadcrumb__sep">›</span>
            <span class="od-breadcrumb__current">@_detail.Title</span>
        </div>

        <div class="od-title-row">
            <div class="od-title-block">
                <div class="od-title-top">
                    <h1 class="od-title">@_detail.Title</h1>
                    <PageHelpButton Guide="HelpGuide" />
                    <span class="od-badge od-badge-type">@OutputEditorDialog.FormatType(_detail.Type)</span>
                    <span class="od-badge od-status--@_detail.Status.ToString().ToLowerInvariant()">
                        @OutputEditorDialog.FormatStatus(_detail.Status)
                    </span>
                    @if (_detail.IsAiGenerated)
                    {
                        <span class="od-badge" style="background:rgba(103,58,183,.1);color:#4527a0;border:1px solid rgba(103,58,183,.2);">
                            AI Generated
                        </span>
                    }
                    @if (_detail.IsArchived)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Archived</MudChip>
                    }
                </div>
                <div class="od-meta-row">
                    @if (!string.IsNullOrWhiteSpace(_detail.AreaName))
                    {
                        <span class="od-meta-item">
                            <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Style="font-size:0.75rem;opacity:.6;" />
                            @_detail.AreaName
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.ProjectTitle))
                    {
                        <span class="od-meta-item">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Style="font-size:0.75rem;opacity:.6;" />
                            @_detail.ProjectTitle
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.GoalTitle))
                    {
                        <span class="od-meta-item">
                            <MudIcon Icon="@Icons.Material.Outlined.Flag" Style="font-size:0.75rem;opacity:.6;" />
                            @_detail.GoalTitle
                        </span>
                    }
                    <span class="od-meta-item">Created <UserLocalTime Utc="_detail.CreatedAtUtc" /></span>
                    <span class="od-meta-item">Updated <UserLocalTime Utc="_detail.UpdatedAtUtc" /></span>
                    @if (_detail.PublishedDate.HasValue)
                    {
                        <span class="od-meta-item" style="color:#1b5e20;">
                            Published <UserLocalTime Utc="_detail.PublishedDate" />
                        </span>
                    }
                    @if (_detail.IsAiGenerated && !string.IsNullOrWhiteSpace(_detail.Model))
                    {
                        <span class="od-meta-item">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size:0.75rem;opacity:.6;" />
                            Model @_detail.Model
                        </span>
                    }
                    @if (_detail.IsAiGenerated && !string.IsNullOrWhiteSpace(_detail.PromptVersion))
                    {
                        <span class="od-meta-item">Prompt @_detail.PromptVersion</span>
                    }
                    @if (_detail.IsArchived && _detail.ArchivedDate.HasValue)
                    {
                        <span class="od-meta-item" style="color:#9c4416;">
                            Archived <UserLocalTime Utc="_detail.ArchivedDate" />
                        </span>
                    }
                </div>
            </div>

            <div class="od-actions">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Edit"
                           Size="Size.Small"
                           OnClick="OpenEditDialogAsync">
                    Edit
                </MudButton>

                @if (!_detail.IsArchived && _detail.Status != OutputStatus.Published)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Outlined.Publish"
                               Size="Size.Small"
                               Disabled="_saving"
                               OnClick="ConfirmPublishAsync">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Publish
                    </MudButton>
                }

                @if (_detail.IsArchived)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Unarchive"
                               Size="Size.Small" OnClick="ConfirmRestoreAsync"
                               Disabled="_saving">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Archive"
                               Size="Size.Small" OnClick="ConfirmArchiveAsync"
                               Disabled="_saving">
                        Archive
                    </MudButton>
                }
            </div>
        </div>
    </div>

    <!-- ── Description ──────────────────────────────────────────── -->
    @if (!string.IsNullOrWhiteSpace(_detail.Description))
    {
        <MudPaper Class="od-description-panel" Elevation="0">
            <p class="od-description-text">@_detail.Description</p>
        </MudPaper>
    }

    <!-- ── Content ──────────────────────────────────────────────── -->
    <MudPaper Class="od-content-panel" Elevation="0">
        <div class="od-content-toolbar">
            <h2 class="od-section-label od-section-label--heading">Content</h2>
            @if (!string.IsNullOrWhiteSpace(_detail.Content))
            {
                <div class="od-content-actions" aria-label="Output content actions">
                    <div class="od-view-toggle" role="group" aria-label="Content view">
                        <button type="button"
                                class="od-view-toggle__button @(!_showRawMarkdown ? "is-active" : null)"
                                aria-pressed="@(!_showRawMarkdown)"
                                @onclick="() => _showRawMarkdown = false">
                            Preview
                        </button>
                        <button type="button"
                                class="od-view-toggle__button @(_showRawMarkdown ? "is-active" : null)"
                                aria-pressed="@_showRawMarkdown"
                                @onclick="() => _showRawMarkdown = true">
                            Raw
                        </button>
                    </div>
                    <button type="button" class="od-content-action" @onclick="CopyContentAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                        Copy
                    </button>
                    <a class="od-content-action"
                       href="@DownloadHref"
                       download="@DownloadFileName"
                       aria-label="Download output as Markdown">
                        <MudIcon Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                        Download .md
                    </a>
                </div>
            }
        </div>
        @if (string.IsNullOrWhiteSpace(_detail.Content))
        {
            <p style="color:var(--mud-palette-text-disabled); font-style: italic;">No content yet. Edit this output to add content.</p>
        }
        else if (_showRawMarkdown)
        {
            <pre class="od-content-pre">@_detail.Content</pre>
        }
        else
        {
            <div class="od-content-markdown">@RenderMarkdown(_detail.Content)</div>
        }
    </MudPaper>

    <!-- ── Source Notes ─────────────────────────────────────────── -->
    <MudPaper Class="od-section-panel" Elevation="0">
        <h2 class="od-section-label od-section-label--section-heading">Source Notes</h2>

        @if (_detail.SourceNotes.Count == 0)
        {
            <p style="color:var(--mud-palette-text-disabled); font-size:0.9rem; margin-bottom:1rem;">No source notes linked yet.</p>
        }
        else
        {
            <div class="od-note-list">
                @foreach (var note in _detail.SourceNotes)
                {
                    <div class="od-note-item">
                        <MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Small" Style="opacity:.6;" />
                        <span class="od-note-title">@note.NoteTitle</span>
                        <span class="od-note-date"><UserLocalTime Utc="note.CreatedAtUtc" /></span>
                        <button type="button" class="od-note-remove"
                                aria-label="Remove @note.NoteTitle from source notes"
                                @onclick="() => RemoveSourceNoteAsync(note.NoteId)">
                            <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                        </button>
                    </div>
                }
            </div>
        }

        <!-- Add Note picker -->
        <div class="od-add-note-row">
            <MudAutocomplete T="NoteDto"
                             @bind-Value="_selectedNote"
                             SearchFunc="SearchNotesAsync"
                             ToStringFunc="@(n => n?.Title ?? "")"
                             Label="Add source note"
                             Placeholder="Search by title…"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Dense="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             Style="flex:1;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       Disabled="_selectedNote is null || _addingNote"
                       OnClick="AddSelectedNoteAsync">
                @if (_addingNote)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Add
            </MudButton>
        </div>
    </MudPaper>
}

<!-- Archive confirmation -->
<MudMessageBox @ref="_archiveMsgBox" Title="Archive Output?" CancelText="Cancel">
    <MessageContent>
        Archiving <strong>@_detail?.Title</strong> will hide it from active views. You can restore it at any time.
    </MessageContent>
    <YesButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled">Archive</MudButton>
    </YesButton>
</MudMessageBox>

<!-- Restore confirmation -->
<MudMessageBox @ref="_restoreMsgBox" Title="Restore Output?" CancelText="Cancel">
    <MessageContent>
        Restore <strong>@_detail?.Title</strong> back to active outputs?
    </MessageContent>
    <YesButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled">Restore</MudButton>
    </YesButton>
</MudMessageBox>

<!-- Publish confirmation -->
<MudMessageBox @ref="_publishMsgBox" Title="Publish Output?" CancelText="Cancel">
    <MessageContent>
        Publish <strong>@_detail?.Title</strong>? This will mark it as Published.
    </MessageContent>
    <YesButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled">
            <MudIcon Icon="@Icons.Material.Outlined.Publish" Class="mr-1" />Publish
        </MudButton>
    </YesButton>
</MudMessageBox>

<style>
/* Theme variables (--font-display, --font-body, --clay, --ink, --line, ...)
   are inherited from brainy-design.css so this page follows the active theme. */

body { font-family: var(--font-body); }

.od-loading, .od-notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 6rem 1rem;
}
.od-notfound__glyph { font-size: 3rem; opacity: .15; font-family: var(--font-display); color: var(--clay); }
.od-notfound__title { font-family: var(--font-display); font-size: 1.4rem; color: var(--ink); margin: 0; }

.od-breadcrumb {
    display: flex; align-items: center; gap: .4rem;
    margin-bottom: 1rem; font-size: .8rem; color: var(--ink-faint);
}
.od-back {
    background: none; border: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: .3rem;
    color: var(--clay); font-family: var(--font-body);
    font-size: .8rem; font-weight: 600; padding: 0; transition: opacity .15s;
}
.od-back:hover { opacity: .7; }
.od-breadcrumb__sep { color: var(--line); }
.od-breadcrumb__current { color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px; }

.od-header { margin-bottom: 1.5rem; }
.od-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
.od-title-block { flex: 1; min-width: 0; }
.od-title-top { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .5rem; }
.od-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    margin: 0;
    letter-spacing: -.02em;
    line-height: 1.15;
}

.od-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: .3rem; }
.od-meta-item { font-size: .75rem; color: var(--ink-faint); display: inline-flex; align-items: center; gap: .25rem; }

.od-badge {
    display: inline-flex; align-items: center;
    padding: 0.2rem 0.55rem; border-radius: 6px;
    font-size: 0.65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;
}
.od-badge-type { background: var(--paper-sunk); color: var(--ink-soft); border: 1px solid var(--line); }
.od-status--draft     { background: var(--paper-sunk); color: var(--ink-soft); border: 1px solid var(--line); }
.od-status--inreview  { background: rgba(237,108,2,.12); color: #b06000; border: 1px solid rgba(237,108,2,.2); }
.od-status--ready     { background: rgba(2,136,209,.12); color: #0277bd; border: 1px solid rgba(2,136,209,.2); }
.od-status--published { background: rgba(46,125,50,.12); color: #1b5e20; border: 1px solid rgba(46,125,50,.2); }
.od-status--archived  { background: var(--paper-sunk); color: var(--ink-faint); border: 1px solid var(--line); }

.od-actions { display: flex; flex-direction: column; gap: .4rem; flex-shrink: 0; }

.od-description-panel {
    background: var(--paper-sunk) !important;
    border: 1px solid var(--line) !important;
    border-radius: 12px !important;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
}
.od-description-text { margin: 0; color: var(--ink-soft); line-height: 1.65; }

.od-content-panel, .od-section-panel {
    background: var(--paper-raised) !important;
    border: 1px solid var(--line) !important;
    border-radius: 14px !important;
    padding: 1.25rem 1.4rem;
    margin-bottom: 1.25rem;
}

.od-section-label {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-faint);
    margin-bottom: 0.75rem; padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
}

.od-content-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .9rem;
    padding-bottom: .55rem;
    border-bottom: 1px solid var(--line);
}
.od-section-label--heading { margin: 0; padding: 0; border: 0; }
.od-section-label--section-heading { margin-top: 0; }
.od-content-actions { display: flex; align-items: center; justify-content: flex-end; gap: .45rem; flex-wrap: wrap; }
.od-view-toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
.od-view-toggle__button, .od-content-action {
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    font: 600 .75rem/1 var(--font-body);
    cursor: pointer;
}
.od-view-toggle__button { padding: .48rem .65rem; }
.od-view-toggle__button + .od-view-toggle__button { border-left: 1px solid var(--line); }
.od-view-toggle__button.is-active { color: var(--clay); background: var(--paper-sunk); }
.od-content-action {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .42rem .55rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    text-decoration: none;
}
.od-view-toggle__button:hover, .od-content-action:hover { color: var(--clay); background: var(--paper-sunk); }
.od-view-toggle__button:focus-visible, .od-content-action:focus-visible, .od-back:focus-visible, .od-note-remove:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--clay) 45%, transparent);
    outline-offset: 2px;
}

.od-content-pre {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink);
    margin: 0;
    background: none;
    border: none;
    padding: 0;
}

.od-content-markdown { color: var(--ink); font-size: .95rem; line-height: 1.7; overflow-wrap: anywhere; }
.od-content-markdown :first-child { margin-top: 0; }
.od-content-markdown :last-child { margin-bottom: 0; }
.od-content-markdown h1, .od-content-markdown h2, .od-content-markdown h3,
.od-content-markdown h4, .od-content-markdown h5, .od-content-markdown h6 {
    color: var(--ink);
    font-family: var(--font-display);
    line-height: 1.25;
    margin: 1.25em 0 .5em;
}
.od-content-markdown a { color: var(--clay); text-decoration-thickness: .08em; text-underline-offset: .15em; }
.od-content-markdown blockquote { margin: 1rem 0; padding: .15rem 1rem; border-left: 3px solid var(--clay); color: var(--ink-soft); }
.od-content-markdown code { padding: .1rem .3rem; border-radius: 4px; background: var(--paper-sunk); }
.od-content-markdown pre { padding: 1rem; border-radius: 8px; overflow-x: auto; background: var(--paper-sunk); border: 1px solid var(--line); }
.od-content-markdown pre code { padding: 0; background: transparent; }
.od-content-markdown table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
.od-content-markdown th, .od-content-markdown td { padding: .45rem .65rem; border: 1px solid var(--line); text-align: left; }

.od-note-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
.od-note-item {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.875rem;
}
.od-note-title { flex: 1; color: var(--ink); font-weight: 500; }
.od-note-date { font-size: 0.75rem; color: var(--ink-faint); white-space: nowrap; }
.od-note-remove {
    background: none; border: none; cursor: pointer;
    color: var(--ink-faint); padding: 0; display: flex; align-items: center;
    transition: color 0.2s;
}
.od-note-remove:hover { color: #d32f2f; }

.od-add-note-row { display: flex; align-items: flex-end; gap: 0.75rem; margin-top: 0.75rem; }

@@media (max-width: 640px) {
    .od-title-row { flex-direction: column; }
    .od-actions { flex-direction: row; flex-wrap: wrap; }
    .od-breadcrumb__current { max-width: 160px; }
    .od-add-note-row { flex-direction: column; align-items: stretch; }
    .od-content-toolbar { align-items: flex-start; flex-direction: column; }
    .od-content-actions { justify-content: flex-start; }
}
</style>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "output-detail",
        PageTitle = "Output Detail",
        Tagline = "Shape one deliverable from source notes to published work",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Output,
                Lead = "Output Detail is the workspace for shaping one deliverable from content and linked source notes through publishable status.",
                Points =
                [
                    "Review type, status, AI-generated marker, and project or area context.",
                    "Read the description and current content in focused panels.",
                    "Connect source notes so the output remains grounded in your second brain.",
                    "Edit, publish, archive, or restore the output from the header."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "This is the EXPRESS phase of CODE — knowledge is only valuable when reused to CREATE something; assemble distilled notes into real deliverables.",
                Points =
                [
                    "Use source notes as ingredients, not an archive to admire.",
                    "Keep provenance visible by linking the notes that informed the output.",
                    "Publishing marks when reused knowledge becomes a finished contribution."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use Edit to update the output title, description, type, status, and content.",
                    "Read Content to check the current draft or final text.",
                    "Search Add source note and click Add to link supporting notes.",
                    "Remove a source note if it no longer belongs in the deliverable.",
                    "Publish when ready, or Archive and Restore to manage the output lifecycle."
                ]
            }
        ]
    };

    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _showRawMarkdown;
    private OutputDetailDto? _detail;

    private List<NoteDto> _allNotes = [];
    private NoteDto? _selectedNote;
    private bool _addingNote;

    private MudMessageBox _archiveMsgBox = null!;
    private MudMessageBox _restoreMsgBox = null!;
    private MudMessageBox _publishMsgBox = null!;

    private string DownloadHref => $"data:text/markdown;charset=utf-8,{Uri.EscapeDataString(_detail?.Content ?? string.Empty)}";

    private string DownloadFileName
    {
        get
        {
            var title = string.IsNullOrWhiteSpace(_detail?.Title) ? "output" : _detail.Title;
            var invalidCharacters = Path.GetInvalidFileNameChars();
            var safeTitle = new string(title.Where(character => !invalidCharacters.Contains(character)).ToArray()).Trim();
            return $"{(string.IsNullOrWhiteSpace(safeTitle) ? "output" : safeTitle)}.md";
        }
    }

    private static MarkupString RenderMarkdown(string content) =>
        new(MarkdownHtmlRenderer.Render(content));

    private async Task CopyContentAsync()
    {
        if (string.IsNullOrWhiteSpace(_detail?.Content))
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _detail.Content);
            Snackbar.Add("Output copied to the clipboard.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("The browser blocked clipboard access. Switch to Raw and copy the content manually.", Severity.Warning);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var notes = await NoteService.GetAllAsync();
        _allNotes = notes
            .Where(note => !note.IsArchived && note.Status != NoteStatus.Archived)
            .ToList();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _detail = await OutputService.GetDetailAsync(Id);
        _loading = false;
        StateHasChanged();
    }

    private async Task OpenEditDialogAsync()
    {
        if (_detail is null) return;

        // Convert detail to summary DTO for the editor
        var summaryDto = new OutputDto(
            _detail.Id, _detail.Title, _detail.Description, _detail.Type, _detail.Status,
            _detail.IsAiGenerated, _detail.IsArchived, _detail.ProjectId, _detail.ProjectTitle,
            _detail.AreaId, _detail.AreaName, _detail.GoalId, _detail.GoalTitle,
            _detail.PublishedDate, _detail.ArchivedDate, _detail.CreatedAtUtc, _detail.UpdatedAtUtc,
            _detail.RowVersion);

        var parameters = new DialogParameters<OutputEditorDialog>();
        parameters.Add(x => x.ExistingOutput, summaryDto);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<OutputEditorDialog>("Edit Output", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmPublishAsync()
    {
        var confirmed = await _publishMsgBox.ShowAsync();
        if (confirmed == true)
        {
            _saving = true;
            try
            {
                await OutputService.PublishAsync(Id);
                Snackbar.Add("Output published.", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                _saving = false;
            }
        }
    }

