@using Brainy.Application.DTOs.Outputs
@using Brainy.Application.Interfaces.Services
@using Brainy.Web.Configuration
@inject IOutputShareLinkService ShareLinkService
@inject SeoOptions SeoOptions
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-family:var(--font-display)">Share link</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="osd-loading"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
        }
        else
        {
            <p class="osd-lead">
                Anyone with this link can view a read-only copy of <strong>@OutputTitle</strong>.
                No sign-in, project, task, or note details are ever shown — only this output's own content.
            </p>

            @if (_rawLink is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">
                    Copy this link now — for your security it will not be shown again. Revoke and re-enable to get a new one.
                </MudAlert>
                <MudTextField T="string" Value="@_rawLink" ReadOnly="true" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Label="Public link"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.ContentCopy"
                              OnAdornmentClick="CopyLinkAsync" />
            }
            else if (_status is { IsActive: true })
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                    A share link is active. The link itself is only ever shown once, right after you enable or regenerate it — if you no longer have it, regenerate to get a new one.
                </MudAlert>
            }

            @if (_status is not null)
            {
                <div class="osd-status">
                    <span class="osd-status__badge @(_status.IsActive ? "is-active" : "is-inactive")">
                        @(_status.IsActive ? "Active" : "Not shared")
                    </span>
                    @if (_status.CreatedAtUtc.HasValue)
                    {
                        <span class="osd-status__item">Created <UserLocalTime Utc="_status.CreatedAtUtc" /></span>
                    }
                    @if (_status.ExpiresAtUtc.HasValue)
                    {
                        <span class="osd-status__item">Expires <UserLocalTime Utc="_status.ExpiresAtUtc" /></span>
                    }
                    @if (_status.LastAccessedAtUtc.HasValue)
                    {
                        <span class="osd-status__item">Last viewed <UserLocalTime Utc="_status.LastAccessedAtUtc" /></span>
                    }
                    @if (_status.RevokedAtUtc.HasValue && !_status.IsActive)
                    {
                        <span class="osd-status__item">Revoked <UserLocalTime Utc="_status.RevokedAtUtc" /></span>
                    }
                </div>
            }

            <MudSelect T="int" @bind-Value="_expiryOption" Label="Expiry (applies next time you enable or regenerate)"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                <MudSelectItem Value="0">Never</MudSelectItem>
                <MudSelectItem Value="7">7 days</MudSelectItem>
                <MudSelectItem Value="30">30 days</MudSelectItem>
                <MudSelectItem Value="90">90 days</MudSelectItem>
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>
        @if (_status is { IsActive: true })
        {
            <MudButton OnClick="RevokeAsync" Color="Color.Error" Variant="Variant.Outlined" Disabled="_saving">
                Revoke
            </MudButton>
            <MudButton OnClick="EnableAsync" Color="Color.Primary" Variant="Variant.Outlined" Disabled="_saving">
                Regenerate
            </MudButton>
        }
        else
        {
            <MudButton OnClick="EnableAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Enable sharing
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
.osd-loading { display: flex; justify-content: center; padding: 2rem; }
.osd-lead { color: var(--ink-soft); font-size: .9rem; line-height: 1.6; margin: 0 0 1rem; }
.osd-status { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; font-size: .8rem; color: var(--ink-faint); margin-bottom: .5rem; }
.osd-status__badge { padding: .2rem .55rem; border-radius: 6px; font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.osd-status__badge.is-active { background: rgba(46,125,50,.12); color: #1b5e20; border: 1px solid rgba(46,125,50,.2); }
.osd-status__badge.is-inactive { background: var(--paper-sunk); color: var(--ink-soft); border: 1px solid var(--line); }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public Guid OutputId { get; set; }

    [Parameter, EditorRequired] public string OutputTitle { get; set; } = string.Empty;

    /// <summary>True if the dialog changed the share link's state, so the caller can refresh its indicator.</summary>
    public bool Changed { get; private set; }

    private bool _loading = true;
    private bool _saving;
    private OutputShareLinkStatusDto? _status;
    private string? _rawLink;
    private int _expiryOption;

    protected override async Task OnInitializedAsync()
    {
        _status = await ShareLinkService.GetStatusAsync(OutputId);
        _loading = false;
    }

    private DateTime? ResolveExpiry() =>
        _expiryOption <= 0 ? null : DateTime.UtcNow.AddDays(_expiryOption);

    private async Task EnableAsync()
    {
        _saving = true;
        try
        {
            var created = await ShareLinkService.EnableAsync(OutputId, ResolveExpiry());
            var origin = SeoOptions.SiteOrigin.TrimEnd('/');
            _rawLink = $"{origin}/share?token={created.RawToken}";
            _status = await ShareLinkService.GetStatusAsync(OutputId);
            Changed = true;
            Snackbar.Add("Share link enabled. Copy it now — it will not be shown again.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevokeAsync()
    {
        _saving = true;
        try
        {
            await ShareLinkService.RevokeAsync(OutputId);
            _rawLink = null;
            _status = await ShareLinkService.GetStatusAsync(OutputId);
            Changed = true;
            Snackbar.Add("Share link revoked.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        if (_rawLink is null) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _rawLink);
            Snackbar.Add("Link copied to the clipboard.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("The browser blocked clipboard access. Select and copy the link manually.", Severity.Warning);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(Changed));
}
