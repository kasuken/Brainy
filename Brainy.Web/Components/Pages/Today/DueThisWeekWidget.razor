@using Brainy.Application.DTOs.Tasks
@using Brainy.Domain.Enums

@* ─────────────────────────────────────────────────────────────────────────────
   DueThisWeekWidget — tasks due within the next 6 days.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-widget td-section">
    <div class="td-section-head">
        <span class="td-section-label td-section-label--week">This week</span>
        <span class="td-section-count">@Tasks.Count task@(Tasks.Count == 1 ? "" : "s")</span>
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        @if (Tasks.Count == 0)
        {
            <p class="td-empty">Nothing due this week.</p>
        }
        else
        {
            @foreach (var t in Tasks)
            {
                <TodayTaskCard Task="t"
                               DueText="@(t.DueDate?.ToString("ddd, MMM d"))"
                               OnComplete="OnComplete"
                               OnReopen="OnReopen"
                               OnSetInProgress="OnSetInProgress"
                               OnEdit="OnEdit" />
            }
        }
    }
</div>

@code {
    /// <summary>Tasks due within the next 6 days (excluding today).</summary>
    [Parameter] public IReadOnlyList<TodayTaskItemDto> Tasks { get; set; } = [];

    /// <summary>Raised with the task ID when the user marks a task complete.</summary>
    [Parameter] public EventCallback<Guid> OnComplete { get; set; }

    /// <summary>Raised with a subtask ID when the user unchecks a completed subtask.</summary>
    [Parameter] public EventCallback<Guid> OnReopen { get; set; }

    /// <summary>Raised with the task ID when the user sets a task as In Progress.</summary>
    [Parameter] public EventCallback<Guid> OnSetInProgress { get; set; }

    /// <summary>Raised with the selected task when the user wants to edit it.</summary>
    [Parameter] public EventCallback<TodayTaskItemDto> OnEdit { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;

    protected override void OnInitialized() => _collapsed = Collapsed;

}
