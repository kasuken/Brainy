@using Brainy.Application.DTOs.Tasks
@using Brainy.Domain.Enums

@* ─────────────────────────────────────────────────────────────────────────────
   HighPriorityProjectWorkWidget — high-priority tasks from priority projects.
   Order: overdue → due today → critical → high → by due date.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-widget td-section">
    <div class="td-section-head">
        <span class="td-section-label" style="color:var(--clay-deep);">Priority work</span>
        <span class="td-section-count">@Tasks.Count task@(Tasks.Count == 1 ? "" : "s")</span>
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        @if (Tasks.Count == 0)
        {
            <p class="td-empty">No high-priority work right now.</p>
        }
        else
        {
            @foreach (var t in OrderedTasks)
            {
                var isOverdue = t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today;
                <div class="td-task @PriorityClass(t.Priority) @(isOverdue ? "td-task--overdue" : "")">
                    <div class="td-task-body">
                        <p class="td-task-title">@t.Title</p>
                        <div class="td-task-meta">
                            <span class="td-task-project">@t.ProjectName</span>
                            <MudChip T="string" Size="Size.Small" Color="@PriorityColor(t.Priority)" Variant="Variant.Outlined">
                                @t.Priority.ToString()
                            </MudChip>
                            @if (t.DueDate.HasValue)
                            {
                                <span class="td-task-due @(isOverdue ? "td-task-due--overdue" : "")">
                                    @t.DueDate.Value.ToString("MMM d")
                                </span>
                            }
                        </div>
                    </div>
                    <MudTooltip Text="Set In Progress">
                        <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow"
                                       Size="Size.Small" Color="Color.Info"
                                       OnClick="() => OnSetInProgress.InvokeAsync(t.Id)" />
                    </MudTooltip>
                    <MudTooltip Text="Edit task">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Size="Size.Small" Color="Color.Default"
                                       OnClick="() => OnEdit.InvokeAsync(t)" />
                    </MudTooltip>
                    <MudTooltip Text="Mark complete">
                        <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                       Size="Size.Small" Color="Color.Success"
                                       OnClick="() => OnComplete.InvokeAsync(t.Id)" />
                    </MudTooltip>
                </div>
            }
        }
    }
</div>

@code {
    /// <summary>High-priority tasks from the user's priority projects.</summary>
    [Parameter] public IReadOnlyList<TodayTaskItemDto> Tasks { get; set; } = [];

    /// <summary>Raised with the task ID when the user marks a task complete.</summary>
    [Parameter] public EventCallback<Guid> OnComplete { get; set; }

    /// <summary>Raised with the task ID when the user sets a task as In Progress.</summary>
    [Parameter] public EventCallback<Guid> OnSetInProgress { get; set; }

    /// <summary>Raised with the selected task when the user wants to edit it.</summary>
    [Parameter] public EventCallback<TodayTaskItemDto> OnEdit { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;

    protected override void OnInitialized() => _collapsed = Collapsed;

    /// <summary>
    /// Orders tasks: overdue first, then due today, then by descending priority, then by due date.
    /// </summary>
    private IEnumerable<TodayTaskItemDto> OrderedTasks =>
        Tasks.OrderBy(DateBucket)
             .ThenByDescending(t => (int)t.Priority)
             .ThenBy(t => t.DueDate ?? DateTime.MaxValue);

    private static int DateBucket(TodayTaskItemDto t)
    {
        if (!t.DueDate.HasValue) return 3;
        if (t.DueDate.Value.Date < DateTime.Today) return 0; // overdue
        if (t.DueDate.Value.Date == DateTime.Today) return 1; // due today
        return 2; // future
    }

    private static Color PriorityColor(TaskPriority p) => p switch
    {
        TaskPriority.Critical => Color.Error,
        TaskPriority.High     => Color.Warning,
        TaskPriority.Medium   => Color.Info,
        _                     => Color.Default,
    };

    private static string PriorityClass(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "td-task--critical",
        TaskPriority.High     => "td-task--high",
        TaskPriority.Medium   => "td-task--medium",
        _                     => "td-task--low",
    };
}
