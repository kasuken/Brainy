@* ─────────────────────────────────────────────────────────────────────────────
   TodayQuickActions — compact action toolbar near the top of Today.
   Four outlined buttons: browse tasks, set focus, process inbox, new note.
───────────────────────────────────────────────────────────────────────────── *@
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IStringLocalizer<TodayQuickActions> Localizer

<div class="td-section" style="display:flex; gap:0.5rem; flex-wrap:wrap; padding-bottom:0.5rem;">

    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.AddTask"
               Style="border-color:var(--line-strong); color:var(--ink-soft); font-size:0.78rem;"
               OnClick="() => OnAddTask.InvokeAsync()">
        @Localizer["NewTask"]
    </MudButton>

    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.TaskAlt"
               Style="border-color:var(--line-strong); color:var(--ink-soft); font-size:0.78rem;"
               OnClick="@(() => Nav.NavigateTo("/projects"))">
        @Localizer["CompleteTask"]
    </MudButton>

    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.CenterFocusStrong"
               Style="border-color:var(--line-strong); color:var(--ink-soft); font-size:0.78rem;"
               OnClick="OpenFocusPickerAsync">
        @Localizer["SetFocus"]
    </MudButton>

    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.Inbox"
               Style="border-color:var(--line-strong); color:var(--ink-soft); font-size:0.78rem;"
               OnClick="@(() => Nav.NavigateTo("/inbox"))">
        @Localizer["ProcessInbox"]
    </MudButton>

    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.NoteAdd"
               Style="border-color:var(--line-strong); color:var(--ink-soft); font-size:0.78rem;"
               OnClick="@(() => Nav.NavigateTo("/notes"))">
        @Localizer["NewNote"]
    </MudButton>

</div>

@code {
    [Parameter] public EventCallback OnAddTask { get; set; }
    [Parameter] public Guid? CurrentTaskId { get; set; }
    [Parameter] public EventCallback OnFocusChanged { get; set; }

    private async Task OpenFocusPickerAsync()
    {
        var parameters = new DialogParameters<FocusPickerDialog>
        {
            { d => d.CurrentTaskId, CurrentTaskId }
        };

        var dialog = await DialogService.ShowAsync<FocusPickerDialog>(
            Localizer["FocusPickerDialogTitle"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await OnFocusChanged.InvokeAsync();
        }
    }
}
