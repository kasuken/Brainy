@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Projects
@inject ITaskService TaskService
@inject ICurrentTaskRecommendationService RecommendationService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<div class="td-widget td-section">
    <div class="td-section-head">
        <span class="td-section-label td-section-label--focus">Current focus</span>
        @if (Task is not null)
        {
            <span class="td-section-count">1 active</span>
        }
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        @if (Task is not null)
        {
            <div style="border: 1px solid var(--line); border-left: 4px solid var(--clay); border-radius: 8px; background: var(--paper-raised); padding: 1.1rem 1.25rem; box-shadow: var(--shadow-sm);">

                <div style="display:flex; align-items:flex-start; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.6rem;">
                    <h2 style="font-family:var(--font-display); font-style:italic; font-size:1.3rem; font-weight:600; color:var(--ink); margin:0; flex:1; min-width:0; line-height:1.25;">
                        @Task.Title
                    </h2>
                    <MudChip T="string" Size="Size.Small" Color="@PriorityColor(Task.Priority)" Variant="Variant.Outlined">
                        @Task.Priority.ToString()
                    </MudChip>
                </div>

                @{
                    var isOverdue = Task.DueDate.HasValue && Task.DueDate.Value.Date < Today;
                    var isHighPriority = Task.Priority is TaskPriority.High or TaskPriority.Critical;
                }
                @if (isOverdue || isHighPriority)
                {
                    <div class="td-focus-urgency" style="margin-bottom:0.5rem;">
                        @if (isOverdue)
                        {
                            <span class="td-focus-urgency-badge td-focus-urgency-badge--overdue">Overdue</span>
                        }
                        @if (isHighPriority)
                        {
                            <span class="td-focus-urgency-badge">@(Task.Priority == TaskPriority.Critical ? "Critical priority" : "High priority")</span>
                        }
                    </div>
                }

                <div class="td-focus-next-step" style="margin-bottom:0.9rem;">
                    @if (!string.IsNullOrWhiteSpace(Task.NextSubtaskTitle))
                    {
                        <span class="td-focus-next-step-label">Continue with:</span>
                        <span class="td-focus-next-step-text">@Task.NextSubtaskTitle</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Task.Description))
                    {
                        <span class="td-focus-next-step-text">@Task.Description</span>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.PlaylistAdd"
                                   OnClick="@(() => OpenEditForFirstStepAsync())">
                            Add a first step
                        </MudButton>
                    }
                </div>

                <div class="td-task-meta" style="margin-bottom:0.9rem;">
                    <a class="td-task-project" href="@($"/projects/{Task.ProjectId}")">@Task.ProjectName</a>
                    @if (Task.DueDate.HasValue)
                    {
                        <span class="td-task-due @(Task.DueDate.Value.Date < Today ? "td-task-due--overdue" : "")">
                            Due @Task.DueDate.Value.ToString("MMM d")
                        </span>
                    }
                </div>


                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.CheckCircle"
                               OnClick="HandleCompleteAsync"
                               Disabled="_busy">
                        Mark Complete
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.ClearAll"
                               OnClick="HandleClearFocusAsync"
                               Disabled="_busy">
                        Clear Focus
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.SwapHoriz"
                               OnClick="OpenFocusPickerAsync"
                               Disabled="_busy">
                        Switch Task
                    </MudButton>
                </div>

            </div>
        }
        else if (_recommendation is not null)
        {
            <div class="td-focus-card td-focus-card--suggested">

                <div class="td-focus-card-head">
                    <span class="td-focus-suggested-label">Suggested</span>
                    <MudChip T="string" Size="Size.Small" Color="@PriorityColor(_recommendation.Priority)" Variant="Variant.Outlined">
                        @_recommendation.Priority.ToString()
                    </MudChip>
                </div>

                <h2 class="td-focus-card-title">@_recommendation.Title</h2>

                <div class="td-task-meta td-focus-card-meta">
                    <a class="td-task-project" href="@($"/projects/{_recommendation.ProjectId}")">@_recommendation.ProjectName</a>
                    @if (_recommendation.DueDate.HasValue)
                    {
                        <span class="td-task-due @(_recommendation.DueDate.Value.Date < Today ? "td-task-due--overdue" : "")">
                            Due @_recommendation.DueDate.Value.ToString("MMM d")
                        </span>
                    }
                </div>

                <div class="td-rec-actions">
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.CenterFocusStrong"
                               OnClick="HandleSetFocusAsync"
                               Disabled="_busy">
                        Set as Focus
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.SwapHoriz"
                               OnClick="OpenFocusPickerAsync"
                               Disabled="_busy">
                        Choose another
                    </MudButton>
                </div>
            </div>
        }
        else if (!_loadingRecommendation)
        {
            <div class="td-focus-empty">
                <p class="td-empty">Nothing in focus. Pick a task to work on now.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.CenterFocusStrong"
                           OnClick="OpenFocusPickerAsync"
                           Disabled="_busy">
                    Choose Focus Task
                </MudButton>
            </div>
        }
    }
</div>

<style>
    .td-focus-card {
        border: 1px solid var(--line);
        border-left: 4px solid var(--clay);
        border-radius: 8px;
        background: var(--paper-raised);
        padding: 1.1rem 1.25rem;
        box-shadow: var(--shadow-sm);
    }

    .td-focus-card--suggested {
        border-style: dashed;
        border-left-style: solid;
        background: var(--paper);
        box-shadow: none;
    }

    .td-focus-card-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
    }

    .td-focus-suggested-label {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--clay);
    }

    .td-focus-card-title {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 0.5rem;
        line-height: 1.25;
        word-break: break-word;
    }

    .td-focus-card-meta {
        margin-bottom: 0.9rem;
    }

    .td-rec-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .td-focus-empty {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .td-focus-urgency {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .td-focus-urgency-badge {
        display: inline-flex;
        align-items: center;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgba(240, 173, 78, 0.15);
        color: #8a5a12;
    }

    .td-focus-urgency-badge--overdue {
        background: rgba(185, 28, 28, 0.12);
        color: #b91c1c;
    }

    .td-focus-next-step {
        font-size: 0.9rem;
        color: var(--ink-soft, var(--ink));
        line-height: 1.4;
    }

    .td-focus-next-step-label {
        font-weight: 600;
        margin-right: 0.35rem;
        color: var(--ink-faint);
    }

    .td-focus-next-step-text {
        color: var(--ink);
    }
</style>

@code {
    /// <summary>The current task in progress, or null when none is set.</summary>
    [Parameter] public TodayTaskItemDto? Task { get; set; }

    /// <summary>Invoked after any action (complete, clear, set focus) so the parent can reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>The user's current calendar date (their timezone), used for overdue calculations.</summary>
    [Parameter] public DateTime Today { get; set; } = DateTime.Today;

    private bool _collapsed;
    private bool _busy;
    private bool _loadingRecommendation;
    private TodayTaskItemDto? _recommendation;
    private Guid? _prevTaskId = Guid.NewGuid(); // sentinel so first run always loads

    protected override void OnInitialized() => _collapsed = Collapsed;

    protected override async Task OnParametersSetAsync()
    {
        // Reload recommendation only when the Task identity changes
        var currentId = Task?.Id;
        if (currentId == _prevTaskId) return;

        _prevTaskId = currentId;

        if (Task is null)
        {
            _loadingRecommendation = true;
            _recommendation = await RecommendationService.GetRecommendationAsync();
            _loadingRecommendation = false;
        }
        else
        {
            _recommendation = null;
        }
    }

    private async Task HandleCompleteAsync()
    {
        if (Task is null) return;
        _busy = true;
        try
        {
            await TaskService.CompleteAsync(Task.Id);
            Snackbar.Add("Task completed.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch
        {
            Snackbar.Add("Could not complete task.", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task HandleClearFocusAsync()
    {
        _busy = true;
        try
        {
            await TaskService.ClearCurrentTaskAsync();
            Snackbar.Add("Focus cleared.", Severity.Info);
            await OnChanged.InvokeAsync();
        }
        catch
        {
            Snackbar.Add("Could not clear focus.", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task HandleSetFocusAsync()
    {
        if (_recommendation is null) return;
        _busy = true;
        try
        {
            await TaskService.SetCurrentTaskAsync(_recommendation.Id);
            Snackbar.Add("Focus set.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        catch
        {
            Snackbar.Add("Could not set focus.", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task OpenFocusPickerAsync()
    {
        var parameters = new DialogParameters<FocusPickerDialog>
        {
            { d => d.CurrentTaskId, Task?.Id }
        };

        var dialog = await DialogService.ShowAsync<FocusPickerDialog>(
            "Choose your current focus",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenEditForFirstStepAsync()
    {
        if (Task is null) return;

        var parameters = new DialogParameters<TaskEditorDialog>
        {
            { d => d.TaskId, Task.Id },
            { d => d.ProjectId, Task.ProjectId }
        };

        var dialog = await DialogService.ShowAsync<TaskEditorDialog>(
            "Edit Task",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await OnChanged.InvokeAsync();
        }
    }

    private static Color PriorityColor(TaskPriority p) => p switch
    {
        TaskPriority.Critical => Color.Error,
        TaskPriority.High     => Color.Warning,
        TaskPriority.Medium   => Color.Info,
        _                     => Color.Default,
    };
}
