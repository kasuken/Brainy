@using Brainy.Application.DTOs.Today

@* ─────────────────────────────────────────────────────────────────────────────
   DailyFocusSummaryWidget — compact 4-tile stat strip at the top of Today.
   Shows: In Focus, Overdue, Due Today, Active Projects at a glance.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-daily-snapshot">
    @if (!_collapsed)
    {
        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items: stretch;">
            @* In Progress *@
            @{
                var inProgressCount = Aggregate?.InProgress?.Count ?? 0;
            }
            <div class="td-snap-item">
                <div class="td-snap-val" style="color:var(--espresso);">
                    @inProgressCount
                </div>
                <div class="td-snap-lbl">In Progress</div>
            </div>

            @* Overdue *@
            @{
                var overdueCount = Aggregate?.Overdue.Count ?? 0;
            }
            <div class="td-snap-item @(overdueCount > 0 ? "td-snap-item--overdue" : "")">
                <div class="td-snap-val @(overdueCount > 0 ? "td-snap-val--overdue" : "")">
                    @overdueCount
                </div>
                <div class="td-snap-lbl">Overdue</div>
            </div>

            @* Due Today *@
            @{
                var dueTodayCount = Aggregate?.DueToday.Count ?? 0;
            }
            <div class="td-snap-item @(dueTodayCount > 0 ? "td-snap-item--today" : "")">
                <div class="td-snap-val @(dueTodayCount > 0 ? "td-snap-val--today" : "")">
                    @dueTodayCount
                </div>
                <div class="td-snap-lbl">Due Today</div>
            </div>

            @* Active Projects *@
            @{
                var projectCount = Aggregate?.PrioritizedProjects.Count ?? 0;
            }
            <div class="td-snap-item">
                <div class="td-snap-val" style="color:var(--sage);">
                    @projectCount
                </div>
                <div class="td-snap-lbl">Active Projects</div>
            </div>
        </div>
    }
</div>

<style>
    .td-daily-snapshot {
        display: flex;
        flex-direction: column;
    }
    
    .td-snap-item {
        flex: 1;
        min-width: 110px;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        box-shadow: var(--shadow-sm);
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .td-snap-item--overdue {
        border-color: rgba(185,28,28,0.3);
    }
    
    .td-snap-item--today {
        border-color: rgba(192,86,29,0.3);
    }

    .td-snap-val {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0.15rem;
        color: var(--ink-soft);
    }
    
    .td-snap-val--overdue { color: #b91c1c; }
    .td-snap-val--today   { color: var(--clay); }

    .td-snap-lbl {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-faint);
    }
</style>

@code {
    /// <summary>Aggregated Today data snapshot; renders zeroes when null.</summary>
    [Parameter] public TodayAggregateDto? Aggregate { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;

    protected override void OnInitialized() => _collapsed = Collapsed;
}
