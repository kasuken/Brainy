@using Brainy.Application.DTOs.Today

@* ─────────────────────────────────────────────────────────────────────────────
   DailyFocusSummaryWidget — compact 4-tile stat strip at the top of Today.
   Shows: In Focus, Overdue, Due Today, Active Projects at a glance.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-widget td-section">
    <div class="td-section-head" style="margin-bottom:0.75rem;">
        <span class="td-section-label">Daily snapshot</span>
        <MudIconButton Icon="@(_collapsed ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ExpandLess)"
                       Size="Size.Small" Style="margin-left:auto; color:var(--ink-faint);"
                       OnClick="() => _collapsed = !_collapsed" />
    </div>

    @if (!_collapsed)
    {
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            @* In Focus *@
            <div style="flex:1; min-width:100px; background:var(--paper-raised); border:1px solid var(--line); border-radius:10px; padding:0.85rem 1rem; box-shadow:var(--shadow-sm); text-align:center;">
                <div style="font-family:var(--font-display); font-size:2rem; font-weight:700; line-height:1; color:var(--espresso); margin-bottom:0.2rem;">
                    @(Aggregate?.CurrentTask is not null ? 1 : 0)
                </div>
                <div style="font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint);">In Focus</div>
            </div>

            @* Overdue *@
            @{
                var overdueCount = Aggregate?.Overdue.Count ?? 0;
            }
            <div style="flex:1; min-width:100px; background:var(--paper-raised); border:1px solid @(overdueCount > 0 ? "rgba(185,28,28,0.3)" : "var(--line)"); border-radius:10px; padding:0.85rem 1rem; box-shadow:var(--shadow-sm); text-align:center;">
                <div style="font-family:var(--font-display); font-size:2rem; font-weight:700; line-height:1; color:@(overdueCount > 0 ? "#b91c1c" : "var(--ink-soft)"); margin-bottom:0.2rem;">
                    @overdueCount
                </div>
                <div style="font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint);">Overdue</div>
            </div>

            @* Due Today *@
            @{
                var dueTodayCount = Aggregate?.DueToday.Count ?? 0;
            }
            <div style="flex:1; min-width:100px; background:var(--paper-raised); border:1px solid @(dueTodayCount > 0 ? "rgba(192,86,29,0.3)" : "var(--line)"); border-radius:10px; padding:0.85rem 1rem; box-shadow:var(--shadow-sm); text-align:center;">
                <div style="font-family:var(--font-display); font-size:2rem; font-weight:700; line-height:1; color:@(dueTodayCount > 0 ? "var(--clay)" : "var(--ink-soft)"); margin-bottom:0.2rem;">
                    @dueTodayCount
                </div>
                <div style="font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint);">Due Today</div>
            </div>

            @* Active Projects *@
            @{
                var projectCount = Aggregate?.PrioritizedProjects.Count ?? 0;
            }
            <div style="flex:1; min-width:100px; background:var(--paper-raised); border:1px solid var(--line); border-radius:10px; padding:0.85rem 1rem; box-shadow:var(--shadow-sm); text-align:center;">
                <div style="font-family:var(--font-display); font-size:2rem; font-weight:700; line-height:1; color:var(--sage); margin-bottom:0.2rem;">
                    @projectCount
                </div>
                <div style="font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-faint);">Active Projects</div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Aggregated Today data snapshot; renders zeroes when null.</summary>
    [Parameter] public TodayAggregateDto? Aggregate { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;

    protected override void OnInitialized() => _collapsed = Collapsed;
}
