@using Brainy.Application.DTOs.Today

@* ─────────────────────────────────────────────────────────────────────────────
   DailyFocusSummaryWidget — compact, actionable status strip at the top of Today.
───────────────────────────────────────────────────────────────────────────── *@

<div class="td-daily-snapshot">
    @if (!_collapsed)
    {
        <div class="td-snap-list" aria-label="Daily status">
            @* In Progress *@
            @{
                var inProgressCount = Aggregate?.InProgress?.Count ?? 0;
            }
            <a class="td-snap-item td-snap-item--link"
               href="/tasks-hub"
               aria-label="@($"{inProgressCount} task{PluralSuffix(inProgressCount)} in progress. Open Tasks Hub.")">
                <div class="td-snap-val td-snap-val--progress">
                    @inProgressCount
                </div>
                <div class="td-snap-lbl">In Progress</div>
            </a>

            @* Overdue *@
            @{
                var overdueCount = Aggregate?.Overdue.Count ?? 0;
            }
            <a class="td-snap-item td-snap-item--link @(overdueCount > 0 ? "td-snap-item--overdue" : "")"
               href="/tasks-hub"
               aria-label="@($"{overdueCount} overdue task{PluralSuffix(overdueCount)}. Open Tasks Hub.")">
                <div class="td-snap-val @(overdueCount > 0 ? "td-snap-val--overdue" : "")">
                    @overdueCount
                </div>
                <div class="td-snap-lbl">Overdue</div>
            </a>

            @* Due Today *@
            @{
                var dueTodayCount = Aggregate?.DueToday.Count ?? 0;
            }
            <a class="td-snap-item td-snap-item--link @(dueTodayCount > 0 ? "td-snap-item--today" : "")"
               href="/tasks-calendar"
               aria-label="@($"{dueTodayCount} task{PluralSuffix(dueTodayCount)} due today. Open Tasks Calendar.")">
                <div class="td-snap-val @(dueTodayCount > 0 ? "td-snap-val--today" : "")">
                    @dueTodayCount
                </div>
                <div class="td-snap-lbl">Due Today</div>
            </a>

            @* Inbox *@
            @{
                var inboxCount = Aggregate?.InboxCount ?? 0;
                var inboxWarning = Aggregate?.InboxWarning ?? false;
            }
            <a class="td-snap-item td-snap-item--link @(inboxWarning ? "td-snap-item--inbox-warning" : "")"
               href="/inbox"
               aria-label="@($"{inboxCount} unprocessed inbox item{PluralSuffix(inboxCount)}. Open Inbox.")">
                @if (inboxWarning)
                {
                    <span class="td-snap-attention" aria-hidden="true"></span>
                }
                <div class="td-snap-val @(inboxWarning ? "td-snap-val--inbox-warning" : "")">
                    @inboxCount
                </div>
                <div class="td-snap-lbl">Inbox</div>
            </a>

            @* Active Projects *@
            @{
                var projectCount = Aggregate?.PrioritizedProjects.Count ?? 0;
            }
            <a class="td-snap-item td-snap-item--link"
               href="/projects"
               aria-label="@($"{projectCount} active project{PluralSuffix(projectCount)}. Open Projects.")">
                <div class="td-snap-val td-snap-val--projects">
                    @projectCount
                </div>
                <div class="td-snap-lbl">Active Projects</div>
            </a>
        </div>
    }
</div>

<style>
    .td-daily-snapshot {
        display: flex;
        flex-direction: column;
    }

    .td-snap-list {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: stretch;
    }

    .td-snap-item {
        flex: 1;
        min-width: 112px;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        box-shadow: var(--shadow-sm);
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        text-decoration: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .td-snap-item--link:hover {
        border-color: rgba(192, 86, 29, 0.45);
        box-shadow: 0 4px 14px rgba(63, 45, 32, 0.1);
        transform: translateY(-2px);
    }

    .td-snap-item--link:focus-visible {
        outline: 2px solid var(--clay);
        outline-offset: 2px;
    }

    .td-snap-item--overdue {
        border-color: rgba(185,28,28,0.3);
    }

    .td-snap-item--today {
        border-color: rgba(192,86,29,0.3);
    }

    .td-snap-item--inbox-warning {
        border-color: rgba(205, 154, 58, 0.65);
        background: linear-gradient(145deg, var(--paper-raised) 55%, rgba(205, 154, 58, 0.1));
    }

    .td-snap-attention {
        position: absolute;
        top: 0.45rem;
        right: 0.5rem;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background: var(--gold);
        box-shadow: 0 0 0 3px rgba(205, 154, 58, 0.15);
    }

    .td-snap-val {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0.15rem;
        color: var(--ink-soft);
    }

    .td-snap-val--progress { color: var(--espresso); }
    .td-snap-val--overdue { color: #b91c1c; }
    .td-snap-val--today   { color: var(--clay); }
    .td-snap-val--inbox-warning { color: #9a650e; }
    .td-snap-val--projects { color: var(--sage); }

    .td-snap-lbl {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-faint);
    }
</style>

@code {
    /// <summary>Aggregated Today data snapshot; renders zeroes when null.</summary>
    [Parameter] public TodayAggregateDto? Aggregate { get; set; }

    /// <summary>Initial collapsed state, managed locally after first render.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private bool _collapsed;

    protected override void OnInitialized() => _collapsed = Collapsed;

    private static string PluralSuffix(int count) => count == 1 ? string.Empty : "s";
}
