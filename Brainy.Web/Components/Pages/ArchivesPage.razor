@page "/archives"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Archives — Brainy</PageTitle>

<div class="arc-page">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <div class="arc-header">
        <div class="arc-header__eyebrow">PARA · Archive</div>
        <h1 class="arc-header__title">Archives</h1>
        <p class="arc-header__sub">
            Completed and inactive projects preserved for reference.
            @if (_projects is not null)
            {
                <span>@_projects.Count archived project@(_projects.Count != 1 ? "s" : "").</span>
            }
        </p>
    </div>

    @if (_loading)
    {
        <div class="arc-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_projects is null || !_projects.Any())
    {
        <div class="arc-empty">
            <div class="arc-empty__glyph">⬡</div>
            <p class="arc-empty__title">No archived projects yet</p>
            <p class="arc-empty__sub">
                When you archive a completed project, it will appear here for future reference.
            </p>
        </div>
    }
    else
    {
        <!-- Search -->
        <div class="arc-search-row">
            <div class="arc-search">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Class="arc-search__icon" />
                <input class="arc-search__input"
                       placeholder="Search archives…"
                       value="@_search"
                       @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button class="arc-search__clear" @onclick="() => _search = string.Empty">✕</button>
                }
            </div>
        </div>

        <div class="arc-list">
            @foreach (var project in Filtered)
            {
                <div class="arc-card">
                    <div class="arc-card__ribbon arc-ribbon--@project.Priority.ToString().ToLower()"></div>
                    <div class="arc-card__body">
                        <div class="arc-card__top">
                            <div class="arc-card__badges">
                                <span class="arc-badge arc-badge--priority arc-pri--@project.Priority.ToString().ToLower()">
                                    @PriorityLabel(project.Priority)
                                </span>
                                @if (project.ArchivedAtUtc.HasValue)
                                {
                                    <span class="arc-badge arc-badge--date">
                                        Archived @project.ArchivedAtUtc.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                            </div>
                        </div>

                        <h2 class="arc-card__name">@project.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(project.DesiredOutcome))
                        {
                            <p class="arc-card__outcome">@project.DesiredOutcome</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(project.Description))
                        {
                            <p class="arc-card__outcome">@project.Description</p>
                        }

                        <div class="arc-card__meta">
                            @if (project.StartDate.HasValue)
                            {
                                <span class="arc-meta-item">
                                    Started @project.StartDate.Value.ToString("MMM d, yyyy")
                                </span>
                            }
                            @if (project.CompletedDate.HasValue)
                            {
                                <span class="arc-meta-item arc-meta-item--completed">
                                    ✓ Completed @project.CompletedDate.Value.ToString("MMM d, yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="arc-card__actions">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Unarchive"
                                   OnClick="() => ConfirmRestore(project)">
                            Restore
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   OnClick="() => OpenProject(project.Id)">
                            View
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Archives page — preserved records, quiet and deliberate aesthetic
   ═══════════════════════════════════════════════════════════════════════════ */

.arc-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
}

/* Header */
.arc-header { margin-bottom: 2rem; }
.arc-header__eyebrow {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: .35rem;
}
.arc-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 .4rem;
    letter-spacing: -.025em;
    line-height: 1.1;
}
.arc-header__sub {
    font-size: .9rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.5;
}
.arc-header__sub span { margin-left: .4rem; }

/* Loading */
.arc-loading {
    display: flex;
    justify-content: center;
    padding: 5rem;
}

/* Empty state */
.arc-empty {
    text-align: center;
    padding: 5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
}
.arc-empty__glyph {
    font-size: 3.5rem;
    opacity: .1;
    font-family: var(--font-display);
    color: var(--ink);
}
.arc-empty__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
}
.arc-empty__sub {
    font-size: .88rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 400px;
    line-height: 1.6;
}

/* Search */
.arc-search-row { margin-bottom: 1.25rem; }
.arc-search {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: var(--paper-raised);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: .5rem .75rem;
    max-width: 400px;
    transition: border-color .15s;
}
.arc-search:focus-within { border-color: var(--clay); }
.arc-search__icon { color: var(--ink-faint); font-size: 1.1rem; flex-shrink: 0; }
.arc-search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: .88rem;
    color: var(--ink);
    outline: none;
}
.arc-search__input::placeholder { color: var(--ink-faint); }
.arc-search__clear {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-faint);
    font-size: .8rem;
    padding: 0 .1rem;
    transition: color .15s;
    flex-shrink: 0;
}
.arc-search__clear:hover { color: var(--clay); }

/* Archive list */
.arc-list {
    display: flex;
    flex-direction: column;
    gap: .75rem;
}

/* Archive card */
.arc-card {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow .2s, border-color .2s;
    animation: arc-card-in .25s ease backwards;
}
.arc-card:hover {
    box-shadow: 0 2px 12px rgba(33,29,23,.08);
    border-color: var(--line-strong);
}

@@keyframes arc-card-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Priority ribbon (left edge) */
.arc-card__ribbon {
    width: 5px;
    flex-shrink: 0;
}
.arc-ribbon--critical { background: var(--clay); }
.arc-ribbon--high     { background: #d4722a; }
.arc-ribbon--medium   { background: var(--gold); }
.arc-ribbon--low      { background: var(--sage); }

/* Card body */
.arc-card__body {
    flex: 1;
    padding: .9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: .4rem;
    min-width: 0;
}
.arc-card__top {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
}
.arc-card__badges { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }

.arc-badge {
    display: inline-flex;
    align-items: center;
    padding: .15rem .5rem;
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.arc-badge--date {
    background: var(--paper-sunk);
    color: var(--ink-faint);
    font-weight: 500;
    text-transform: none;
    font-size: .68rem;
    letter-spacing: 0;
}
.arc-pri--critical { color: #b03a18; background: rgba(176,58,24,.10); }
.arc-pri--high     { color: #d4722a; background: rgba(212,114,42,.10); }
.arc-pri--medium   { color: #a07820; background: rgba(160,120,32,.10); }
.arc-pri--low      { color: var(--sage); background: rgba(111,122,90,.10); }

.arc-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -.01em;
}
.arc-card:hover .arc-card__name { color: var(--ink); }
.arc-card__outcome {
    font-size: .82rem;
    color: var(--ink-faint);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.arc-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: .15rem;
}
.arc-meta-item {
    font-size: .72rem;
    color: var(--ink-faint);
    font-style: italic;
}
.arc-meta-item--completed { color: #4a5c38; font-style: normal; font-weight: 600; }

/* Card actions */
.arc-card__actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .4rem;
    padding: .75rem .9rem;
    flex-shrink: 0;
    border-left: 1px solid var(--line);
    background: var(--paper-sunk);
}

@@media (max-width: 560px) {
    .arc-card { flex-direction: column; }
    .arc-card__ribbon { width: 100%; height: 4px; }
    .arc-card__actions {
        flex-direction: row;
        border-left: none;
        border-top: 1px solid var(--line);
        justify-content: flex-start;
    }
}
</style>

@code {
    private IReadOnlyList<ProjectDto>? _projects;
    private bool _loading = true;
    private string _search = string.Empty;

    private IEnumerable<ProjectDto> Filtered =>
        _projects is null
            ? []
            : string.IsNullOrWhiteSpace(_search)
                ? _projects
                : _projects.Where(p =>
                    p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
                    (p.DesiredOutcome?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _projects = await ProjectService.GetAllArchivedAsync();
        _loading = false;
    }

    private async Task ConfirmRestore(ProjectDto project)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Restore project",
            $"Restore \"{project.Name}\"? It will return to active projects with status Not Started, and its tasks will be unarchived.",
            yesText: "Restore", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ProjectService.RestoreAsync(project.Id);
            Snackbar.Add($"\"{project.Name}\" restored to active projects.", Severity.Success);
            await LoadAsync();
        }
    }

    private void OpenProject(Guid id) => Nav.NavigateTo($"/projects/{id}");

    private static string PriorityLabel(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "⚑ Critical",
        ProjectPriority.High     => "↑ High",
        ProjectPriority.Medium   => "— Medium",
        ProjectPriority.Low      => "↓ Low",
        _                        => p.ToString()
    };
}
