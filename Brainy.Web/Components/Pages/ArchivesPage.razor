</style>

@code {
    private static readonly string[] EntityTypes = ["Project", "Area", "Resource", "Note"];
    private static readonly string[] TypeFilters = ["All", "Project", "Area", "Resource", "Note"];

    private IReadOnlyList<ProjectDto>? _projects;
    private IReadOnlyList<GoalDto>? _goals;
    private bool _loading = true;
    private bool _showRetention;
    private bool _purging;

    private List<ArchiveItem> _allItems = [];
    private List<ArchiveItem> _filtered = [];

    private string _search = string.Empty;
    private string _typeFilter = "All";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private Dictionary<string, int?> _retentionDays = new();
    private Dictionary<string, bool> _savingRetention = new();

    private List<ProjectDto> _archivedProjects = [];
    private List<AreaDto> _archivedAreas = [];
    private List<ResourceDto> _archivedResources = [];
    private List<NoteDto> _archivedNotes = [];

    private IEnumerable<ProjectDto> FilteredProjects =>
        _projects is null
            ? []
            : string.IsNullOrWhiteSpace(_search)
                ? _projects
                : _projects.Where(p =>
                    p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
                    (p.DesiredOutcome?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _dateFrom.HasValue ||
        _dateTo.HasValue ||
        _typeFilter != "All";
    private IEnumerable<GoalDto> FilteredGoals =>
        _goals is null
            ? []
            : string.IsNullOrWhiteSpace(_search)
                ? _goals
                : _goals.Where(g =>
                    g.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (g.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
                    (g.AreaName?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var projects = await ProjectService.GetAllArchivedAsync();
            var areas = await AreaService.GetAllArchivedAsync();
            var resources = await ResourceService.GetAllArchivedAsync();
            var notes = await NoteService.GetAllArchivedAsync();
            var rules = await RetentionService.GetRulesAsync();

            _archivedProjects = [.. projects];
            _archivedAreas = [.. areas];
            _archivedResources = [.. resources];
            _archivedNotes = [.. notes];

            _retentionDays = EntityTypes.ToDictionary(type => type, _ => (int?)null);
            _savingRetention = EntityTypes.ToDictionary(type => type, _ => false);

            foreach (var rule in rules)
            {
                if (_retentionDays.ContainsKey(rule.EntityType))
                {
                    _retentionDays[rule.EntityType] = rule.RetentionDays;
                }
            }

            _allItems =
            [
                .._archivedProjects.Select(p => new ArchiveItem(
                    p.Id,
                    "Project",
                    p.Name,
                    BuildSnippet(p.Description ?? p.DesiredOutcome),
                    p.ArchivedAtUtc,
                    p.UpdatedAtUtc)),

                .._archivedAreas.Select(a => new ArchiveItem(
                    a.Id,
                    "Area",
                    a.Name,
                    BuildSnippet(a.Description ?? a.Purpose),
                    a.ArchivedAtUtc,
                    a.UpdatedAtUtc)),

                .._archivedResources.Select(r => new ArchiveItem(
                    r.Id,
                    "Resource",
                    r.Name,
                    BuildSnippet(r.Description ?? r.Topic),
                    r.ArchivedAtUtc,
                    r.UpdatedAtUtc)),

                .._archivedNotes.Select(n => new ArchiveItem(
                    n.Id,
                    "Note",
                    n.Title,
                    BuildSnippet(n.Content),
                    n.ArchivedAtUtc,
                    n.UpdatedAtUtc))
            ];

            _allItems = [.. _allItems.OrderByDescending(item => item.ArchivedAtUtc ?? item.UpdatedAtUtc)];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _allItems = [];
            _filtered = [];
            Snackbar.Add($"Could not load archives: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
        var projectsTask = ProjectService.GetAllArchivedAsync();
        var goalsTask = GoalService.GetAllArchivedAsync();

        await Task.WhenAll(projectsTask, goalsTask);

        _projects = await projectsTask;
        _goals = await goalsTask;
        _loading = false;
    }

    private void ApplyFilter()
    {
        IEnumerable<ArchiveItem> query = _allItems;

        if (_typeFilter != "All")
        {
            query = query.Where(item => item.EntityType == _typeFilter);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(item =>
                item.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (item.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));
        }

        if (_dateFrom.HasValue)
        {
            query = query.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value >= _dateFrom.Value);
        }

        if (_dateTo.HasValue)
        {
            var inclusiveEnd = _dateTo.Value.AddDays(1);
            query = query.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value < inclusiveEnd);
        }

        _filtered = [.. query];
    }

    private void SetTypeFilter(string type)
    {
        _typeFilter = type;
        ApplyFilter();
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _search = string.Empty;
        ApplyFilter();
    }

    private Task OnDateFromChanged(DateTime? value)
    {
        _dateFrom = value;
        ApplyFilter();
        return Task.CompletedTask;
    }

    private Task OnDateToChanged(DateTime? value)
    {
        _dateTo = value;
        ApplyFilter();
        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _typeFilter = "All";
        _dateFrom = null;
        _dateTo = null;
        ApplyFilter();
    }

    private async Task ConfirmRestore(ArchiveItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            $"Restore {item.EntityType}",
            $"Restore \"{item.Name}\"? It will return to active views.",
            yesText: "Restore",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            switch (item.EntityType)
            {
                case "Project":
                    await ProjectService.RestoreAsync(item.Id);
                    break;
                case "Area":
                    await AreaService.RestoreAsync(item.Id);
                    break;
                case "Resource":
                    await ResourceService.RestoreAsync(item.Id);
                    break;
                case "Note":
                    await NoteService.RestoreAsync(item.Id);
                    break;
            }

            Snackbar.Add($"\"{item.Name}\" restored.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ViewItem(ArchiveItem item)
    {
        var url = item.EntityType switch
        {
            "Project" => $"/projects/{item.Id}",
            "Area" => $"/areas/{item.Id}",
            "Resource" => $"/resources/{item.Id}",
            _ => "/notes"
        };

        Nav.NavigateTo(url);
    }

    private async Task SaveRetentionAsync(string entityType)
    {
        _savingRetention[entityType] = true;

        try
        {
            await RetentionService.UpsertRuleAsync(entityType, _retentionDays[entityType]);
            Snackbar.Add($"{entityType} retention saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private async Task SetNeverExpireAsync(string entityType)
    {
        _savingRetention[entityType] = true;

        try
        {
            await RetentionService.DeleteRuleAsync(entityType);
            _retentionDays[entityType] = null;
            Snackbar.Add($"{entityType} retention cleared.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private async Task PurgeExpiredAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Permanently delete expired items",
            "This will permanently delete all archived items past their retention period. This cannot be undone.",
            yesText: "Delete expired items",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _purging = true;

        var deletedCount = 0;
        var failureCount = 0;
        var now = DateTime.UtcNow;

        try
        {
            foreach (var project in GetExpiredProjects(now))
            {
                try
                {
                    await ProjectService.DeleteAsync(project.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var area in GetExpiredAreas(now))
            {
                try
                {
                    await AreaService.DeleteAsync(area.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var resource in GetExpiredResources(now))
            {
                try
                {
                    await ResourceService.DeleteAsync(resource.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var note in GetExpiredNotes(now))
            {
                try
                {
                    await NoteService.DeleteAsync(note.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            if (deletedCount > 0)
            {
                Snackbar.Add($"{deletedCount} expired item{(deletedCount != 1 ? "s" : "")} permanently deleted.", Severity.Success);
            }
            else
            {
                Snackbar.Add("No expired items were eligible for deletion.", Severity.Info);
            }

            if (failureCount > 0)
            {
                Snackbar.Add($"{failureCount} item{(failureCount != 1 ? "s" : "")} could not be deleted.", Severity.Warning);
            }

            await LoadAsync();
        }
        finally
        {
            _purging = false;
        }
    }

    private int CountNearExpiry(string entityType)
    {
        if (!_retentionDays.TryGetValue(entityType, out var days) || days is null)
        {
            return 0;
        }

        var cutoff = DateTime.UtcNow.AddDays(30);

        return _allItems.Count(item =>
            item.EntityType == entityType &&
            item.ArchivedAtUtc.HasValue &&
            item.ArchivedAtUtc.Value.AddDays(days.Value) <= cutoff);
    }

    private void ToggleRetention() => _showRetention = !_showRetention;

    private void OnRetentionDaysChanged(string entityType, int? value) => _retentionDays[entityType] = value;

    private bool IsSavingRetention(string entityType) =>
        _savingRetention.TryGetValue(entityType, out var saving) && saving;

    private string GetTypeButtonClass(string type) =>
        type == _typeFilter ? "arc-type-btn arc-type-btn--on" : "arc-type-btn";

    private static string GetTypeBadgeClass(string entityType) =>
        $"arc-type arc-type--{entityType.ToLowerInvariant()}";
    private void OpenProject(Guid id) => Nav.NavigateTo($"/projects/{id}");

    private async Task RestoreGoalAsync(Guid id, string title)
    {
        await GoalService.RestoreAsync(id);
        Snackbar.Add($"\"{title}\" restored to active goals.", Severity.Success);
        await LoadAsync();
    }

    private static string GetArchivedLabel(ArchiveItem item) =>
        item.ArchivedAtUtc.HasValue
            ? $"Archived {item.ArchivedAtUtc.Value:MMM d, yyyy}"
            : $"Updated {item.UpdatedAtUtc:MMM d, yyyy}";

    private string GetEmptyTitle()
    {
        if (_typeFilter != "All" && !_allItems.Any(item => item.EntityType == _typeFilter))
        {
            return $"No archived {GetEntityTypeLabel(_typeFilter, plural: true)}";
        }

        return "Nothing here";
    }

    private string GetEmptySubtitle()
    {
        if (_allItems.Count == 0)
        {
            return "Archived projects, areas, resources, and notes will appear here once you start preserving completed work.";
        }

        if (_typeFilter != "All" && !_allItems.Any(item => item.EntityType == _typeFilter))
        {
            return $"Archive a {GetEntityTypeLabel(_typeFilter, plural: false).ToLowerInvariant()} to keep it available for future reference here.";
        }

        if (HasActiveFilters)
        {
            return "Try widening your search or adjusting the archived date range.";
        }

        return "There are no archived items in this view right now.";
    }

    private static string GetEntityTypeLabel(string entityType, bool plural) => (entityType, plural) switch
    {
        ("Project", true) => "Projects",
        ("Area", true) => "Areas",
        ("Resource", true) => "Resources",
        ("Note", true) => "Notes",
        ("Project", false) => "Project",
        ("Area", false) => "Area",
        ("Resource", false) => "Resource",
        _ => "Note"
    };

    private static string? BuildSnippet(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var normalized = string.Join(" ", value.ReplaceLineEndings(" ").Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return normalized.Length <= 140 ? normalized : $"{normalized[..140]}…";
    }

    private IEnumerable<ProjectDto> GetExpiredProjects(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Project", out var days) || days is null)
        {
            return [];
        }

        return _archivedProjects.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<AreaDto> GetExpiredAreas(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Area", out var days) || days is null)
        {
            return [];
        }

        return _archivedAreas.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<ResourceDto> GetExpiredResources(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Resource", out var days) || days is null)
        {
            return [];
        }

        return _archivedResources.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<NoteDto> GetExpiredNotes(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Note", out var days) || days is null)
        {
            return [];
        }

        return _archivedNotes.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private record ArchiveItem(
        Guid Id,
        string EntityType,
        string Name,
        string? Description,
        DateTime? ArchivedAtUtc,
        DateTime UpdatedAtUtc);
    private static string PriorityLabel(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "⚑ Critical",
        ProjectPriority.High     => "↑ High",
        ProjectPriority.Medium   => "— Medium",
        ProjectPriority.Low      => "↓ Low",
        _                        => p.ToString()
    };

    private static string GoalStatusLabel(GoalStatus status) => status switch
    {
        GoalStatus.Planned => "Planned",
        GoalStatus.Active => "Active",
        GoalStatus.Achieved => "Achieved",
        GoalStatus.Abandoned => "Abandoned",
        GoalStatus.Archived => "Archived",
        _ => status.ToString()
    };
}
