/* Card actions */
.arc-card__actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .4rem;
    padding: .75rem .9rem;
    flex-shrink: 0;
    border-left: 1px solid var(--line);
    background: var(--paper-sunk);
}

@@media (max-width: 560px) {
    .arc-page {
        padding-inline: .75rem;
    }

    .arc-toolbar {
        align-items: stretch;
    }

    .arc-search,
    .arc-toolbar__picker,
    .arc-retention-input {
        min-width: 100%;
        width: 100%;
    }
