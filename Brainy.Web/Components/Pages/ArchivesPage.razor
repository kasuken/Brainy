@page "/archives"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Resources
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Archives
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IAreaService AreaService
@inject IResourceService ResourceService
@inject INoteService NoteService
@inject IGoalService GoalService
@inject IArchiveRetentionService RetentionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Archives — Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    .arc-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .arc-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .arc-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .arc-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: arc-fade-up 0.4s ease both;
    }

    @@keyframes arc-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .arc-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .arc-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 400;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .arc-title-row {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .arc-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }

    .arc-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .arc-filter-label {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        margin-top: 1.25rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .arc-filter-label:first-of-type {
        margin-top: 0;
    }

    .arc-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .arc-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .arc-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .arc-chip--on {
        background: var(--mud-palette-text-primary);
        color: var(--mud-palette-surface);
        border-color: var(--mud-palette-text-primary);
    }

    /* ── Main Area ── */
    .arc-main {
        animation: arc-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .arc-section-title {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 500;
        margin: 0 0 1rem;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.01em;
    }

    /* ── Ledger ── */
    .arc-ledger {
        display: flex;
        flex-direction: column;
        border-top: 3px solid var(--mud-palette-text-primary);
        margin-bottom: 3rem;
    }

    .arc-row-in {
        animation: arc-card-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @@keyframes arc-card-in {
        from { opacity: 0; transform: translateY(10px) scale(0.99); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .arc-ledger-item {
        display: grid;
        grid-template-columns: 2rem 1fr;
        gap: 1rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        transition: background 0.3s ease;
        position: relative;
    }

    .arc-item-body {
        grid-column: 1 / -1;
    }

    .arc-item-actions {
        grid-column: 1 / -1;
    }

    @@media (min-width: 768px) {
        .arc-ledger-item {
            grid-template-columns: 2rem 100px 1fr auto;
            align-items: start;
        }

        .arc-item-body {
            grid-column: auto;
        }

        .arc-item-actions {
            grid-column: auto;
        }
    }

    /* ── Bulk action toolbar ── */
    .arc-bulk-toolbar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 10px;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        animation: arc-fade-up 0.25s ease both;
    }

    .arc-bulk-count {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin-right: auto;
    }

    /* ── Select-all header ── */
    .arc-select-all-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 2px solid var(--mud-palette-lines-default);
    }

    .arc-select-all-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }

    .arc-ledger-item:hover {
        background: rgba(0,0,0,0.01);
    }

    .arc-item-type {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        padding-top: 0.25rem;
    }

    .arc-item-body {
        min-width: 0;
    }

    .arc-item-name {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 500;
        line-height: 1.2;
        color: var(--mud-palette-text-primary);
        margin: 0 0 0.25rem;
        text-decoration: none;
    }

    .arc-item-desc {
        font-size: 0.9rem;
        color: var(--mud-palette-text-secondary);
        margin: 0;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .arc-item-meta {
        font-size: 0.75rem;
        color: var(--mud-palette-text-disabled);
        font-weight: 500;
        margin-top: 0.5rem;
    }

    .arc-item-actions {
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
    }

    /* ── Retention Section ── */
    .arc-retention-box {
        background: var(--mud-palette-table-lines);
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 2rem;
        margin-top: 4rem;
        animation: arc-fade-up 0.8s ease both;
    }

    .arc-retention-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        width: 100%;
        background: none;
        border: none;
        padding: 0;
        text-align: left;
    }

    .arc-retention-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        margin: 0;
    }

    .arc-retention-body {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--mud-palette-lines-default);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .arc-retention-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .arc-retention-card {
        background: var(--mud-palette-surface);
        padding: 1.25rem;
        border-radius: 10px;
        border: 1px solid var(--mud-palette-lines-default);
    }
    
    .arc-retention-card-title {
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.5rem;
    }

</style>

<div class="arc-page">
    <div class="arc-layout">

        @* ── Sidebar ── *@
        <aside class="arc-sidebar">
            <p class="arc-eyebrow">Vault</p>
            <div class="arc-title-row">
                <h1 class="arc-title">Archives</h1>
                <PageHelpButton Guide="HelpGuide" />
            </div>
            
            <p class="arc-meta">
                @if (_loading)
                {
                    <span>Loading…</span>
                }
                else
                {
                    <span>@_allItems.Count total items</span>
                    @if (_goals.Count > 0)
                    {
                        <span> · @_goals.Count goals</span>
                    }
                }
            </p>

            <div class="arc-widget">
                <MudTextField @bind-Value="_search"
                              Placeholder="Search archives…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyDown="@((e) => ApplyFilter())"
                              OnKeyUp="@((e) => ApplyFilter())"
                              OnClearButtonClick="@(() => ClearSearch())"
                              Class="mb-5" />

                <div class="arc-filter-label">Entity Type</div>
                <div class="arc-chips">
                    @foreach (var type in TypeFilters)
                    {
                        <button type="button"
                                class="arc-chip @(type == _typeFilter ? "arc-chip--on" : "")"
                                @onclick="() => SetTypeFilter(type)">
                            @type
                        </button>
                    }
                </div>

                <div class="arc-filter-label">Date Range</div>
                <div style="display:flex; flex-direction:column; gap:0.5rem;">
                    <MudDatePicker Label="Archived from"
                                   Date="_dateFrom"
                                   DateChanged="OnDateFromChanged"
                                   Clearable="true"
                                   Editable="false"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />

                    <MudDatePicker Label="Archived to"
                                   Date="_dateTo"
                                   DateChanged="OnDateToChanged"
                                   Clearable="true"
                                   Editable="false"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </div>

                @if (HasActiveFilters)
                {
                    <div style="margin-top: 1.5rem; border-top: 1px solid var(--mud-palette-lines-default); padding-top: 1rem;">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   OnClick="ClearFilters">
                            Clear filters
                        </MudButton>
                    </div>
                }
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="arc-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Accessing the vault…</p>
                </div>
            }
            else
            {
                @if (_filtered.Count == 0 && FilteredGoals.Count() == 0)
                {
                    <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                        <h2 style="font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                            @GetEmptyTitle()
                        </h2>
                        <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                            @GetEmptySubtitle()
                        </p>
                    </div>
                }

                @if (_filtered.Count > 0)
                {
                    @* ── Bulk actions toolbar ── *@
                    @if (_selectedItems.Count > 0)
                    {
                        <div class="arc-bulk-toolbar">
                            <span class="arc-bulk-count">@_selectedItems.Count selected</span>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Dark"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="BulkRestoreAsync">
                                Restore Selected
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DeleteForever"
                                       OnClick="ConfirmBulkDeleteAsync">
                                Delete Selected
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="@(() => _selectedItems.Clear())">
                                Clear
                            </MudButton>
                        </div>
                    }

                    <h2 class="arc-section-title">Items</h2>
                    <div class="arc-ledger">
                        @* Select-all header *@
                        <div class="arc-select-all-row">
                            <MudCheckBox T="bool"
                                         Value="@(_filtered.Count > 0 && _filtered.All(i => _selectedItems.Contains(i.Id)))"
                                         ValueChanged="ToggleSelectAllItems"
                                         Size="Size.Small"
                                         Color="Color.Primary" />
                            <span class="arc-select-all-label">Select all (@_filtered.Count)</span>
                        </div>

                        @for (int i = 0; i < _filtered.Count; i++)
                        {
                            var item = _filtered[i];
                            var idx = i;
                            <div class="arc-ledger-item arc-row-in" style="animation-delay:@(idx * 25)ms;">
                                <div style="display:flex; align-items:flex-start; padding-top:0.1rem;">
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedItems.Contains(item.Id)"
                                                 ValueChanged="@((bool v) => ToggleItem(item.Id, v))"
                                                 Size="Size.Small"
                                                 Color="Color.Primary" />
                                </div>
                                <div class="arc-item-type">@item.EntityType</div>
                                <div class="arc-item-body">
                                    <h3 class="arc-item-name">@item.Name</h3>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="arc-item-desc">@item.Description</p>
                                    }
                                    <div class="arc-item-meta">@GetArchivedLabel(item)</div>
                                </div>
                                <div class="arc-item-actions">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmRestore(item)">
                                        Restore
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="() => ViewItem(item)">
                                        View
                                    </MudButton>
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               OnClick="() => ConfirmDeleteItemAsync(item)">
                                        Delete
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (FilteredGoals.Any())
                {
                    @* ── Goals bulk actions toolbar ── *@
                    @if (_selectedGoalIds.Count > 0)
                    {
                        <div class="arc-bulk-toolbar" style="margin-top: 1rem;">
                            <span class="arc-bulk-count">@_selectedGoalIds.Count selected</span>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Dark"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="BulkRestoreGoalsAsync">
                                Restore Selected
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DeleteForever"
                                       OnClick="ConfirmBulkDeleteGoalsAsync">
                                Delete Selected
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="@(() => _selectedGoalIds.Clear())">
                                Clear
                            </MudButton>
                        </div>
                    }

                    <h2 class="arc-section-title" style="margin-top: 2rem;">Goals</h2>
                    <div class="arc-ledger">
                        @* Select-all header *@
                        @{
                            var filteredGoalsList = FilteredGoals.ToList();
                        }
                        <div class="arc-select-all-row">
                            <MudCheckBox T="bool"
                                         Value="@(filteredGoalsList.Count > 0 && filteredGoalsList.All(g => _selectedGoalIds.Contains(g.Id)))"
                                         ValueChanged="ToggleSelectAllGoals"
                                         Size="Size.Small"
                                         Color="Color.Primary" />
                            <span class="arc-select-all-label">Select all (@filteredGoalsList.Count)</span>
                        </div>

                        @for(int i = 0; i < filteredGoalsList.Count; i++)
                        {
                            var goal = filteredGoalsList[i];
                            var idx = i;
                            <div class="arc-ledger-item arc-row-in" style="animation-delay:@(idx * 25)ms;">
                                <div style="display:flex; align-items:flex-start; padding-top:0.1rem;">
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedGoalIds.Contains(goal.Id)"
                                                 ValueChanged="@((bool v) => ToggleGoalItem(goal.Id, v))"
                                                 Size="Size.Small"
                                                 Color="Color.Primary" />
                                </div>
                                <div class="arc-item-type">
                                    <span style="color: var(--mud-palette-warning);">@GoalStatusLabel(goal.Status)</span><br/>
                                    <span style="font-size:0.6rem; opacity:0.6;">GOAL</span>
                                </div>
                                <div class="arc-item-body">
                                    <h3 class="arc-item-name">@goal.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(goal.Description))
                                    {
                                        <p class="arc-item-desc">@goal.Description</p>
                                    }
                                    <div class="arc-item-meta">
                                        @if (goal.ArchivedAtUtc.HasValue)
                                        {
                                            <span>Archived @goal.ArchivedAtUtc.Value.ToString("MMM d, yyyy")</span>
                                        }
                                        <span style="margin-left:1rem;">@goal.CompletedMilestones/@goal.TotalMilestones milestones</span>
                                    </div>
                                </div>
                                <div class="arc-item-actions">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="() => RestoreGoalAsync(goal.Id, goal.Title)">
                                        Restore
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="@(() => Nav.NavigateTo($"/goals/{goal.Id}"))">
                                        View
                                    </MudButton>
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.DeleteForever"
                                               OnClick="() => ConfirmDeleteGoalAsync(goal)">
                                        Delete
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ── Retention Rules Footer Widget ── *@
                <section class="arc-retention-box">
                    <button type="button" class="arc-retention-header" @onclick="ToggleRetention">
                        <div>
                            <h2 class="arc-retention-title">Retention Rules</h2>
                            <p style="margin: 0.25rem 0 0; color: var(--mud-palette-text-secondary); font-size: 0.85rem;">Automate deletion of old items</p>
                        </div>
                        <MudIcon Icon="@(_showRetention ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Add)" Size="Size.Large" />
                    </button>

                    @if (_showRetention)
                    {
                        <div class="arc-retention-body">
                            <p style="margin:0; font-size:0.9rem; color:var(--mud-palette-text-secondary);">
                                Set how long archived items are kept before becoming eligible for permanent deletion. Leave blank to keep forever.
                            </p>

                            <div class="arc-retention-grid">
                                @foreach (var entityType in EntityTypes)
                                {
                                    var type = entityType;
                                    var nearExpiryCount = CountNearExpiry(type);

                                    <div class="arc-retention-card">
                                        <div class="arc-retention-card-title">@type Rules</div>
                                        <MudNumericField T="int?"
                                                         Value="@_retentionDays[type]"
                                                         ValueChanged="value => OnRetentionDaysChanged(type, value)"
                                                         Label="Days to keep"
                                                         Min="1"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Immediate="true"
                                                         HideSpinButtons="false"
                                                         Class="mb-4" />

                                        <div style="display:flex; gap:0.5rem;">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Dark"
                                                       Size="Size.Small"
                                                       Disabled="@IsSavingRetention(type)"
                                                       OnClick="() => SaveRetentionAsync(type)">
                                                @(IsSavingRetention(type) ? "Saving…" : "Save")
                                            </MudButton>
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Default"
                                                       Size="Size.Small"
                                                       Disabled="@IsSavingRetention(type)"
                                                       OnClick="() => SetNeverExpireAsync(type)">
                                                Never expire
                                            </MudButton>
                                        </div>

                                        @if (nearExpiryCount > 0)
                                        {
                                            <div style="margin-top: 1rem; font-size: 0.75rem; color: var(--mud-palette-warning); display:flex; align-items:center; gap:0.25rem; font-weight: 500;">
                                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
                                                @nearExpiryCount item@(nearExpiryCount != 1 ? "s" : "") near expiry
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div style="margin-top: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--mud-palette-lines-default); display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
                                <div>
                                    <h4 style="font-family: var(--font-display); margin:0 0 0.25rem; font-size:1.1rem; color:var(--mud-palette-error);">Purge Expired Data</h4>
                                    <p style="margin:0; font-size:0.85rem; color:var(--mud-palette-text-secondary);">Permanently remove items already past their retention period. This action cannot be undone.</p>
                                </div>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.DeleteForever"
                                           Disabled="_purging"
                                           OnClick="PurgeExpiredAsync">
                                    @(_purging ? "Purging system…" : "Permanently delete expired items")
                                </MudButton>
                            </div>
                        </div>
                    }
                </section>
            }
        </main>
    </div>
</div>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "archives",
        PageTitle = "Archives",
        Tagline = "Keep inactive work available without letting it crowd today",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Archive,
                Lead = "Archives hold inactive projects, areas, resources, notes, and goals so you can restore or review them later.",
                Points =
                [
                    "Browse preserved material that no longer belongs in active work views.",
                    "Search and filter archived items by type and archived date range.",
                    "Restore items when they become active again, or view them for context."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "Archives protect focus through actionability over storage — inactive material is set aside, not lost.",
                Points =
                [
                    "Active screens stay clear because completed or paused work moves out of the way.",
                    "Archived knowledge remains available when old context becomes useful again.",
                    "Retention rules help decide what stays forever and what can eventually be removed."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use Search archives to narrow the list by title or description.",
                    "Choose an Entity Type chip when you only want projects, areas, resources, notes, or all items.",
                    "Set Archived from or Archived to dates to focus on a time window.",
                    "Select View to open an archived item, or Restore to return it to active views.",
                    "Expand Retention Rules if you need to save keep-for-days settings or purge expired archived data."
                ]
            }
        ]
    };

    private static readonly string[] EntityTypes = ["Project", "Area", "Resource", "Note"];
    private static readonly string[] TypeFilters = ["All", "Project", "Area", "Resource", "Note"];

    private bool _loading = true;
    private bool _showRetention;
    private bool _purging;

    private List<ArchiveItem> _allItems = [];
    private List<ArchiveItem> _filtered = [];

    private string _search = string.Empty;
    private string _typeFilter = "All";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private Dictionary<string, int?> _retentionDays = new();
    private Dictionary<string, bool> _savingRetention = new();

    private List<ProjectDto> _archivedProjects = [];
    private List<AreaDto> _archivedAreas = [];
    private List<ResourceDto> _archivedResources = [];
    private List<NoteDto> _archivedNotes = [];

    private List<GoalDto> _goals = [];

    // ── Bulk selection state ──────────────────────────────────────────────────
    private readonly HashSet<Guid> _selectedItems = [];
    private readonly HashSet<Guid> _selectedGoalIds = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        _dateFrom.HasValue ||
        _dateTo.HasValue ||
        _typeFilter != "All";

    private IEnumerable<GoalDto> FilteredGoals =>
        string.IsNullOrWhiteSpace(_search)
            ? _goals
            : _goals.Where(g =>
                g.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (g.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true) ||
                (g.AreaName?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var projects = await ProjectService.GetAllArchivedAsync();
            var areas = await AreaService.GetAllArchivedAsync();
            var resources = await ResourceService.GetAllArchivedAsync();
            var notes = await NoteService.GetAllArchivedAsync();
            var goals = await GoalService.GetAllArchivedAsync();
            var rules = await RetentionService.GetRulesAsync();

            _archivedProjects = [.. projects];
            _archivedAreas = [.. areas];
            _archivedResources = [.. resources];
            _archivedNotes = [.. notes];
            _goals = [.. goals];

            _retentionDays = EntityTypes.ToDictionary(type => type, _ => (int?)null);
            _savingRetention = EntityTypes.ToDictionary(type => type, _ => false);

            foreach (var rule in rules)
            {
                if (_retentionDays.ContainsKey(rule.EntityType))
                {
                    _retentionDays[rule.EntityType] = rule.RetentionDays;
                }
            }

            _allItems =
            [
                .._archivedProjects.Select(p => new ArchiveItem(
                    p.Id,
                    "Project",
                    p.Name,
                    BuildSnippet(p.Description ?? p.DesiredOutcome),
                    p.ArchivedAtUtc,
                    p.UpdatedAtUtc)),

                .._archivedAreas.Select(a => new ArchiveItem(
                    a.Id,
                    "Area",
                    a.Name,
                    BuildSnippet(a.Description ?? a.Purpose),
                    a.ArchivedAtUtc,
                    a.UpdatedAtUtc)),

                .._archivedResources.Select(r => new ArchiveItem(
                    r.Id,
                    "Resource",
                    r.Name,
                    BuildSnippet(r.Description ?? r.Topic),
                    r.ArchivedAtUtc,
                    r.UpdatedAtUtc)),

                .._archivedNotes.Select(n => new ArchiveItem(
                    n.Id,
                    "Note",
                    n.Title,
                    BuildSnippet(n.Content),
                    n.ArchivedAtUtc,
                    n.UpdatedAtUtc))
            ];

            _allItems = [.. _allItems.OrderByDescending(item => item.ArchivedAtUtc ?? item.UpdatedAtUtc)];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _allItems = [];
            _filtered = [];
            _goals = [];
            Snackbar.Add($"Could not load archives: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<ArchiveItem> query = _allItems;

        if (_typeFilter != "All")
        {
            query = query.Where(item => item.EntityType == _typeFilter);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(item =>
                item.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (item.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));
        }

        if (_dateFrom.HasValue)
        {
            query = query.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value >= _dateFrom.Value);
        }

        if (_dateTo.HasValue)
        {
            var inclusiveEnd = _dateTo.Value.AddDays(1);
            query = query.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value < inclusiveEnd);
        }

        _filtered = [.. query];

        // Clear stale selections whenever the visible set changes.
        _selectedItems.Clear();
        _selectedGoalIds.Clear();
    }

    private void SetTypeFilter(string type)
    {
        _typeFilter = type;
        ApplyFilter();
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        _search = string.Empty;
        ApplyFilter();
    }

    private Task OnDateFromChanged(DateTime? value)
    {
        _dateFrom = value;
        ApplyFilter();
        return Task.CompletedTask;
    }

    private Task OnDateToChanged(DateTime? value)
    {
        _dateTo = value;
        ApplyFilter();
        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _typeFilter = "All";
        _dateFrom = null;
        _dateTo = null;
        ApplyFilter();
    }

    private async Task ConfirmRestore(ArchiveItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            $"Restore {item.EntityType}",
            $"Restore \"{item.Name}\"? It will return to active views.",
            yesText: "Restore",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            switch (item.EntityType)
            {
                case "Project":
                    await ProjectService.RestoreAsync(item.Id);
                    break;
                case "Area":
                    await AreaService.RestoreAsync(item.Id);
                    break;
                case "Resource":
                    await ResourceService.RestoreAsync(item.Id);
                    break;
                case "Note":
                    await NoteService.RestoreAsync(item.Id);
                    break;
            }

            Snackbar.Add($"\"{item.Name}\" restored.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ViewItem(ArchiveItem item)
    {
        var url = item.EntityType switch
        {
            "Project" => $"/projects/{item.Id}",
            "Area" => $"/areas/{item.Id}",
            "Resource" => $"/resources/{item.Id}",
            _ => "/notes"
        };

        Nav.NavigateTo(url);
    }

    private async Task SaveRetentionAsync(string entityType)
    {
        _savingRetention[entityType] = true;

        try
        {
            await RetentionService.UpsertRuleAsync(entityType, _retentionDays[entityType]);
            Snackbar.Add($"{entityType} retention saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private async Task SetNeverExpireAsync(string entityType)
    {
        _savingRetention[entityType] = true;

        try
        {
            await RetentionService.DeleteRuleAsync(entityType);
            _retentionDays[entityType] = null;
            Snackbar.Add($"{entityType} retention cleared.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingRetention[entityType] = false;
        }
    }

    private async Task PurgeExpiredAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Permanently delete expired items",
            "This will permanently delete all archived items past their retention period. This cannot be undone.",
            yesText: "Delete expired items",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _purging = true;

        var deletedCount = 0;
        var failureCount = 0;
        var now = DateTime.UtcNow;

        try
        {
            foreach (var project in GetExpiredProjects(now))
            {
                try
                {
                    await ProjectService.DeleteAsync(project.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var area in GetExpiredAreas(now))
            {
                try
                {
                    await AreaService.DeleteAsync(area.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var resource in GetExpiredResources(now))
            {
                try
                {
                    await ResourceService.DeleteAsync(resource.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            foreach (var note in GetExpiredNotes(now))
            {
                try
                {
                    await NoteService.DeleteAsync(note.Id);
                    deletedCount++;
                }
                catch
                {
                    failureCount++;
                }
            }

            if (deletedCount > 0)
            {
                Snackbar.Add($"{deletedCount} expired item{(deletedCount != 1 ? "s" : "")} permanently deleted.", Severity.Success);
            }
            else
            {
                Snackbar.Add("No expired items were eligible for deletion.", Severity.Info);
            }

            if (failureCount > 0)
            {
                Snackbar.Add($"{failureCount} item{(failureCount != 1 ? "s" : "")} could not be deleted.", Severity.Warning);
            }

            await LoadAsync();
        }
        finally
        {
            _purging = false;
        }
    }

    private int CountNearExpiry(string entityType)
    {
        if (!_retentionDays.TryGetValue(entityType, out var days) || days is null)
        {
            return 0;
        }

        var cutoff = DateTime.UtcNow.AddDays(30);

        return _allItems.Count(item =>
            item.EntityType == entityType &&
            item.ArchivedAtUtc.HasValue &&
            item.ArchivedAtUtc.Value.AddDays(days.Value) <= cutoff);
    }

    private void ToggleRetention() => _showRetention = !_showRetention;

    private void OnRetentionDaysChanged(string entityType, int? value) => _retentionDays[entityType] = value;

    private bool IsSavingRetention(string entityType) =>
        _savingRetention.TryGetValue(entityType, out var saving) && saving;

    private string GetTypeButtonClass(string type) =>
        type == _typeFilter ? "arc-type-btn arc-type-btn--on" : "arc-type-btn";

    private static string GetTypeBadgeClass(string entityType) =>
        $"arc-type arc-type--{entityType.ToLowerInvariant()}";

    private static string GetArchivedLabel(ArchiveItem item) =>
        item.ArchivedAtUtc.HasValue
            ? $"Archived {item.ArchivedAtUtc.Value:MMM d, yyyy}"
            : $"Updated {item.UpdatedAtUtc:MMM d, yyyy}";

    private string GetEmptyTitle()
    {
        if (_typeFilter != "All" && !_allItems.Any(item => item.EntityType == _typeFilter))
        {
            return $"No archived {GetEntityTypeLabel(_typeFilter, plural: true)}";
        }

        return "Nothing here";
    }

    private string GetEmptySubtitle()
    {
        if (_allItems.Count == 0)
        {
            return "Archived projects, areas, resources, and notes will appear here once you start preserving completed work.";
        }

        if (_typeFilter != "All" && !_allItems.Any(item => item.EntityType == _typeFilter))
        {
            return $"Archive a {GetEntityTypeLabel(_typeFilter, plural: false).ToLowerInvariant()} to keep it available for future reference here.";
        }

        if (HasActiveFilters)
        {
            return "Try widening your search or adjusting the archived date range.";
        }

        return "There are no archived items in this view right now.";
    }

    private static string GetEntityTypeLabel(string entityType, bool plural) => (entityType, plural) switch
    {
        ("Project", true) => "Projects",
        ("Area", true) => "Areas",
        ("Resource", true) => "Resources",
        ("Note", true) => "Notes",
        ("Project", false) => "Project",
        ("Area", false) => "Area",
        ("Resource", false) => "Resource",
        _ => "Note"
    };

    private static string? BuildSnippet(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var normalized = string.Join(" ", value.ReplaceLineEndings(" ").Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return normalized.Length <= 140 ? normalized : $"{normalized[..140]}…";
    }

    private IEnumerable<ProjectDto> GetExpiredProjects(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Project", out var days) || days is null)
        {
            return [];
        }

        return _archivedProjects.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<AreaDto> GetExpiredAreas(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Area", out var days) || days is null)
        {
            return [];
        }

        return _archivedAreas.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<ResourceDto> GetExpiredResources(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Resource", out var days) || days is null)
        {
            return [];
        }

        return _archivedResources.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private IEnumerable<NoteDto> GetExpiredNotes(DateTime now)
    {
        if (!_retentionDays.TryGetValue("Note", out var days) || days is null)
        {
            return [];
        }

        return _archivedNotes.Where(item => item.ArchivedAtUtc.HasValue && item.ArchivedAtUtc.Value.AddDays(days.Value) <= now);
    }

    private async Task RestoreGoalAsync(Guid id, string title)
    {
        try
        {
            await GoalService.RestoreAsync(id);
            Snackbar.Add($"\"{title}\" restored to active goals.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string GoalStatusLabel(GoalStatus status) => status switch
    {
        GoalStatus.Planned => "Planned",
        GoalStatus.Active => "Active",
        GoalStatus.Achieved => "Achieved",
        GoalStatus.Abandoned => "Abandoned",
        GoalStatus.Archived => "Archived",
        _ => status.ToString()
    };

    // ── Selection helpers ─────────────────────────────────────────────────────

    private void ToggleItem(Guid id, bool selected)
    {
        if (selected) _selectedItems.Add(id);
        else          _selectedItems.Remove(id);
    }

    private void ToggleGoalItem(Guid id, bool selected)
    {
        if (selected) _selectedGoalIds.Add(id);
        else          _selectedGoalIds.Remove(id);
    }

    private void ToggleSelectAllItems(bool selectAll)
    {
        if (selectAll)
            foreach (var item in _filtered) _selectedItems.Add(item.Id);
        else
            _selectedItems.ExceptWith(_filtered.Select(i => i.Id));
    }

    private void ToggleSelectAllGoals(bool selectAll)
    {
        if (selectAll)
            foreach (var goal in FilteredGoals) _selectedGoalIds.Add(goal.Id);
        else
            _selectedGoalIds.ExceptWith(FilteredGoals.Select(g => g.Id));
    }

    // ── Bulk restore (items) ──────────────────────────────────────────────────

    private async Task BulkRestoreAsync()
    {
        var toRestore = _filtered.Where(i => _selectedItems.Contains(i.Id)).ToList();
        var (success, fail) = (0, 0);

        foreach (var item in toRestore)
        {
            try
            {
                switch (item.EntityType)
                {
                    case "Project":  await ProjectService.RestoreAsync(item.Id);  break;
                    case "Area":     await AreaService.RestoreAsync(item.Id);     break;
                    case "Resource": await ResourceService.RestoreAsync(item.Id); break;
                    case "Note":     await NoteService.RestoreAsync(item.Id);     break;
                }
                success++;
            }
            catch
            {
                fail++;
            }
        }

        if (success > 0) Snackbar.Add($"{success} item{(success != 1 ? "s" : "")} restored.", Severity.Success);
        if (fail > 0)    Snackbar.Add($"{fail} item{(fail != 1 ? "s" : "")} could not be restored.", Severity.Warning);

        _selectedItems.Clear();
        await LoadAsync();
    }

    // ── Bulk permanent delete (items) ─────────────────────────────────────────

    private async Task ConfirmBulkDeleteAsync()
    {
        var count = _selectedItems.Count;
        var confirmed = await DialogService.ShowMessageBox(
            "Permanently delete selected items",
            $"Permanently delete {count} selected item{(count != 1 ? "s" : "")}? This cannot be undone.",
            yesText: "Delete permanently",
            cancelText: "Cancel");

        if (confirmed != true) return;

        var toDelete = _filtered.Where(i => _selectedItems.Contains(i.Id)).ToList();
        var (success, fail) = (0, 0);

        foreach (var item in toDelete)
        {
            try
            {
                switch (item.EntityType)
                {
                    case "Project":  await ProjectService.DeleteAsync(item.Id);  break;
                    case "Area":     await AreaService.DeleteAsync(item.Id);     break;
                    case "Resource": await ResourceService.DeleteAsync(item.Id); break;
                    case "Note":     await NoteService.DeleteAsync(item.Id);     break;
                }
                success++;
            }
            catch
            {
                fail++;
            }
        }

        if (success > 0) Snackbar.Add($"{success} item{(success != 1 ? "s" : "")} permanently deleted.", Severity.Success);
        if (fail > 0)    Snackbar.Add($"{fail} item{(fail != 1 ? "s" : "")} could not be deleted.", Severity.Warning);

        _selectedItems.Clear();
        await LoadAsync();
    }

    // ── Per-row permanent delete (item) ──────────────────────────────────────

    private async Task ConfirmDeleteItemAsync(ArchiveItem item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            $"Permanently delete {item.EntityType}",
            $"Permanently delete \"{item.Name}\"? This cannot be undone.",
            yesText: "Delete permanently",
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            switch (item.EntityType)
            {
                case "Project":  await ProjectService.DeleteAsync(item.Id);  break;
                case "Area":     await AreaService.DeleteAsync(item.Id);     break;
                case "Resource": await ResourceService.DeleteAsync(item.Id); break;
                case "Note":     await NoteService.DeleteAsync(item.Id);     break;
            }

            Snackbar.Add($"\"{item.Name}\" permanently deleted.", Severity.Success);
            _selectedItems.Remove(item.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ── Bulk restore (goals) ──────────────────────────────────────────────────

    private async Task BulkRestoreGoalsAsync()
    {
        var toRestore = FilteredGoals.Where(g => _selectedGoalIds.Contains(g.Id)).ToList();
        var (success, fail) = (0, 0);

        foreach (var goal in toRestore)
        {
            try
            {
                await GoalService.RestoreAsync(goal.Id);
                success++;
            }
            catch
            {
                fail++;
            }
        }

        if (success > 0) Snackbar.Add($"{success} goal{(success != 1 ? "s" : "")} restored.", Severity.Success);
        if (fail > 0)    Snackbar.Add($"{fail} goal{(fail != 1 ? "s" : "")} could not be restored.", Severity.Warning);

        _selectedGoalIds.Clear();
        await LoadAsync();
    }

    // ── Bulk permanent delete (goals) ─────────────────────────────────────────

    private async Task ConfirmBulkDeleteGoalsAsync()
    {
        var count = _selectedGoalIds.Count;
        var confirmed = await DialogService.ShowMessageBox(
            "Permanently delete selected goals",
            $"Permanently delete {count} selected goal{(count != 1 ? "s" : "")}? This cannot be undone.",
            yesText: "Delete permanently",
            cancelText: "Cancel");

        if (confirmed != true) return;

        var toDelete = FilteredGoals.Where(g => _selectedGoalIds.Contains(g.Id)).ToList();
        var (success, fail) = (0, 0);

        foreach (var goal in toDelete)
        {
            try
            {
                await GoalService.DeleteAsync(goal.Id);
                success++;
            }
            catch
            {
                fail++;
            }
        }

        if (success > 0) Snackbar.Add($"{success} goal{(success != 1 ? "s" : "")} permanently deleted.", Severity.Success);
        if (fail > 0)    Snackbar.Add($"{fail} goal{(fail != 1 ? "s" : "")} could not be deleted.", Severity.Warning);

        _selectedGoalIds.Clear();
        await LoadAsync();
    }

    // ── Per-row permanent delete (goal) ──────────────────────────────────────

    private async Task ConfirmDeleteGoalAsync(GoalDto goal)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Permanently delete goal",
            $"Permanently delete \"{goal.Title}\"? This cannot be undone.",
            yesText: "Delete permanently",
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            await GoalService.DeleteAsync(goal.Id);
            Snackbar.Add($"\"{goal.Title}\" permanently deleted.", Severity.Success);
            _selectedGoalIds.Remove(goal.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private record ArchiveItem(
        Guid Id,
        string EntityType,
        string Name,
        string? Description,
        DateTime? ArchivedAtUtc,
        DateTime UpdatedAtUtc);
}
