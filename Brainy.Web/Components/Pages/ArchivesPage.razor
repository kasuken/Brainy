@page "/archives"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Resources
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Archives
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IAreaService AreaService
@inject IResourceService ResourceService
@inject INoteService NoteService
@inject IArchiveRetentionService RetentionService
@inject IGoalService GoalService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Archives — Brainy</PageTitle>

<div class="arc-page">
    <div class="arc-header">
        <div class="arc-header__eyebrow">PARA · Archive</div>
        <h1 class="arc-header__title">Archives</h1>
        <p class="arc-header__sub">
            @if (_loading)
            {
                <span>Loading archived items…</span>
            }
            else
            Completed and inactive work preserved for reference.
            @if (_projects is not null || _goals is not null)
            {
                <span>@_allItems.Count archived item@(_allItems.Count != 1 ? "s" : "") across your PARA system.</span>
                <span>
                    @(_projects?.Count ?? 0) archived project@((_projects?.Count ?? 0) != 1 ? "s" : "")
                    · @(_goals?.Count ?? 0) archived goal@((_goals?.Count ?? 0) != 1 ? "s" : "")
                </span>
            }
        </p>
    </div>

    @if (_loading)
    {
        <div class="arc-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if ((_projects is null || !_projects.Any()) && (_goals is null || !_goals.Any()))
    {
        <div class="arc-empty">
            <div class="arc-empty__glyph">⬡</div>
            <p class="arc-empty__title">No archived items yet</p>
            <p class="arc-empty__sub">
                When you archive goals or completed projects, they will appear here for future reference.
            </p>
        </div>
    }
    else
    {
        <div class="arc-type-filter" role="tablist" aria-label="Archive type filter">
            @foreach (var type in TypeFilters)
            {
                <button type="button"
                        class="@GetTypeButtonClass(type)"
                        @onclick="() => SetTypeFilter(type)">
                    @type
                </button>
            }
        </div>

        <div class="arc-toolbar">
            <div class="arc-search">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Class="arc-search__icon" />
                <input class="arc-search__input"
                       placeholder="Search archives…"
                       value="@_search"
                       @oninput="OnSearchChanged" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button" class="arc-search__clear" @onclick="ClearSearch">✕</button>
                }
            </div>

            <MudDatePicker Label="Archived from"
                           Date="_dateFrom"
                           DateChanged="OnDateFromChanged"
                           Clearable="true"
                           Editable="false"
                           Variant="Variant.Outlined"
                           Class="arc-toolbar__picker" />

            <MudDatePicker Label="Archived to"
                           Date="_dateTo"
                           DateChanged="OnDateToChanged"
                           Clearable="true"
                           Editable="false"
                           Variant="Variant.Outlined"
                           Class="arc-toolbar__picker" />

            @if (HasActiveFilters)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Size="Size.Small"
                           Class="arc-clear-btn"
                           OnClick="ClearFilters">
                    Clear filters
                </MudButton>
            }
        </div>
        </div>

        @if (FilteredProjects.Any())
        {
            <div class="arc-section-head">
                <span class="arc-section-head__label">Projects</span>
                <span class="arc-section-head__count">@FilteredProjects.Count() shown</span>
            </div>

        @if (_filtered.Count == 0)
        {
            <div class="arc-empty">
                <div class="arc-empty__glyph">⬡</div>
                <p class="arc-empty__title">@GetEmptyTitle()</p>
                <p class="arc-empty__sub">@GetEmptySubtitle()</p>
            </div>
        }
        else
        {
            <div class="arc-list">
                @foreach (var item in _filtered)
                {
                    <div class="arc-row">
                        <div class="@GetTypeBadgeClass(item.EntityType)">
                            @item.EntityType
                        </div>
            <div class="arc-list">
                @foreach (var project in FilteredProjects)
                {
                    <div class="arc-card">
                        <div class="arc-card__ribbon arc-ribbon--@project.Priority.ToString().ToLower()"></div>
                        <div class="arc-card__body">
                            <div class="arc-card__top">
                                <div class="arc-card__badges">
                                    <span class="arc-badge arc-badge--priority arc-pri--@project.Priority.ToString().ToLower()">
                                        @PriorityLabel(project.Priority)
                                    </span>
                                    @if (project.ArchivedAtUtc.HasValue)
                                    {
                                        <span class="arc-badge arc-badge--date">
                                            Archived @project.ArchivedAtUtc.Value.ToString("MMM d, yyyy")
                                        </span>
                                    }
                                </div>
                            </div>

                        <div class="arc-row__body">
                            <div class="arc-row__header">
                                <div class="arc-row__name">@item.Name</div>
                                <div class="arc-row__meta">@GetArchivedLabel(item)</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="arc-row__desc">@item.Description</div>
                            }
                        </div>
                            <h2 class="arc-card__name">@project.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(project.DesiredOutcome))
                            {
                                <p class="arc-card__outcome">@project.DesiredOutcome</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(project.Description))
                            {
                                <p class="arc-card__outcome">@project.Description</p>
                            }

                            <div class="arc-card__meta">
                                @if (project.StartDate.HasValue)
                                {
                                    <span class="arc-meta-item">
                                        Started @project.StartDate.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                                @if (project.CompletedDate.HasValue)
                                {
                                    <span class="arc-meta-item arc-meta-item--completed">
                                        ✓ Completed @project.CompletedDate.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="arc-row__actions">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Unarchive"
                                       OnClick="() => ConfirmRestore(item)">
                                Restore
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="() => ViewItem(item)">
                                View
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        }

        <section class="arc-retention">
            <button type="button" class="arc-retention__header" @onclick="ToggleRetention">
                <div>
                    <div class="arc-retention__title">⚙ Retention Rules</div>
                </div>
                <MudIcon Icon="@(_showRetention ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
            </button>

            @if (_showRetention)
            {
                <div class="arc-retention__body">
                    <p class="arc-retention__intro">
                        Set how long archived items are kept before becoming eligible for permanent deletion. Leave blank to keep forever.
                    </p>

                    @foreach (var entityType in EntityTypes)
                    {
                        var type = entityType;
                        var nearExpiryCount = CountNearExpiry(type);

                        <div class="arc-retention-row">
                            <div class="arc-retention-label">@type</div>

                            <MudNumericField T="int?"
                                             Value="@_retentionDays[type]"
                                             ValueChanged="value => OnRetentionDaysChanged(type, value)"
                                             Label="Days"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Immediate="true"
                                             HideSpinButtons="false"
                                             Class="arc-retention-input" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@IsSavingRetention(type)"
                                       OnClick="() => SaveRetentionAsync(type)">
                                @if (IsSavingRetention(type))
                                {
                                    <span>Saving…</span>
                                }
                                else
                                {
                                    <span>Save</span>
                                }
                            </MudButton>

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Disabled="@IsSavingRetention(type)"
                                       OnClick="() => SetNeverExpireAsync(type)">
                                Never expire
                            </MudButton>

                            @if (nearExpiryCount > 0)
                            {
                                <MudChip T="string"
                                         Color="Color.Warning"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small">
                                    @nearExpiryCount item@(nearExpiryCount != 1 ? "s" : "") near expiry
                                </MudChip>
                            }
                        </div>
                    }

                    <div class="arc-retention__purge">
                        <p class="arc-retention__purge-copy">
                            Permanently remove items already past their retention period.
                        </p>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.DeleteForever"
                                   Disabled="_purging"
                                   OnClick="PurgeExpiredAsync">
                            @if (_purging)
                            {
                                <span>Purging…</span>
                            }
                            else
                            {
                                <span>Permanently delete expired items</span>
                            }
                        </MudButton>
                    </div>
                </div>
            }
        </section>
                        <div class="arc-card__actions">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Unarchive"
                                       OnClick="() => ConfirmRestore(project)">
                                Restore
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="() => OpenProject(project.Id)">
                                View
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        }

        @if (FilteredGoals.Any())
        {
            <div class="arc-section-head arc-section-head--goals">
                <span class="arc-section-head__label">Goals</span>
                <span class="arc-section-head__count">@FilteredGoals.Count() shown</span>
            </div>

            <div class="arc-list">
                @foreach (var goal in FilteredGoals)
                {
                    <div class="arc-card arc-card--goal">
                        <div class="arc-card__ribbon arc-ribbon--goal"></div>
                        <div class="arc-card__body">
                            <div class="arc-card__top">
                                <div class="arc-card__badges">
                                    <span class="arc-badge arc-badge--goal-status">
                                        @GoalStatusLabel(goal.Status)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(goal.AreaName))
                                    {
                                        <span class="arc-badge arc-badge--goal-area">@goal.AreaName</span>
                                    }
                                    @if (goal.ArchivedAtUtc.HasValue)
                                    {
                                        <span class="arc-badge arc-badge--date">
                                            Archived @goal.ArchivedAtUtc.Value.ToString("MMM d, yyyy")
                                        </span>
                                    }
                                </div>
                            </div>

                            <h2 class="arc-card__name">@goal.Title</h2>

                            @if (!string.IsNullOrWhiteSpace(goal.Description))
                            {
                                <p class="arc-card__outcome">@goal.Description</p>
                            }

                            <div class="arc-card__meta">
                                @if (goal.TargetDate.HasValue)
                                {
                                    <span class="arc-meta-item">Target @goal.TargetDate.Value.ToString("MMM d, yyyy")</span>
                                }
                                <span class="arc-meta-item">@goal.CompletedMilestones/@goal.TotalMilestones milestones</span>
                            </div>
                        </div>

                        <div class="arc-card__actions">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Unarchive"
                                       OnClick="() => RestoreGoalAsync(goal.Id, goal.Title)">
                                Restore
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick='() => Nav.NavigateTo($"/goals/{goal.Id}")'>
                                View
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!FilteredProjects.Any() && !FilteredGoals.Any())
        {
            <div class="arc-empty arc-empty--filtered">
                <div class="arc-empty__glyph">⌕</div>
                <p class="arc-empty__title">No archived items match</p>
                <p class="arc-empty__sub">Try a broader search term.</p>
            </div>
        }
    }
</div>

<style>
.arc-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
}

.arc-header { margin-bottom: 2rem; }

.arc-header__eyebrow {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: .35rem;
}

.arc-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 .4rem;
    letter-spacing: -.025em;
    line-height: 1.1;
}

.arc-header__sub {
    font-size: .9rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.5;
}

.arc-loading {
    display: flex;
    justify-content: center;
    padding: 5rem;
}

.arc-type-filter {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-bottom: 1rem;
}

.arc-type-btn {
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: .45rem .85rem;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .02em;
    cursor: pointer;
    transition: border-color .15s, background .15s, color .15s, transform .15s;
}

.arc-type-btn:hover {
    border-color: var(--line-strong);
    color: var(--ink);
    transform: translateY(-1px);
}

.arc-type-btn--on {
    background: rgba(192,86,29,.10);
    border-color: rgba(192,86,29,.3);
    color: var(--clay-deep);
}

.arc-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1.25rem;
}

}
.arc-empty__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
}
.arc-empty__sub {
    font-size: .88rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 400px;
    line-height: 1.6;
}

/* Search */
.arc-search-row { margin-bottom: 1.25rem; }
.arc-section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
    margin: 1.5rem 0 .7rem;
}
.arc-section-head--goals { margin-top: 2rem; }
.arc-section-head__label {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
}
.arc-section-head__count {
    font-size: .75rem;
    color: var(--ink-faint);
}
.arc-search {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: var(--paper-raised);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: .5rem .75rem;
    min-width: min(100%, 340px);
    flex: 1 1 280px;
    transition: border-color .15s;
}

.arc-search:focus-within { border-color: var(--clay); }

.arc-search__icon {
    color: var(--ink-faint);
    font-size: 1.1rem;
    flex-shrink: 0;
}

.arc-search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: .88rem;
    color: var(--ink);
    outline: none;
}

.arc-search__input::placeholder { color: var(--ink-faint); }

.arc-search__clear {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-faint);
    font-size: .8rem;
    padding: 0 .1rem;
    transition: color .15s;
    flex-shrink: 0;
}

.arc-search__clear:hover { color: var(--clay); }

.arc-toolbar__picker {
    min-width: 180px;
    flex: 0 1 220px;
}

.arc-clear-btn { margin-left: auto; }

.arc-list {
    display: flex;
    flex-direction: column;
    gap: .75rem;
}

.arc-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: .8rem 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color .15s, box-shadow .15s;
}

.arc-row:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
}

.arc-row__body {
    flex: 1;
    min-width: 0;
}

.arc-row__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .2rem;
}

.arc-row__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    color: var(--ink);
}

.arc-row__desc {
    font-size: .8rem;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.arc-row__meta {
    font-size: .72rem;
    color: var(--ink-faint);
    font-style: italic;
    flex-shrink: 0;
}

.arc-row__actions {
    display: flex;
    gap: .4rem;
    flex-shrink: 0;
}

.arc-type {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: .35rem .6rem;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    flex-shrink: 0;
}

.arc-type--project  { background: rgba(192,86,29,.12); color: var(--clay-deep); }
.arc-type--area     { background: rgba(111,122,90,.14); color: #4a5c38; }
.arc-type--resource { background: rgba(205,154,58,.14); color: #7a5c0e; }
.arc-type--note     { background: var(--paper-sunk); color: var(--ink-soft); }

.arc-empty {
    text-align: center;
    padding: 5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
}

.arc-empty__glyph {
    font-size: 3.5rem;
    opacity: .1;
    font-family: var(--font-display);
    color: var(--ink);
}

.arc-empty__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
}

.arc-empty__sub {
    font-size: .88rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 440px;
    line-height: 1.6;
}

.arc-retention {
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
}

.arc-retention__header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    background: var(--paper-raised);
    border: none;
    color: var(--ink);
}

.arc-retention__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
    text-align: left;
}

.arc-retention__body {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--line);
    background: var(--paper-sunk);
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.arc-retention__intro,
.arc-retention__purge-copy {
    margin: 0;
    color: var(--ink-soft);
    font-size: .85rem;
    line-height: 1.6;
}

.arc-retention-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
}

.arc-retention-label {
    min-width: 80px;
    font-weight: 600;
    font-size: .85rem;
    color: var(--ink);
}

.arc-retention-input {
    width: 150px;
}

.arc-retention__purge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: .5rem;
    border-top: 1px solid var(--line);
}

/* Preserved project archive styling */
.arc-card {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow .2s, border-color .2s;
}

.arc-card__ribbon {
    width: 5px;
    flex-shrink: 0;
}

.arc-ribbon--critical { background: var(--clay); }
.arc-ribbon--high     { background: #d4722a; }
.arc-ribbon--medium   { background: var(--gold); }
.arc-ribbon--low      { background: var(--sage); }
.arc-ribbon--goal     { background: linear-gradient(180deg, var(--gold), var(--clay)); }

@@media (max-width: 720px) {
    .arc-row {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .arc-row__header {
        flex-direction: column;
        align-items: flex-start;
    }

    .arc-row__actions {
        width: 100%;
        justify-content: flex-start;
    }

    .arc-clear-btn { margin-left: 0; }
/* Card body */
.arc-card__body {
    flex: 1;
    padding: .9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: .4rem;
    min-width: 0;
}
.arc-card__top {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
}
.arc-card__badges { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }

.arc-badge {
    display: inline-flex;
    align-items: center;
    padding: .15rem .5rem;
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.arc-badge--date {
    background: var(--paper-sunk);
    color: var(--ink-faint);
    font-weight: 500;
    text-transform: none;
    font-size: .68rem;
    letter-spacing: 0;
}
.arc-pri--critical { color: #b03a18; background: rgba(176,58,24,.10); }
.arc-pri--high     { color: #d4722a; background: rgba(212,114,42,.10); }
.arc-pri--medium   { color: #a07820; background: rgba(160,120,32,.10); }
.arc-pri--low      { color: var(--sage); background: rgba(111,122,90,.10); }
.arc-badge--goal-status { color: #2f6f61; background: rgba(47,111,97,.10); }
.arc-badge--goal-area { color: #7a5c0e; background: rgba(160,120,32,.10); }

.arc-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -.01em;
}
.arc-card:hover .arc-card__name { color: var(--ink); }
.arc-card__outcome {
    font-size: .82rem;
    color: var(--ink-faint);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
