@page "/para"
@rendermode InteractiveServer
@attribute [Authorize]

@using Brainy.Application.DTOs.Para
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Resources
@using Brainy.Application.Interfaces.Services

@inject IParaSummaryService ParaSummaryService
@inject IProjectService ProjectService
@inject IAreaService AreaService
@inject IResourceService ResourceService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>PARA Overview – Brainy</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap');

    .para-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .para-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .para-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    .para-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: pd-fade-up 0.4s ease both;
    }

    .para-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .para-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
    }

    .para-title-row {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .para-lead {
        font-size: 1.15rem;
        line-height: 1.5;
        color: var(--mud-palette-text-secondary);
        border-left: 2px solid var(--mud-palette-lines-default);
        padding-left: 1rem;
        margin-bottom: 2rem;
    }

    .para-main {
        animation: pd-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .para-load-state {
        min-height: 220px;
        display: grid;
        place-items: center;
        align-content: center;
        gap: 0.75rem;
        color: var(--mud-palette-text-secondary);
        text-align: center;
    }

    .para-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @@media (min-width: 1200px) {
        .para-grid {
            grid-template-columns: 1fr 1fr;
        }
        .para-card:nth-child(2n) {
            transform: translateY(2rem);
        }
        .para-card:nth-child(2n):hover {
            transform: translateY(calc(2rem - 5px));
        }
    }

    @@keyframes pd-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .para-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 16px;
        padding: 2.5rem 2rem 3rem 2rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .para-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
        border-color: rgba(192, 86, 29, 0.25); 
    }

    .para-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 6px;
        background: var(--mud-palette-lines-default);
        transition: background 0.3s ease;
    }

    .para-card--project:hover::before { background: #d32f2f; }
    .para-card--area:hover::before { background: #ed6c02; }
    .para-card--resource:hover::before { background: #fbc02d; }
    .para-card--archive:hover::before { background: #388e3c; }

    .para-card-count {
        font-family: var(--font-display);
        font-size: 4rem;
        font-weight: 300;
        line-height: 1;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 1rem;
        transition: color 0.3s ease;
    }

    .para-card:hover .para-card-count {
        color: var(--mud-palette-text-primary);
    }

    .para-card-name {
        font-family: var(--font-display);
        font-size: 2.25rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: var(--mud-palette-text-primary);
    }

    .para-card-desc {
        font-size: 1rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 1.5rem;
        line-height: 1.4;
    }

    .para-card-archived {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-top: auto;
    }

    .para-card-cta {
        position: absolute;
        top: 2rem;
        right: 2rem;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--mud-palette-lines-default);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mud-palette-text-disabled);
        transition: all 0.3s ease;
    }

    .para-card:hover .para-card-cta {
        color: var(--mud-palette-surface);
        background: var(--mud-palette-text-primary);
        border-color: var(--mud-palette-text-primary);
        transform: rotate(-45deg);
    }

    /* Staggered animation */
    .para-grid > :nth-child(1) { animation-delay: 0.0s; }
    .para-grid > :nth-child(2) { animation-delay: 0.1s; }
    .para-grid > :nth-child(3) { animation-delay: 0.2s; }
    .para-grid > :nth-child(4) { animation-delay: 0.3s; }

    /* ── Recent Items / Quick Actions section ── */
    .para-actions-section {
        margin-top: 3rem;
        animation: pd-fade-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        animation-delay: 0.4s;
    }

    .para-actions-title {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 500;
        margin: 0 0 1.5rem;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.01em;
    }

    .para-items-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @@media (min-width: 900px) {
        .para-items-grid {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }

    .para-items-col {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .para-items-col-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        padding-bottom: 0.75rem;
        border-bottom: 2px solid;
        margin-bottom: 0.25rem;
        margin-top: 0;
    }

    .para-items-col-header--project  { border-color: #d32f2f; }
    .para-items-col-header--area     { border-color: #ed6c02; }
    .para-items-col-header--resource { border-color: #fbc02d; }

    .para-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .para-item-row:last-of-type {
        border-bottom: none;
    }

    .para-item-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        text-decoration: none;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .para-item-link:hover {
        color: var(--mud-palette-primary);
        text-decoration: underline;
    }

    .para-items-empty {
        font-size: 0.85rem;
        color: var(--mud-palette-text-disabled);
        text-align: center;
        padding: 1.25rem 0;
        margin: 0;
    }

    .para-items-footer {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--mud-palette-lines-default);
        text-align: right;
    }

    .para-items-footer a {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        text-decoration: none;
    }

    .para-items-footer a:hover {
        color: var(--mud-palette-text-primary);
    }
    
</style>

<div class="para-page">
    <div class="para-layout">

        <aside class="para-sidebar">
            <p class="para-eyebrow">Second Brain Architecture</p>
            <div class="para-title-row">
                <h1 id="para-title" class="para-title">Your PARA Overview</h1>
                <PageHelpButton Guide="HelpGuide" />
            </div>
            <p class="para-lead">
                Four categories that organize everything you capture into clear, actionable knowledge.
            </p>
        </aside>

        <section class="para-main" aria-labelledby="para-title">
            @if (_loading)
            {
                <div class="para-load-state" role="status" aria-live="polite">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                    <span>Loading your PARA overview…</span>
                </div>
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
                    <MudText Typo="Typo.body1">@_loadError</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync" Class="mt-2">
                        Try again
                    </MudButton>
                </MudAlert>
            }
            else if (_summary is not null)
            {
                <div class="para-grid">

                    @* Projects *@
                    <a href="/projects" class="para-card para-card--project">
                        <span class="para-card-count">@_summary.ActiveProjectCount</span>
                        <h2 class="para-card-name">Projects</h2>
                        <p class="para-card-desc">Short-term outcomes with a clear deadline and next action.</p>
                        @if (_summary.ArchivedProjectCount > 0)
                        {
                            <p class="para-card-archived">@_summary.ArchivedProjectCount archived</p>
                        }
                        <div class="para-card-cta" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </div>
                    </a>

                    @* Areas *@
                    <a href="/areas" class="para-card para-card--area">
                        <span class="para-card-count">@_summary.ActiveAreaCount</span>
                        <h2 class="para-card-name">Areas</h2>
                        <p class="para-card-desc">Ongoing responsibilities you maintain without a fixed end date.</p>
                        @if (_summary.ArchivedAreaCount > 0)
                        {
                            <p class="para-card-archived">@_summary.ArchivedAreaCount archived</p>
                        }
                        <div class="para-card-cta" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </div>
                    </a>

                    @* Resources *@
                    <a href="/resources" class="para-card para-card--resource">
                        <span class="para-card-count">@_summary.ActiveResourceCount</span>
                        <h2 class="para-card-name">Resources</h2>
                        <p class="para-card-desc">Reference material and topics of interest for future use.</p>
                        @if (_summary.ArchivedResourceCount > 0)
                        {
                            <p class="para-card-archived">@_summary.ArchivedResourceCount archived</p>
                        }
                        <div class="para-card-cta" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </div>
                    </a>

                    @* Archives *@
                    <a href="/archives" class="para-card para-card--archive">
                        <span class="para-card-count">@_summary.TotalArchiveCount</span>
                        <h2 class="para-card-name">Archives</h2>
                        <p class="para-card-desc">Inactive projects, areas, and resources kept for later reference.</p>
                        @if (_summary.TotalArchiveCount > 0)
                        {
                            <p class="para-card-archived">
                                @_summary.ArchivedProjectCount&nbsp;project@(_summary.ArchivedProjectCount == 1 ? "" : "s"),
                                @_summary.ArchivedAreaCount&nbsp;area@(_summary.ArchivedAreaCount == 1 ? "" : "s"),
                                @_summary.ArchivedResourceCount&nbsp;resource@(_summary.ArchivedResourceCount == 1 ? "" : "s")
                            </p>
                        }
                        <div class="para-card-cta" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </div>
                    </a>

                </div>

                @* ── Recent Items / Quick Actions ── *@
                <section class="para-actions-section">
                    <h2 class="para-actions-title">Recent Active Items</h2>
                    <div class="para-items-grid">

                        @* Projects column *@
                        <div class="para-items-col">
                            <h3 class="para-items-col-header para-items-col-header--project">
                                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" />
                                Projects
                            </h3>
                            @if (_recentProjects.Count == 0)
                            {
                                <p class="para-items-empty">No active projects</p>
                            }
                            else
                            {
                                @foreach (var project in _recentProjects)
                                {
                                    <div class="para-item-row">
                                        <a href="/projects/@project.Id" class="para-item-link" title="@project.Name">@project.Name</a>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 aria-label="@($"Actions for {project.Name}")"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <MudMenuItem Icon="@Icons.Material.Outlined.OpenInNew"
                                                         OnClick="@(() => Nav.NavigateTo($"/projects/{project.Id}"))">
                                                Open
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Archive"
                                                         OnClick="() => ArchiveProjectAsync(project)">
                                                Move to Archive
                                            </MudMenuItem>
                                        </MudMenu>
                                    </div>
                                }
                            }
                            <div class="para-items-footer">
                                <a href="/projects">All projects →</a>
                            </div>
                        </div>

                        @* Areas column *@
                        <div class="para-items-col">
                            <h3 class="para-items-col-header para-items-col-header--area">
                                <MudIcon Icon="@Icons.Material.Outlined.Landscape" Size="Size.Small" />
                                Areas
                            </h3>
                            @if (_recentAreas.Count == 0)
                            {
                                <p class="para-items-empty">No active areas</p>
                            }
                            else
                            {
                                @foreach (var area in _recentAreas)
                                {
                                    <div class="para-item-row">
                                        <a href="/areas/@area.Id" class="para-item-link" title="@area.Name">@area.Name</a>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 aria-label="@($"Actions for {area.Name}")"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <MudMenuItem Icon="@Icons.Material.Outlined.OpenInNew"
                                                         OnClick="@(() => Nav.NavigateTo($"/areas/{area.Id}"))">
                                                Open
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Archive"
                                                         OnClick="() => ArchiveAreaAsync(area)">
                                                Move to Archive
                                            </MudMenuItem>
                                        </MudMenu>
                                    </div>
                                }
                            }
                            <div class="para-items-footer">
                                <a href="/areas">All areas →</a>
                            </div>
                        </div>

                        @* Resources column *@
                        <div class="para-items-col">
                            <h3 class="para-items-col-header para-items-col-header--resource">
                                <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" />
                                Resources
                            </h3>
                            @if (_recentResources.Count == 0)
                            {
                                <p class="para-items-empty">No active resources</p>
                            }
                            else
                            {
                                @foreach (var resource in _recentResources)
                                {
                                    <div class="para-item-row">
                                        <a href="/resources/@resource.Id" class="para-item-link" title="@resource.Name">@resource.Name</a>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 aria-label="@($"Actions for {resource.Name}")"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <MudMenuItem Icon="@Icons.Material.Outlined.OpenInNew"
                                                         OnClick="@(() => Nav.NavigateTo($"/resources/{resource.Id}"))">
                                                Open
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Archive"
                                                         OnClick="() => ArchiveResourceAsync(resource)">
                                                Move to Archive
                                            </MudMenuItem>
                                        </MudMenu>
                                    </div>
                                }
                            }
                            <div class="para-items-footer">
                                <a href="/resources">All resources →</a>
                            </div>
                        </div>

                    </div>
                </section>
            }
        </section>

    </div>
</div>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "para",
        PageTitle = "PARA Overview",
        Tagline = "See how your Second Brain is organized by actionability",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Dashboard,
                Lead = "The PARA Overview summarizes the four core buckets that hold your active and archived knowledge.",
                Points =
                [
                    "See counts for Projects, Areas, Resources, and Archives in one place.",
                    "Jump directly into any PARA bucket from its dashboard card.",
                    "Spot archived totals without mixing inactive material into active views."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "PARA organizes knowledge by actionability, not by where something came from.",
                Points =
                [
                    "Project = a short-term outcome with a deadline.",
                    "Area = an ongoing responsibility with no fixed end.",
                    "Resource = a topic or reference you may reuse later; Archive = inactive material kept for context."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Review the count on each card to understand where your knowledge currently lives.",
                    "Open Projects when you need work tied to short-term outcomes and next actions.",
                    "Open Areas or Resources when you need responsibilities or reference topics.",
                    "Open Archives when you need inactive material that should stay out of active views.",
                    "Use the Recent Active Items section to quickly archive items directly from this page."
                ]
            }
        ]
    };

    private ParaSummaryDto? _summary;
    private bool _loading = true;
    private string? _loadError;

    private List<ProjectDto> _recentProjects = [];
    private List<AreaDto>    _recentAreas    = [];
    private List<ResourceDto> _recentResources = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            // These services share the scoped DbContext, so load sequentially.
            var summary = await ParaSummaryService.GetSummaryAsync();
            var projects = await ProjectService.GetAllNonArchivedAsync();
            var areas = await AreaService.GetAllActiveAsync();
            var resources = await ResourceService.GetAllActiveAsync();

            _summary = summary;
            _recentProjects = [.. projects.OrderByDescending(p => p.UpdatedAtUtc).Take(5)];
            _recentAreas = [.. areas.OrderByDescending(a => a.UpdatedAtUtc).Take(5)];
            _recentResources = [.. resources.OrderByDescending(r => r.UpdatedAtUtc).Take(5)];
        }
        catch
        {
            _summary = null;
            _recentProjects = [];
            _recentAreas = [];
            _recentResources = [];
            _loadError = "Brainy could not load your PARA overview. Your data was not changed.";
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Archive actions ───────────────────────────────────────────────────────

    /// <summary>Archives a project and optimistically updates the summary counts.</summary>
    private async Task ArchiveProjectAsync(ProjectDto project)
    {
        try
        {
            await ProjectService.ArchiveAsync(project.Id);
            Snackbar.Add($"\"{project.Name}\" moved to Archives.", Severity.Success);
            _recentProjects.RemoveAll(p => p.Id == project.Id);
            if (_summary is not null)
                _summary = _summary with
                {
                    ActiveProjectCount   = Math.Max(0, _summary.ActiveProjectCount - 1),
                    ArchivedProjectCount = _summary.ArchivedProjectCount + 1
                };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Archives an area and optimistically updates the summary counts.</summary>
    private async Task ArchiveAreaAsync(AreaDto area)
    {
        try
        {
            await AreaService.ArchiveAsync(area.Id);
            Snackbar.Add($"\"{area.Name}\" moved to Archives.", Severity.Success);
            _recentAreas.RemoveAll(a => a.Id == area.Id);
            if (_summary is not null)
                _summary = _summary with
                {
                    ActiveAreaCount   = Math.Max(0, _summary.ActiveAreaCount - 1),
                    ArchivedAreaCount = _summary.ArchivedAreaCount + 1
                };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Archives a resource and optimistically updates the summary counts.</summary>
    private async Task ArchiveResourceAsync(ResourceDto resource)
    {
        try
        {
            await ResourceService.ArchiveAsync(resource.Id);
            Snackbar.Add($"\"{resource.Name}\" moved to Archives.", Severity.Success);
            _recentResources.RemoveAll(r => r.Id == resource.Id);
            if (_summary is not null)
                _summary = _summary with
                {
                    ActiveResourceCount   = Math.Max(0, _summary.ActiveResourceCount - 1),
                    ArchivedResourceCount = _summary.ArchivedResourceCount + 1
                };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
