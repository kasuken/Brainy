@using Brainy.Application.DTOs.Notes
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums

@implements IAsyncDisposable

@inject INoteService NoteService
@inject INoteImageService NoteImageService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Class="qcd">
    <TitleContent>
        <div class="qcd__header">
            <span class="qcd__header-mark" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Add" />
            </span>
            <div class="qcd__header-text">
                <span class="qcd__title">Capture</span>
                <span class="qcd__subtitle">Paste, type or drop anything — sort it out later.</span>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="qcd__body" @ref="_root">
            <textarea @ref="_textArea"
                      class="qcd__input"
                      placeholder="What do you want to remember?"
                      rows="4"
                      spellcheck="true"
                      value="@_text"
                      @oninput="OnTextInput"></textarea>

            @if (_attachments.Count > 0)
            {
                <div class="qcd__attachments">
                    @foreach (var attachment in _attachments)
                    {
                        <div class="qcd__attachment">
                            <span class="qcd__attachment-icon" aria-hidden="true">
                                <MudIcon Icon="@(IsImage(attachment) ? Icons.Material.Outlined.Image : Icons.Material.Outlined.Description)" Size="Size.Small" />
                            </span>
                            <span class="qcd__attachment-name">@attachment.Name</span>
                            <button type="button" class="qcd__attachment-remove" title="Remove attachment" @onclick="() => RemoveAttachment(attachment)">
                                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                            </button>
                        </div>
                    }
                </div>
            }
            else if (_detectedKind is not null)
            {
                <div class="qcd__detected">
                    <span class="qcd__detected-dot" aria-hidden="true"></span>
                    <span>Looks like a <strong>@_detectedKind</strong> — Brainy will tag it for you.</span>
                </div>
            }

            <div class="qcd__toolbar">
                <label class="qcd__attach" title="Attach a file or image">
                    <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                    <span>Attach</span>
                    <InputFile id="qcd-attach-input"
                               OnChange="HandleAttach"
                               multiple
                               accept="image/*,.txt,.md,.pdf,.docx,.csv,.mp3,.mp4,.wav,.m4a"
                               class="qcd__file-hidden"
                               aria-label="Attach files or images" />
                </label>

                @if (_speechSupported)
                {
                    <button type="button"
                            class="qcd__mic @(_listening ? "qcd__mic--active" : "")"
                            title="@(_listening ? "Stop voice capture" : "Capture by voice")"
                            @onclick="ToggleDictationAsync">
                        <MudIcon Icon="@(_listening ? Icons.Material.Filled.Stop : Icons.Material.Outlined.Mic)" Size="Size.Small" />
                        <span>@(_listening ? "Listening…" : "Speak")</span>
                    </button>
                }

                <span class="qcd__hint">Enter to save · Shift+Enter for a new line · paste or drop a screenshot</span>
            </div>

            <button type="button" class="qcd__details-toggle" @onclick="ToggleDetails">
                <MudIcon Icon="@(_showDetails ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                <span>@(_showDetails ? "Hide details" : "Add a title")</span>
            </button>

            @if (_showDetails)
            {
                <input class="qcd__title-input"
                       placeholder="Optional title"
                       value="@_titleOverride"
                       @oninput="OnTitleOverrideInput" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_valid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Save to Inbox
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .qcd .mud-dialog-title {
        padding-bottom: 0;
    }

    /* ── Header ── */
    .qcd__header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .qcd__header-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 12px;
        background: var(--clay-soft);
        color: var(--clay-deep);
        flex: none;
    }

    .qcd__header-text {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 0;
    }

    .qcd__title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.2;
    }

    .qcd__subtitle {
        font-size: 0.8rem;
        color: var(--ink-soft);
        line-height: 1.3;
    }

    /* ── Body ── */
    .qcd__body {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding-top: 0.5rem;
        border-radius: 12px;
        transition: box-shadow 0.15s ease, background 0.15s ease;
    }

    .qcd__body--drag {
        box-shadow: 0 0 0 2px var(--clay);
        background: var(--clay-soft);
    }

    .qcd__input {
        width: 100%;
        min-height: 7.5rem;
        resize: vertical;
        border: 1.5px solid var(--line);
        border-radius: 12px;
        background: var(--paper-raised);
        padding: 0.9rem 1rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink);
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .qcd__input::placeholder {
        color: var(--ink-faint);
    }

    .qcd__input:focus {
        outline: none;
        border-color: var(--clay);
        background: var(--paper);
        box-shadow: 0 0 0 3px var(--clay-ring);
    }

    /* ── Detected kind hint ── */
    .qcd__detected {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--ink-soft);
        padding: 0 0.15rem;
    }

    .qcd__detected strong {
        color: var(--clay-deep);
        font-weight: 600;
        text-transform: capitalize;
    }

    .qcd__detected-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--clay);
        flex: none;
    }

    /* ── Attachment chips ── */
    .qcd__attachments {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .qcd__attachment {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.65rem;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        background: var(--paper-raised);
    }

    .qcd__attachment-icon {
        display: inline-flex;
        color: var(--clay-deep);
        flex: none;
    }

    .qcd__attachment-name {
        flex: 1;
        min-width: 0;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--ink);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qcd__attachment-remove {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        cursor: pointer;
        padding: 0.15rem;
        border-radius: 999px;
        flex: none;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .qcd__attachment-remove:hover {
        background: var(--clay-soft);
        color: var(--clay-deep);
    }

    /* ── Toolbar ── */
    .qcd__toolbar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .qcd__attach {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        background: var(--paper-raised);
        color: var(--ink-soft);
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    }

    .qcd__attach:hover {
        border-color: var(--clay-ring);
        background: var(--paper);
        color: var(--ink);
    }

    .qcd__mic {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        background: var(--paper-raised);
        color: var(--ink-soft);
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    }

    .qcd__mic:hover {
        border-color: var(--clay-ring);
        background: var(--paper);
        color: var(--ink);
    }

    .qcd__mic--active {
        border-color: var(--clay);
        background: var(--clay-soft);
        color: var(--clay-deep);
    }

    .qcd__mic--active .mud-icon-root {
        animation: qcd-pulse 1.2s ease-in-out infinite;
    }

    @@keyframes qcd-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .qcd__file-hidden {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .qcd__hint {
        flex: 1;
        min-width: 0;
        font-size: 0.72rem;
        color: var(--ink-faint);
        line-height: 1.4;
    }

    /* ── Details ── */
    .qcd__details-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        align-self: flex-start;
        border: none;
        background: transparent;
        color: var(--ink-soft);
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0.15rem 0;
        transition: color 0.15s ease;
    }

    .qcd__details-toggle:hover {
        color: var(--clay-deep);
    }

    .qcd__title-input {
        width: 100%;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        background: var(--paper-raised);
        padding: 0.6rem 0.8rem;
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: var(--ink);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .qcd__title-input::placeholder {
        color: var(--ink-faint);
    }

    .qcd__title-input:focus {
        outline: none;
        border-color: var(--clay);
        box-shadow: 0 0 0 3px var(--clay-ring);
    }

    @@media (max-width: 600px) {
        .qcd__hint {
            flex-basis: 100%;
        }
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private const int MaxTitleLength = 120;

    private ElementReference _textArea;
    private ElementReference _root;
    private DotNetObjectReference<QuickCaptureDialog>? _selfRef;

    private string _text = "";
    private string _titleOverride = "";
    private bool _showDetails;
    private bool _saving;
    private bool _speechSupported;
    private bool _listening;

    private readonly List<IBrowserFile> _attachments = [];

    // Maximum number of files that can be attached to a single capture.
    private const int MaxAttachments = 10;

    // Extensions whose content can be read inline as plain text.
    private static readonly HashSet<string> TextExtensions =
        new(StringComparer.OrdinalIgnoreCase) { ".txt", ".md", ".csv" };

    private static readonly HashSet<string> ImageExtensions =
        new(StringComparer.OrdinalIgnoreCase) { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg" };

    private bool _valid =>
        !string.IsNullOrWhiteSpace(_text) || _attachments.Count > 0;

    /// <summary>True when the given attachment's content type or extension identifies it as an image.</summary>
    private static bool IsImage(IBrowserFile file) =>
        file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
        ImageExtensions.Contains(Path.GetExtension(file.Name));

    /// <summary>The type Brainy inferred for the current capture, shown as a hint.</summary>
    private string? _detectedKind =>
        IsSingleUrl(_text, out _) ? "link"
        : !string.IsNullOrWhiteSpace(_text) ? "note"
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("brainyCapture.init", _selfRef, _textArea, _root, "qcd-attach-input");
        _speechSupported = await JS.InvokeAsync<bool>("brainyCapture.isSpeechSupported");
        if (_speechSupported)
            StateHasChanged();
    }

    // ── Input handlers ──────────────────────────────────────────────────────────

    private void OnTextInput(ChangeEventArgs e) => _text = e.Value?.ToString() ?? string.Empty;

    private void OnTitleOverrideInput(ChangeEventArgs e) => _titleOverride = e.Value?.ToString() ?? string.Empty;

    private void ToggleDetails() => _showDetails = !_showDetails;

    private void RemoveAttachment(IBrowserFile file) => _attachments.Remove(file);

    /// <summary>Stores chosen, pasted or dropped files, up to the attachment limit.</summary>
    private void HandleAttach(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxAttachments))
        {
            if (_attachments.Count >= MaxAttachments)
            {
                Snackbar.Add($"You can attach up to {MaxAttachments} files.", Severity.Warning);
                break;
            }
            _attachments.Add(file);
        }
    }

    // ── Voice capture ───────────────────────────────────────────────────────────

    /// <summary>Starts or stops browser dictation into the capture box.</summary>
    private async Task ToggleDictationAsync()
    {
        if (_listening)
        {
            await JS.InvokeVoidAsync("brainyCapture.stopDictation");
            _listening = false;
            return;
        }

        _listening = await JS.InvokeAsync<bool>("brainyCapture.startDictation", (string?)null);
        if (!_listening)
            Snackbar.Add("Voice capture isn't available in this browser.", Severity.Warning);
    }

    /// <summary>Receives a final transcript segment and appends it to the capture box.</summary>
    [JSInvokable]
    public async Task OnSpeechResultAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        _text = string.IsNullOrWhiteSpace(_text) ? text : $"{_text.TrimEnd()} {text}";
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called when dictation stops, either by the user or after silence.</summary>
    [JSInvokable]
    public async Task OnSpeechEndAsync()
    {
        _listening = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called when dictation fails. Surfaces only actionable problems.</summary>
    [JSInvokable]
    public async Task OnSpeechErrorAsync(string error)
    {
        _listening = false;
        if (error is "not-allowed" or "service-not-allowed")
            Snackbar.Add("Microphone access was blocked. Allow it to use voice capture.", Severity.Warning);
        else if (error is not "aborted" and not "no-speech")
            Snackbar.Add("Voice capture stopped unexpectedly.", Severity.Warning);
        await InvokeAsync(StateHasChanged);
    }

    // ── Save ──────────────────────────────────────────────────────────────────

    /// <summary>Invoked from JavaScript when the user presses Enter in the capture box.</summary>
    [JSInvokable]
    public async Task SaveFromKeyboardAsync()
    {
        if (!_valid || _saving) return;
        await Submit();
    }

    private async Task Submit()
    {
        if (!_valid) return;

        _saving = true;
        try
        {
            if (_attachments.Count > 0)
                await SaveAttachmentsCaptureAsync();
            else if (IsSingleUrl(_text, out var url))
                await SaveUrlCaptureAsync(url);
            else
                await SaveTextCaptureAsync();

            Snackbar.Add("Saved to Inbox", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Plain text or a multi-line thought. The first line becomes the title.</summary>
    private async Task SaveTextCaptureAsync()
    {
        var (title, body) = DeriveTitleAndBody(_text);
        await NoteService.CreateAsync(new CreateNoteDto(
            title, body, ParaCategory.Project, Status: NoteStatus.Inbox));
    }

    /// <summary>A single pasted or typed URL. Stored as a linked Source.</summary>
    private async Task SaveUrlCaptureAsync(string url)
    {
        var title = string.IsNullOrWhiteSpace(_titleOverride) ? CleanUrl(url) : _titleOverride.Trim();
        await NoteService.CreateAsync(new CreateNoteDto(
            title, "", ParaCategory.Project, Status: NoteStatus.Inbox, SourceUrl: url));
    }

    /// <summary>
    /// Handles one or more attachments of any mix of images and files. Images are uploaded and
    /// embedded as Markdown references (then linked to the note so the serving endpoint can
    /// enforce ownership); other files are inlined as text when possible or noted by name.
    /// </summary>
    private async Task SaveAttachmentsCaptureAsync()
    {
        var caption = _text.Trim();
        var contentParts = new List<string>();
        var imageIds = new List<Guid>();

        foreach (var file in _attachments)
        {
            if (IsImage(file))
            {
                var imageId = await UploadImageAsync(file);
                imageIds.Add(imageId);
                contentParts.Add($"![{file.Name}](/api/note-images/{imageId})");
            }
            else
            {
                contentParts.Add(await ReadFileTextOrPlaceholderAsync(file));
            }
        }

        if (!string.IsNullOrWhiteSpace(caption))
            contentParts.Add(caption);

        var content = string.Join("\n\n", contentParts);
        var title = ResolveAttachmentTitle(_attachments[0], caption);

        var created = await NoteService.CreateAsync(new CreateNoteDto(
            title, content, ParaCategory.Project, Status: NoteStatus.Inbox));

        if (imageIds.Count > 0)
            await NoteImageService.AssociateWithNoteAsync(created.Id, imageIds);
    }

    /// <summary>Uploads a single image attachment and returns its stored id.</summary>
    private async Task<Guid> UploadImageAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(INoteImageService.MaxSizeBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var imageDto = await NoteImageService.UploadAsync(
            new UploadNoteImageDto(bytes, file.ContentType, file.Name));
        return imageDto.Id;
    }

    private static async Task<string> ReadFileTextOrPlaceholderAsync(IBrowserFile file)
    {
        var ext = Path.GetExtension(file.Name);
        if (!TextExtensions.Contains(ext))
            return $"[Attached file: {file.Name}]";

        try
        {
            const long maxTextBytes = 5 * 1024 * 1024; // 5 MB ceiling for inline text
            await using var stream = file.OpenReadStream(maxTextBytes);
            using var reader = new StreamReader(stream);
            return await reader.ReadToEndAsync();
        }
        catch
        {
            return $"[Attached file: {file.Name}]";
        }
    }

    private string ResolveAttachmentTitle(IBrowserFile file, string caption)
    {
        if (!string.IsNullOrWhiteSpace(_titleOverride))
            return _titleOverride.Trim();
        if (!string.IsNullOrWhiteSpace(caption))
            return DeriveTitleAndBody(caption).Title;
        return Path.GetFileNameWithoutExtension(file.Name);
    }

    // ── Smart parsing ────────────────────────────────────────────────────────────

    /// <summary>Splits free text into a short title (first line) and the remaining body.</summary>
    private (string Title, string Body) DeriveTitleAndBody(string text)
    {
        var trimmed = text.Trim();
        if (!string.IsNullOrWhiteSpace(_titleOverride))
            return (_titleOverride.Trim(), trimmed);

        var breakIndex = trimmed.IndexOf('\n');
        var firstLine = (breakIndex >= 0 ? trimmed[..breakIndex] : trimmed).Trim();

        if (firstLine.Length <= MaxTitleLength)
        {
            var body = breakIndex >= 0 ? trimmed[(breakIndex + 1)..].TrimStart('\r', '\n') : "";
            return (firstLine, body);
        }

        // A long, single-line block: keep everything in the body so nothing is lost.
        return (firstLine[..MaxTitleLength].TrimEnd() + "…", trimmed);
    }

    /// <summary>True when the entire text is a single http(s) or www URL.</summary>
    private static bool IsSingleUrl(string text, out string url)
    {
        url = "";
        var t = text.Trim();
        if (t.Length == 0 || t.Any(char.IsWhiteSpace))
            return false;

        if (Uri.TryCreate(t, UriKind.Absolute, out var abs) &&
            (abs.Scheme == Uri.UriSchemeHttp || abs.Scheme == Uri.UriSchemeHttps))
        {
            url = t;
            return true;
        }

        if (t.StartsWith("www.", StringComparison.OrdinalIgnoreCase) && t.Contains('.') &&
            Uri.TryCreate("https://" + t, UriKind.Absolute, out _))
        {
            url = "https://" + t;
            return true;
        }

        return false;
    }

    /// <summary>Produces a tidy, scheme-less label from a URL for use as a note title.</summary>
    private static string CleanUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return url;

        var display = (uri.Host + uri.PathAndQuery).TrimEnd('/');
        return display.Length <= MaxTitleLength ? display : display[..MaxTitleLength].TrimEnd() + "…";
    }

    private void Cancel() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("brainyCapture.dispose");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone; nothing to clean up.
        }
        _selfRef?.Dispose();
    }
}
