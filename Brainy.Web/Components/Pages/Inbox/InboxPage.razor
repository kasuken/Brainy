@page "/inbox"
@rendermode InteractiveServer
@attribute [Authorize]
@namespace Brainy.Web.Components.Pages.InboxPage

@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Inbox
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Inbox
@using Brainy.Web.Components.Pages.Notes

@inject INoteService NoteService
@inject IInboxMetricsService MetricsService
@inject IInboxSuggestionsService SuggestionsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Inbox – Brainy</PageTitle>

<div class="inbox-page">
    <div class="inbox-layout">

        @* ── Sidebar ── *@
        <aside class="inbox-sidebar">
            @* ── Hero ── *@
            <div class="inbox-hero">
                <div class="inbox-hero__text">
                    <div class="inbox-hero__heading-row">
                        <h1 class="inbox-hero__heading">Inbox</h1>
                        @if (!_loading && _notes.Count > 0)
                        {
                            <span class="inbox-hero__badge">@_notes.Count</span>
                        }
                        <MudSpacer />
                        <PageHelpButton Guide="HelpGuide" />
                    </div>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">
                        @if (_loading)
                        {
                            <span>Loading…</span>
                        }
                        else if (_notes.Count == 0)
                        {
                            <span>Your inbox is clear — nothing to process.</span>
                        }
                        else
                        {
                            <span>Decide where each captured note belongs.</span>
                        }
                    </MudText>
                </div>

                @if (!_loading && _notes.Count > 0)
                {
                    <div class="inbox-hero__actions">
                        @if (_selectedIds.Count > 0)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.DoneAll"
                                       OnClick="BulkProcessSelectedAsync"
                                       Disabled="_busy"
                                       Class="inbox-hero__cta">
                                Process @_selectedIds.Count selected
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       OnClick="ClearSelection"
                                       Disabled="_busy"
                                       Class="inbox-hero__cta-clear">
                                Clear
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Outlined.DoneAll"
                                       OnClick="ProcessNextAsync"
                                       Disabled="_busy"
                                       Class="inbox-hero__cta">
                                Process next
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Outlined.CheckBox"
                                       OnClick="SelectAll"
                                       Class="inbox-hero__cta-clear">
                                Select all
                            </MudButton>
                        }
                    </div>
                }
            </div>

            @* ── Progress bar when notes exist ── *@
            @if (!_loading && _totalOnLoad > 0)
            {
                var processed = _totalOnLoad - _notes.Count;
                <div class="inbox-progress" title="@processed of @_totalOnLoad processed">
                    <div class="inbox-progress__track">
                        <div class="inbox-progress__fill"
                             style="width: @((processed * 100 / _totalOnLoad).ToString())%"></div>
                    </div>
                    <span class="inbox-progress__label">@processed / @_totalOnLoad processed</span>
                </div>
            }

            @* ── Metrics strip ── *@
            @if (_metrics is not null)
            {
                <div class="inbox-metrics">
                    <div class="inbox-metric-tile">
                        <span class="inbox-metric-tile__value @(_metrics.WaitingCount > 10 ? "inbox-metric--warn" : "")">
                            @_metrics.WaitingCount
                        </span>
                        <span class="inbox-metric-tile__label">Waiting</span>
                    </div>
                    <div class="inbox-metric-tile">
                        <span class="inbox-metric-tile__value">@_metrics.CapturedTodayCount</span>
                        <span class="inbox-metric-tile__label">Captured Today</span>
                    </div>
                    <div class="inbox-metric-tile">
                        <span class="inbox-metric-tile__value">
                            @(_metrics.OldestItemAgeInDays.HasValue ? $"{_metrics.OldestItemAgeInDays}d" : "—")
                        </span>
                        <span class="inbox-metric-tile__label">Oldest Item</span>
                    </div>
                    <div class="inbox-metric-tile">
                        <span class="inbox-metric-tile__value">
                            @(_metrics.AvgProcessingDays.HasValue ? $"{_metrics.AvgProcessingDays:F1}d" : "—")
                        </span>
                        <span class="inbox-metric-tile__label">Avg. Processing</span>
                    </div>
                </div>
            }
        </aside>

        @* ── Main Content ── *@
        <main class="inbox-main">
            @* ── Loading ── *@
            @if (_loading)
            {
                <div class="inbox-state">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Loading inbox…</MudText>
                </div>
            }

            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    Inbox could not be loaded. Check your connection and try again.
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync" Class="ml-2">Retry</MudButton>
                </MudAlert>
            }

            @* ── Empty / Zero-inbox ── *@
            else if (_notes.Count == 0)
            {
                <div class="inbox-empty">
                    <div class="inbox-empty__orbit" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.AllInbox" Class="inbox-empty__icon" />
                        <span class="inbox-empty__ring inbox-empty__ring--1"></span>
                        <span class="inbox-empty__ring inbox-empty__ring--2"></span>
                    </div>
                    <MudText Typo="Typo.h6" GutterBottom="true" Class="inbox-empty__headline">
                        All clear
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-5">
                        Every captured note has been processed. Great work.
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.NoteAdd"
                               Href="/notes">
                        Capture a new note
                    </MudButton>
                </div>
            }

            @* ── Note cards ── *@
            else
            {
                <div class="inbox-list">
                    @foreach (var note in _notes)
                    {
                        var isSelected = _selectedIds.Contains(note.Id);
                        var suggestion = GetSuggestion(note.Id);
                        <div class="inbox-card @(_busyId == note.Id ? "inbox-card--busy" : "") @(isSelected ? "inbox-card--selected" : "")">

                            <div class="inbox-card__header-row">
                                @* Checkbox *@
                                <label class="inbox-card__checkbox-wrap" aria-label="@($"Select {note.Title} for bulk processing")">
                                    <input type="checkbox"
                                           class="inbox-card__checkbox"
                                           checked="@isSelected"
                                           disabled="@_busy"
                                           @onchange="() => ToggleSelection(note.Id)" />
                                    <span class="inbox-card__checkbox-box" aria-hidden="true">
                                        @if (isSelected)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="inbox-card__checkbox-check" />
                                        }
                                    </span>
                                </label>

                                <div class="inbox-card__meta">
                                    <span class="inbox-card__pill">Unprocessed</span>
                                    <span class="inbox-card__date">
                                        <UserLocalTime Utc="note.CreatedAtUtc" />
                                    </span>
                                </div>
                            </div>

                            <div class="inbox-card__body">
                                <p class="inbox-card__title">@note.Title</p>

                                @if (suggestion is not null)
                                {
                                    <span class="inbox-card__pill inbox-card__pill--suggestion" title="@suggestion.Reasoning">
                                        Suggested: @suggestion.SuggestedCategory
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(note.Content))
                                {
                                    <p class="inbox-card__snippet">@TruncateContent(note.Content)</p>
                                }
                            </div>

                            <div class="inbox-card__actions">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           Disabled="_busy"
                                           OnClick="() => ProcessNoteAsync(note)"
                                           Class="inbox-card__btn-process">
                                    Process
                                </MudButton>

                                <div class="inbox-card__actions-right">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small"
                                                   aria-label="@($"Edit {note.Title}")"
                                                   Disabled="_busy"
                                                   OnClick="() => EditNoteAsync(note)"
                                                   Class="inbox-card__btn-icon" />

                                    <MudIconButton Icon="@Icons.Material.Outlined.Archive"
                                                   Size="Size.Small"
                                                   aria-label="@($"Archive {note.Title} without processing")"
                                                   Disabled="_busy"
                                                   OnClick="() => QuickArchiveAsync(note)"
                                                   Class="inbox-card__btn-icon" />
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<style>
    /* ── Page ── */
    .inbox-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 0;
    }

    .inbox-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @@media (min-width: 960px) {
        .inbox-layout {
            grid-template-columns: 340px 1fr;
            align-items: start;
            gap: 3rem;
        }
    }

    .inbox-sidebar {
        position: sticky;
        top: 2rem;
    }

    /* ── Hero ── */
    .inbox-hero {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .inbox-hero__heading-row {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.35rem;
    }

    .inbox-hero__heading {
        font-family: var(--font-display) !important;
        font-weight: 600 !important;
        letter-spacing: -0.5px;
        color: var(--mud-palette-text-primary);
        margin: 0 !important;
    }

    .inbox-hero__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.6rem;
        height: 1.6rem;
        padding: 0 0.4rem;
        border-radius: 999px;
        background: var(--clay, #c0561d);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        font-family: 'Hanken Grotesk', sans-serif;
        line-height: 1;
    }

    .inbox-hero__actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .inbox-hero__cta-clear {
        color: var(--mud-palette-text-secondary) !important;
    }

    /* ── Progress bar ── */
    .inbox-progress {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .inbox-progress__track {
        width: 100%;
        height: 5px;
        border-radius: 99px;
        background: var(--mud-palette-lines-default);
        overflow: hidden;
    }

    .inbox-progress__fill {
        height: 100%;
        border-radius: 99px;
        background: var(--clay, #c0561d);
        transition: width 0.4s ease;
    }

    .inbox-progress__label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        font-family: 'Hanken Grotesk', sans-serif;
    }

    /* ── Metrics strip ── */
    .inbox-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .inbox-metric-tile {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .inbox-metric-tile__value {
        font-family: var(--font-display);
        font-size: 1.55rem;
        font-weight: 500;
        color: var(--mud-palette-text-secondary);
        line-height: 1;
    }

    .inbox-metric--warn { color: var(--clay, #c0561d); }

    .inbox-metric-tile__label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }

    /* ── Loading / empty states ── */
    .inbox-state, .inbox-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4rem 1rem;
        text-align: center;
        gap: 0.5rem;
    }

    .inbox-empty__orbit {
        position: relative;
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .inbox-empty__icon {
        font-size: 2.5rem !important;
        width: 2.5rem !important;
        height: 2.5rem !important;
        color: var(--clay, #c0561d);
        opacity: 0.65;
        position: relative;
        z-index: 1;
    }

    .inbox-empty__ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid var(--clay, #c0561d);
    }

    .inbox-empty__ring--1 {
        opacity: 0.18;
        animation: inbox-ring-pulse 2.4s ease-out infinite;
    }

    .inbox-empty__ring--2 {
        opacity: 0.10;
        animation: inbox-ring-pulse 2.4s ease-out 1.2s infinite;
    }

    @@keyframes inbox-ring-pulse {
        0%   { transform: scale(1);   opacity: 0.18; }
        100% { transform: scale(2.0); opacity: 0; }
    }

    .inbox-empty__headline {
        font-family: var(--font-display) !important;
        font-weight: 600 !important;
    }

        /* ── Cards ── */
    .inbox-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        align-items: start;
    }

    .inbox-card {
        display: flex;
        flex-direction: column;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 16px;
        padding: 1.5rem;
        transition: border-color 0.25s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
        height: 100%;
        animation: card-fade-up 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @@keyframes card-fade-up {
        0%   { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    .inbox-card:hover {
        border-color: rgba(192, 86, 29, 0.4);
        box-shadow: 0 12px 30px rgba(192, 86, 29, 0.1);
        transform: translateY(-4px);
    }

    .inbox-card--busy {
        opacity: 0.55;
        pointer-events: none;
    }

    .inbox-card--selected {
        border-color: var(--clay, #c0561d);
        background: rgba(192, 86, 29, 0.04);
    }

    .inbox-card__header-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    /* ── Checkbox ── */
    .inbox-card__checkbox-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
    }

    .inbox-card__checkbox {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .inbox-card__checkbox-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border: 1.5px solid var(--mud-palette-lines-default);
        border-radius: 5px;
        background: var(--mud-palette-surface);
        transition: border-color 0.15s ease, background 0.15s ease;
        flex-shrink: 0;
    }

    .inbox-card--selected .inbox-card__checkbox-box {
        border-color: var(--clay, #c0561d);
        background: var(--clay, #c0561d);
    }

    .inbox-card__checkbox-wrap:hover .inbox-card__checkbox-box {
        border-color: var(--clay, #c0561d);
    }

    .inbox-card__checkbox-check {
        color: #fff;
        font-size: 0.8rem !important;
        width: 0.8rem !important;
        height: 0.8rem !important;
    }

    .inbox-card__meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .inbox-card__pill {
        display: inline-flex;
        align-items: center;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: rgba(192, 86, 29, 0.10);
        color: #c0561d;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .inbox-card__pill--suggestion {
        margin: 0 0 0.6rem;
        width: fit-content;
        background: rgba(192, 86, 29, 0.08);
        color: var(--mud-palette-text-secondary);
        text-transform: none;
        letter-spacing: 0;
        font-weight: 600;
    }

    .inbox-card__date {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .inbox-card__body {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-bottom: 1.25rem;
    }

    .inbox-card__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--mud-palette-text-primary);
        margin: 0 0 0.5rem;
        line-height: 1.35;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .inbox-card__snippet {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        line-height: 1.55;
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    /* ── Card actions ── */
    .inbox-card__actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    
    .inbox-card--selected .inbox-card__actions {
        border-top-color: rgba(192, 86, 29, 0.2);
    }

    .inbox-card__actions-right {
        display: flex;
        gap: 0.25rem;
    }

    .inbox-card__btn-process {
        white-space: nowrap;
    }

    .inbox-card__btn-icon {
        color: var(--mud-palette-text-secondary) !important;
    }

    .inbox-card__btn-icon:hover {
        color: var(--mud-palette-text-primary) !important;
    }

</style>
@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "inbox",
        PageTitle = "Inbox",
        Tagline = "Where every captured thought lands before it finds a home",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Inbox,
                Lead = "The Inbox holds everything you captured but haven't organised yet — quick notes, links, ideas and clippings. It is a temporary staging area, not a storage place.",
                Points =
                [
                    "See every unprocessed note in one list.",
                    "Decide where each item belongs, one at a time or in bulk.",
                    "Keep it moving toward empty so nothing important gets buried."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In Tiago Forte's CODE method, the Inbox is the bridge between Capture and Organize. You capture freely without judging, then later decide where each note lives using PARA.",
                Points =
                [
                    "Capture should be frictionless — judge later, not now.",
                    "Organize close to action: send each note to a Project, Area, Resource or Archive.",
                    "An empty inbox means your thinking is up to date and trustworthy."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Open a note to review what you captured.",
                    "Choose its PARA category and an optional destination.",
                    "Distil it: add a title, highlights or a short summary if useful.",
                    "Process single notes, or select several and process them in bulk.",
                    "Repeat until the inbox is clear."
                ]
            }
        ]
    };

    private IReadOnlyList<NoteDto> _notes = [];
    private readonly Dictionary<Guid, InboxSuggestionDto> _suggestionsByNoteId = [];
    private InboxMetricsDto? _metrics;
    private bool _loading = true;
    private string? _loadError;
    private bool _busy;
    private Guid? _busyId;
    private int _totalOnLoad;
    private HashSet<Guid> _selectedIds = [];

    private static readonly DialogOptions _processDialogOptions = new()
    {
        MaxWidth      = MaxWidth.Small,
        FullWidth     = true,
        BackdropClick = true,
        CloseButton   = false,
    };

    private static readonly DialogOptions _bulkDialogOptions = new()
    {
        MaxWidth      = MaxWidth.Small,
        FullWidth     = true,
        BackdropClick = true,
        CloseButton   = false,
    };

    private static readonly DialogOptions _editDialogOptions = new()
    {
        MaxWidth         = MaxWidth.Large,
        FullWidth        = true,
        BackdropClick    = false,
        CloseOnEscapeKey = false,
        CloseButton      = false,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _notes = await NoteService.GetInboxAsync();
            _metrics = await MetricsService.GetMetricsAsync();
            await LoadSuggestionsAsync(_notes);
            if (_totalOnLoad == 0)
                _totalOnLoad = _notes.Count;
            // Remove any selections for notes no longer in inbox
            _selectedIds.IntersectWith(_notes.Select(n => n.Id));
        }
        catch
        {
            _loadError = "Unable to reach the inbox.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleSelection(Guid id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void SelectAll() => _selectedIds = _notes.Select(n => n.Id).ToHashSet();

    private void ClearSelection() => _selectedIds.Clear();

    private async Task BulkProcessSelectedAsync()
    {
        if (_selectedIds.Count == 0) return;

        var count = _selectedIds.Count;
        var parameters = new DialogParameters<BulkProcessDialog>
        {
            { x => x.NoteCount, count }
        };

        var dialog = await DialogService.ShowAsync<BulkProcessDialog>("", parameters, _bulkDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BulkProcessDialog.BulkProcessResult r })
        {
            _busy = true;
            try
            {
                var processed = await NoteService.BulkProcessInboxAsync(
                    _selectedIds, r.Category, r.Status, r.ProjectId, r.AreaId, r.ResourceId);
                Snackbar.Add($"{processed} note{(processed == 1 ? "" : "s")} moved to {r.Category}.", Severity.Success);
                _selectedIds.Clear();
                _notes = await NoteService.GetInboxAsync();
                await LoadSuggestionsAsync(_notes);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not process notes: {ex.Message}", Severity.Error);
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private async Task ProcessNoteAsync(NoteDto note)
    {
        var parameters = new DialogParameters<ProcessNoteDialog>
        {
            { x => x.Note, note }
        };

        var dialog = await DialogService.ShowAsync<ProcessNoteDialog>("", parameters, _processDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ProcessNoteDto dto })
        {
            _busy   = true;
            _busyId = note.Id;
            try
            {
                await NoteService.ProcessNoteAsync(dto);
                Snackbar.Add($"\"{dto.Title ?? note.Title}\" moved to {dto.ParaCategory}.", Severity.Success);
                _selectedIds.Remove(note.Id);
                _notes = await NoteService.GetInboxAsync();
                await LoadSuggestionsAsync(_notes);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not process note: {ex.Message}", Severity.Error);
            }
            finally
            {
                _busy   = false;
                _busyId = null;
            }
        }
    }

    /// <summary>Opens the process dialog for the first (oldest) note in the inbox.</summary>
    private async Task ProcessNextAsync()
    {
        if (_notes.Count == 0) return;
        await ProcessNoteAsync(_notes[0]);
    }

    private async Task EditNoteAsync(NoteDto note)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, note.Id }
        };
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", parameters, _editDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _notes = await NoteService.GetInboxAsync();
            await LoadSuggestionsAsync(_notes);
        }
    }

    private async Task QuickArchiveAsync(NoteDto note)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Archive Note",
            $"Archive \"{note.Title}\" without processing?",
            yesText: "Archive", cancelText: "Cancel");

        if (confirmed != true) return;

        _busy   = true;
        _busyId = note.Id;
        try
        {
            await NoteService.ProcessNoteAsync(new ProcessNoteDto(
                note.Id, ParaCategory.Archive, NoteStatus.Archived));
            Snackbar.Add($"\"{note.Title}\" archived.", Severity.Info);
            _selectedIds.Remove(note.Id);
            _notes = await NoteService.GetInboxAsync();
            await LoadSuggestionsAsync(_notes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not archive note: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy   = false;
            _busyId = null;
        }
    }

    private static string TruncateContent(string content) =>
        content.Length <= 160 ? content : content[..160] + "…";

    private InboxSuggestionDto? GetSuggestion(Guid noteId) =>
        _suggestionsByNoteId.GetValueOrDefault(noteId);

    private async Task LoadSuggestionsAsync(IEnumerable<NoteDto> notes)
    {
        _suggestionsByNoteId.Clear();

        try
        {
            // The suggestions service currently exposes only per-note lookup, so this
            // intentionally performs one lightweight call per visible inbox item.
            foreach (var note in notes)
            {
                var suggestion = await SuggestionsService.SuggestAsync(note);
                if (suggestion is not null)
                {
                    _suggestionsByNoteId[note.Id] = suggestion;
                }
            }
        }
        catch
        {
            _suggestionsByNoteId.Clear();
        }
    }
}


