@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Resources
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums

@inject IProjectService ProjectService
@inject IAreaService AreaService
@inject IResourceService ResourceService

<MudDialog Class="bpd">

    <TitleContent>
        <div class="bpd__title">
            <span class="bpd__title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.DoneAll" />
            </span>
            <span>Process @NoteCount note@(NoteCount == 1 ? "" : "s")</span>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="bpd__body">

            <p class="bpd__summary">
                Assign all
                <strong class="bpd__count">@NoteCount selected note@(NoteCount == 1 ? "" : "s")</strong>
                to the same destination.
            </p>

            @* PARA category *@
            <p class="bpd__section-label">Where do they belong?</p>
            <div class="bpd__categories">
                @foreach (var cat in Enum.GetValues<ParaCategory>())
                {
                    var active = cat == _category;
                    <button type="button"
                            class="bpd__cat @(active ? "bpd__cat--active" : "")"
                            @onclick="() => OnCategoryChanged(cat)">
                        <span class="bpd__cat-dot" style="background: @DotColor(cat)"></span>
                        <span class="bpd__cat-label">@cat</span>
                        <span class="bpd__cat-desc">@CatDesc(cat)</span>
                        @if (active)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="bpd__cat-check" />
                        }
                    </button>
                }
            </div>

            @* Destination picker *@
            @if (_category == ParaCategory.Project && _projects.Count > 0)
            {
                <p class="bpd__section-label mt-4">Assign to project <span class="bpd__optional">(optional)</span></p>
                <MudSelect T="Guid?" @bind-Value="_projectId"
                           Placeholder="— none —"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="bpd__dest-select">
                    @foreach (var p in _projects)
                    {
                        <MudSelectItem T="Guid?" Value="@p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_category == ParaCategory.Area && _areas.Count > 0)
            {
                <p class="bpd__section-label mt-4">Assign to area <span class="bpd__optional">(optional)</span></p>
                <MudSelect T="Guid?" @bind-Value="_areaId"
                           Placeholder="— none —"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="bpd__dest-select">
                    @foreach (var a in _areas)
                    {
                        <MudSelectItem T="Guid?" Value="@a.Id">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_category == ParaCategory.Resource && _resources.Count > 0)
            {
                <p class="bpd__section-label mt-4">Assign to resource <span class="bpd__optional">(optional)</span></p>
                <MudSelect T="Guid?" @bind-Value="_resourceId"
                           Placeholder="— none —"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="bpd__dest-select">
                    @foreach (var r in _resources)
                    {
                        <MudSelectItem T="Guid?" Value="@r.Id">@r.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @* Status *@
            <p class="bpd__section-label mt-4">Mark as</p>
            <div class="bpd__statuses">
                @foreach (var s in new[] { NoteStatus.Active, NoteStatus.Distilled, NoteStatus.Archived })
                {
                    var active = s == _status;
                    <button type="button"
                            class="bpd__status @(active ? "bpd__status--active" : "")"
                            @onclick="() => _status = s">
                        <MudIcon Icon="@StatusIcon(s)" Class="bpd__status-icon" />
                        <span class="bpd__status-label">@s</span>
                    </button>
                }
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="bpd__btn-cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DoneAll"
                   OnClick="Confirm"
                   Class="bpd__btn-confirm">
            Process @NoteCount note@(NoteCount == 1 ? "" : "s")
        </MudButton>
    </DialogActions>

</MudDialog>

<style>
    .bpd .mud-dialog-title {
        padding-bottom: 0;
    }

    .bpd__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--ink);
    }

    .bpd__title-icon {
        color: var(--clay);
        display: flex;
    }

    .bpd__body {
        padding: 0.25rem 0 0.5rem;
    }

    .bpd__summary {
        font-family: var(--font-body);
        font-size: 0.875rem;
        color: var(--ink-soft);
        margin: 0 0 1.25rem;
    }

    .bpd__count {
        color: var(--clay);
    }

    .bpd__section-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-soft);
        margin: 0 0 0.65rem;
    }

    .bpd__optional {
        font-weight: 400;
        text-transform: none;
        letter-spacing: 0;
        color: var(--ink-faint);
        font-size: 0.7rem;
    }

    .bpd__dest-select {
        margin-bottom: 0.25rem;
    }

    /* ── Category picker ── */
    .bpd__categories {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .bpd__cat {
        display: grid;
        grid-template-columns: 10px 1fr max-content max-content;
        align-items: center;
        gap: 0.7rem;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid var(--line);
        border-radius: 8px;
        background: var(--paper-raised);
        cursor: pointer;
        font-family: var(--font-body);
        text-align: left;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        width: 100%;
    }

    .bpd__cat:hover {
        border-color: var(--clay-ring);
        background: var(--paper);
        box-shadow: var(--shadow-sm);
    }

    .bpd__cat--active {
        border-color: var(--clay);
        background: var(--clay-soft);
        box-shadow: 0 0 0 3px var(--clay-ring);
    }

    .bpd__cat-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .bpd__cat-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--ink);
    }

    .bpd__cat-desc {
        font-size: 0.75rem;
        color: var(--ink-faint);
    }

    .bpd__cat-check {
        color: var(--clay);
        font-size: 1rem !important;
        width: 1rem !important;
        height: 1rem !important;
    }

    /* ── Status picker ── */
    .bpd__statuses {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .bpd__status {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.85rem;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        background: var(--paper-raised);
        cursor: pointer;
        font-family: var(--font-body);
        font-size: 0.83rem;
        font-weight: 500;
        color: var(--ink-soft);
        transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    }

    .bpd__status:hover {
        border-color: var(--clay-ring);
        color: var(--ink);
    }

    .bpd__status--active {
        border-color: var(--clay);
        background: var(--clay-soft);
        color: var(--clay-deep);
        font-weight: 600;
    }

    .bpd__status-icon {
        font-size: 0.95rem !important;
        width: 0.95rem !important;
        height: 0.95rem !important;
    }

    /* ── Footer buttons ── */
    .bpd__btn-cancel {
        color: var(--ink-soft) !important;
    }

    .bpd__btn-confirm {
        background: var(--clay) !important;
        color: #fff !important;
    }

    .bpd__btn-confirm:hover {
        background: var(--clay-deep) !important;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int NoteCount { get; set; }

    private ParaCategory _category = ParaCategory.Project;
    private NoteStatus _status = NoteStatus.Active;
    private Guid? _projectId;
    private Guid? _areaId;
    private Guid? _resourceId;

    private IReadOnlyList<ProjectDto> _projects = [];
    private IReadOnlyList<AreaDto> _areas = [];
    private IReadOnlyList<ResourceDto> _resources = [];

    protected override async Task OnInitializedAsync()
    {
        _projects  = await ProjectService.GetAllActiveAsync();
        _areas     = await AreaService.GetAllActiveAsync();
        _resources = await ResourceService.GetAllActiveAsync();
    }

    private void OnCategoryChanged(ParaCategory cat)
    {
        _category   = cat;
        _projectId  = null;
        _areaId     = null;
        _resourceId = null;
    }

    /// <summary>Result tuple returned to the caller on confirmation.</summary>
    public record BulkProcessResult(
        ParaCategory Category,
        NoteStatus Status,
        Guid? ProjectId,
        Guid? AreaId,
        Guid? ResourceId);

    private void Confirm() =>
        MudDialog.Close(DialogResult.Ok(new BulkProcessResult(
            _category, _status, _projectId, _areaId, _resourceId)));

    private void Cancel() => MudDialog.Cancel();

    private static string DotColor(ParaCategory cat) => cat switch
    {
        ParaCategory.Project  => "#c0561d",
        ParaCategory.Area     => "#6f7a5a",
        ParaCategory.Resource => "#3a7bcd",
        ParaCategory.Archive  => "#9a9180",
        _                     => "#9a9180"
    };

    private static string CatDesc(ParaCategory cat) => cat switch
    {
        ParaCategory.Project  => "Active outcome",
        ParaCategory.Area     => "Ongoing responsibility",
        ParaCategory.Resource => "Reference material",
        ParaCategory.Archive  => "Inactive / kept",
        _                     => ""
    };

    private static string StatusIcon(NoteStatus s) => s switch
    {
        NoteStatus.Active    => Icons.Material.Outlined.PlayCircle,
        NoteStatus.Distilled => Icons.Material.Outlined.AutoAwesome,
        NoteStatus.Archived  => Icons.Material.Outlined.Archive,
        _                    => Icons.Material.Outlined.Circle
    };
}
