@* Note editing is now handled via a MudBlazor dialog opened from /notes.
   This route exists only for backwards compatibility and redirects gracefully. *@
@page "/notes/{id:guid}"
@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    [Parameter] public Guid Id { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo("/notes", replace: true);
}
