@* Note editing is handled via a MudBlazor dialog opened from /notes.
   This route exists for deep links (e.g. search results) and forwards
   the note id so the editor dialog opens automatically. *@
@page "/notes/{id:guid}"
@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    [Parameter] public Guid Id { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo($"/notes?open={Id}", replace: true);
}
