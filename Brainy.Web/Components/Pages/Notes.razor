@page "/notes"
@rendermode InteractiveServer
@attribute [Authorize]
@namespace Brainy.Web.Components.Pages.NotesPage

@using Brainy.Application.DTOs.Notes
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Notes
@using Brainy.Web.Components.Pages.Templates
@using Brainy.Application.DTOs.Templates

@inject INoteService NoteService
@inject INoteTemplateService NoteTemplateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<Notes> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<style>

    /* ── Page Layout ── */
    .nn-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .nn-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .nn-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar & Hero ── */
    .nn-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
    }

    .nn-hero {
        margin-bottom: 2rem;
    }

    .nn-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .nn-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
    }
    
    .nn-action-container {
        margin-top: 1rem;
        padding-top: 1.5rem;
        border-top: 2px solid var(--mud-palette-lines-default);
    }

    /* ── Main Area ── */
    .nn-main {
        animation: nn-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @@keyframes nn-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .nn-section-head {
        display: flex;
        align-items: baseline;
        gap: 0.65rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    
    .nn-section-label {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
    }

    /* ── Favorites Grid ── */
    .nn-fav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .nn-fav-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .nn-fav-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, #ed6c02, #fbc02d);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .nn-fav-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(192, 86, 29, 0.08);
        border-color: rgba(192, 86, 29, 0.35); 
    }
    
    .nn-fav-card:hover::before {
        opacity: 1;
    }

    .nn-fav-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.2;
        color: var(--mud-palette-text-primary);
        margin: 0;
    }

    .nn-fav-open, .nn-note-open {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
        text-align: left;
    }

    .nn-fav-open:hover, .nn-note-open:hover { color: var(--clay); text-decoration: underline; text-underline-offset: .16em; }
    .nn-fav-open:focus-visible, .nn-note-open:focus-visible {
        outline: 3px solid var(--clay-ring);
        outline-offset: 2px;
    }

    .nn-fav-summary {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── MudTable Stying deep ── */
    ::deep .mud-table {
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: none !important;
        font-family: 'Hanken Grotesk', sans-serif !important;
        overflow: hidden;
    }

    ::deep .mud-table-head {
        background: var(--mud-palette-table-lines);
    }

    ::deep .mud-table-head th {
        font-weight: 700 !important;
        color: var(--mud-palette-text-primary) !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.75rem !important;
    }

    ::deep .mud-table-cell {
        font-size: 0.9rem !important;
        border-bottom: 1px solid var(--mud-palette-lines-default) !important;
    }

    ::deep .mud-table-row {
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    ::deep .mud-table-row:hover {
        background-color: rgba(192, 86, 29, 0.04) !important;
    }
    
    ::deep .mud-button-filled.mud-button-filled-primary {
        background-color: #1a1a1a;
        color: white;
    }
</style>

<AuthorizeView>
    <Authorized>
        <div class="nn-page">
            <div class="nn-layout">

                @* ── Sidebar ── *@
                <aside class="nn-sidebar">
                    <div class="nn-hero">
                        <p class="nn-eyebrow">@Localizer["Eyebrow"]</p>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <h1 class="nn-title">@Localizer["Title"]</h1>
                            <MudSpacer />
                            <PageHelpButton Guide="HelpGuide" />
                        </div>
                    </div>

                    <MudTextField @bind-Value="_searchText"
                                  Placeholder="@Localizer["SearchPlaceholder"]"
                                  aria-label="@Localizer["SearchAriaLabel"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />

                    <MudSelect T="ParaCategory" @bind-SelectedValues="_selectedCategories"
                               MultiSelection="true"
                               Label="@Localizer["CategoryLabel"]"
                               Placeholder="@Localizer["CategoryPlaceholder"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Dense="true"
                               Class="mb-3">
                        @foreach (var category in Enum.GetValues<ParaCategory>())
                        {
                            <MudSelectItem T="ParaCategory" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="NoteStatus" @bind-SelectedValues="_selectedStatuses"
                               MultiSelection="true"
                               Label="@Localizer["StatusLabel"]"
                               Placeholder="@Localizer["StatusPlaceholder"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Dense="true"
                               Class="mb-3">
                        @foreach (var status in Enum.GetValues<NoteStatus>())
                        {
                            <MudSelectItem T="NoteStatus" Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSwitch T="bool" @bind-Value="_favoritesOnly"
                               Color="Color.Warning"
                               Label="@Localizer["FavoritesOnlyLabel"]"
                               Class="mb-3" />

                    @if (HasActiveFilters)
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                                   OnClick="ClearFilters"
                                   Class="mb-2">
                            @Localizer["ClearFilters"]
                        </MudButton>
                    }

                    <div class="nn-action-container">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialogAsync"
                                   FullWidth="true"
                                   Style="border-radius: 8px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
                            @Localizer["WriteNewNote"]
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="OpenNoteTemplatePickerAsync"
                                   FullWidth="true"
                                   Class="mt-2">
                            @Localizer["FromTemplate"]
                        </MudButton>
                    </div>
                </aside>

                @* ── Main Layout ── *@
                <main class="nn-main">
                    @if (_loading)
                    {
                        <div style="padding:4rem; text-align:center;">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                        </div>
                    }
                    else if (_loadError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            @Localizer["LoadError"]
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadNotesAsync" Class="ml-2">@Localizer["Retry"]</MudButton>
                        </MudAlert>
                    }
                    else
                    {
                        @if (FavoriteNotes.Any())
                        {
                            <div class="nn-section-head">
                                <span class="nn-section-label">@Localizer["QuickAccess"]</span>
                            </div>
                            <div class="nn-fav-grid">
                                @foreach (var note in FavoriteNotes)
                                {
                                    <article class="nn-fav-card">
                                        <div style="display:flex; justify-content:space-between; align-items:start;">
                                            <h3 class="nn-fav-title"><button type="button" class="nn-fav-open" @onclick="() => OpenEditDialogAsync(note.Id)">@note.Title</button></h3>
                                            <span>
                                                <MudIconButton Icon="@Icons.Material.Filled.Star"
                                                               Color="Color.Warning"
                                                               Size="Size.Small"
                                                               aria-label="@Localizer["RemoveFromFavoritesAria", note.Title]"
                                                               OnClick="@(() => ToggleFavoriteAsync(note.Id))" />
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(note.AiSummary))
                                        {
                                            <p class="nn-fav-summary">@TruncateSummary(note.AiSummary)</p>
                                        }
                                        <div style="display:flex; gap:0.5rem; margin-top:auto; padding-top:1rem;">
                                            <MudChip T="string" Size="Size.Small" Color="CategoryColor(note.ParaCategory)" Variant="Variant.Outlined">@note.ParaCategory</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="StatusColor(note.Status)" Variant="Variant.Outlined">@note.Status</MudChip>
                                        </div>
                                    </article>
                                }
                            </div>
                        }

                        @if (_notes.Count == 0)
                        {
                            <div style="padding: 4rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                                <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Style="font-size:3.5rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                                <h2 style="font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">@Localizer["NoNotesYetTitle"]</h2>
                                <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">@Localizer["NoNotesYetDescription"]</p>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">
                                    @Localizer["CreateFirstNote"]
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <div class="nn-section-head" style="margin-top:2rem;">
                                <span class="nn-section-label">@Localizer["Library"]</span>
                            </div>
                            
                            <MudTable Items="FilteredNotes"
                                      Dense="false"
                                      Hover="true"
                                      Striped="false"
                                      Breakpoint="Breakpoint.Sm"
                                      RowsPerPage="10"
                                      T="NoteDto"
                                      MultiSelection="true"
                                      @bind-SelectedItems="_selectedNotes"
                                      Class="notes-table">
                                
                                <ToolBarContent>
                                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                                        @Localizer[FilteredNotes.Count() == 1 ? "NoteCountSingular" : "NoteCountPlural", FilteredNotes.Count()]
                                        @if (HasActiveFilters)
                                        {
                                            <span> @Localizer["MatchingFilters"]</span>
                                        }
                                    </MudText>
                                    <MudSpacer />
                                    @if (_selectedNotes.Count > 0)
                                    {
                                        <div class="notes-bulk-bar" style="display:flex; align-items:center; background:rgba(192, 86, 29, 0.1); padding:4px 8px; border-radius:8px; border: 1px solid rgba(192, 86, 29, 0.3);">
                                            <MudChip T="string" Size="Size.Small" Style="background: var(--mud-palette-surface);" Variant="Variant.Filled" Class="mr-2">
                                                <span style="color: var(--mud-palette-text-primary); font-weight: 600;">@Localizer["SelectedCount", _selectedNotes.Count]</span>
                                            </MudChip>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.DriveFileMove"
                                                       OnClick="BulkMoveCategoryAsync">
                                                @Localizer["MoveTo"]
                                            </MudButton>
                                        </div>
                                    }
                                </ToolBarContent>

                                <HeaderContent>
                                    <MudTh Style="width:48px"></MudTh>
                                    <MudTh>@Localizer["ColumnTitle"]</MudTh>
                                    <MudTh>@Localizer["ColumnCategory"]</MudTh>
                                    <MudTh>@Localizer["ColumnStatus"]</MudTh>
                                    <MudTh>@Localizer["ColumnUpdated"]</MudTh>
                                    <MudTh Style="width:48px"></MudTh>
                                </HeaderContent>

                                <RowTemplate Context="noteContext">
                                    <MudTd>
                                        <span @onclick:stopPropagation="true">
                                            <MudIconButton Icon="@(noteContext.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                                           Color="@(noteContext.IsFavorite ? Color.Warning : Color.Default)"
                                                           Size="Size.Small"
                                                           aria-label="@FavoriteAriaLabel(noteContext)"
                                                           OnClick="@(() => ToggleFavoriteAsync(noteContext.Id))" />
                                        </span>
                                    </MudTd>
                                    <MudTd DataLabel="Title">
                                        <div style="display:flex; align-items:center; gap:0.4rem; font-family: var(--font-display); font-size:1.1rem; color:var(--mud-palette-text-primary); margin-bottom:0.25rem;">
                                            <button type="button" class="nn-note-open"
                                                    @onclick="() => OpenEditDialogAsync(noteContext.Id)"
                                                    @onclick:stopPropagation="true">
                                                <strong>@noteContext.Title</strong>
                                            </button>
                                            @if (noteContext.HasImages)
                                            {
                                                <MudTooltip Text="@Localizer["ContainsImagesTooltip"]" Placement="Placement.Top">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Image"
                                                             Style="font-size:1rem; color:var(--mud-palette-text-secondary); flex-shrink:0;" />
                                                </MudTooltip>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(noteContext.AiSummary))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block;">
                                                @TruncateSummary(noteContext.AiSummary)
                                            </MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Category">
                                        <MudChip T="string" Size="Size.Small" Color="CategoryColor(noteContext.ParaCategory)" Variant="Variant.Outlined">
                                            @noteContext.ParaCategory
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small" Color="StatusColor(noteContext.Status)" Variant="Variant.Outlined">
                                            @noteContext.Status
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Updated">
                                        <div style="color:var(--mud-palette-text-secondary); font-size: 0.8rem;"><UserLocalTime Utc="noteContext.UpdatedAtUtc" /></div>
                                    </MudTd>
                                    <MudTd>
                                        <span @onclick:stopPropagation="true">
                                            <MudTooltip Text="@Localizer["SaveAsTemplateTooltip"]">
                                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                                               Size="Size.Small"
                                                               aria-label="@Localizer["SaveAsTemplateAria", noteContext.Title]"
                                                               OnClick="@(() => SaveAsTemplateAsync(noteContext))" />
                                            </MudTooltip>
                                        </span>
                                    </MudTd>
                                </RowTemplate>

                                <NoRecordsContent>
                                    <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Style="font-size:3rem;" Color="Color.Secondary" />
                                                        <MudText Typo="Typo.subtitle1">@Localizer["NoNotesMatchFilters"]</MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                            @Localizer["TryDifferentKeywords"] <MudLink @onclick="ClearFilters">@Localizer["ClearAllFiltersLink"]</MudLink>.
                                        </MudText>
                                    </MudStack>
                                </NoRecordsContent>

                                <PagerContent>
                                    <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                                </PagerContent>

                            </MudTable>
                        }
                    }
                </main>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "notes",
        PageTitle = "Notes",
        Tagline = "Your organised knowledge base — every note you have captured",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.Notes,
                Lead = "Notes is the home of all your knowledge. Browse, search and open everything you have captured and distilled across projects, areas and resources.",
                Points =
                [
                    "Search your whole knowledge base from one place.",
                    "Pin the notes you reach for most as favourites.",
                    "Open any note to read, refine or link it.",
                    "Create a fresh note whenever an idea is worth keeping."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "Notes are the building blocks of your Second Brain. In Tiago Forte's CODE method they hold what you Capture and what you Distill — the raw material you later reuse to create.",
                Points =
                [
                    "Keep the original source so insights stay trustworthy.",
                    "Distil with progressive summarisation: highlight, then summarise the highlights.",
                    "Link related notes so ideas connect instead of sitting in isolation."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use the search box to find a note by title.",
                    "Click a note to open it for reading or editing.",
                    "Mark important notes as favourites for quick access.",
                    "Create a new note when you have something worth capturing.",
                    "Distil and link notes over time so they stay useful months later."
                ]
            }
        ]
    };

    private IReadOnlyList<NoteDto> _notes = [];
    private string _searchText = string.Empty;
    private bool _loading = true;
    private string? _loadError;
    private HashSet<NoteDto> _selectedNotes = [];
    private IEnumerable<ParaCategory> _selectedCategories = [];
    private IEnumerable<NoteStatus> _selectedStatuses = [];
    private bool _favoritesOnly;

    private IEnumerable<NoteDto> FavoriteNotes =>
        _notes.Where(n => n.IsFavorite);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || _selectedCategories.Any()
        || _selectedStatuses.Any()
        || _favoritesOnly;

    private IEnumerable<NoteDto> FilteredNotes =>
        _notes.Where(n =>
            (string.IsNullOrWhiteSpace(_searchText) || n.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            && (!_selectedCategories.Any() || _selectedCategories.Contains(n.ParaCategory))
            && (!_selectedStatuses.Any() || _selectedStatuses.Contains(n.Status))
            && (!_favoritesOnly || n.IsFavorite));

    private string FavoriteAriaLabel(NoteDto note) => note.IsFavorite
        ? Localizer["RemoveFromFavoritesAria", note.Title]
        : Localizer["AddToFavoritesAria", note.Title];

    private static readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth        = MaxWidth.Large,
        FullWidth       = true,
        BackdropClick   = false,
        CloseOnEscapeKey = false,
        CloseButton     = false,
    };

    /// <summary>Note id from a deep link (e.g. /notes/{id} redirect); opens the editor on load.</summary>
    [SupplyParameterFromQuery(Name = "open")]
    public Guid? OpenNoteId { get; set; }

    /// <summary>Set by the command palette's "New note" command (issue #318) to open the
    /// create dialog on load, exactly as the page's own "New Note" button would.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool? CreateFromQuery { get; set; }

    private bool _deepLinkHandled;
    private bool _paletteCreateHandled;

    protected override async Task OnInitializedAsync() => await LoadNotesAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (OpenNoteId.HasValue && !_deepLinkHandled)
        {
            _deepLinkHandled = true;
            await OpenEditDialogAsync(OpenNoteId.Value);
            return;
        }

        if (CreateFromQuery == true && !_paletteCreateHandled)
        {
            _paletteCreateHandled = true;
            await OpenCreateDialogAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _notes = await NoteService.GetAllAsync();
            _selectedNotes.Clear();
        }
        catch
        {
            _loadError = "Unable to reach the notes library.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadNotesAsync();
    }

    private async Task OpenNoteTemplatePickerAsync()
    {
        var dialog = await DialogService.ShowAsync<NoteTemplatePickerDialog>("New note from template", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is NoteDto)
            await LoadNotesAsync();
    }

    private async Task SaveAsTemplateAsync(NoteDto note)
    {
        var parameters = new DialogParameters<SaveAsTemplateDialog>
        {
            { x => x.Message, $"Save \"{note.Title}\" — its title and content — as a reusable template." }
        };
        var dialog = await DialogService.ShowAsync<SaveAsTemplateDialog>("Save as template", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string templateName) return;

        await NoteTemplateService.CreateFromNoteAsync(new SaveNoteAsTemplateDto(note.Id, templateName));
        Snackbar.Add($"Saved \"{templateName}\" as a template.", Severity.Success);
    }

    private async Task OpenEditDialogAsync(Guid noteId)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, noteId }
        };
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadNotesAsync();
    }

    private async Task ToggleFavoriteAsync(Guid noteId)
    {
        try
        {
            var updated = await NoteService.ToggleFavoriteAsync(noteId);
            // Update in place to avoid a full reload
            _notes = _notes.Select(n => n.Id == noteId ? updated : n).ToList();
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Could not update favorite.", Severity.Error);
        }
    }

    private async Task BulkMoveCategoryAsync()
    {
        if (_selectedNotes.Count == 0) return;

        var mostCommon = _selectedNotes
            .GroupBy(n => n.ParaCategory)
            .OrderByDescending(g => g.Count())
            .First().Key;

        var parameters = new DialogParameters<MoveCategoryDialog>
        {
            { x => x.NoteCount,        _selectedNotes.Count },
            { x => x.InitialCategory,  mostCommon           }
        };

        var opts = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = true };
        var dialog = await DialogService.ShowAsync<MoveCategoryDialog>("", parameters, opts);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ParaCategory targetCategory })
        {
            var ids = _selectedNotes.Select(n => n.Id);
            var moved = await NoteService.BulkMoveCategoryAsync(ids, targetCategory);
            Snackbar.Add($"{moved} note{(moved == 1 ? "" : "s")} moved to {targetCategory}.", Severity.Success);
            await LoadNotesAsync();
        }
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _selectedCategories = [];
        _selectedStatuses = [];
        _favoritesOnly = false;
    }

    private static string TruncateSummary(string summary) =>
        summary.Length <= 120 ? summary : summary[..120] + "…";

    private static Color CategoryColor(ParaCategory category) => category switch
    {
        ParaCategory.Project  => Color.Primary,
        ParaCategory.Area     => Color.Tertiary,
        ParaCategory.Resource => Color.Info,
        ParaCategory.Archive  => Color.Default,
        _                     => Color.Default
    };

    private static Color StatusColor(NoteStatus status) => status switch
    {
        NoteStatus.Inbox     => Color.Warning,
        NoteStatus.Active    => Color.Success,
        NoteStatus.Distilled => Color.Info,
        NoteStatus.Archived  => Color.Default,
        _                    => Color.Default
    };
}

