@page "/notes"
@rendermode InteractiveServer
@attribute [Authorize]
@namespace Brainy.Web.Components.Pages.NotesPage

@using Brainy.Application.DTOs.Notes
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Notes

@inject INoteService NoteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Notes – Brainy</PageTitle>

<MudStack Row="false" Spacing="4">

    @* Header row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.Notes" Class="mr-2" />Notes
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialogAsync">
            New Note
        </MudButton>
    </MudStack>

    @* Search box *@
    <MudTextField @bind-Value="_searchText"
                  Placeholder="Search notes by title…"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Class="mb-2" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (FavoriteNotes.Any())
    {
        @* ── Favorites section ── *@
        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" Class="mr-1" />
            Favorites
        </MudText>
        <MudGrid Spacing="2" Class="mb-4">
            @foreach (var note in FavoriteNotes)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-3 d-flex flex-column gap-1" Elevation="1" Style="cursor:pointer;"
                              @onclick="() => OpenEditDialogAsync(note.Id)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body1"><strong>@note.Title</strong></MudText>
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Star"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               Title="Remove from favorites"
                                               OnClick="@(() => ToggleFavoriteAsync(note.Id))" />
                            </span>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(note.AiSummary))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@TruncateSummary(note.AiSummary)</MudText>
                        }
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Size="Size.Small" Color="CategoryColor(note.ParaCategory)" Variant="Variant.Outlined">@note.ParaCategory</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="StatusColor(note.Status)" Variant="Variant.Filled">@note.Status</MudChip>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudDivider Class="mb-4" />
    }

    @if (!_loading && _notes.Count == 0)
    {
        @* Empty state: no notes exist yet *@
        <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0" Outlined="true">
            <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Style="font-size:4rem;"
                     Color="Color.Secondary" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">No notes yet</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Capture your first piece of knowledge to get started.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">
                Create your first note
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudTable Items="FilteredNotes"
                  Dense="false"
                  Hover="true"
                  Striped="false"
                  Breakpoint="Breakpoint.Sm"
                  RowsPerPage="10"
                  OnRowClick="OnRowClick"
                  T="NoteDto"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedNotes"
                  Class="cursor-pointer">

            <ToolBarContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                    @FilteredNotes.Count() note@(FilteredNotes.Count() == 1 ? "" : "s")
                    @if (!string.IsNullOrWhiteSpace(_searchText))
                    {
                        <span> matching "<strong>@_searchText</strong>"</span>
                    }
                </MudText>
                <MudSpacer />
                @if (_selectedNotes.Count > 0)
                {
                    <div class="notes-bulk-bar">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="mr-2">
                            @_selectedNotes.Count selected
                        </MudChip>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.DriveFileMove"
                                   OnClick="BulkMoveCategoryAsync">
                            Move to…
                        </MudButton>
                    </div>
                }
            </ToolBarContent>

            <HeaderContent>
                <MudTh Style="width:48px"></MudTh>
                <MudTh>Title</MudTh>
                <MudTh>Category</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Updated</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@(context.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                       Color="@(context.IsFavorite ? Color.Warning : Color.Default)"
                                       Size="Size.Small"
                                       Title="@(context.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                                       OnClick="@(() => ToggleFavoriteAsync(context.Id))" />
                    </span>
                </MudTd>
                <MudTd DataLabel="Title">
                    <MudText Typo="Typo.body1"><strong>@context.Title</strong></MudText>
                    @if (!string.IsNullOrWhiteSpace(context.AiSummary))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @TruncateSummary(context.AiSummary)
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Category">
                    <MudChip T="string" Size="Size.Small" Color="CategoryColor(context.ParaCategory)" Variant="Variant.Outlined">
                        @context.ParaCategory
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)" Variant="Variant.Filled">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Updated">
                    <MudText Typo="Typo.body2">@context.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</MudText>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudStack Class="pa-6" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Style="font-size:3rem;" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">No notes match your search</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Try different keywords or <MudLink @onclick="ClearSearch">clear the search</MudLink>.
                    </MudText>
                </MudStack>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
            </PagerContent>

        </MudTable>
    }

</MudStack>

@code {
    private IReadOnlyList<NoteDto> _notes = [];
    private string _searchText = string.Empty;
    private bool _loading = true;
    private HashSet<NoteDto> _selectedNotes = [];

    private IEnumerable<NoteDto> FavoriteNotes =>
        _notes.Where(n => n.IsFavorite);

    private IEnumerable<NoteDto> FilteredNotes =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _notes
            : _notes.Where(n => n.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private static readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth        = MaxWidth.Large,
        FullWidth       = true,
        BackdropClick   = false,
        CloseOnEscapeKey = false,
        CloseButton     = false,
    };

    protected override async Task OnInitializedAsync() => await LoadNotesAsync();

    private async Task LoadNotesAsync()
    {
        _loading = true;
        _notes   = await NoteService.GetAllAsync();
        _selectedNotes.Clear();
        _loading = false;
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadNotesAsync();
    }

    private async Task OpenEditDialogAsync(Guid noteId)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, noteId }
        };
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadNotesAsync();
    }

    private async Task ToggleFavoriteAsync(Guid noteId)
    {
        try
        {
            var updated = await NoteService.ToggleFavoriteAsync(noteId);
            // Update in place to avoid a full reload
            _notes = _notes.Select(n => n.Id == noteId ? updated : n).ToList();
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Could not update favorite.", Severity.Error);
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<NoteDto> args)
    {
        await OpenEditDialogAsync(args.Item!.Id);
    }

    private async Task BulkMoveCategoryAsync()
    {
        if (_selectedNotes.Count == 0) return;

        var mostCommon = _selectedNotes
            .GroupBy(n => n.ParaCategory)
            .OrderByDescending(g => g.Count())
            .First().Key;

        var parameters = new DialogParameters<MoveCategoryDialog>
        {
            { x => x.NoteCount,        _selectedNotes.Count },
            { x => x.InitialCategory,  mostCommon           }
        };

        var opts = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = true };
        var dialog = await DialogService.ShowAsync<MoveCategoryDialog>("", parameters, opts);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ParaCategory targetCategory })
        {
            var ids = _selectedNotes.Select(n => n.Id);
            var moved = await NoteService.BulkMoveCategoryAsync(ids, targetCategory);
            Snackbar.Add($"{moved} note{(moved == 1 ? "" : "s")} moved to {targetCategory}.", Severity.Success);
            await LoadNotesAsync();
        }
    }

    private void ClearSearch() => _searchText = string.Empty;

    private static string TruncateSummary(string summary) =>
        summary.Length <= 120 ? summary : summary[..120] + "…";

    private static Color CategoryColor(ParaCategory category) => category switch
    {
        ParaCategory.Project  => Color.Primary,
        ParaCategory.Area     => Color.Tertiary,
        ParaCategory.Resource => Color.Info,
        ParaCategory.Archive  => Color.Default,
        _                     => Color.Default
    };

    private static Color StatusColor(NoteStatus status) => status switch
    {
        NoteStatus.Inbox     => Color.Warning,
        NoteStatus.Active    => Color.Success,
        NoteStatus.Distilled => Color.Info,
        NoteStatus.Archived  => Color.Default,
        _                    => Color.Default
    };
}
