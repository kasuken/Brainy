@namespace Brainy.Web.Components.Pages.Week

<nav class="wv-switch" aria-label="Execution view">
    <a class="wv-switch__item @(IsToday ? "wv-switch__item--active" : null)"
       href="/today"
       aria-current="@(IsToday ? "page" : null)">
        <MudIcon Icon="@Icons.Material.Outlined.WbSunny" Size="Size.Small" />
        <span>Today</span>
    </a>
    <a class="wv-switch__item @(IsToday ? null : "wv-switch__item--active")"
       href="/today/week"
       aria-current="@(IsToday ? null : "page")">
        <MudIcon Icon="@Icons.Material.Outlined.DateRange" Size="Size.Small" />
        <span>Week</span>
    </a>
</nav>

<style>
    .wv-switch {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem;
        border-radius: 999px;
        background: rgba(255,255,255,.72);
        border: 1px solid rgba(124, 97, 65, .18);
        box-shadow: 0 12px 32px rgba(72, 54, 33, .08);
        backdrop-filter: blur(8px);
    }

    .wv-switch__item {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem .9rem;
        border-radius: 999px;
        color: var(--ink-soft, var(--mud-palette-text-secondary));
        text-decoration: none;
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .02em;
        transition: background-color .18s ease, color .18s ease, transform .18s ease;
    }

    .wv-switch__item:hover {
        color: var(--clay, #c0561d);
        transform: translateY(-1px);
    }

    .wv-switch__item--active {
        background: linear-gradient(135deg, rgba(192, 86, 29, .13), rgba(245, 190, 102, .15));
        color: var(--clay, #c0561d);
        box-shadow: inset 0 0 0 1px rgba(192, 86, 29, .18);
    }

    .wv-switch__item:focus-visible {
        outline: 3px solid rgba(192, 86, 29, .25);
        outline-offset: 2px;
    }
</style>

@code {
    [Parameter]
    public bool IsToday { get; set; }
}
