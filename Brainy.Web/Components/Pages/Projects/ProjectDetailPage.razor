@page "/projects/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.Outputs
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Pages.Notes
@attribute [Authorize]
@implements IAsyncDisposable
@inject IProjectService ProjectService
@inject ITaskService TaskService
@inject INoteService NoteService
@inject IOutputService OutputService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_detail?.Name ?? "Project") — Brainy</PageTitle>

@if (_loading)
{
    <div class="pd-loading">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_detail is null)
{
    <div class="pd-notfound">
        <span class="pd-notfound__glyph">⬡</span>
        <p class="pd-notfound__title">Project not found</p>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick='() => Nav.NavigateTo("/projects")'>
            Back to Projects
        </MudButton>
    </div>
}
else
{
    <!-- ── Header ──────────────────────────────────────────────────── -->
    <div class="pd-header">
        <div class="pd-breadcrumb">
            <button class="pd-back" @onclick='() => Nav.NavigateTo("/projects")'>
                <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
                Projects
            </button>
            <span class="pd-breadcrumb__sep">›</span>
            <span class="pd-breadcrumb__current">@_detail.Emoji @_detail.Name</span>
        </div>

        <div class="pd-title-row">
            <div class="pd-ribbon pd-ribbon--@_detail.Priority.ToString().ToLower()"></div>
            <div class="pd-title-block">
                <div class="pd-badges">
                    <span class="pd-badge pd-status--@_detail.Status.ToString().ToLower()">
                        @StatusLabel(_detail.Status)
                    </span>
                    <span class="pd-badge pd-priority"
                          style="color:@PriorityColor(_detail.Priority);background:@PriorityBg(_detail.Priority)">
                        @PriorityLabel(_detail.Priority)
                    </span>
                </div>
                <div class="pd-heading-row">
                    <h1 class="pd-title">@_detail.Emoji @_detail.Name</h1>
                    <PageHelpButton Guide="HelpGuide" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_detail.DesiredOutcome))
                {
                    <p class="pd-outcome">
                        <span class="pd-outcome__label">Desired outcome</span>
                        @_detail.DesiredOutcome
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_detail.Description))
                {
                    <p class="pd-description">@_detail.Description</p>
                }
                @if (_detail.GoalId.HasValue && !string.IsNullOrWhiteSpace(_detail.GoalTitle))
                {
                    <div class="pd-goal-link">
                        <span class="pd-goal-link__label">Goal</span>
                        <a class="pd-goal-link__anchor" href="@($"/goals/{_detail.GoalId.Value}")">
                            @_detail.GoalTitle
                        </a>
                    </div>
                }
            </div>
            <div class="pd-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Size="Size.Small" OnClick="OpenEditDialog">
                    Edit
                </MudButton>
                @if (_detail.Status != ProjectStatus.Completed && _detail.Status != ProjectStatus.Archived)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Small" OnClick="OpenCompletionDialog">
                        Complete
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Archive"
                           Size="Size.Small" OnClick="ConfirmArchive">
                    Archive
                </MudButton>
            </div>
        </div>
    </div>

    <!-- ── Stats bar ────────────────────────────────────────────────── -->
    <div class="pd-stats">
        <div class="pd-stat">
            <span class="pd-stat__value">@OpenTaskCount</span>
            <span class="pd-stat__label">Open tasks</span>
        </div>
        <div class="pd-stat">
            <span class="pd-stat__value">@DoneTaskCount</span>
            <span class="pd-stat__label">Completed</span>
        </div>
        <div class="pd-stat">
            <span class="pd-stat__value">@_detail.Notes.Count</span>
            <span class="pd-stat__label">Notes</span>
        </div>
        <div class="pd-stat">
            <span class="pd-stat__value">@_detail.ResourceNotes.Count</span>
            <span class="pd-stat__label">Resources</span>
        </div>
        <div class="pd-stat pd-stat--wide">
            <div class="pd-stat__progress-row">
                <span class="pd-stat__pct">@ProgressPercent.ToString("F0")%</span>
                <div class="pd-stat__track">
                    <div class="pd-stat__fill" style="width:@(ProgressPercent.ToString("F0"))%"></div>
                </div>
            </div>
            <span class="pd-stat__label">
                Progress
                @if (_progressRefreshing)
                {
                    <span class="pd-progress-pulse" title="Updating…"></span>
                }
            </span>
        </div>
        @if (_detail.DueDate.HasValue)
        {
            <div class="pd-stat @(_detail.DueDate < DateTime.Today ? "pd-stat--overdue" : "")">
                <span class="pd-stat__value">@_detail.DueDate.Value.ToString("MMM d")</span>
                <span class="pd-stat__label">
                    @(_detail.DueDate < DateTime.Today ? "Overdue" : "Due date")
                </span>
            </div>
        }
    </div>

    <!-- ── Tabs ──────────────────────────────────────────────────────── -->
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             Class="pd-tabs" PanelClass="pd-panel">

        <!-- Tasks tab -->
        <MudTabPanel Text="Tasks" BadgeData="@(_detail.OpenTaskCount > 0 ? _detail.OpenTaskCount : (int?)null)"
                     BadgeColor="Color.Primary">
            <div class="pd-section-header">
                <h2 class="pd-section-title">Tasks</h2>
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick='() => OpenAddTaskDialog()'>
                    Add task
                </MudButton>
            </div>
            <TaskListComponent ProjectId="ProjectId" OnTaskChanged="OnBoardTaskChanged" />
        </MudTabPanel>

        <!-- Board tab -->
        <MudTabPanel Text="Board">
            <TaskBoardComponent ProjectId="ProjectId" OnTaskChanged="OnBoardTaskChanged" />
        </MudTabPanel>

        <!-- Notes tab -->
        <MudTabPanel Text="Notes" BadgeData="@(_detail.Notes.Count > 0 ? _detail.Notes.Count : (int?)null)"
                     BadgeColor="Color.Secondary">
            <div class="pd-section-header">
                <h2 class="pd-section-title">Notes</h2>
                <div class="d-flex gap-1">
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                               OnClick="OpenNewNoteDialog">
                        New note
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.AddLink" Size="Size.Small"
                               OnClick="OpenLinkNoteDialog">
                        Link existing
                    </MudButton>
                </div>
            </div>

            @if (!_detail.Notes.Any())
            {
                <div class="pd-empty">
                    <span class="pd-empty__icon">📝</span>
                    <p>No notes linked to this project yet.</p>
                </div>
            }
            else
            {
                <div class="pd-note-grid">
                    @foreach (var note in _detail.Notes)
                    {
                        <div class="pd-note-card" @onclick="() => OpenNote(note.Id)">
                            <div class="pd-note-card__header">
                                <span class="pd-note-status pd-note-status--@note.Status.ToString().ToLower()">
                                    @note.Status
                                </span>
                                <div class="pd-note-card__actions" @onclick:stopPropagation="true">
                                    <button class="pd-note-action" @onclick="() => UnlinkNote(note.Id, note.Title)" title="Remove from project">
                                        <svg viewBox="0 0 16 16" fill="currentColor" width="12" height="12">
                                            <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                        </svg>
                                    </button>
                                </div>
                                <span class="pd-note-card__date">@note.UpdatedAtUtc.ToString("MMM d")</span>
                            </div>
                            <h4 class="pd-note-card__title">@note.Title</h4>
                            @if (!string.IsNullOrWhiteSpace(note.AiSummary))
                            {
                                <p class="pd-note-card__summary">@note.AiSummary</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(note.Content))
                            {
                                <p class="pd-note-card__summary">
                                    @(note.Content.Length > 120 ? note.Content[..120] + "…" : note.Content)
                                </p>
                            }
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

        <!-- Resources tab -->
        <MudTabPanel Text="Resources" BadgeData="@(_detail.ResourceNotes.Count > 0 ? _detail.ResourceNotes.Count : (int?)null)"
                     BadgeColor="Color.Tertiary">
            <div class="pd-section-header">
                <h2 class="pd-section-title">Related Resources</h2>
            </div>

            @if (!_detail.ResourceNotes.Any())
            {
                <div class="pd-empty">
                    <span class="pd-empty__icon">📚</span>
                    <p>No resource notes linked to this project.</p>
                </div>
            }
            else
            {
                <div class="pd-note-grid">
                    @foreach (var res in _detail.ResourceNotes)
                    {
                        <div class="pd-note-card pd-note-card--resource" @onclick="() => OpenNote(res.Id)">
                            <div class="pd-note-card__header">
                                <span class="pd-resource-badge">Resource</span>
                                <span class="pd-note-card__date">@res.UpdatedAtUtc.ToString("MMM d")</span>
                            </div>
                            <h4 class="pd-note-card__title">@res.Title</h4>
                            @if (!string.IsNullOrWhiteSpace(res.AiSummary))
                            {
                                <p class="pd-note-card__summary">@res.AiSummary</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(res.Content))
                            {
                                <p class="pd-note-card__summary">
                                    @(res.Content.Length > 120 ? res.Content[..120] + "…" : res.Content)
                                </p>
                            }
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

        <!-- Outputs tab -->
        <MudTabPanel Text="Outputs" BadgeData="@(_outputs.Count > 0 ? _outputs.Count : (int?)null)"
                     BadgeColor="Color.Info">
            <div class="pd-section-header">
                <h2 class="pd-section-title">Related Outputs</h2>
            </div>

            @if (_outputs.Count == 0)
            {
                <div class="pd-empty">
                    <span class="pd-empty__icon">📄</span>
                    <p>No outputs linked to this project.</p>
                </div>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true" Class="pd-outputs-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var output in _outputs)
                        {
                            <tr>
                                <td>
                                    <MudLink Href="@($"/outputs/{output.Id}")" Color="Color.Default">
                                        @output.Title
                                    </MudLink>
                                </td>
                                <td><span class="pd-output-type">@OutputTypeLabel(output.Type)</span></td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@OutputStatusColor(output.Status)"
                                             Variant="Variant.Outlined">
                                        @output.Status.ToString()
                                    </MudChip>
                                </td>
                                <td><span class="pd-output-date">@RelativeDate(output.UpdatedAtUtc)</span></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>

        <!-- Info tab -->
        <MudTabPanel Text="Info">
            <div class="pd-info-grid">
                <div class="pd-info-row">
                    <span class="pd-info-label">Status</span>
                    <span class="pd-badge pd-status--@_detail.Status.ToString().ToLower()">@StatusLabel(_detail.Status)</span>
                </div>
                <div class="pd-info-row">
                    <span class="pd-info-label">Priority</span>
                    <span class="pd-badge pd-priority"
                          style="color:@PriorityColor(_detail.Priority);background:@PriorityBg(_detail.Priority)">
                        @PriorityLabel(_detail.Priority)
                    </span>
                </div>
                @if (_detail.StartDate.HasValue)
                {
                    <div class="pd-info-row">
                        <span class="pd-info-label">Start Date</span>
                        <span>@_detail.StartDate.Value.ToString("MMMM d, yyyy")</span>
                    </div>
                }
                @if (_detail.DueDate.HasValue)
                {
                    <div class="pd-info-row">
                        <span class="pd-info-label">Due Date</span>
                        <span class="@(_detail.DueDate < DateTime.Today ? "pd-overdue-text" : "")">
                            @_detail.DueDate.Value.ToString("MMMM d, yyyy")
                        </span>
                    </div>
                }
                @if (_detail.CompletedDate.HasValue)
                {
                    <div class="pd-info-row">
                        <span class="pd-info-label">Completed</span>
                        <span>@_detail.CompletedDate.Value.ToString("MMMM d, yyyy")</span>
                    </div>
                }
                <div class="pd-info-row">
                    <span class="pd-info-label">Created</span>
                    <span>@_detail.CreatedAtUtc.ToString("MMMM d, yyyy")</span>
                </div>
                <div class="pd-info-row">
                    <span class="pd-info-label">Last updated</span>
                    <span>@_detail.UpdatedAtUtc.ToString("MMMM d, yyyy 'at' h:mm tt")</span>
                </div>
            </div>
        </MudTabPanel>
    </MudTabs>
}

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Project Detail page — "Open Dossier" workspace style
   ═══════════════════════════════════════════════════════════════════════════ */

/* Loading / not-found */
.pd-loading, .pd-notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 6rem 1rem;
}
.pd-notfound__glyph {
    font-size: 3rem;
    opacity: .15;
    font-family: var(--font-display);
    color: var(--clay);
}
.pd-notfound__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink);
    margin: 0;
}

/* Breadcrumb */
.pd-breadcrumb {
    display: flex;
    align-items: center;
    gap: .4rem;
    margin-bottom: 1rem;
    font-size: .8rem;
    color: var(--ink-faint);
}
.pd-back {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--clay);
    font-family: var(--font-body);
    font-size: .8rem;
    font-weight: 600;
    padding: 0;
    transition: opacity .15s;
}
.pd-back:hover { opacity: .7; }
.pd-breadcrumb__sep { color: var(--line-strong); }
.pd-breadcrumb__current { color: var(--ink-soft); }

/* Header */
.pd-header {
    margin-bottom: 1.5rem;
}
.pd-title-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
}
.pd-ribbon {
    width: 5px;
    min-height: 80px;
    border-radius: 3px;
    flex-shrink: 0;
    margin-top: 4px;
}
.pd-ribbon--critical { background: var(--clay); }
.pd-ribbon--high     { background: #d4722a; }
.pd-ribbon--medium   { background: var(--gold); }
.pd-ribbon--low      { background: var(--sage); }

.pd-title-block { flex: 1; min-width: 0; }

.pd-heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .75rem;
}

.pd-heading-row .pd-title {
    flex: 1;
    min-width: 0;
}

.pd-badges { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .6rem; }

.pd-badge {
    display: inline-flex;
    align-items: center;
    padding: .2rem .65rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.pd-status--notstarted { background: var(--paper-sunk); color: var(--ink-soft); }
.pd-status--active     { background: rgba(111,122,90,.14); color: #4a5c38; }
.pd-status--waiting    { background: rgba(205,154,58,.14); color: #7a5c0e; }
.pd-status--completed  { background: rgba(192,86,29,.10); color: var(--clay-deep); }
.pd-status--archived   { background: var(--paper-sunk); color: var(--ink-faint); }

.pd-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 .5rem;
    letter-spacing: -.02em;
    line-height: 1.15;
}
.pd-outcome {
    font-size: .9rem;
    color: var(--ink-soft);
    margin: 0 0 .4rem;
    line-height: 1.5;
    padding: .5rem .75rem;
    border-left: 3px solid var(--clay);
    background: var(--clay-soft);
    border-radius: 0 8px 8px 0;
}
.pd-outcome__label {
    display: block;
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--clay);
    margin-bottom: .2rem;
}
.pd-description {
    font-size: .88rem;
    color: var(--ink-soft);
    margin: .4rem 0 0;
    line-height: 1.6;
}
.pd-goal-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    margin-top: .8rem;
    padding: .5rem .75rem;
    border-radius: 12px;
    border: 1px solid rgba(160,120,32,.18);
    background: rgba(160,120,32,.07);
}
.pd-goal-link__label {
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
}
.pd-goal-link__anchor {
    color: var(--clay-deep);
    font-weight: 600;
    text-decoration: none;
}
.pd-goal-link__anchor:hover { text-decoration: underline; }
.pd-actions {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    flex-shrink: 0;
}

/* Stats bar */
.pd-stats {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 1.75rem;
}
.pd-stat {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: .75rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: .15rem;
    min-width: 80px;
    box-shadow: var(--shadow-sm);
}
.pd-stat--wide { flex: 1; min-width: 200px; }
.pd-stat--overdue .pd-stat__value { color: #b03a18; }

.pd-stat__value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
}
.pd-stat__label {
    font-size: .7rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
}
.pd-stat__progress-row {
    display: flex;
    align-items: center;
    gap: .6rem;
}
.pd-stat__pct {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    flex-shrink: 0;
}
.pd-stat__track {
    flex: 1;
    height: 6px;
    background: var(--paper-sunk);
    border-radius: 999px;
    overflow: hidden;
}
.pd-stat__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--clay-deep), var(--clay));
    border-radius: 999px;
    transition: width .6s ease;
    min-width: 3px;
}

/* Tabs */
.pd-tabs .mud-tab {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: .85rem;
    text-transform: none;
    letter-spacing: 0;
}
.pd-panel { padding: 1.25rem 0 0; }

/* Section header */
.pd-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
}
.pd-section-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
}

/* Empty state */
.pd-empty {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--ink-faint);
    font-size: .9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
}
.pd-empty__icon { font-size: 2rem; opacity: .4; }
.pd-empty p { margin: 0; }

/* Task list */
.pd-task-list { display: flex; flex-direction: column; gap: .4rem; }

.pd-task {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    padding: .75rem .9rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color .15s, box-shadow .15s;
}
.pd-task:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
.pd-task--done { opacity: .55; }

.pd-task__check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    margin-top: 2px;
    transition: border-color .15s, background .15s;
    color: white;
}
.pd-task__check:hover { border-color: var(--sage); }
.pd-task__check--done {
    background: var(--sage);
    border-color: var(--sage);
}

.pd-task__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .2rem; }
.pd-task__title {
    font-size: .9rem;
    color: var(--ink);
    font-weight: 500;
    line-height: 1.4;
}
.pd-task--done .pd-task__title { text-decoration: line-through; }
.pd-task__desc { font-size: .78rem; color: var(--ink-soft); }

.pd-task__meta { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
.pd-task__subtasks {
    font-size: .72rem;
    background: var(--paper-sunk);
    border-radius: 999px;
    padding: .1rem .45rem;
    color: var(--ink-soft);
    font-weight: 600;
}
.pd-task__due { font-size: .75rem; color: var(--ink-soft); }
.pd-task__due--overdue { color: #b03a18; font-weight: 600; }
.pd-task__priority {
    font-size: .68rem;
    letter-spacing: .05em;
    text-transform: uppercase;
    font-weight: 700;
    padding: .1rem .4rem;
    border-radius: 4px;
}
.pd-tp--critical { color: #b03a18; background: rgba(176,58,24,.10); }
.pd-tp--high     { color: #d4722a; background: rgba(212,114,42,.10); }
.pd-tp--medium   { color: #a07820; background: rgba(160,120,32,.10); }
.pd-tp--low      { color: var(--sage); background: rgba(111,122,90,.10); }

/* Subtask progress bar */
.pd-subtask-progress {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: .25rem;
}
.pd-subtask-progress__track {
    flex: 1;
    height: 3px;
    background: var(--paper-sunk);
    border-radius: 999px;
    overflow: hidden;
    max-width: 80px;
}
.pd-subtask-progress__fill {
    height: 100%;
    background: var(--sage);
    border-radius: 999px;
    transition: width .4s ease;
}
.pd-subtask-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: .72rem;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-weight: 600;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: .2rem;
    transition: color .15s;
}
.pd-subtask-toggle:hover { color: var(--clay); }
.pd-subtask-toggle__chevron {
    display: inline-block;
    font-size: .9rem;
    transition: transform .2s ease;
    line-height: 1;
}
.pd-subtask-toggle__chevron--open { transform: rotate(90deg); }

/* Subtask list */
.pd-subtask-list {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    margin-top: .4rem;
    padding-left: .5rem;
    border-left: 2px solid var(--line);
}
.pd-subtask {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .35rem .5rem;
    border-radius: 6px;
    background: var(--paper-sunk);
    transition: background .15s;
}
.pd-subtask:hover { background: var(--paper-raised); }
.pd-subtask--done { opacity: .5; }
.pd-subtask__title {
    flex: 1;
    font-size: .82rem;
    color: var(--ink);
    font-weight: 400;
    line-height: 1.4;
}
.pd-subtask--done .pd-subtask__title { text-decoration: line-through; }
.pd-task__check--sm {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* Note cards */
.pd-note-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: .9rem;
}
.pd-note-card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: .9rem 1rem;
    cursor: pointer;
    transition: box-shadow .2s, border-color .2s, transform .15s;
    display: flex;
    flex-direction: column;
    gap: .5rem;
}
.pd-note-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
    transform: translateY(-1px);
}
.pd-note-card--resource { border-left: 3px solid var(--gold); }

.pd-note-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
}
.pd-note-card__actions {
    margin-left: auto;
    opacity: 0;
    transition: opacity .15s;
}
.pd-note-card:hover .pd-note-card__actions { opacity: 1; }
.pd-note-action {
    background: none;
    border: none;
    cursor: pointer;
    padding: .2rem;
    color: var(--ink-faint);
    border-radius: 4px;
    display: inline-flex;
    transition: color .15s, background .15s;
}
.pd-note-action:hover { color: #b03a18; background: rgba(176,58,24,.08); }
.pd-note-card__date { font-size: .72rem; color: var(--ink-faint); flex-shrink: 0; }
.pd-note-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
    line-height: 1.3;
}
.pd-note-card:hover .pd-note-card__title { color: var(--clay); }
.pd-note-card__summary {
    font-size: .78rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.pd-note-status {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: .15rem .45rem;
    border-radius: 999px;
}
.pd-note-status--inbox    { background: rgba(192,86,29,.12); color: var(--clay); }
.pd-note-status--active   { background: rgba(111,122,90,.12); color: #4a5c38; }
.pd-note-status--distilled { background: rgba(205,154,58,.12); color: #7a5c0e; }
.pd-note-status--archived { background: var(--paper-sunk); color: var(--ink-faint); }

.pd-resource-badge {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: .15rem .45rem;
    border-radius: 999px;
    background: rgba(205,154,58,.14);
    color: #7a5c0e;
}

/* Info tab */
.pd-info-grid { display: flex; flex-direction: column; gap: 0; max-width: 540px; }
.pd-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .75rem 0;
    border-bottom: 1px solid var(--line);
    gap: 1rem;
}
.pd-info-row:last-child { border-bottom: none; }
.pd-info-label {
    font-size: .78rem;
    letter-spacing: .05em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-faint);
    flex-shrink: 0;
}
.pd-overdue-text { color: #b03a18; font-weight: 600; }

/* Progress auto-refresh pulse indicator */
.pd-progress-pulse {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--clay);
    margin-left: .35rem;
    vertical-align: middle;
    animation: pd-pulse 1s ease-in-out infinite;
}
@@keyframes pd-pulse {
    0%, 100% { opacity: .2; transform: scale(.8); }
    50%       { opacity: 1;  transform: scale(1.15); }
}

/* Outputs tab */
.pd-outputs-table { margin-top: .25rem; }
.pd-output-type {
    font-size: .78rem;
    color: var(--ink-soft);
}
.pd-output-date {
    font-size: .78rem;
    color: var(--ink-faint);
    white-space: nowrap;
}

@@media (max-width: 640px) {
    .pd-title-row { flex-direction: column; }
    .pd-actions { flex-direction: row; }
    .pd-stats { gap: .4rem; }
    .pd-stat { min-width: calc(50% - .25rem); }
    .pd-stat--wide { min-width: 100%; }
    .pd-note-grid { grid-template-columns: 1fr; }
}
</style>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "project-detail",
        PageTitle = "Project Detail",
        Tagline = "Keep one outcome's tasks, notes, and outputs moving together",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.FolderSpecial,
                Lead = "Project detail is the workbench for one outcome, collecting the actions and knowledge needed to finish it.",
                Points =
                [
                    "Review project status, priority, due date, open tasks, notes, resources, outputs, and progress in one place.",
                    "Manage the project's task list or board without losing the surrounding context.",
                    "Link notes, review related resources and outputs, then edit, complete, or archive the project when needed."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In PARA, a Project is a short-term outcome with a deadline — the most actionable bucket in your Second Brain.",
                Points =
                [
                    "Use this page as the active context for one outcome so tasks, notes, resources, and outputs stay connected.",
                    "Finished projects get archived so active work stays light while the supporting material remains retrievable.",
                    "Tasks live in project context because each next action should move a concrete outcome forward."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Review the header badges, desired outcome, due date, open task count, and progress before changing work.",
                    "Use Add task on the Tasks tab to break the outcome into next actions, or switch to Board to manage flow.",
                    "Use Notes to link project notes, then check Resources and Outputs for supporting material and produced work.",
                    "Use Edit when scope, priority, or dates change.",
                    "Use Complete when the outcome is done, then Archive to remove it from active views."
                ]
            }
        ]
    };

    [Parameter] public Guid ProjectId { get; set; }

    private bool _loading = true;
    private ProjectDetailDto? _detail;
    private IReadOnlyList<OutputDto> _outputs = [];

    // Live progress — updated by PeriodicTimer independently of the full detail load
    private ProjectProgressDto? _progress;
    private bool _progressRefreshing;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // Computed helpers that prefer live progress when available
    private int OpenTaskCount    => _progress?.OpenTaskCount    ?? _detail?.OpenTaskCount    ?? 0;
    private int DoneTaskCount    => _progress?.DoneTaskCount    ?? _detail?.DoneTaskCount    ?? 0;
    private double ProgressPercent => _progress?.ProgressPercent ?? _detail?.ProgressPercent ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        StartProgressPolling();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = new CancellationTokenSource();
            _progress = null;
            await LoadAsync();
            StartProgressPolling();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _detail = await ProjectService.GetProjectDetailAsync(ProjectId);
        _outputs = _detail is not null
            ? await OutputService.GetByProjectAsync(ProjectId)
            : [];
        _loading = false;
    }

    private void StartProgressPolling()
    {
        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        var token = _cts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(token))
                {
                    _progressRefreshing = true;
                    await InvokeAsync(StateHasChanged);

                    var fresh = await ProjectService.GetProjectProgressAsync(ProjectId, token);
                    if (fresh is not null)
                        _progress = fresh;

                    _progressRefreshing = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { /* navigation away — expected */ }
        }, token);
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
        _timer?.Dispose();
    }

    private async Task OpenNote(Guid noteId)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, noteId }
        };
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", parameters, NoteEditorOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenAddTaskDialog()
    {
        var parameters = new DialogParameters<TaskEditorDialog>();
        parameters.Add(x => x.ProjectId, ProjectId);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TaskEditorDialog>("New Task", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OnBoardTaskChanged()
    {
        await LoadAsync();
    }

    private static DialogOptions NoteEditorOptions => new()
    {
        MaxWidth         = MaxWidth.Large,
        FullWidth        = true,
        BackdropClick    = false,
        CloseOnEscapeKey = false,
        CloseButton      = false,
    };

    private async Task OpenNewNoteDialog()
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.ProjectId, ProjectId }
        };
        var dialog = await DialogService.ShowAsync<NoteEditorDialog>("", parameters, NoteEditorOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenLinkNoteDialog()
    {
        var parameters = new DialogParameters<ProjectNoteDialog>();
        parameters.Add(x => x.ProjectId, ProjectId);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectNoteDialog>("Link Existing Note", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task UnlinkNote(Guid noteId, string noteTitle)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Remove from project",
            $"Remove \"{noteTitle}\" from this project? The note will be kept but unlinked.",
            yesText: "Remove", cancelText: "Cancel");

        if (confirmed == true)
        {
            await NoteService.UnlinkFromProjectAsync(noteId);
            Snackbar.Add($"\"{noteTitle}\" removed from project.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenCompletionDialog()
    {
        if (_detail is null) return;

        var overdueTasks = _detail.Tasks.Count(t => !t.IsArchived
            && t.Status != TaskItemStatus.Done
            && t.DueDate.HasValue
            && t.DueDate.Value.Date < DateTime.Today);

        var summary = new ProjectSummaryDto(
            _detail.Id, _detail.Name, _detail.Description, _detail.DesiredOutcome,
            _detail.Status, _detail.Priority, _detail.StartDate, _detail.DueDate,
            _detail.CompletedDate, _detail.IsArchived, _detail.AreaId,
            _detail.CreatedAtUtc, _detail.UpdatedAtUtc, _detail.ArchivedAtUtc,
            _detail.TotalTaskCount, _detail.OpenTaskCount, _detail.DoneTaskCount,
            _detail.ProgressPercent, overdueTasks, _detail.Emoji);

        var parameters = new DialogParameters<ProjectCompletionDialog>();
        parameters.Add(x => x.Project, summary);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectCompletionDialog>("Complete Project", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            Nav.NavigateTo("/projects");
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters<ProjectEditorDialog>();
        parameters.Add(x => x.ProjectId, ProjectId);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectEditorDialog>("Edit Project", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmArchive()
    {
        var name = _detail?.Name ?? "this project";
        var confirmed = await DialogService.ShowMessageBox(
            "Archive project",
            $"Archive \"{name}\"? It will be hidden from active views.",
            yesText: "Archive", cancelText: "Cancel");

        if (confirmed == true)
        {
            await ProjectService.ArchiveAsync(ProjectId);
            Snackbar.Add($"\"{name}\" archived.", Severity.Success);
            Nav.NavigateTo("/projects");
        }
    }

    private static string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.NotStarted => "Not Started",
        ProjectStatus.Active     => "Active",
        ProjectStatus.Waiting    => "Waiting",
        ProjectStatus.Completed  => "Completed",
        ProjectStatus.Archived   => "Archived",
        _                        => s.ToString()
    };

    private static string PriorityLabel(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "⚑ Critical",
        ProjectPriority.High     => "↑ High",
        ProjectPriority.Medium   => "— Medium",
        ProjectPriority.Low      => "↓ Low",
        _                        => p.ToString()
    };

    private static string PriorityColor(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "#c0561d",
        ProjectPriority.High     => "#d4722a",
        ProjectPriority.Medium   => "#a07820",
        ProjectPriority.Low      => "#4a5c38",
        _                        => "#9a9180"
    };

    private static string PriorityBg(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "rgba(192,86,29,.10)",
        ProjectPriority.High     => "rgba(212,114,42,.10)",
        ProjectPriority.Medium   => "rgba(160,120,32,.10)",
        ProjectPriority.Low      => "rgba(74,92,56,.10)",
        _                        => "transparent"
    };

    private static Color OutputStatusColor(OutputStatus status) => status switch
    {
        OutputStatus.Draft     => Color.Default,
        OutputStatus.InReview  => Color.Warning,
        OutputStatus.Ready     => Color.Info,
        OutputStatus.Published => Color.Success,
        OutputStatus.Archived  => Color.Dark,
        _                      => Color.Default
    };

    private static string OutputTypeLabel(OutputType type) => type switch
    {
        OutputType.BlogPost             => "Blog Post",
        OutputType.LinkedInPost         => "LinkedIn Post",
        OutputType.Report               => "Report",
        OutputType.ProductSpec          => "Product Spec",
        OutputType.MeetingBrief         => "Meeting Brief",
        OutputType.Roadmap              => "Roadmap",
        OutputType.DecisionRecord       => "Decision Record",
        OutputType.LearningPlan         => "Learning Plan",
        OutputType.ResearchSummary      => "Research Summary",
        OutputType.PresentationOutline  => "Presentation Outline",
        OutputType.Proposal             => "Proposal",
        OutputType.EmailDraft           => "Email Draft",
        OutputType.Custom               => "Custom",
        _                               => type.ToString()
    };

    private static string RelativeDate(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 2)  return "just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }
