@using Brainy.Application.DTOs.Areas
@using Brainy.Application.DTOs.Goals
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Common
@using Brainy.Domain.Enums
@using System.Globalization
@inject IProjectService ProjectService
@inject IAreaService AreaService
@inject IGoalService GoalService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-family:var(--font-display)">
            @(ProjectId.HasValue ? "Edit Project" : "New Project")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <div class="ped-fields">
                <MudTextField @bind-Value="_name" Label="Name" Required="true"
                              RequiredError="Name is required"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudTextField T="string"
                              Value="@_emoji"
                              ValueChanged="OnEmojiChanged"
                              Label="Emoji (optional)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="ped-emoji-input"
                              MaxLength="16"
                              HelperText="@EmojiHelperText" />

                <MudSelect @bind-Value="_areaId" Label="Area" Required="true"
                           RequiredError="Area is required"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft"
                           Placeholder="Select an area…">
                    @foreach (var area in _areas)
                    {
                        <MudSelectItem Value="area.Id">@area.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid?" @bind-Value="_goalId" Label="Goal (optional)"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft"
                           Placeholder="Select a goal…">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">(none)</MudSelectItem>
                    @foreach (var goal in _goals)
                    {
                        <MudSelectItem T="Guid?" Value="@goal.Id">@goal.Title</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_desiredOutcome" Label="Desired Outcome"
                              HelperText="What does 'done' look like?"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudTextField @bind-Value="_description" Label="Description"
                              Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <div class="ped-row">
                    <MudSelect @bind-Value="_status" Label="Status"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var s in Enum.GetValues<ProjectStatus>().Where(s => s != ProjectStatus.Archived))
                        {
                            <MudSelectItem Value="s">@StatusLabel(s)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect @bind-Value="_priority" Label="Priority"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in Enum.GetValues<ProjectPriority>().Reverse())
                        {
                            <MudSelectItem Value="p">@p.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="ped-row">
                    <MudDatePicker @bind-Date="_startDate" Label="Start Date"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" />
                    <MudDatePicker @bind-Date="_dueDate" Label="Due Date"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Editable="true" />
                </div>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="!_valid || _saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            @(ProjectId.HasValue ? "Save changes" : "Create project")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
.ped-fields { display: flex; flex-direction: column; gap: .85rem; padding-top: .25rem; }
.ped-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.ped-emoji-input { max-width: 170px; }
.ped-emoji-input .mud-input-helper-text { white-space: nowrap; }
@@media (max-width: 480px) { .ped-row { grid-template-columns: 1fr; } }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid? ProjectId { get; set; }

    private MudForm _form = null!;
    private bool _valid;
    private bool _saving;
    private static string EmojiHelperText =>
        $"Win + . (Windows) / Ctrl + Cmd + Space (macOS). Default: {ProjectEmojiDefaults.DefaultEmoji}.";

    private string _name = "";
    private string _emoji = "";
    private Guid _areaId;
    private Guid? _goalId;
    private string? _desiredOutcome;
    private string? _description;
    private ProjectStatus _status = ProjectStatus.NotStarted;
    private ProjectPriority _priority = ProjectPriority.Medium;
    private DateTime? _startDate;
    private DateTime? _dueDate;

    private IReadOnlyList<AreaDto> _areas = [];
    private IReadOnlyList<GoalDto> _goals = [];

    protected override async Task OnInitializedAsync()
    {
        _areas = await AreaService.GetAllActiveAsync();
        _goals = await GoalService.GetAllNonArchivedAsync();

        if (ProjectId.HasValue)
        {
            var dto = await ProjectService.GetByIdAsync(ProjectId.Value);
            if (dto is not null)
            {
                _name           = dto.Name;
                _emoji          = dto.Emoji == ProjectEmojiDefaults.DefaultEmoji ? string.Empty : dto.Emoji;
                _areaId         = dto.AreaId ?? Guid.Empty;
                if (_areaId == Guid.Empty)
                    Snackbar.Add("This project has no area assigned. Please select an area before saving.", Severity.Warning);
                _goalId         = dto.GoalId;
                _desiredOutcome = dto.DesiredOutcome;
                _description    = dto.Description;
                _status         = dto.Status;
                _priority       = dto.Priority;
                _startDate      = dto.StartDate;
                _dueDate        = dto.DueDate;
            }
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_valid) return;

        if (_areaId == Guid.Empty)
        {
            Snackbar.Add("Please select an area for this project.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (ProjectId.HasValue)
            {
                await ProjectService.UpdateAsync(new UpdateProjectDto(
                    ProjectId.Value, _name, _areaId, _description, _desiredOutcome,
                    _status, _priority, _startDate, _dueDate, _goalId, _emoji));
            }
            else
            {
                await ProjectService.CreateAsync(new CreateProjectDto(
                    _name, _areaId, _description, _desiredOutcome, _status, _priority, _startDate, _dueDate, _goalId, _emoji));
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private Task OnEmojiChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _emoji = string.Empty;
            return Task.CompletedTask;
        }

        var enumerator = StringInfo.GetTextElementEnumerator(value.Trim());
        _emoji = enumerator.MoveNext() ? enumerator.GetTextElement() : string.Empty;
        return Task.CompletedTask;
    }

    private static string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.NotStarted => "Not Started",
        ProjectStatus.Active     => "Active",
        ProjectStatus.Waiting    => "Waiting",
        ProjectStatus.Completed  => "Completed",
        _                        => s.ToString()
    };
}
