@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnTaskChanged { get; set; }

    private record ColumnDef(
        TaskItemStatus Status,
        string Name,
        string Color,
        string EmptyIcon,
        string EmptyLabel);

    private static readonly ColumnDef[] _columns =
    [
        new(TaskItemStatus.Todo,       "To Do",       "#9a9180", "○", "Nothing queued"),
        new(TaskItemStatus.InProgress, "In Progress", "#c0561d", "◎", "Nothing active"),
        new(TaskItemStatus.Waiting,    "Waiting",     "#cd9a3a", "◷", "Nothing on hold"),
        new(TaskItemStatus.Done,       "Done",        "#6f7a5a", "✓", "Nothing complete yet"),
    ];

    private static readonly TaskItemStatus[] _bulkStatuses =
        [TaskItemStatus.Todo, TaskItemStatus.InProgress, TaskItemStatus.Waiting, TaskItemStatus.Done];

    private Dictionary<TaskItemStatus, List<TaskItemDto>> _tasksByStatus = new();
    private Guid? _draggingTaskId;
    private TaskItemStatus? _dragOverStatus;
    private Guid? _dragOverCardId;
    private bool _loading = true;
    private Guid _loadedProjectId;
    private readonly HashSet<Guid> _selectedTaskIds = [];
    private bool _selectMode;
    private bool _bulkBusy;
    private TaskItemStatus? _bulkStatusTarget;
    private TaskPriority? _bulkPriorityTarget;
    private string _liveAnnouncement = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId != ProjectId)
            await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        _loadedProjectId = ProjectId;
        var tasks = await TaskService.GetByProjectAsync(ProjectId);
        _tasksByStatus = new Dictionary<TaskItemStatus, List<TaskItemDto>>
        {
            [TaskItemStatus.Todo]       = tasks.Where(t => t.Status == TaskItemStatus.Todo).ToList(),
            [TaskItemStatus.InProgress] = tasks.Where(t => t.Status == TaskItemStatus.InProgress).ToList(),
            [TaskItemStatus.Waiting]    = tasks.Where(t => t.Status == TaskItemStatus.Waiting).ToList(),
            [TaskItemStatus.Done]       = tasks.Where(t => t.Status == TaskItemStatus.Done).ToList(),
        };
        _selectedTaskIds.IntersectWith(tasks.Select(task => task.Id));
        _loading = false;
    }

    private void ToggleSelectMode()
    {
        _selectMode = !_selectMode;
        if (!_selectMode)
        {
            ResetBulkSelectionState();
            Announce("Select mode off.");
            return;
        }

        Announce("Select mode on. Choose tasks for bulk actions.");
    }

    private void ToggleSelection(Guid taskId)
    {
        _selectMode = true;

        if (!_selectedTaskIds.Add(taskId))
            _selectedTaskIds.Remove(taskId);

        if (_selectedTaskIds.Count == 0)
        {
            ResetBulkSelectionTargets();
            Announce("No tasks selected.");
            return;
        }

        Announce($"{_selectedTaskIds.Count} task{(_selectedTaskIds.Count == 1 ? string.Empty : "s")} selected.");
    }

    private void ClearSelection()
    {
        ResetBulkSelectionState();
        Announce("Selection cleared.");
    }

    private void OnBulkStatusChanged(TaskItemStatus? status) => _bulkStatusTarget = status;

    private void OnBulkPriorityChanged(TaskPriority? priority) => _bulkPriorityTarget = priority;

    private void OnDragStart(Guid taskId)
    {
        if (_selectMode)
            return;

        _draggingTaskId = taskId;
    }

    private void OnDragEnter(TaskItemStatus status) => _dragOverStatus = status;

    private void OnDragEnterCard(Guid cardId)
    {
        // Only highlight as drop target when hovering over a different card
        if (_draggingTaskId.HasValue && _draggingTaskId.Value != cardId)
            _dragOverCardId = cardId;
    }

    private void OnDragEnd()
    {
        _draggingTaskId = null;
        _dragOverStatus = null;
        _dragOverCardId = null;
    }

    /// <summary>Handles drops onto the column body (empty space) — moves card or reorders to end.</summary>
    private async Task OnDrop(TaskItemStatus targetStatus)
    {
        if (_selectMode)
            return;

        _dragOverStatus = null;
        _dragOverCardId = null;
        if (_draggingTaskId is null) return;

        var taskId = _draggingTaskId.Value;
        _draggingTaskId = null;

        var source = _tasksByStatus.Values.SelectMany(l => l).FirstOrDefault(t => t.Id == taskId);
        if (source is null) return;

        if (source.Status == targetStatus)
        {
            // Dropped on empty column area — move card to end of its own column and persist
            var list = _tasksByStatus[targetStatus];
            list.RemoveAll(t => t.Id == taskId);
            list.Add(source);
            await PersistColumnOrderAsync(targetStatus, list);
            Announce($"{source.Title} moved to the end of {StatusLabel(targetStatus)}.");
        }
        else
        {
            await MoveToColumnAsync(source, taskId, targetStatus);
        }

        await OnTaskChanged.InvokeAsync();
    }

    /// <summary>Handles drops onto a specific card — reorders within column or cross-column move.</summary>
    private async Task OnDropOnCard(Guid targetCardId, TaskItemStatus colStatus)
    {
        if (_selectMode)
            return;

        _dragOverStatus = null;
        _dragOverCardId = null;
        if (_draggingTaskId is null) return;

        var taskId = _draggingTaskId.Value;
        _draggingTaskId = null;

        if (taskId == targetCardId) return;

        var source = _tasksByStatus.Values.SelectMany(l => l).FirstOrDefault(t => t.Id == taskId);
        if (source is null) return;

        if (source.Status == colStatus)
        {
            // Intra-column reorder: insert the dragged card immediately before the target card
            var list = _tasksByStatus[colStatus];
            list.RemoveAll(t => t.Id == taskId);
            var insertIdx = list.FindIndex(t => t.Id == targetCardId);
            list.Insert(insertIdx < 0 ? list.Count : insertIdx, source);
            await PersistColumnOrderAsync(colStatus, list);
            Announce($"{source.Title} reordered in {StatusLabel(colStatus)}.");
        }
        else
        {
            await MoveToColumnAsync(source, taskId, colStatus);
        }

        await OnTaskChanged.InvokeAsync();
    }

    private async Task PersistColumnOrderAsync(TaskItemStatus status, List<TaskItemDto> ordered)
    {
        try
        {
            await TaskService.ReorderAsync(ProjectId, status, ordered.Select(t => t.Id).ToList());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save order: {ex.Message}", Severity.Warning);
            await LoadTasksAsync();
        }
    }

    private async Task MoveToColumnAsync(TaskItemDto source, Guid taskId, TaskItemStatus targetStatus)
    {
        try
        {
            var updated = await TaskService.UpdateAsync(new UpdateTaskDto(
                taskId, source.Title, source.Description,
                targetStatus, source.Priority, source.DueDate, source.Complexity,
                RowVersion: source.RowVersion));

            // Reload when the moved card has subtasks so its progress indicator survives the move.
            if (source.SubtaskCount > 0)
            {
                await LoadTasksAsync();
            }
            else
            {
                _tasksByStatus[source.Status].RemoveAll(t => t.Id == taskId);
                _tasksByStatus[targetStatus].Add(updated);
            }

            Announce($"{source.Title} moved to {StatusLabel(targetStatus)}.");
        }
        catch (ConcurrencyConflictException ex)
        {
            // Another session changed this task; reload the board to show the latest state.
            Snackbar.Add(ex.Message, Severity.Warning);
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not move task: {ex.Message}", Severity.Error);
        }
    }

    private async Task MoveTaskToStatusAsync(Guid taskId, TaskItemStatus targetStatus)
    {
        if (_selectMode)
            return;

        var source = _tasksByStatus.Values.SelectMany(list => list).FirstOrDefault(task => task.Id == taskId);
        if (source is null || source.Status == targetStatus)
            return;

        await MoveToColumnAsync(source, taskId, targetStatus);
        await OnTaskChanged.InvokeAsync();
    }

    private async Task OpenAddDialog(TaskItemStatus initialStatus)
    {
        var parameters = new DialogParameters<TaskEditorDialog>();
        parameters.Add(x => x.ProjectId, ProjectId);
        parameters.Add(x => x.InitialStatus, initialStatus);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TaskEditorDialog>("New Task", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
        }
    }

    private async Task OpenAddSubtaskDialog(Guid parentTaskId)
    {
        var parameters = new DialogParameters<TaskEditorDialog>();
        parameters.Add(x => x.ProjectId, ProjectId);
        parameters.Add(x => x.ParentTaskId, parentTaskId);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TaskEditorDialog>("New Subtask", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
        }
    }

    private async Task OpenEditDialog(Guid taskId)
    {
        var parameters = new DialogParameters<TaskEditorDialog>();
        parameters.Add(x => x.TaskId, taskId);
        parameters.Add(x => x.ProjectId, ProjectId);

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TaskEditorDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
        }
    }

    private async Task ConfirmDeleteTask(Guid taskId, string title)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete task",
            $"Permanently delete \"{title}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            await TaskService.DeleteAsync(taskId);
            foreach (var list in _tasksByStatus.Values)
                list.RemoveAll(t => t.Id == taskId);
            _selectedTaskIds.Remove(taskId);
            Announce($"{title} deleted.");
            await OnTaskChanged.InvokeAsync();
        }
    }

    private async Task ApplyBulkStatusAsync()
    {
        if (!_bulkStatusTarget.HasValue || _selectedTaskIds.Count == 0)
            return;

        try
        {
            _bulkBusy = true;
            var updatedCount = await TaskService.BulkUpdateStatusAsync(_selectedTaskIds, _bulkStatusTarget.Value);
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
            Snackbar.ShowSuccess($"Updated status for {updatedCount} task{(updatedCount == 1 ? string.Empty : "s")}.");
            ResetBulkSelectionState();
            Announce($"Updated status for {updatedCount} task{(updatedCount == 1 ? string.Empty : "s")}.");
        }
        catch (Exception ex)
        {
            Snackbar.ShowError($"Could not update task status: {ex.Message}");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task ApplyBulkPriorityAsync()
    {
        if (!_bulkPriorityTarget.HasValue || _selectedTaskIds.Count == 0)
            return;

        try
        {
            _bulkBusy = true;
            var updatedCount = await TaskService.BulkUpdatePriorityAsync(_selectedTaskIds, _bulkPriorityTarget.Value);
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
            Snackbar.ShowSuccess($"Updated priority for {updatedCount} task{(updatedCount == 1 ? string.Empty : "s")}.");
            ResetBulkSelectionState();
            Announce($"Updated priority for {updatedCount} task{(updatedCount == 1 ? string.Empty : "s")}.");
        }
        catch (Exception ex)
        {
            Snackbar.ShowError($"Could not update task priority: {ex.Message}");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (_selectedTaskIds.Count == 0)
            return;

        var selectedCount = _selectedTaskIds.Count;
        var confirmed = await DialogService.ShowMessageBox(
            "Delete tasks",
            $"Permanently delete {selectedCount} selected task{(selectedCount == 1 ? string.Empty : "s")}? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            _bulkBusy = true;
            var deletedCount = await TaskService.BulkDeleteAsync(_selectedTaskIds);
            await LoadTasksAsync();
            await OnTaskChanged.InvokeAsync();
            Snackbar.ShowSuccess($"Deleted {deletedCount} task{(deletedCount == 1 ? string.Empty : "s")}.");
            ResetBulkSelectionState();
            Announce($"Deleted {deletedCount} task{(deletedCount == 1 ? string.Empty : "s")}.");
        }
        catch (Exception ex)
        {
            Snackbar.ShowError($"Could not delete selected tasks: {ex.Message}");
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private void ResetBulkSelectionState()
    {
        _selectedTaskIds.Clear();
        _selectMode = false;
        ResetBulkSelectionTargets();
    }

    private void ResetBulkSelectionTargets()
    {
        _bulkStatusTarget = null;
        _bulkPriorityTarget = null;
    }

    private void Announce(string message)
    {
        _liveAnnouncement = string.Empty;
        _liveAnnouncement = message;
    }

    private DependencySummary GetDependencySummary(TaskItemDto task)
    {
        var dependencyIds = task.DependsOnTaskIds?.Distinct().ToList() ?? [];
        if (dependencyIds.Count == 0)
            return new DependencySummary(0, 0, string.Empty);

        var taskLookup = FlattenTasks(_tasksByStatus.Values.SelectMany(tasks => tasks))
            .GroupBy(candidate => candidate.Id)
            .ToDictionary(group => group.Key, group => group.First());

        var unresolvedTitles = new List<string>();
        var missingCount = 0;

        foreach (var dependencyId in dependencyIds)
        {
            if (!taskLookup.TryGetValue(dependencyId, out var dependencyTask))
            {
                missingCount++;
                continue;
            }

            if (dependencyTask.Status != TaskItemStatus.Done)
                unresolvedTitles.Add(dependencyTask.Title);
        }

        var unresolvedCount = unresolvedTitles.Count + missingCount;
        return new DependencySummary(
            dependencyIds.Count,
            unresolvedCount,
            BuildDependencyTooltip(dependencyIds.Count, unresolvedCount, unresolvedTitles, missingCount));
    }

    private static IEnumerable<TaskItemDto> FlattenTasks(IEnumerable<TaskItemDto> tasks)
    {
        foreach (var task in tasks)
        {
            yield return task;

            if (task.Subtasks is null)
                continue;

            foreach (var subtask in FlattenTasks(task.Subtasks))
                yield return subtask;
        }
    }

    private static string BuildDependencyTooltip(
        int totalCount,
        int unresolvedCount,
        IReadOnlyCollection<string> unresolvedTitles,
        int missingCount)
    {
        if (unresolvedCount == 0)
            return $"All {totalCount} prerequisite{(totalCount == 1 ? string.Empty : "s")} are complete.";

        var details = new List<string>();
        if (unresolvedTitles.Count > 0)
            details.Add(string.Join(", ", unresolvedTitles));
        if (missingCount > 0)
            details.Add($"{missingCount} unavailable prerequisite{(missingCount == 1 ? string.Empty : "s")}");

        return details.Count == 0
            ? $"Blocked by {unresolvedCount} unfinished prerequisite{(unresolvedCount == 1 ? string.Empty : "s")}."
            : $"Blocked by {unresolvedCount} unfinished prerequisite{(unresolvedCount == 1 ? string.Empty : "s")}: {string.Join("; ", details)}.";
    }

    private readonly record struct DependencySummary(int TotalCount, int UnresolvedCount, string Tooltip)
    {
        public bool HasDependencies => TotalCount > 0;
        public bool IsBlocked => UnresolvedCount > 0;
    }

    private static IEnumerable<ColumnDef> GetMoveTargetColumns(TaskItemStatus currentStatus) =>
        _columns.Where(column => column.Status != currentStatus);

    private static string GetTaskAriaLabel(TaskItemDto task, DependencySummary dependency, bool selectMode)
    {
        var parts = new List<string>
        {
            task.Title,
            $"Status {StatusLabel(task.Status)}",
            $"Priority {PriorityAccessibleLabel(task.Priority)}"
        };

        if (task.Complexity.HasValue)
            parts.Add($"Complexity {task.Complexity.Value}");

        parts.Add(dependency.HasDependencies
            ? dependency.IsBlocked
                ? $"Blocked by {dependency.UnresolvedCount} prerequisite{(dependency.UnresolvedCount == 1 ? string.Empty : "s")}"
                : $"{dependency.TotalCount} prerequisite{(dependency.TotalCount == 1 ? string.Empty : "s")} complete"
            : "No dependencies");

        parts.Add(selectMode ? "Select mode active" : "Move task menu available");

        return string.Join(". ", parts);
    }

    private static string StatusLabel(TaskItemStatus status) => status switch
    {
        TaskItemStatus.Todo       => "To Do",
        TaskItemStatus.InProgress => "In Progress",
        _                         => status.ToString()
    };

    private static string PriorityAccessibleLabel(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "Critical",
        TaskPriority.High     => "High",
        TaskPriority.Medium   => "Medium",
        TaskPriority.Low      => "Low",
        _                     => p.ToString()
    };

    private static string PriorityLabel(TaskPriority p) => p switch
    {
        TaskPriority.Critical => "⚑ Critical",
        TaskPriority.High     => "↑ High",
        TaskPriority.Medium   => "— Med",
        TaskPriority.Low      => "↓ Low",
        _                     => p.ToString()
    };
}
