@page "/projects"
@using Microsoft.AspNetCore.Authorization
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Components.Shared
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Projects — Brainy</PageTitle>

<style>

    .pp-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 1.5rem 0;
        font-family: 'Hanken Grotesk', sans-serif;
    }

    .pp-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }

    @@media (min-width: 1024px) {
        .pp-layout {
            grid-template-columns: 360px 1fr;
            align-items: start;
            gap: 4rem;
        }
    }

    /* ── Sidebar ── */
    .pp-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        animation: pp-fade-up 0.4s ease both;
    }

    @@keyframes pp-fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .pp-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .pp-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        line-height: 1;
        color: var(--mud-palette-text-primary);
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .pp-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .pp-title-row .pp-title {
        flex: 1;
        min-width: 0;
    }

    .pp-meta {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        margin: 0 0 2rem;
        font-weight: 500;
    }

    .pp-widget {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    
    .pp-filter-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
    }

    .pp-filter-label {
        width: 100%;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mud-palette-text-disabled);
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 0.35rem;
    }

    .pp-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        background: var(--mud-palette-table-lines);
        border: 1px solid transparent;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .pp-chip:hover {
        background: var(--mud-palette-surface);
        border-color: var(--mud-palette-lines-default);
    }

    .pp-chip--on {
        background: rgba(192, 86, 29, 0.1);
        border-color: rgba(192, 86, 29, 0.3);
        color: var(--clay, #c0561d);
    }
    
    .pp-chip-dot {
        width: 6px; height: 6px; border-radius: 50%;
    }

    /* ── Main Area ── */
    .pp-main {
        animation: pp-fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .pp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .pp-view-switch {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1rem;
    }

    @@keyframes pp-card-in {
        from { opacity: 0; transform: translateY(15px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>

<div class="pp-page">
    <div class="pp-layout">

        @* ── Sidebar ── *@
        <aside class="pp-sidebar">
            <p class="pp-eyebrow">Portfolio</p>
            <div class="pp-title-row">
                <h1 class="pp-title">Projects</h1>
                <PageHelpButton Guide="HelpGuide" />
            </div>
            <p class="pp-meta">@(_summaries?.Count ?? 0) projects total · @(_filtered?.Count ?? 0) shown</p>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Large"
                       Class="mb-6"
                       Style="font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 8px;"
                       FullWidth="true"
                       OnClick="OpenCreateDialog">
                New Project
            </MudButton>

            <div class="pp-widget">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search projects…"
                              aria-label="Search projects"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              
                              OnKeyUp="@(() => ApplyFilters())"
                              Class="mb-5" />

                <div class="pp-filter-label">Status</div>
                <div class="pp-filter-group">
                    @foreach (var status in StatusFilters)
                    {
                        <button type="button"
                                class="pp-chip @(IsStatusActive(status) ? "pp-chip--on" : "")"
                                aria-pressed="@IsStatusActive(status)"
                                @onclick="() => ToggleStatusFilter(status)">
                            <span class="pp-chip-dot" style="background:@StatusColor(status)"></span>
                            @StatusLabel(status)
                        </button>
                    }
                </div>

                <div class="pp-filter-label">Priority</div>
                <div class="pp-filter-group">
                    @foreach (var pri in PriorityFilters)
                    {
                        <button type="button"
                                class="pp-chip @(IsPriorityActive(pri) ? "pp-chip--on" : "")"
                                aria-pressed="@IsPriorityActive(pri)"
                                @onclick="() => TogglePriorityFilter(pri)">
                            <span class="pp-chip-dot" style="background:@PriorityColor(pri)"></span>
                            @PriorityLabel(pri)
                        </button>
                    }
                </div>

                <div class="pp-filter-label">Sort By</div>
                <div class="pp-filter-group" style="margin-bottom:0;">
                    @foreach (var opt in SortOptions)
                    {
                        <button type="button"
                                class="pp-chip @(_sortBy == opt ? "pp-chip--on" : "")"
                                aria-pressed="@(_sortBy == opt)"
                                aria-label="@SortAriaLabel(opt)"
                                @onclick="() => SetSort(opt)">
                            @opt
                            @if (_sortBy == opt)
                            {
                                <span style="opacity:0.7; font-size:0.7rem;">@(_sortAsc ? "↑" : "↓")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </aside>

        @* ── Main Layout ── *@
        <main class="pp-main">
            @if (_loading)
            {
                <div style="padding: 5rem 0; text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <p style="margin-top: 1rem; color: var(--mud-palette-text-disabled); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem;">Loading projects…</p>
                </div>
            }
            else if (_loadError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    Projects could not be loaded. Check your connection and try again.
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync" Class="ml-2">Retry</MudButton>
                </MudAlert>
            }
            else if (_filtered is { Count: 0 })
            {
                <div style="padding: 5rem 2rem; display: flex; flex-direction: column; align-items: center; text-align: center; border: 1px dashed var(--mud-palette-lines-default); border-radius: 16px; background: var(--mud-palette-table-lines);">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Style="font-size:4rem; color: var(--mud-palette-text-disabled); margin-bottom: 1.5rem;" />
                    <h2 style="font-family: var(--font-display); font-size: 1.75rem; margin: 0 0 0.5rem; color: var(--mud-palette-text-primary);">
                        @(_summaries?.Count == 0 ? "No projects yet" : "Nothing matches")
                    </h2>
                    <p style="color: var(--mud-palette-text-secondary); margin: 0 0 2rem; max-width: 400px;">
                        @(_summaries?.Count == 0
                            ? "Create your first project to start tracking outcomes."
                            : "Try broadening your search or clearing filters.")
                    </p>
                    @if (_summaries?.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Create first project
                        </MudButton>
                    }
                </div>
            }
            else
            {
                <div class="pp-view-switch">
                    <MudSwitch T="bool"
                               @bind-Value="_tableViewEnabled"
                               Color="Color.Primary"
                               Label="@(_tableViewEnabled ? "Table view" : "Card view")" />
                </div>

                @if (_tableViewEnabled)
                {
                    <MudTable Items="_filtered" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Project</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Priority</MudTh>
                            <MudTh>Due</MudTh>
                            <MudTh>Progress</MudTh>
                            <MudTh>Open Tasks</MudTh>
                            <MudTh align="Align.Right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Project">
                                <MudLink Href="@($"/projects/{context.Id}")">@($"{context.Emoji} {context.Name}")</MudLink>
                            </MudTd>
                            <MudTd DataLabel="Status">@StatusLabel(context.Status)</MudTd>
                            <MudTd DataLabel="Priority">@PriorityLabel(context.Priority)</MudTd>
                            <MudTd DataLabel="Due">@(context.DueDate?.ToString("MMM d, yyyy") ?? "—")</MudTd>
                            <MudTd DataLabel="Progress">@($"{context.ProgressPercent:F0}%")</MudTd>
                            <MudTd DataLabel="Open Tasks">@context.OpenTaskCount</MudTd>
                            <MudTd DataLabel="Actions" align="Align.Right">
                                <MudTooltip Text="Open">
                                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenDetail(context.Id))" />
                                </MudTooltip>
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                                @if (context.Status != ProjectStatus.Completed && context.Status != ProjectStatus.Archived)
                                {
                                    <MudTooltip Text="Complete">
                                        <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenCompletionDialog(context))" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="Archive">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Archive"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ConfirmArchive(context.Id, context.Name))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <div class="pp-grid">
                        @for (int i = 0; i < (_filtered?.Count ?? 0); i++)
                        {
                            var p = _filtered![i];
                            var idx = i;
                            <div style="animation-delay:@(idx * 35)ms; animation: pp-card-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;">
                                <ProjectSummaryCard Project="p"
                                                    OnNavigate="id => OpenDetail(id)"
                                                    OnEdit="proj => OpenEditDialog(proj)"
                                                    OnComplete="proj => OpenCompletionDialog(proj)"
                                                    OnArchive="proj => ConfirmArchive(proj.Id, proj.Name)" />
                            </div>
                        }
                    </div>
                }
            }
        </main>

    </div>
</div>

@code {
    private static readonly PageHelpGuide HelpGuide = new()
    {
        Key = "projects",
        PageTitle = "Projects",
        Tagline = "Turn active outcomes into visible progress before the deadline",
        Sections =
        [
            new PageHelpSection
            {
                Title = "What this screen is for",
                Icon = Icons.Material.Outlined.FolderSpecial,
                Lead = "Projects is your portfolio of active outcomes with deadlines, showing what needs attention now.",
                Points =
                [
                    "Create new projects with a desired outcome, priority, status, and dates.",
                    "Search, filter, and sort the project list by status, priority, due date, progress, or name.",
                    "Open each project card to manage its tasks and notes, or complete, edit, and archive it from the card."
                ]
            },
            new PageHelpSection
            {
                Title = "The Second Brain idea",
                Icon = Icons.Material.Outlined.Lightbulb,
                Lead = "In PARA, a Project is a short-term outcome with a deadline — the most actionable bucket in your Second Brain.",
                Points =
                [
                    "Keep work attached to the outcome it moves forward, not buried in generic storage.",
                    "Finished projects get archived so active views stay focused without losing context.",
                    "Tasks live inside their project context, where progress and next actions are visible."
                ]
            },
            new PageHelpSection
            {
                Title = "How to use this page",
                Icon = Icons.Material.Outlined.PlaylistAddCheck,
                Ordered = true,
                Points =
                [
                    "Use New Project to capture the outcome, deadline, priority, and supporting context.",
                    "Filter by Status or Priority when you need a focused view of current commitments.",
                    "Search by name, desired outcome, or description to find a project quickly.",
                    "Sort by Priority, Due Date, Progress, or Name to decide what to open next.",
                    "Use each project card to open details, edit metadata, complete the outcome, or archive it."
                ]
            }
        ]
    };

    private bool _loading = true;
    private string? _loadError;
    private List<ProjectSummaryDto>? _summaries;
    private List<ProjectSummaryDto>? _filtered;
    private bool _tableViewEnabled;

    private string _searchText = "";
    private readonly HashSet<ProjectStatus> _activeStatusFilters = [];
    private readonly HashSet<ProjectPriority> _activePriorityFilters = [];
    private string _sortBy = "Priority";
    private bool _sortAsc;

    private static readonly ProjectStatus[] StatusFilters =
        [ProjectStatus.NotStarted, ProjectStatus.Active, ProjectStatus.Waiting, ProjectStatus.Completed];

    private static readonly ProjectPriority[] PriorityFilters =
        [ProjectPriority.Critical, ProjectPriority.High, ProjectPriority.Medium, ProjectPriority.Low];

    private static readonly string[] SortOptions = ["Priority", "Name", "Due Date", "Progress"];

    private string SortAriaLabel(string option) => _sortBy == option
        ? $"Sort by {option}, currently {(_sortAsc ? "ascending" : "descending")}; activate to reverse"
        : $"Sort by {option}";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await ProjectService.GetProjectSummariesAsync();
            _summaries = result.ToList();
            ApplyFilters();
        }
        catch
        {
            _loadError = "Unable to reach the project portfolio.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        _searchText = "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<ProjectSummaryDto> q = _summaries ?? [];

        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(p =>
                p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (p.DesiredOutcome?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));

        if (_activeStatusFilters.Count > 0)
            q = q.Where(p => _activeStatusFilters.Contains(p.Status));

        if (_activePriorityFilters.Count > 0)
            q = q.Where(p => _activePriorityFilters.Contains(p.Priority));

        q = _sortBy switch
        {
            "Name"     => _sortAsc ? q.OrderBy(p => p.Name) : q.OrderByDescending(p => p.Name),
            "Due Date" => _sortAsc
                ? q.OrderBy(p => p.DueDate ?? DateTime.MaxValue)
                : q.OrderByDescending(p => p.DueDate ?? DateTime.MinValue),
            "Progress" => _sortAsc ? q.OrderBy(p => p.ProgressPercent) : q.OrderByDescending(p => p.ProgressPercent),
            _          => _sortAsc ? q.OrderBy(p => p.Priority) : q.OrderByDescending(p => p.Priority),
        };

        _filtered = q.ToList();
    }

    private void ToggleStatusFilter(ProjectStatus s)
    {
        if (!_activeStatusFilters.Remove(s)) _activeStatusFilters.Add(s);
        ApplyFilters();
    }

    private void TogglePriorityFilter(ProjectPriority p)
    {
        if (!_activePriorityFilters.Remove(p)) _activePriorityFilters.Add(p);
        ApplyFilters();
    }

    private void SetSort(string option)
    {
        if (_sortBy == option) _sortAsc = !_sortAsc;
        else { _sortBy = option; _sortAsc = false; }
        ApplyFilters();
    }

    private bool IsStatusActive(ProjectStatus s) => _activeStatusFilters.Contains(s);
    private bool IsPriorityActive(ProjectPriority p) => _activePriorityFilters.Contains(p);

    private static string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.NotStarted => "Not Started",
        ProjectStatus.Active     => "Active",
        ProjectStatus.Waiting    => "Waiting",
        ProjectStatus.Completed  => "Completed",
        ProjectStatus.Archived   => "Archived",
        _                        => s.ToString()
    };

    private static string StatusColor(ProjectStatus s) => s switch
    {
        ProjectStatus.Active    => "#4a5c38",
        ProjectStatus.Waiting   => "#7a5c0e",
        ProjectStatus.Completed => "#9c4416",
        _                       => "#9a9180"
    };

    private static string PriorityLabel(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "⚑ Critical",
        ProjectPriority.High     => "↑ High",
        ProjectPriority.Medium   => "— Medium",
        ProjectPriority.Low      => "↓ Low",
        _                        => p.ToString()
    };

    private static string PriorityColor(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "#c0561d",
        ProjectPriority.High     => "#d4722a",
        ProjectPriority.Medium   => "#a07820",
        ProjectPriority.Low      => "#4a5c38",
        _                        => "#9a9180"
    };

    private static string PriorityBg(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "rgba(192,86,29,.10)",
        ProjectPriority.High     => "rgba(212,114,42,.10)",
        ProjectPriority.Medium   => "rgba(160,120,32,.10)",
        ProjectPriority.Low      => "rgba(74,92,56,.10)",
        _                        => "transparent"
    };

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/projects/{id}");

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ProjectEditorDialog>();
        parameters.Add(x => x.ProjectId, null);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectEditorDialog>("New Project", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            if (result.Data is ProjectDto createdProject)
            {
                Nav.NavigateTo($"/projects/{createdProject.Id}");
                return;
            }

            await LoadAsync();
        }
    }

    private async Task OpenCompletionDialog(ProjectSummaryDto p)
    {
        var parameters = new DialogParameters<ProjectCompletionDialog>();
        parameters.Add(x => x.Project, p);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectCompletionDialog>("Complete Project", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditDialog(ProjectSummaryDto p)
    {
        var parameters = new DialogParameters<ProjectEditorDialog>();
        parameters.Add(x => x.ProjectId, p.Id);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProjectEditorDialog>("Edit Project", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task ConfirmArchive(Guid id, string name)
    {
        var parameters = new DialogParameters<ArchiveReasonDialog>
        {
            { x => x.Title, "Archive project" },
            { x => x.Message, $"Archive \"{name}\"? It will be moved to Archives and hidden from active views." }
        };
        var dialog = await DialogService.ShowAsync<ArchiveReasonDialog>(
            "Archive project",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        await ProjectService.ArchiveAsync(id, archivedReason: result.Data as string);
        Snackbar.Add($"\"{name}\" archived.", Severity.Success);
        await LoadAsync();
    }
}
