@using Brainy.Application.Common
@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject ITaskService TaskService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Class="ted-dialog">
    <TitleContent>
        <div class="ted-header">
            <span class="ted-header__glyph">@(TaskId.HasValue ? "✎" : (ParentTaskId.HasValue ? "↳" : "+"))</span>
            <span class="ted-header__title">@HeaderTitle</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="ted-form">
            <MudTextField @bind-Value="_title"
                          Label="Title"
                          Required="true"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          AutoFocus="true"
                          FullWidth="true" />
            <MudTextField @bind-Value="_description"
                          Label="Description"
                          Lines="3"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_priority" Label="Priority" Variant="Variant.Outlined" FullWidth="true">
                        <MudSelectItem Value="TaskPriority.Low">↓ Low</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.Medium">— Medium</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.High">↑ High</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.Critical">⚑ Critical</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_status" Label="Status" Variant="Variant.Outlined" FullWidth="true">
                        <MudSelectItem Value="TaskItemStatus.Todo">To Do</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.InProgress">In Progress</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.Waiting">Waiting</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.Done">Done</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="TaskComplexity?" @bind-Value="_complexity" Label="Complexity (t-shirt)" Variant="Variant.Outlined" Clearable="true" FullWidth="true">
                        <MudSelectItem T="TaskComplexity?" Value="@null">— Not estimated</MudSelectItem>
                        <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.XS)">XS · Extra-small</MudSelectItem>
                        <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.S)">S · Small</MudSelectItem>
                        <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.M)">M · Medium</MudSelectItem>
                        <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.L)">L · Large</MudSelectItem>
                        <MudSelectItem T="TaskComplexity?" Value="@((TaskComplexity?)TaskComplexity.XL)">XL · Extra-large</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudDatePicker @bind-Date="_dueDate"
                           Label="Due Date"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           DateFormat="MMM d, yyyy" />

            @* ── Recurrence ── *@
            <MudDivider Class="ted-divider" />
            <div class="ted-recurrence">
                <div class="ted-recurrence__toggle">
                    <MudSwitch @bind-Value="_isRecurring" Color="Color.Primary" Label="Recurring task" />
                </div>
                @if (_isRecurring)
                {
                    <MudGrid Spacing="2" Class="ted-recurrence__fields">
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_recurrenceType" T="RecurrenceType?" Label="Repeats" Variant="Variant.Outlined" FullWidth="true">
                                <MudSelectItem T="RecurrenceType?" Value="@((RecurrenceType?)RecurrenceType.Daily)">Daily</MudSelectItem>
                                <MudSelectItem T="RecurrenceType?" Value="@((RecurrenceType?)RecurrenceType.Weekly)">Weekly</MudSelectItem>
                                <MudSelectItem T="RecurrenceType?" Value="@((RecurrenceType?)RecurrenceType.Monthly)">Monthly</MudSelectItem>
                                <MudSelectItem T="RecurrenceType?" Value="@((RecurrenceType?)RecurrenceType.Yearly)">Yearly</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="_recurrenceInterval"
                                             Label="Every (interval)"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="365"
                                             FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_nextOccurrenceDate"
                                           Label="First / next occurrence"
                                           Variant="Variant.Outlined"
                                           Clearable="true"
                                           DateFormat="MMM d, yyyy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_recurrenceEndDate"
                                           Label="Ends on (optional)"
                                           Variant="Variant.Outlined"
                                           Clearable="true"
                                           DateFormat="MMM d, yyyy" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Outlined="true" Class="ted-recurrence__preview">
                                <MudText Typo="Typo.body2" Class="ted-recurrence__summary">@RecurrenceSummary</MudText>
                                @if (UpcomingOccurrences.Count > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="ted-recurrence__label">Upcoming occurrences</MudText>
                                    <div class="ted-recurrence__chips">
                                        @foreach (var occurrence in UpcomingOccurrences)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Color="Color.Primary"
                                                     Icon="@Icons.Material.Rounded.EventRepeat">
                                                @FormatRecurrenceDate(occurrence)
                                            </MudChip>
                                        }
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            </div>

            @if (_dependencyCandidates.Count > 0)
            {
                <MudDivider Class="ted-divider" />
                <MudSelect T="Guid"
                           @bind-SelectedValues="_selectedDependencyIds"
                           MultiSelection="true"
                           MultiSelectionTextFunc="@FormatSelectedDependencies"
                           Label="Prerequisites"
                           HelperText="This task cannot start or finish until every selected task is done."
                           Variant="Variant.Outlined"
                           Clearable="true"
                           FullWidth="true">
                    @foreach (var candidate in _dependencyCandidates)
                    {
                        <MudSelectItem T="Guid" Value="@candidate.Id">
                            @candidate.Title (@FormatStatus(candidate.Status))
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            @if (ShowSubtasks)
            {
                <MudDivider Class="ted-divider" />
                <div class="ted-subtasks">
                    <div class="ted-subtasks__head">
                        <span class="ted-subtasks__title">Subtasks</span>
                        @if (_existingSubtasks.Count > 0)
                        {
                            var pending = _existingSubtasks.Count(s => s.Status != TaskItemStatus.Done);
                            <span class="ted-subtasks__count">@pending of @_existingSubtasks.Count pending</span>
                        }
                        else if (_stagedSubtasks.Count > 0)
                        {
                            <span class="ted-subtasks__count">@_stagedSubtasks.Count to add</span>
                        }
                    </div>

                    @* ── Existing subtasks ── *@
                    @if (_existingSubtasks.Count > 0)
                    {
                        <MudList T="string" Dense="true" Class="ted-subtasks__list">
                            @foreach (var sub in _existingSubtasks)
                            {
                                var subDone     = sub.Status == TaskItemStatus.Done;
                                var subOverdue  = !subDone && sub.DueDate.HasValue && sub.DueDate.Value.Date < DateTime.Today;
                                var subDueToday = !subDone && sub.DueDate.HasValue && sub.DueDate.Value.Date == DateTime.Today;
                                var toggling    = _togglingSubtasks.Contains(sub.Id);
                                <MudListItem T="string" Class="@($"ted-subtasks__item {(subOverdue ? "ted-subtasks__item--overdue" : subDueToday ? "ted-subtasks__item--due-today" : "")}")">
                                    <div class="ted-subtasks__row">
                                        <MudTooltip Text="@(subDone ? "Mark incomplete" : "Mark complete")">
                                            <MudIconButton Icon="@(subDone ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.RadioButtonUnchecked)"
                                                           Color="@(subDone ? Color.Success : subOverdue ? Color.Error : subDueToday ? Color.Warning : Color.Default)"
                                                           Size="Size.Small"
                                                           Disabled="@toggling"
                                                           Style="flex-shrink:0; padding:2px; margin:-2px;"
                                                           OnClick="@(() => ToggleSubtaskAsync(sub))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Edit subtask">
                                            <button type="button"
                                                    class="ted-subtask-title-btn @(subDone ? "ted-subtasks__text--done" : "")"
                                                    @onclick="@(() => OpenSubtaskAsync(sub))">@sub.Title</button>
                                        </MudTooltip>
                                        @if (!subDone && sub.DueDate.HasValue)
                                        {
                                            @if (subOverdue)
                                            {
                                                var days = (int)(DateTime.Today - sub.DueDate.Value.Date).TotalDays;
                                                <span class="ted-subtask-badge ted-subtask-badge--overdue">@days day@(days == 1 ? "" : "s") overdue</span>
                                            }
                                            else if (subDueToday)
                                            {
                                                <span class="ted-subtask-badge ted-subtask-badge--today">Due today</span>
                                            }
                                            else
                                            {
                                                <span class="ted-subtask-badge">@sub.DueDate.Value.ToString("MMM d")</span>
                                            }
                                        }
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    @* ── Staged (new) subtasks ── *@
                    @if (_stagedSubtasks.Count > 0)
                    {
                        <MudList T="string" Dense="true" Class="ted-subtasks__list">
                            @foreach (var sub in _stagedSubtasks)
                            {
                                <MudListItem T="string" Class="ted-subtasks__item">
                                    <div class="ted-subtasks__row">
                                        <span class="ted-subtasks__glyph">↳</span>
                                        <span class="ted-subtasks__text">@sub</span>
                                        <MudIconButton Icon="@Icons.Material.Rounded.Close"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@(() => RemoveStagedSubtask(sub))"
                                                       title="Remove subtask" />
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    <div class="ted-subtasks__add">
                        <MudTextField @bind-Value="_newSubtaskTitle"
                                      Label="Add a subtask"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      OnKeyDown="OnSubtaskKeyDown"
                                      FullWidth="true" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Add"
                                   OnClick="AddStagedSubtask"
                                   Disabled="@string.IsNullOrWhiteSpace(_newSubtaskTitle)">
                            Add
                        </MudButton>
                    </div>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">
            @(_saving ? "Saving…" : (TaskId.HasValue ? "Save changes" : (ParentTaskId.HasValue ? "Create subtask" : "Create task")))
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
.ted-dialog .mud-dialog { border-radius: 16px; }
