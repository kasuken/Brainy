@using Brainy.Application.DTOs.Tasks
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@inject ITaskService TaskService
@inject ISnackbar Snackbar

<MudDialog Class="ted-dialog">
    <TitleContent>
        <div class="ted-header">
            <span class="ted-header__glyph">@(TaskId.HasValue ? "✎" : (ParentTaskId.HasValue ? "↳" : "+"))</span>
            <span class="ted-header__title">@HeaderTitle</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="ted-form">
            <MudTextField @bind-Value="_title"
                          Label="Title"
                          Required="true"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          AutoFocus="true"
                          FullWidth="true" />
            <MudTextField @bind-Value="_description"
                          Label="Description"
                          Lines="3"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_priority" Label="Priority" Variant="Variant.Outlined" FullWidth="true">
                        <MudSelectItem Value="TaskPriority.Low">↓ Low</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.Medium">— Medium</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.High">↑ High</MudSelectItem>
                        <MudSelectItem Value="TaskPriority.Critical">⚑ Critical</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_status" Label="Status" Variant="Variant.Outlined" FullWidth="true">
                        <MudSelectItem Value="TaskItemStatus.Todo">To Do</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.InProgress">In Progress</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.Waiting">Waiting</MudSelectItem>
                        <MudSelectItem Value="TaskItemStatus.Done">Done</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudDatePicker @bind-Date="_dueDate"
                           Label="Due Date"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           DateFormat="MMM d, yyyy" />

            @if (ShowSubtasks)
            {
                <MudDivider Class="ted-divider" />
                <div class="ted-subtasks">
                    <div class="ted-subtasks__head">
                        <span class="ted-subtasks__title">Subtasks</span>
                        @if (_stagedSubtasks.Count > 0)
                        {
                            <span class="ted-subtasks__count">@_stagedSubtasks.Count to add</span>
                        }
                    </div>
                    @if (_stagedSubtasks.Count > 0)
                    {
                        <MudList T="string" Dense="true" Class="ted-subtasks__list">
                            @foreach (var sub in _stagedSubtasks)
                            {
                                <MudListItem T="string" Class="ted-subtasks__item">
                                    <div class="ted-subtasks__row">
                                        <span class="ted-subtasks__glyph">↳</span>
                                        <span class="ted-subtasks__text">@sub</span>
                                        <MudIconButton Icon="@Icons.Material.Rounded.Close"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@(() => RemoveStagedSubtask(sub))"
                                                       title="Remove subtask" />
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    <div class="ted-subtasks__add">
                        <MudTextField @bind-Value="_newSubtaskTitle"
                                      Label="Add a subtask"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      OnKeyDown="OnSubtaskKeyDown"
                                      FullWidth="true" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Add"
                                   OnClick="AddStagedSubtask"
                                   Disabled="@string.IsNullOrWhiteSpace(_newSubtaskTitle)">
                            Add
                        </MudButton>
                    </div>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">
            @(_saving ? "Saving…" : (TaskId.HasValue ? "Save changes" : (ParentTaskId.HasValue ? "Create subtask" : "Create task")))
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
.ted-dialog .mud-dialog { border-radius: 16px; }
.ted-header {
    display: flex;
    align-items: center;
    gap: .6rem;
}
.ted-header__glyph {
    font-size: 1.3rem;
    color: var(--clay);
    line-height: 1;
}
.ted-header__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
}
.ted-form { padding: .25rem 0 .5rem; }
.ted-divider { margin: .25rem 0; }
.ted-subtasks__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: .35rem;
}
.ted-subtasks__title {
    font-family: var(--font-display);
    font-size: .95rem;
    font-weight: 500;
    color: var(--ink);
}
.ted-subtasks__count {
    font-size: .75rem;
    color: var(--clay);
}
.ted-subtasks__list { padding: 0; }
.ted-subtasks__row {
    display: flex;
    align-items: center;
    gap: .5rem;
    width: 100%;
}
.ted-subtasks__glyph { color: var(--clay); }
.ted-subtasks__text { flex: 1; }
.ted-subtasks__add {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: .35rem;
}
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? TaskId { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ParentTaskId { get; set; }
    [Parameter] public TaskItemStatus InitialStatus { get; set; } = TaskItemStatus.Todo;

    private string HeaderTitle =>
        TaskId.HasValue ? "Edit Task" : ParentTaskId.HasValue ? "New Subtask" : "New Task";

    private string _title = string.Empty;
    private string? _description;
    private TaskPriority _priority = TaskPriority.Medium;
    private TaskItemStatus _status = TaskItemStatus.Todo;
    private DateTime? _dueDate;
    private bool _saving;
    private bool _isSubtask;
    private string _newSubtaskTitle = string.Empty;
    private readonly List<string> _stagedSubtasks = [];

    // Only top-level tasks (not subtasks, and not the "create subtask" flow) can own subtasks.
    private bool ShowSubtasks => !_isSubtask && !ParentTaskId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _status = InitialStatus;

        if (TaskId.HasValue)
        {
            var task = await TaskService.GetByIdAsync(TaskId.Value);
            if (task is not null)
            {
                _title       = task.Title;
                _description = task.Description;
                _priority    = task.Priority;
                _status      = task.Status;
                _dueDate     = task.DueDate;
                _isSubtask   = task.ParentTaskId.HasValue;
            }
        }
    }

    private void AddStagedSubtask()
    {
        var title = _newSubtaskTitle?.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        _stagedSubtasks.Add(title);
        _newSubtaskTitle = string.Empty;
    }

    private void RemoveStagedSubtask(string title) => _stagedSubtasks.Remove(title);

    private void OnSubtaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddStagedSubtask();
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;
        _saving = true;
        try
        {
            Guid parentId;
            if (TaskId.HasValue)
            {
                await TaskService.UpdateAsync(new UpdateTaskDto(TaskId.Value, _title, _description, _status, _priority, _dueDate));
                parentId = TaskId.Value;
            }
            else
            {
                var created = await TaskService.CreateAsync(new CreateTaskDto(ProjectId, _title, _description, _priority, _dueDate, ParentTaskId));
                parentId = created.Id;
            }

            if (ShowSubtasks && _stagedSubtasks.Count > 0)
            {
                foreach (var subtaskTitle in _stagedSubtasks)
                {
                    await TaskService.CreateAsync(new CreateTaskDto(ProjectId, subtaskTitle, null, TaskPriority.Medium, null, parentId));
                }
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
