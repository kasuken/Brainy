@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? TaskId { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ParentTaskId { get; set; }
    [Parameter] public TaskItemStatus InitialStatus { get; set; } = TaskItemStatus.Todo;

    private string HeaderTitle =>
        TaskId.HasValue ? "Edit Task" : ParentTaskId.HasValue ? "New Subtask" : "New Task";

    private string _title = string.Empty;
    private string? _description;
    private TaskPriority _priority = TaskPriority.Medium;
    private TaskItemStatus _status = TaskItemStatus.Todo;
    private TaskComplexity? _complexity;
    private DateTime? _dueDate;
    private bool _saving;
    // Concurrency token captured when the task was loaded; passed back on update.
    private byte[]? _rowVersion;
    private bool _isSubtask;

    // Recurrence fields
    private bool _isRecurring;
    private RecurrenceType? _recurrenceType;
    private int? _recurrenceInterval = 1;
    private DateTime? _recurrenceEndDate;
    private DateTime? _nextOccurrenceDate;
    private string _newSubtaskTitle = string.Empty;
    private readonly List<string> _stagedSubtasks = [];
    private IReadOnlyList<TaskItemDto> _existingSubtasks = [];
    private readonly HashSet<Guid> _togglingSubtasks = [];
    private IReadOnlyList<TaskItemDto> _dependencyCandidates = [];
    private IEnumerable<Guid> _selectedDependencyIds = [];
    private string RecurrenceSummary =>
        TaskService.GetRecurrenceSummary(_recurrenceType, _recurrenceInterval, _nextOccurrenceDate, _recurrenceEndDate);

    private IReadOnlyList<DateTime> UpcomingOccurrences =>
        TaskService.GetUpcomingOccurrences(_recurrenceType, _recurrenceInterval, _nextOccurrenceDate, _recurrenceEndDate, count: 5);

    // Only top-level tasks (not subtasks, and not the "create subtask" flow) can own subtasks.
    private bool ShowSubtasks => !_isSubtask && !ParentTaskId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _status = InitialStatus;

        var projectTasks = await TaskService.GetByProjectAsync(ProjectId);
        _dependencyCandidates = projectTasks
            .SelectMany(task => new[] { task }.Concat(task.Subtasks ?? []))
            .Where(task => task.Id != TaskId)
            .OrderBy(task => task.Status == TaskItemStatus.Done ? 1 : 0)
            .ThenBy(task => task.Title)
            .ToList();

        if (TaskId.HasValue)
        {
            var task = await TaskService.GetByIdAsync(TaskId.Value);
            if (task is not null)
            {
                _title            = task.Title;
                _description      = task.Description;
                _priority         = task.Priority;
                _status           = task.Status;
                _dueDate          = task.DueDate;
                _complexity       = task.Complexity;
                _isSubtask        = task.ParentTaskId.HasValue;
                _existingSubtasks = task.Subtasks ?? [];
                _isRecurring          = task.IsRecurring;
                _recurrenceType       = task.RecurrenceType;
                _recurrenceInterval   = task.RecurrenceInterval ?? 1;
                _recurrenceEndDate    = task.RecurrenceEndDate;
                _nextOccurrenceDate   = task.NextOccurrenceDate;
                _rowVersion           = task.RowVersion;
                _selectedDependencyIds = task.DependsOnTaskIds ?? [];
            }
        }
    }

    private void AddStagedSubtask()
    {
        var title = _newSubtaskTitle?.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        _stagedSubtasks.Add(title);
        _newSubtaskTitle = string.Empty;
    }

    private void RemoveStagedSubtask(string title) => _stagedSubtasks.Remove(title);

    private void OnSubtaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddStagedSubtask();
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;
        _saving = true;
        try
        {
            Guid parentId;
            if (TaskId.HasValue)
            {
                await TaskService.UpdateAsync(new UpdateTaskDto(
                    TaskId.Value, _title, _description, _status, _priority, _dueDate, _complexity,
                    _isRecurring, _recurrenceType, _recurrenceInterval, _recurrenceEndDate, _nextOccurrenceDate,
                    RowVersion: _rowVersion,
                    DependsOnTaskIds: _selectedDependencyIds.ToList()));
                parentId = TaskId.Value;
            }
            else
            {
                var created = await TaskService.CreateAsync(new CreateTaskDto(
                    ProjectId, _title, _description, _priority, _dueDate, ParentTaskId, _complexity,
                    _isRecurring, _recurrenceType, _recurrenceInterval, _recurrenceEndDate, _nextOccurrenceDate,
                    DependsOnTaskIds: _selectedDependencyIds.ToList()));
                parentId = created.Id;
            }

            if (ShowSubtasks && _stagedSubtasks.Count > 0)
            {
                foreach (var subtaskTitle in _stagedSubtasks)
                {
                    await TaskService.CreateAsync(new CreateTaskDto(ProjectId, subtaskTitle, null, TaskPriority.Medium, null, parentId));
                }
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ConcurrencyConflictException ex)
        {
            // Keep the dialog open so the user's edits are not lost.
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatStatus(TaskItemStatus status) => status switch
    {
        TaskItemStatus.Todo => "To do",
        TaskItemStatus.InProgress => "In progress",
        TaskItemStatus.Waiting => "Waiting",
        TaskItemStatus.Done => "Done",
        _ => status.ToString()
    };

    private string FormatSelectedDependencies(List<string> selectedIds) =>
        string.Join(", ", selectedIds.Select(id =>
            Guid.TryParse(id, out var taskId)
                ? _dependencyCandidates.FirstOrDefault(task => task.Id == taskId)?.Title ?? id
                : id));

    private static string FormatRecurrenceDate(DateTime date) => date.ToString("MMM d, yyyy");

    private async Task ToggleSubtaskAsync(TaskItemDto sub)
    {
        _togglingSubtasks.Add(sub.Id);
        try
        {
            if (sub.Status == TaskItemStatus.Done)
                await TaskService.ReopenAsync(sub.Id);
            else
                await TaskService.CompleteAsync(sub.Id);

            await RefreshSubtasksAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _togglingSubtasks.Remove(sub.Id);
        }
    }

    private async Task OpenSubtaskAsync(TaskItemDto sub)
    {
        var parameters = new DialogParameters<TaskEditorDialog>
        {
            { d => d.TaskId, sub.Id },
            { d => d.ProjectId, ProjectId }
        };

        var dialog = await DialogService.ShowAsync<TaskEditorDialog>(
            "Edit Subtask",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await RefreshSubtasksAsync();
    }

    private async Task RefreshSubtasksAsync()
    {
        if (!TaskId.HasValue) return;
        var task = await TaskService.GetByIdAsync(TaskId.Value);
        _existingSubtasks = task?.Subtasks ?? [];
        if (task is not null && task.Status != _status)
        {
            var wasAutoCompleted = task.Status == TaskItemStatus.Done && _status != TaskItemStatus.Done;
            _status = task.Status;
            if (wasAutoCompleted)
                Snackbar.Add("All subtasks complete — task marked as done ✓", Severity.Success);
        }
        StateHasChanged();
    }
}
