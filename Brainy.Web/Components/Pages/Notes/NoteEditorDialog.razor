@implements IAsyncDisposable

@using Brainy.Application.Common
@using Brainy.Application.DTOs.ActionItems
@using Brainy.Application.DTOs.Highlights
@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.NoteRelationships
@using Brainy.Application.DTOs.RelatedNotes
@using Brainy.Application.DTOs.Summaries
@using Brainy.Application.Interfaces.AI
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Brainy.Web.Security
@using Microsoft.JSInterop
@using System.Text.Json

@inject INoteService NoteService
@inject INoteImageService NoteImageService
@inject INoteRelationshipService RelationshipService
@inject IRelatedNotesService RelatedNotesService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IHighlightService HighlightService
@inject ISummaryService SummaryService
@inject IActionItemService ActionItemService
@inject IAiAssistant AiAssistant
@inject IJSRuntime JS

<MudDialog>

    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(NoteId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.NoteAdd)"
                     Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(NoteId.HasValue ? "Edit Note" : "New Note")</MudText>
            @if (NoteId.HasValue && _originalNote is not null)
            {
                <MudTooltip Text="@(_originalNote.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                    <MudIconButton Icon="@(_originalNote.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                   Color="@(_originalNote.IsFavorite ? Color.Warning : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="ToggleFavoriteAsync" />
                </MudTooltip>
            }
        </div>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <div class="note-editor-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading note…</MudText>
            </div>
        }
        else
        {
            <div class="ned">

                @* ── Title ── *@
                <div class="ned__title-section">
                    <input type="text"
                           id="ned-title-input"
                           class="note-editor__title-input @(_titleError ? "invalid" : "")"
                           placeholder="Untitled note…"
                           value="@_model.Title"
                           @oninput="OnTitleInput"
                           maxlength="500"
                           aria-label="Note title"
                           aria-required="true"
                           autocomplete="off"
                           spellcheck="true" />
                    @if (_titleError)
                    {
                        <span class="note-editor__title-error" role="alert">Title is required</span>
                    }
                </div>

                <MudDivider Class="my-3" />

                @* ── Body ── *@
                <div class="ned__body">

                    @* Editor main *@
                    <div class="ned__main">

                        <div class="note-editor__toolbar">
                            <div class="note-editor__tabs" role="tablist" aria-label="Editor mode">
                                <button type="button" role="tab"
                                        class="note-editor__tab @(_activeTab == "write" ? "active" : "")"
                                        aria-selected="@(_activeTab == "write")"
                                        @onclick='() => _activeTab = "write"'>Write</button>
                                <button type="button" role="tab"
                                        class="note-editor__tab @(_activeTab == "preview" ? "active" : "")"
                                        aria-selected="@(_activeTab == "preview")"
                                        @onclick='() => _activeTab = "preview"'>Preview</button>
                            </div>

                            @if (_activeTab == "write")
                            {
                                <div class="note-editor__format-tools" role="toolbar" aria-label="Markdown formatting">
                                    <button type="button" class="note-editor__tool" title="Bold"
                                            @onclick='() => InsertMarkdownAsync("**", "**", "bold text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                                            <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Italic"
                                            @onclick='() => InsertMarkdownAsync("*", "*", "italic text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="19" y1="4" x2="10" y2="4" /><line x1="14" y1="20" x2="5" y2="20" />
                                            <line x1="15" y1="4" x2="9" y2="20" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Heading 2"
                                            @onclick='() => InsertMarkdownAsync("## ", "", "Heading")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 12h16M4 6v12M20 6v12" />
                                        </svg>
                                    </button>
                                    <span class="note-editor__tool-divider" aria-hidden="true"></span>
                                    <button type="button" class="note-editor__tool" title="Blockquote"
                                            @onclick='() => InsertMarkdownAsync("> ", "", "quoted text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" />
                                            <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool note-editor__tool--mono" title="Inline code"
                                            @onclick='() => InsertMarkdownAsync("`", "`", "code")'>
                                        &lt;/&gt;
                                    </button>
                                    <span class="note-editor__tool-divider" aria-hidden="true"></span>
                                    <button type="button" class="note-editor__tool" title="Bullet list"
                                            @onclick='() => InsertMarkdownAsync("- ", "", "list item")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="9" y1="6" x2="20" y2="6" /><line x1="9" y1="12" x2="20" y2="12" />
                                            <line x1="9" y1="18" x2="20" y2="18" />
                                            <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none" />
                                            <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none" />
                                            <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Numbered list"
                                            @onclick='() => InsertMarkdownAsync("1. ", "", "list item")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="10" y1="6" x2="21" y2="6" /><line x1="10" y1="12" x2="21" y2="12" />
                                            <line x1="10" y1="18" x2="21" y2="18" />
                                            <path d="M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Link"
                                            @onclick='() => InsertMarkdownAsync("[", "](https://)", "link text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Paste an image (Ctrl+V) to embed it"
                                            @onclick="HintPasteImage">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <path d="M21 15l-5-5L5 21" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_activeTab == "write")
                        {
                            <textarea id="ned-content-area"
                                      class="note-editor__textarea ned__textarea"
                                      placeholder="Start writing… Markdown is supported."
                                      aria-label="Note content"
                                      @oninput="OnContentInput">@_model.Content</textarea>
                        }
                        else
                        {
                            <div class="note-editor__preview ned__textarea markdown-body"
                                 role="article" aria-label="Rendered preview">
                                @RenderMarkdown()
                            </div>
                        }

                    </div>

                    @* Sidebar *@
                    <aside class="ned__sidebar note-editor__sidebar" aria-label="Note properties">

                        <div class="note-editor__sidebar-section">
                            <h3 class="note-editor__sidebar-heading">PARA Category</h3>
                            <MudSelect T="ParaCategory"
                                       Value="_model.ParaCategory"
                                       ValueChanged="OnParaCategoryChanged"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomLeft">
                                @foreach (var cat in Enum.GetValues<ParaCategory>())
                                {
                                    <MudSelectItem Value="cat">
                                        <span class="note-editor__select-option">
                                            <span class="note-editor__select-dot"
                                                  style="background:@CategoryDotColor(cat)"></span>
                                            @cat.ToString()
                                        </span>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        @* ── Source ── *@
                        <div class="note-editor__sidebar-section">
                            <h3 class="note-editor__sidebar-heading">Source</h3>
                            <MudTextField T="string"
                                          Value="_model.SourceUrl"
                                          ValueChanged="OnSourceUrlChanged"
                                          Label="Source URL"
                                          Placeholder="https://…"
                                          InputType="InputType.Url"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Link"
                                          Class="mb-2" />
                            <MudTextField T="string"
                                          Value="_model.SourceTitle"
                                          ValueChanged="OnSourceTitleChanged"
                                          Label="Source Title"
                                          Placeholder="Article or page name"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />
                            @if (!string.IsNullOrWhiteSpace(_model.SourceUrl))
                            {
                                <MudLink Href="@_model.SourceUrl"
                                         Target="_blank"
                                         Typo="Typo.caption"
                                         Class="mt-1 d-block ned-source__open-link">
                                    Open source ↗
                                </MudLink>
                            }
                        </div>

                        <div class="note-editor__sidebar-section">
                            <h3 class="note-editor__sidebar-heading">Status</h3>
                            <MudSelect T="NoteStatus"
                                       Value="_model.Status"
                                       ValueChanged="OnStatusChanged"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomLeft">
                                @foreach (var status in Enum.GetValues<NoteStatus>())
                                {
                                    <MudSelectItem Value="status">@status.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        @if (NoteId.HasValue)
                        {
                            @if (_originalNote is not null)
                            {
                                @* ── Linked Notes ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-links__header">
                                        <h3 class="note-editor__sidebar-heading">Linked Notes</h3>
                                        <button type="button"
                                                class="ned-links__add-btn"
                                                title="Link a note"
                                                @onclick="OpenLinkPickerAsync">
                                            <MudIcon Icon="@Icons.Material.Outlined.AddLink"
                                                     Class="ned-links__add-icon" />
                                        </button>
                                    </div>

                                    @if (_linksLoading)
                                    {
                                        <div class="ned-links__loading">
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary" />
                                        </div>
                                    }
                                    else if (_links.Count == 0)
                                    {
                                        <p class="ned-links__empty">No linked notes yet.</p>
                                    }
                                    else
                                    {
                                        <div class="ned-links__list">
                                            @foreach (var link in _links)
                                            {
                                                <div class="ned-links__item">
                                                    <span class="ned-links__type-badge">
                                                        @RelTypLabel(link.Type)
                                                    </span>
                                                    <button type="button"
                                                            class="ned-links__note-title"
                                                            title="Open @link.LinkedNoteTitle"
                                                            @onclick="() => OpenLinkedNoteAsync(link.LinkedNoteId)">
                                                        @link.LinkedNoteTitle
                                                    </button>
                                                    <button type="button"
                                                            class="ned-links__remove"
                                                            title="Remove link"
                                                            @onclick="() => RemoveLinkAsync(link)">
                                                        <MudIcon Icon="@Icons.Material.Outlined.LinkOff"
                                                                 Class="ned-links__remove-icon" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Related Notes (AI-free similarity) ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-related__header">
                                        <h3 class="note-editor__sidebar-heading">Related Notes</h3>
                                        @if (_relatedLoading)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary"
                                                                 Class="ned-related__spinner" />
                                        }
                                    </div>

                                    @if (!_relatedLoading && _relatedNotes.Count == 0)
                                    {
                                        <p class="ned-links__empty">No similar notes found yet.</p>
                                    }
                                    else if (_relatedNotes.Count > 0)
                                    {
                                        <div class="ned-related__list">
                                            @foreach (var r in _relatedNotes)
                                            {
                                                <button type="button"
                                                        class="ned-related__item"
                                                        title="Open: @r.Title"
                                                        @onclick="() => OpenLinkedNoteAsync(r.Id)">
                                                    <span class="ned-related__item-dot"
                                                          style="background:@CatDotColor(r.ParaCategory)"></span>
                                                    <span class="ned-related__item-title">@r.Title</span>
                                                    <span class="ned-related__item-score"
                                                          title="Similarity: @((r.SimilarityScore * 100).ToString("F0"))%">
                                                        @ScoreBar(r.SimilarityScore)
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Check Duplicates ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-dup__header">
                                        <h3 class="note-editor__sidebar-heading">🔁 Check Duplicates</h3>
                                    </div>
                                    <MudButton Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Disabled="_dupChecking"
                                               OnClick="CheckDuplicatesAsync"
                                               Class="ned-dup__btn mb-2">
                                        @if (_dupChecking)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Default"
                                                                 Class="mr-1" />
                                            <span>Checking…</span>
                                        }
                                        else
                                        {
                                            <span>Check for duplicates</span>
                                        }
                                    </MudButton>
                                    @if (_dupChecked && !_dupChecking)
                                    {
                                        @if (_duplicates.Count == 0)
                                        {
                                            <p class="ned-links__empty">No duplicates found ✓</p>
                                        }
                                        else
                                        {
                                            <div class="ned-dup__list">
                                                @foreach (var dup in _duplicates)
                                                {
                                                    var dupId = dup.Id;
                                                    <div class="ned-dup__item">
                                                        <span class="ned-dup__title">@dup.Title</span>
                                                        <div class="ned-dup__actions">
                                                            <MudButton Size="Size.Small"
                                                                       Variant="Variant.Text"
                                                                       Color="Color.Primary"
                                                                       OnClick="() => LinkAsSimilarAsync(dupId)">Link as Similar</MudButton>
                                                            <MudButton Size="Size.Small"
                                                                       Variant="Variant.Text"
                                                                       Color="Color.Default"
                                                                       OnClick="() => DismissDuplicate(dupId)">Dismiss</MudButton>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>

                                @* ── Highlights ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-links__header">
                                        <h3 class="note-editor__sidebar-heading">Highlights</h3>
                                        <button type="button"
                                                class="ned-links__add-btn"
                                                title="Add highlight"
                                                @onclick="() => _showAddHighlightForm = !_showAddHighlightForm">
                                            <MudIcon Icon="@Icons.Material.Outlined.Highlight"
                                                     Class="ned-links__add-icon" />
                                        </button>
                                    </div>

                                    @if (_showAddHighlightForm)
                                    {
                                        <div class="ned-highlights__form">
                                            <MudTextField T="string"
                                                          @bind-Value="_newHighlightText"
                                                          Label="Highlighted passage"
                                                          Placeholder="The exact text…"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="2"
                                                          Immediate="true"
                                                          Class="mb-2" />
                                            <MudTextField T="string"
                                                          @bind-Value="_newHighlightAnnotation"
                                                          Label="Annotation (optional)"
                                                          Placeholder="Why does this matter?"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          Class="mb-2" />
                                            <div class="ned-highlights__layers mb-2">
                                                <span class="note-editor__meta-label">Layer:</span>
                                                <button type="button"
                                                        class="ned-highlights__layer-btn @(_newHighlightLayer == 1 ? "active" : "")"
                                                        title="Bold – first pass"
                                                        @onclick="() => _newHighlightLayer = 1">Bold</button>
                                                <button type="button"
                                                        class="ned-highlights__layer-btn ned-highlights__layer-btn--2 @(_newHighlightLayer == 2 ? "active" : "")"
                                                        title="Highlight – second pass"
                                                        @onclick="() => _newHighlightLayer = 2">Highlight</button>
                                                <button type="button"
                                                        class="ned-highlights__layer-btn ned-highlights__layer-btn--3 @(_newHighlightLayer == 3 ? "active" : "")"
                                                        title="Key Insight – most important"
                                                        @onclick="() => _newHighlightLayer = 3">Key</button>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           Disabled="_highlightsLoading"
                                                           OnClick="AddHighlightAsync">Add</MudButton>
                                                <MudButton Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           OnClick="() => _showAddHighlightForm = false">Cancel</MudButton>
                                            </div>
                                        </div>
                                    }

                                    @if (_highlightsLoading)
                                    {
                                        <div class="ned-links__loading">
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary" />
                                        </div>
                                    }
                                    else if (_highlights.Count == 0 && !_showAddHighlightForm)
                                    {
                                        <p class="ned-links__empty">No highlights yet.</p>
                                    }
                                    else if (_highlights.Count > 0)
                                    {
                                        <div class="ned-highlights__list">
                                            @foreach (var h in _highlights)
                                            {
                                                <div class="ned-highlights__item ned-links__item">
                                                    <span class="ned-highlights__layer-badge ned-highlights__layer-badge--@h.Layer"
                                                          title="Layer @h.Layer: @LayerLabel(h.Layer)">
                                                        @LayerLabel(h.Layer)
                                                    </span>
                                                    <div class="ned-highlights__content">
                                                        <span class="ned-highlights__text">@h.Text</span>
                                                        @if (!string.IsNullOrWhiteSpace(h.Annotation))
                                                        {
                                                            <span class="ned-highlights__annotation">@h.Annotation</span>
                                                        }
                                                    </div>
                                                    <button type="button"
                                                            class="ned-links__remove"
                                                            title="Delete highlight"
                                                            @onclick="() => DeleteHighlightAsync(h)">
                                                        <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline"
                                                                 Class="ned-links__remove-icon" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Actions ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-links__header">
                                        <h3 class="note-editor__sidebar-heading">Actions</h3>
                                        @if (_actionsExtracting)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary"
                                                                 Class="ned-links__add-btn" />
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="ned-links__add-btn"
                                                    title="@(_isDirty ? "Save note changes before AI extraction" : "Extract actions with AI")"
                                                    aria-label="Extract actions with AI"
                                                    disabled="@(_originalNote is null || _isDirty || _actionsLoading)"
                                                    @onclick="ExtractActionsAsync">✨</button>
                                        }
                                        <button type="button"
                                                class="ned-links__add-btn"
                                                title="Add action"
                                                aria-label="Add action"
                                                disabled="@(_originalNote is null || _actionsLoading)"
                                                @onclick="() => OpenActionEditorAsync(null)">
                                            <MudIcon Icon="@Icons.Material.Outlined.AddTask"
                                                     Class="ned-links__add-icon" />
                                        </button>
                                    </div>

                                    @if (_actionsLoading)
                                    {
                                        <div class="ned-links__loading">
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                        </div>
                                    }
                                    else if (_actions.Count == 0)
                                    {
                                        <p class="ned-links__empty">No actions distilled yet.</p>
                                    }
                                    else
                                    {
                                        <div class="ned-links__list" aria-label="Distilled actions">
                                            @foreach (var action in _actions)
                                            {
                                                <div class="ned-links__item">
                                                    <MudIconButton Icon="@(action.Status == ActionItemStatus.Done
                                                                            ? Icons.Material.Filled.CheckCircle
                                                                            : Icons.Material.Outlined.RadioButtonUnchecked)"
                                                                   Color="@(action.Status == ActionItemStatus.Done ? Color.Success : Color.Default)"
                                                                   Size="Size.Small"
                                                                   aria-label="@(action.Status == ActionItemStatus.Done
                                                                                   ? $"Reopen {action.Title}"
                                                                                   : $"Mark {action.Title} done")"
                                                                   OnClick="() => ToggleActionStatusAsync(action)" />
                                                    <div class="ned-highlights__content">
                                                        <span class="ned-highlights__text">@action.Title</span>
                                                        @if (action.IsAiGenerated)
                                                        {
                                                            <span class="ned-summaries__ai-badge ned-links__type-badge"
                                                                  title="AI extracted with @(action.Model ?? "unknown model") · @(action.PromptVersion ?? "unknown prompt")">
                                                                ✨ AI
                                                            </span>
                                                        }
                                                        @if (action.TaskItemId.HasValue)
                                                        {
                                                            <button type="button"
                                                                    class="ned-links__note-title"
                                                                    title="Open project @action.ProjectName"
                                                                    @onclick="() => OpenActionProject(action)">
                                                                Task in @action.ProjectName
                                                            </button>
                                                        }
                                                    </div>
                                                    @if (!action.TaskItemId.HasValue)
                                                    {
                                                        <MudIconButton Icon="@Icons.Material.Outlined.TaskAlt"
                                                                       Size="Size.Small"
                                                                       aria-label="@($"Promote {action.Title} to a task")"
                                                                       OnClick="() => OpenPromotionAsync(action)" />
                                                    }
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                                   Size="Size.Small"
                                                                   aria-label="@($"Edit {action.Title}")"
                                                                   OnClick="() => OpenActionEditorAsync(action)" />
                                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   aria-label="@($"Delete {action.Title}")"
                                                                   OnClick="() => DeleteActionAsync(action)" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Summary Layers ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-links__header">
                                        <h3 class="note-editor__sidebar-heading">Summary Layers</h3>
                                        @if (_summaryGenerating)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary"
                                                                 Class="ned-links__add-btn" />
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="ned-links__add-btn"
                                                    title="Generate AI summary"
                                                    disabled="@(_originalNote is null)"
                                                    @onclick="GenerateAiSummaryAsync">
                                                ✨
                                            </button>
                                        }
                                        <button type="button"
                                                class="ned-links__add-btn"
                                                title="Add summary layer"
                                                @onclick="() => _showAddSummaryForm = !_showAddSummaryForm">
                                            <MudIcon Icon="@Icons.Material.Outlined.Summarize"
                                                     Class="ned-links__add-icon" />
                                        </button>
                                    </div>

                                    @if (_showAddSummaryForm)
                                    {
                                        <div class="ned-summaries__form">
                                            <MudTextField T="string"
                                                          @bind-Value="_newSummaryContent"
                                                          Label="Summary"
                                                          Placeholder="Distil the key ideas…"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="3"
                                                          Immediate="true"
                                                          Class="mb-2" />
                                            <div class="d-flex gap-2">
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           Disabled="_summariesLoading"
                                                           OnClick="AddSummaryAsync">Add</MudButton>
                                                <MudButton Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           OnClick="() => _showAddSummaryForm = false">Cancel</MudButton>
                                            </div>
                                        </div>
                                    }

                                    @if (_summariesLoading)
                                    {
                                        <div class="ned-links__loading">
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary" />
                                        </div>
                                    }
                                    else if (_summaries.Count == 0 && !_showAddSummaryForm)
                                    {
                                        <p class="ned-links__empty">No summary layers yet.</p>
                                    }
                                    else if (_summaries.Count > 0)
                                    {
                                        <div class="ned-summaries__list">
                                            @foreach (var s in _summaries)
                                            {
                                                <div class="ned-summaries__item ned-links__item">
                                                    @if (s.IsAiGenerated)
                                                    {
                                                        <span class="ned-summaries__ai-badge ned-links__type-badge"
                                                              title="AI-generated">✨ AI</span>
                                                    }
                                                    <span class="ned-summaries__content">@s.Content</span>
                                                    <button type="button"
                                                            class="ned-links__remove"
                                                            title="Delete summary"
                                                            @onclick="() => DeleteSummaryAsync(s)">
                                                        <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline"
                                                                 Class="ned-links__remove-icon" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="note-editor__sidebar-section">
                                    <h3 class="note-editor__sidebar-heading">Metadata</h3>
                                    <div class="note-editor__meta">
                                        <div class="note-editor__meta-row">
                                            <span class="note-editor__meta-label">Created</span>
                                            <span class="note-editor__meta-value">
                                                <UserLocalTime Utc="_originalNote?.CreatedAtUtc" />
                                            </span>
                                        </div>
                                        <div class="note-editor__meta-row">
                                            <span class="note-editor__meta-label">Updated</span>
                                            <span class="note-editor__meta-value">
                                                <UserLocalTime Utc="_originalNote?.UpdatedAtUtc" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="note-editor__sidebar-section">
                                <h3 class="note-editor__sidebar-heading">Markdown tips</h3>
                                <p class="note-editor__sidebar-tip">
                                    Use <strong>Write</strong> to author with Markdown, then
                                    <strong>Preview</strong> to see it rendered.
                                </p>
                                @if (ProjectId.HasValue)
                                {
                                    <p class="note-editor__sidebar-tip">
                                        This note will be linked to the current <strong>project</strong>.
                                    </p>
                                }
                                else
                                {
                                    <p class="note-editor__sidebar-tip">
                                        New notes land in your <strong>Inbox</strong> unless you pick another status.
                                    </p>
                                }
                            </div>
                        }

                    </aside>

                </div>
            </div>
        }
    </DialogContent>

    <DialogActions>
        @if (_isDirty)
        {
            <span class="note-editor__unsaved-badge mr-2" aria-live="polite">
                <span class="note-editor__unsaved-dot" aria-hidden="true"></span>
                Unsaved changes
            </span>
        }
        else if (_saved)
        {
            <span class="note-editor__saved-badge mr-2" aria-live="polite">Saved</span>
        }
        <MudSpacer />
        <MudButton OnClick="CancelAsync" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="_saving || _loading"
                   StartIcon="@Icons.Material.Filled.Save">
            @(_saving ? "Saving…" : "Save note")
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>When set the dialog is in edit mode; null means create mode.</summary>
    [Parameter] public Guid? NoteId { get; set; }

    /// <summary>Optional project to link a newly created note to. Ignored in edit mode.</summary>
    [Parameter] public Guid? ProjectId { get; set; }

    private sealed class NoteFormModel
    {
        public string Title              { get; set; } = string.Empty;
        public string Content            { get; set; } = string.Empty;
        public ParaCategory ParaCategory { get; set; } = ParaCategory.Project;
        public NoteStatus   Status       { get; set; } = NoteStatus.Inbox;
        public string       SourceUrl    { get; set; } = string.Empty;
        public string       SourceTitle  { get; set; } = string.Empty;
    }

    private readonly NoteFormModel _model = new();
    private NoteDto? _originalNote;
    private string _activeTab = "write";
    private bool _loading    = true;
    private bool _isDirty;
    private bool _saved;
    private bool _titleError;
    private bool _saving;
    private IDisposable? _locationChangingHandler;

    // ── Clipboard image paste ──
    private DotNetObjectReference<NoteEditorDialog>? _dotNetRef;
    private bool _pasteRegistered;
    private readonly List<Guid> _pendingImageIds = [];
    private NoteDto? _persistedNoteAwaitingImageAssociation;
    private bool _pendingImagesReferencedByPersistedNote;
    private IReadOnlyList<NoteRelationshipDto> _links = [];
    private bool _linksLoading;

    // ── Related notes ──
    private IReadOnlyList<RelatedNoteDto> _relatedNotes = [];
    private bool _relatedLoading;
    private CancellationTokenSource? _relatedCts;

    // ── Highlights ──
    private IReadOnlyList<HighlightDto> _highlights = [];
    private bool _highlightsLoading;
    private bool _showAddHighlightForm;
    private string _newHighlightText       = string.Empty;
    private string _newHighlightAnnotation = string.Empty;
    private int    _newHighlightLayer      = 1;

    // ── Summary layers ──
    private IReadOnlyList<SummaryDto> _summaries = [];
    private bool _summariesLoading;
    private bool _summaryGenerating;
    private bool _showAddSummaryForm;
    private string _newSummaryContent = string.Empty;

    // ── Actions ──
    private IReadOnlyList<ActionItemDto> _actions = [];
    private bool _actionsLoading;
    private bool _actionsExtracting;

    // ── Duplicate detection ──
    private bool _dupChecking;
    private bool _dupChecked;
    private List<(Guid Id, string Title)> _duplicates = [];

    protected override async Task OnInitializedAsync()
    {
        if (NoteId.HasValue)
        {
            var note = await NoteService.GetByIdAsync(NoteId.Value);
            if (note is null)
            {
                Snackbar.Add("Note not found or you don't have access.", Severity.Error);
                MudDialog.Cancel();
                return;
            }
            _originalNote        = note;
            _model.Title         = note.Title;
            _model.Content       = note.Content;
            _model.ParaCategory  = note.ParaCategory;
            _model.Status        = note.Status;
            _model.SourceUrl     = note.SourceUrl    ?? string.Empty;
            _model.SourceTitle   = note.SourceTitle  ?? string.Empty;

            _links = await RelationshipService.GetForNoteAsync(NoteId.Value);

            _relatedLoading = true;
            _relatedNotes   = await RelatedNotesService.GetRelatedAsync(NoteId.Value);
            _relatedLoading = false;

            _highlights = await HighlightService.GetByNoteAsync(NoteId.Value);
            _summaries  = await SummaryService.GetByNoteAsync(NoteId.Value);
            _actions    = await ActionItemService.GetByNoteAsync(NoteId.Value);
        }
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _locationChangingHandler = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The content textarea only exists on the Write tab; (re)attach the paste
        // handler whenever it becomes available and detach when leaving Write.
        if (!_loading && _activeTab == "write" && !_pasteRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("brainyNoteEditor.registerPasteHandler", "ned-content-area", _dotNetRef);
            _pasteRegistered = true;
        }
        else if (_activeTab != "write" && _pasteRegistered)
        {
            _pasteRegistered = false;
        }
    }

    /// <summary>
    /// Invoked from JavaScript when an image is pasted into the editor. Pulls the image
    /// bytes via a stream reference, stores them in the database, and inserts the Markdown
    /// reference at the caret.
    /// </summary>
    [JSInvokable]
    public async Task OnImagePastedAsync(string contentType, string fileName)
    {
        try
        {
            var streamRef = await JS.InvokeAsync<IJSStreamReference?>("brainyNoteEditor.getPastedImageBytes");
            if (streamRef is null)
                return;

            byte[] bytes;
            await using (var stream = await streamRef.OpenReadStreamAsync(INoteImageService.MaxSizeBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            await JS.InvokeVoidAsync("brainyNoteEditor.clearPastedImage");

            var saved = await NoteImageService.UploadAsync(
                new UploadNoteImageDto(bytes, contentType, fileName, NoteId));
            _pendingImageIds.Add(saved.Id);

            var alt = string.IsNullOrWhiteSpace(saved.FileName) ? "image" : saved.FileName;
            var markdown = $"\n![{alt}](/api/note-images/{saved.Id})\n";

            var newValue = await JS.InvokeAsync<string?>(
                "brainyNoteEditor.insertTextAtCursor", "ned-content-area", markdown);

            if (newValue is not null)
            {
                _model.Content = newValue;
                MarkDirty();
            }

            StateHasChanged();
            Snackbar.Add("Image added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add image: {ex.Message}", Severity.Error);
        }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!_isDirty) return;

        var confirmed = await DialogService.ShowMessageBox(
            "Unsaved Changes",
            "You have unsaved changes that will be lost. Leave anyway?",
            yesText: "Leave", cancelText: "Stay");

        if (confirmed != true)
            context.PreventNavigation();
    }

    private void MarkDirty()
    {
        _saved = false;
        if (_isDirty) return;
        _isDirty = true;
        _ = JS.InvokeVoidAsync("brainyNoteEditor.addBeforeunloadWarning");
    }

    private async Task ToggleFavoriteAsync()
    {
        if (_originalNote is null) return;
        try
        {
            _originalNote = await NoteService.ToggleFavoriteAsync(_originalNote.Id);
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Could not update favorite.", Severity.Error);
        }
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        _model.Title = e.Value?.ToString() ?? string.Empty;
        _titleError  = string.IsNullOrWhiteSpace(_model.Title);
        MarkDirty();
        ScheduleRelatedRefresh();
    }

    private void OnContentInput(ChangeEventArgs e)
    {
        _model.Content = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        ScheduleRelatedRefresh();
    }

    private void OnParaCategoryChanged(ParaCategory value)
    {
        _model.ParaCategory = value;
        MarkDirty();
    }

    private void OnStatusChanged(NoteStatus value)
    {
        _model.Status = value;
        MarkDirty();
    }

    private void OnSourceUrlChanged(string value)
    {
        _model.SourceUrl = value;
        MarkDirty();
    }

    private void OnSourceTitleChanged(string value)
    {
        _model.SourceTitle = value;
        MarkDirty();
    }

    private async Task InsertMarkdownAsync(string prefix, string suffix, string placeholder)
    {
        var newValue = await JS.InvokeAsync<string?>(
            "brainyNoteEditor.insertMarkdown",
            "ned-content-area", prefix, suffix, placeholder);

        if (newValue is not null)
        {
            _model.Content = newValue;
            MarkDirty();
        }
    }

    private void HintPasteImage() =>
        Snackbar.Add("Copy an image, then paste it (Ctrl+V) into the editor to embed it.", Severity.Info);

    private async Task SaveAsync()
    {
        _titleError = string.IsNullOrWhiteSpace(_model.Title);
        if (_titleError)
        {
            Snackbar.Add("Please enter a title for the note.", Severity.Warning);
            return;
        }

        _saving = true;
        var notePersisted = _persistedNoteAwaitingImageAssociation is not null;
        try
        {
            NoteDto saved;
            if (_persistedNoteAwaitingImageAssociation is { } persistedNote)
            {
                // The note was committed by an earlier attempt but linking its pending
                // images failed. Retry only the association instead of creating a duplicate.
                saved = persistedNote;
            }
            else if (NoteId.HasValue)
            {
                saved = await NoteService.UpdateAsync(new UpdateNoteDto(
                    NoteId.Value,
                    _model.Title,
                    _model.Content,
                    _originalNote!.AiSummary,
                    _model.Status,
                    _model.ParaCategory,
                    _originalNote.ProjectId,
                    _originalNote.AreaId,
                    _originalNote.ResourceId,
                    SourceUrl: _model.SourceUrl,
                    SourceTitle: _model.SourceTitle,
                    RowVersion: _originalNote.RowVersion));
                _originalNote = saved;
            }
            else
            {
                saved = await NoteService.CreateAsync(new CreateNoteDto(
                    _model.Title,
                    _model.Content,
                    _model.ParaCategory,
                    ProjectId: ProjectId,
                    Status: _model.Status,
                    SourceUrl: string.IsNullOrWhiteSpace(_model.SourceUrl) ? null : _model.SourceUrl,
                    SourceTitle: string.IsNullOrWhiteSpace(_model.SourceTitle) ? null : _model.SourceTitle));

                if (_pendingImageIds.Count > 0)
                {
                    _persistedNoteAwaitingImageAssociation = saved;
                    _pendingImagesReferencedByPersistedNote = true;
                }
            }
            notePersisted = true;

            // Link any images pasted before the note was first saved.
            if (_pendingImageIds.Count > 0)
            {
                await NoteImageService.AssociateWithNoteAsync(saved.Id, _pendingImageIds);
                _pendingImageIds.Clear();
                _persistedNoteAwaitingImageAssociation = null;
                _pendingImagesReferencedByPersistedNote = false;
            }

            _isDirty = false;
            _saved   = true;
            await CleanupJsAsync();

            Snackbar.Add(NoteId.HasValue ? "Note saved." : "Note created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (ConcurrencyConflictException ex)
        {
            // Keep the dialog open so the user's edits are not lost.
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            if (!notePersisted && !NoteId.HasValue)
                await TryDeletePendingImagesAsync(removeMarkdownReferences: true, notifyOnFailure: true);

            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (_isDirty)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Unsaved Changes",
                "You have unsaved changes that will be lost. Leave anyway?",
                yesText: "Leave", cancelText: "Stay");

            if (confirmed != true) return;
        }

        await TryDeletePendingImagesAsync(removeMarkdownReferences: false, notifyOnFailure: true);
        await CleanupJsAsync();
        MudDialog.Cancel();
    }

    private MarkupString RenderMarkdown()
    {
        if (string.IsNullOrWhiteSpace(_model.Content))
            return new MarkupString(
                "<p class='note-editor__preview-empty'>Nothing to preview yet — switch to <strong>Write</strong> to add content.</p>");

        return new MarkupString(MarkdownHtmlRenderer.Render(_model.Content));
    }

    private static string CategoryDotColor(ParaCategory cat) => cat switch
    {
        ParaCategory.Project  => "#c0561d",
        ParaCategory.Area     => "#6f7a5a",
        ParaCategory.Resource => "#2196f3",
        ParaCategory.Archive  => "#9a9180",
        _                     => "#9a9180"
    };

    private async Task CleanupJsAsync()
    {
        try { await JS.InvokeVoidAsync("brainyNoteEditor.removeBeforeunloadWarning"); }
        catch { /* ignore: circuit may be tearing down */ }
    }

    private async Task TryDeletePendingImagesAsync(bool removeMarkdownReferences, bool notifyOnFailure)
    {
        if (_pendingImageIds.Count == 0 || _pendingImagesReferencedByPersistedNote)
            return;

        var pendingIds = _pendingImageIds.ToArray();
        try
        {
            await NoteImageService.DeletePendingAsync(pendingIds);
            _pendingImageIds.Clear();

            if (removeMarkdownReferences)
            {
                var pendingUrls = pendingIds
                    .Select(id => $"/api/note-images/{id}")
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                var retainedLines = _model.Content
                    .Replace("\r\n", "\n", StringComparison.Ordinal)
                    .Split('\n')
                    .Where(line => !pendingUrls.Any(url => line.Contains(url, StringComparison.OrdinalIgnoreCase)));
                _model.Content = string.Join("\n", retainedLines);
                Snackbar.Add("Pending images were removed after the failed save. Paste them again before retrying.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            if (notifyOnFailure)
                Snackbar.Add($"Could not clean up pending images: {ex.Message}", Severity.Warning);
        }
    }

    // ── Relationship helpers ──────────────────────────────────────────────────

    private async Task OpenLinkPickerAsync()
    {
        if (!NoteId.HasValue) return;

        var excluded = _links.Select(l => l.LinkedNoteId);
        var parameters = new DialogParameters<NoteLinkPickerDialog>
        {
            { x => x.CurrentNoteId,   NoteId.Value },
            { x => x.ExcludedNoteIds, excluded     }
        };

        var opts = new DialogOptions
        {
            MaxWidth      = MaxWidth.Small,
            FullWidth     = true,
            BackdropClick = true,
            CloseButton   = false
        };
        var dialog = await DialogService.ShowAsync<NoteLinkPickerDialog>("", parameters, opts);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateNoteRelationshipDto dto })
        {
            _linksLoading = true;
            try
            {
                await RelationshipService.CreateAsync(dto);
                _links = await RelationshipService.GetForNoteAsync(NoteId.Value);
                Snackbar.Add("Note linked.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not link note: {ex.Message}", Severity.Error);
            }
            finally
            {
                _linksLoading = false;
            }
        }
    }

    private async Task RemoveLinkAsync(NoteRelationshipDto link)
    {
        if (!NoteId.HasValue) return;
        _linksLoading = true;
        try
        {
            await RelationshipService.DeleteAsync(link.Id);
            _links = await RelationshipService.GetForNoteAsync(NoteId.Value);
            Snackbar.Add("Link removed.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not remove link: {ex.Message}", Severity.Error);
        }
        finally
        {
            _linksLoading = false;
        }
    }

    private async Task OpenLinkedNoteAsync(Guid linkedNoteId)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, linkedNoteId }
        };
        var opts = new DialogOptions
        {
            MaxWidth         = MaxWidth.Large,
            FullWidth        = true,
            BackdropClick    = false,
            CloseOnEscapeKey = false,
            CloseButton      = false
        };
        await DialogService.ShowAsync<NoteEditorDialog>("", parameters, opts);
    }

    private static string RelTypLabel(RelationshipType t) => t switch
    {
        RelationshipType.Related     => "Related",
        RelationshipType.References  => "References",
        RelationshipType.FollowUp    => "Follow-up",
        RelationshipType.Duplicate   => "Duplicate",
        RelationshipType.Supports    => "Supports",
        RelationshipType.Contradicts => "Contradicts",
        _                            => t.ToString()
    };

    // ── Related notes helpers ─────────────────────────────────────────────────

    private void ScheduleRelatedRefresh()
    {
        if (!NoteId.HasValue) return;
        _relatedCts?.Cancel();
        _relatedCts = new CancellationTokenSource();
        _ = ExecuteRelatedRefreshAsync(_relatedCts.Token);
    }

    private async Task ExecuteRelatedRefreshAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(1500, ct);
            if (ct.IsCancellationRequested) return;

            _relatedLoading = true;
            StateHasChanged();

            _relatedNotes   = await RelatedNotesService.GetRelatedByContentAsync(
                NoteId!.Value, _model.Title, _model.Content, 5, ct);

            _relatedLoading = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch
        {
            _relatedLoading = false;
        }
    }

    private static string ScoreBar(double score)
    {
        // ▪ (filled blocks) as a visual indicator: 1-4 blocks
        var blocks = score switch
        {
            >= 0.20 => "████",
            >= 0.12 => "███░",
            >= 0.07 => "██░░",
            _       => "█░░░"
        };
        return blocks;
    }

    private static string CatDotColor(ParaCategory cat) => cat switch
    {
        ParaCategory.Project  => "#c0561d",
        ParaCategory.Area     => "#6f7a5a",
        ParaCategory.Resource => "#3a7bcd",
        ParaCategory.Archive  => "#9a9180",
        _                     => "#9a9180"
    };

    // ── Highlights helpers ────────────────────────────────────────────────────

    private async Task AddHighlightAsync()
    {
        if (!NoteId.HasValue) return;
        if (string.IsNullOrWhiteSpace(_newHighlightText))
        {
            Snackbar.Add("Highlight text must not be empty.", Severity.Warning);
            return;
        }

        _highlightsLoading = true;
        try
        {
            await HighlightService.CreateAsync(new CreateHighlightDto(
                NoteId.Value,
                _newHighlightText,
                string.IsNullOrWhiteSpace(_newHighlightAnnotation) ? null : _newHighlightAnnotation,
                _newHighlightLayer,
                FindHighlightOffset(_model.Content, _newHighlightText),
                FindHighlightEndOffset(_model.Content, _newHighlightText)));
            _highlights = await HighlightService.GetByNoteAsync(NoteId.Value);
            _newHighlightText       = string.Empty;
            _newHighlightAnnotation = string.Empty;
            _newHighlightLayer      = 1;
            _showAddHighlightForm   = false;
            Snackbar.Add("Highlight added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add highlight: {ex.Message}", Severity.Error);
        }
        finally
        {
            _highlightsLoading = false;
        }
    }

    private static int? FindHighlightOffset(string content, string text)
    {
        var trimmed = text.Trim();
        var index = content.IndexOf(trimmed, StringComparison.Ordinal);
        return index < 0 ? null : index;
    }

    private static int? FindHighlightEndOffset(string content, string text)
    {
        var start = FindHighlightOffset(content, text);
        return start.HasValue ? start.Value + text.Trim().Length : null;
    }

