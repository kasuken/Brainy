    /// <summary>Generates an AI summary for the current note and saves it as a summary layer.</summary>
    private async Task GenerateAiSummaryAsync()
    {
        if (_originalNote is null) return;

        _summaryGenerating = true;
        try
        {
            var content = $"{_model.Title}\n\n{_model.Content}";
            var result = await AiAssistant.SummarizeAsync(content);
            if (!result.Success)
            {
                Snackbar.Add($"AI summary failed: {result.ErrorMessage}", Severity.Warning);
                return;
            }
            await SummaryService.CreateAsync(new CreateSummaryDto(
                _originalNote.Id,
                result.Content,
                IsAiGenerated: true,
                Model: result.Model,
                PromptVersion: result.PromptVersion));
            _summaries = await SummaryService.GetByNoteAsync(_originalNote.Id);
            Snackbar.Add("AI summary generated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not generate AI summary: {ex.Message}", Severity.Error);
        }
        finally
        {
            _summaryGenerating = false;
            StateHasChanged();
        }
    }

    // ── Duplicate detection helpers ───────────────────────────────────────────

    /// <summary>Fetches the 20 most-recent candidate notes and asks the AI to identify potential duplicates.</summary>
    private async Task CheckDuplicatesAsync()
    {
        if (!NoteId.HasValue) return;

        _dupChecking = true;
        _dupChecked  = false;
        _duplicates.Clear();
        StateHasChanged();

        try
        {
            var allNotes = await NoteService.GetAllAsync();
            var candidates = allNotes
                .Where(n => n.Id != NoteId.Value)
                .Take(20)
                .Select(n => (Id: n.Id, Title: n.Title, Summary: n.AiSummary))
                .ToList();

            var result = await AiAssistant.DetectDuplicatesAsync(
                _model.Title, _model.Content, candidates);

            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? "AI assistant is not configured.", Severity.Warning);
                return;
            }

            var ids = string.IsNullOrWhiteSpace(result.Content)
                ? []
                : JsonSerializer.Deserialize<List<string>>(result.Content) ?? [];

            var idSet = ids
                .Select(s => Guid.TryParse(s, out var g) ? g : (Guid?)null)
                .Where(g => g.HasValue)
                .Select(g => g!.Value)
                .ToHashSet();

            _duplicates = allNotes
                .Where(n => idSet.Contains(n.Id))
                .Select(n => (n.Id, n.Title))
                .ToList();

            _dupChecked = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not check for duplicates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _dupChecking = false;
        }
    }

    /// <summary>Creates a Duplicate relationship between the current note and the given note, then removes it from the list.</summary>
    private async Task LinkAsSimilarAsync(Guid duplicateId)
    {
        if (!NoteId.HasValue) return;
        try
        {
            await RelationshipService.CreateAsync(new CreateNoteRelationshipDto(
                NoteId.Value, duplicateId, RelationshipType.Duplicate));
            _links = await RelationshipService.GetForNoteAsync(NoteId.Value);
            DismissDuplicate(duplicateId);
            Snackbar.Add("Note linked as duplicate.", Severity.Success);
        }
        catch (InvalidOperationException)
        {
            // Relationship already exists — just remove from the displayed list
            DismissDuplicate(duplicateId);
            Snackbar.Add("Notes are already linked.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not link note: {ex.Message}", Severity.Error);
        }
    }

    private void DismissDuplicate(Guid id) =>
        _duplicates = _duplicates.Where(d => d.Id != id).ToList();

    public async ValueTask DisposeAsync()
    {
        _relatedCts?.Cancel();
        _relatedCts?.Dispose();
        _locationChangingHandler?.Dispose();
        try { await JS.InvokeVoidAsync("brainyNoteEditor.unregisterPasteHandler", "ned-content-area"); }
        catch { /* ignore: circuit may be tearing down */ }
        _dotNetRef?.Dispose();
        await TryDeletePendingImagesAsync(removeMarkdownReferences: false, notifyOnFailure: false);
        await CleanupJsAsync();
    }
