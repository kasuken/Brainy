@implements IAsyncDisposable

@using Brainy.Application.DTOs.Notes
@using Brainy.Application.DTOs.NoteRelationships
@using Brainy.Application.DTOs.RelatedNotes
@using Brainy.Application.Interfaces.Services
@using Brainy.Domain.Enums
@using Markdig
@using Microsoft.JSInterop

@inject INoteService NoteService
@inject INoteImageService NoteImageService
@inject INoteRelationshipService RelationshipService
@inject IRelatedNotesService RelatedNotesService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudDialog>

    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(NoteId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.NoteAdd)"
                     Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(NoteId.HasValue ? "Edit Note" : "New Note")</MudText>
            @if (NoteId.HasValue && _originalNote is not null)
            {
                <MudTooltip Text="@(_originalNote.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                    <MudIconButton Icon="@(_originalNote.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                   Color="@(_originalNote.IsFavorite ? Color.Warning : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="ToggleFavoriteAsync" />
                </MudTooltip>
            }
        </div>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <div class="note-editor-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading note…</MudText>
            </div>
        }
        else
        {
            <div class="ned">

                @* ── Title ── *@
                <div class="ned__title-section">
                    <input type="text"
                           id="ned-title-input"
                           class="note-editor__title-input @(_titleError ? "invalid" : "")"
                           placeholder="Untitled note…"
                           value="@_model.Title"
                           @oninput="OnTitleInput"
                           maxlength="500"
                           aria-label="Note title"
                           aria-required="true"
                           autocomplete="off"
                           spellcheck="true" />
                    @if (_titleError)
                    {
                        <span class="note-editor__title-error" role="alert">Title is required</span>
                    }
                </div>

                <MudDivider Class="my-3" />

                @* ── Body ── *@
                <div class="ned__body">

                    @* Editor main *@
                    <div class="ned__main">

                        <div class="note-editor__toolbar">
                            <div class="note-editor__tabs" role="tablist" aria-label="Editor mode">
                                <button type="button" role="tab"
                                        class="note-editor__tab @(_activeTab == "write" ? "active" : "")"
                                        aria-selected="@(_activeTab == "write")"
                                        @onclick='() => _activeTab = "write"'>Write</button>
                                <button type="button" role="tab"
                                        class="note-editor__tab @(_activeTab == "preview" ? "active" : "")"
                                        aria-selected="@(_activeTab == "preview")"
                                        @onclick='() => _activeTab = "preview"'>Preview</button>
                            </div>

                            @if (_activeTab == "write")
                            {
                                <div class="note-editor__format-tools" role="toolbar" aria-label="Markdown formatting">
                                    <button type="button" class="note-editor__tool" title="Bold"
                                            @onclick='() => InsertMarkdownAsync("**", "**", "bold text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                                            <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Italic"
                                            @onclick='() => InsertMarkdownAsync("*", "*", "italic text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="19" y1="4" x2="10" y2="4" /><line x1="14" y1="20" x2="5" y2="20" />
                                            <line x1="15" y1="4" x2="9" y2="20" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Heading 2"
                                            @onclick='() => InsertMarkdownAsync("## ", "", "Heading")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 12h16M4 6v12M20 6v12" />
                                        </svg>
                                    </button>
                                    <span class="note-editor__tool-divider" aria-hidden="true"></span>
                                    <button type="button" class="note-editor__tool" title="Blockquote"
                                            @onclick='() => InsertMarkdownAsync("> ", "", "quoted text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" />
                                            <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool note-editor__tool--mono" title="Inline code"
                                            @onclick='() => InsertMarkdownAsync("`", "`", "code")'>
                                        &lt;/&gt;
                                    </button>
                                    <span class="note-editor__tool-divider" aria-hidden="true"></span>
                                    <button type="button" class="note-editor__tool" title="Bullet list"
                                            @onclick='() => InsertMarkdownAsync("- ", "", "list item")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="9" y1="6" x2="20" y2="6" /><line x1="9" y1="12" x2="20" y2="12" />
                                            <line x1="9" y1="18" x2="20" y2="18" />
                                            <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none" />
                                            <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none" />
                                            <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Numbered list"
                                            @onclick='() => InsertMarkdownAsync("1. ", "", "list item")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="10" y1="6" x2="21" y2="6" /><line x1="10" y1="12" x2="21" y2="12" />
                                            <line x1="10" y1="18" x2="21" y2="18" />
                                            <path d="M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Link"
                                            @onclick='() => InsertMarkdownAsync("[", "](https://)", "link text")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                                        </svg>
                                    </button>
                                    <button type="button" class="note-editor__tool" title="Paste an image (Ctrl+V) to embed it"
                                            @onclick="HintPasteImage">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <path d="M21 15l-5-5L5 21" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_activeTab == "write")
                        {
                            <textarea id="ned-content-area"
                                      class="note-editor__textarea ned__textarea"
                                      placeholder="Start writing… Markdown is supported."
                                      aria-label="Note content"
                                      @oninput="OnContentInput">@_model.Content</textarea>
                        }
                        else
                        {
                            <div class="note-editor__preview ned__textarea markdown-body"
                                 role="article" aria-label="Rendered preview">
                                @RenderMarkdown()
                            </div>
                        }

                    </div>

                    @* Sidebar *@
                    <aside class="ned__sidebar note-editor__sidebar" aria-label="Note properties">

                        <div class="note-editor__sidebar-section">
                            <h3 class="note-editor__sidebar-heading">PARA Category</h3>
                            <MudSelect T="ParaCategory"
                                       Value="_model.ParaCategory"
                                       ValueChanged="OnParaCategoryChanged"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomLeft">
                                @foreach (var cat in Enum.GetValues<ParaCategory>())
                                {
                                    <MudSelectItem Value="cat">
                                        <span class="note-editor__select-option">
                                            <span class="note-editor__select-dot"
                                                  style="background:@CategoryDotColor(cat)"></span>
                                            @cat.ToString()
                                        </span>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        @if (NoteId.HasValue)
                        {
                            <div class="note-editor__sidebar-section">
                                <h3 class="note-editor__sidebar-heading">Status</h3>
                                <MudSelect T="NoteStatus"
                                           Value="_model.Status"
                                           ValueChanged="OnStatusChanged"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomLeft">
                                    @foreach (var status in Enum.GetValues<NoteStatus>())
                                    {
                                        <MudSelectItem Value="status">@status.ToString()</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (_originalNote is not null)
                            {
                                @* ── Linked Notes ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-links__header">
                                        <h3 class="note-editor__sidebar-heading">Linked Notes</h3>
                                        <button type="button"
                                                class="ned-links__add-btn"
                                                title="Link a note"
                                                @onclick="OpenLinkPickerAsync">
                                            <MudIcon Icon="@Icons.Material.Outlined.AddLink"
                                                     Class="ned-links__add-icon" />
                                        </button>
                                    </div>

                                    @if (_linksLoading)
                                    {
                                        <div class="ned-links__loading">
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary" />
                                        </div>
                                    }
                                    else if (_links.Count == 0)
                                    {
                                        <p class="ned-links__empty">No linked notes yet.</p>
                                    }
                                    else
                                    {
                                        <div class="ned-links__list">
                                            @foreach (var link in _links)
                                            {
                                                <div class="ned-links__item">
                                                    <span class="ned-links__type-badge">
                                                        @RelTypLabel(link.Type)
                                                    </span>
                                                    <button type="button"
                                                            class="ned-links__note-title"
                                                            title="Open @link.LinkedNoteTitle"
                                                            @onclick="() => OpenLinkedNoteAsync(link.LinkedNoteId)">
                                                        @link.LinkedNoteTitle
                                                    </button>
                                                    <button type="button"
                                                            class="ned-links__remove"
                                                            title="Remove link"
                                                            @onclick="() => RemoveLinkAsync(link)">
                                                        <MudIcon Icon="@Icons.Material.Outlined.LinkOff"
                                                                 Class="ned-links__remove-icon" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @* ── Related Notes (AI-free similarity) ── *@
                                <div class="note-editor__sidebar-section">
                                    <div class="ned-related__header">
                                        <h3 class="note-editor__sidebar-heading">Related Notes</h3>
                                        @if (_relatedLoading)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small"
                                                                 Color="Color.Primary"
                                                                 Class="ned-related__spinner" />
                                        }
                                    </div>

                                    @if (!_relatedLoading && _relatedNotes.Count == 0)
                                    {
                                        <p class="ned-links__empty">No similar notes found yet.</p>
                                    }
                                    else if (_relatedNotes.Count > 0)
                                    {
                                        <div class="ned-related__list">
                                            @foreach (var r in _relatedNotes)
                                            {
                                                <button type="button"
                                                        class="ned-related__item"
                                                        title="Open: @r.Title"
                                                        @onclick="() => OpenLinkedNoteAsync(r.Id)">
                                                    <span class="ned-related__item-dot"
                                                          style="background:@CatDotColor(r.ParaCategory)"></span>
                                                    <span class="ned-related__item-title">@r.Title</span>
                                                    <span class="ned-related__item-score"
                                                          title="Similarity: @((r.SimilarityScore * 100).ToString("F0"))%">
                                                        @ScoreBar(r.SimilarityScore)
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="note-editor__sidebar-section">
                                    <h3 class="note-editor__sidebar-heading">Metadata</h3>
                                    <div class="note-editor__meta">
                                        <div class="note-editor__meta-row">
                                            <span class="note-editor__meta-label">Created</span>
                                            <span class="note-editor__meta-value">
                                                @_originalNote.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                            </span>
                                        </div>
                                        <div class="note-editor__meta-row">
                                            <span class="note-editor__meta-label">Updated</span>
                                            <span class="note-editor__meta-value">
                                                @_originalNote.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="note-editor__sidebar-section">
                                <h3 class="note-editor__sidebar-heading">Markdown tips</h3>
                                <p class="note-editor__sidebar-tip">
                                    Use <strong>Write</strong> to author with Markdown, then
                                    <strong>Preview</strong> to see it rendered.
                                </p>
                                <p class="note-editor__sidebar-tip">
                                    New notes land in your <strong>Inbox</strong>.
                                </p>
                            </div>
                        }

                    </aside>

                </div>
            </div>
        }
    </DialogContent>

    <DialogActions>
        @if (_isDirty)
        {
            <span class="note-editor__unsaved-badge mr-2" aria-live="polite">
                <span class="note-editor__unsaved-dot" aria-hidden="true"></span>
                Unsaved changes
            </span>
        }
        else if (_saved)
        {
            <span class="note-editor__saved-badge mr-2" aria-live="polite">Saved</span>
        }
        <MudSpacer />
        <MudButton OnClick="CancelAsync" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="_saving || _loading"
                   StartIcon="@Icons.Material.Filled.Save">
            @(_saving ? "Saving…" : "Save note")
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>When set the dialog is in edit mode; null means create mode.</summary>
    [Parameter] public Guid? NoteId { get; set; }

    private sealed class NoteFormModel
    {
        public string Title              { get; set; } = string.Empty;
        public string Content            { get; set; } = string.Empty;
        public ParaCategory ParaCategory { get; set; } = ParaCategory.Project;
        public NoteStatus   Status       { get; set; } = NoteStatus.Inbox;
    }

    private readonly NoteFormModel _model = new();
    private NoteDto? _originalNote;
    private string _activeTab = "write";
    private bool _loading    = true;
    private bool _isDirty;
    private bool _saved;
    private bool _titleError;
    private bool _saving;
    private IDisposable? _locationChangingHandler;

    // ── Clipboard image paste ──
    private DotNetObjectReference<NoteEditorDialog>? _dotNetRef;
    private bool _pasteRegistered;
    private readonly List<Guid> _pendingImageIds = [];
    private IReadOnlyList<NoteRelationshipDto> _links = [];
    private bool _linksLoading;

    // ── Related notes ──
    private IReadOnlyList<RelatedNoteDto> _relatedNotes = [];
    private bool _relatedLoading;
    private CancellationTokenSource? _relatedCts;

    private static readonly MarkdownPipeline _pipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    protected override async Task OnInitializedAsync()
    {
        if (NoteId.HasValue)
        {
            var note = await NoteService.GetByIdAsync(NoteId.Value);
            if (note is null)
            {
                Snackbar.Add("Note not found or you don't have access.", Severity.Error);
                MudDialog.Cancel();
                return;
            }
            _originalNote        = note;
            _model.Title         = note.Title;
            _model.Content       = note.Content;
            _model.ParaCategory  = note.ParaCategory;
            _model.Status        = note.Status;

            _links = await RelationshipService.GetForNoteAsync(NoteId.Value);

            _relatedLoading = true;
            _relatedNotes   = await RelatedNotesService.GetRelatedAsync(NoteId.Value);
            _relatedLoading = false;
        }
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _locationChangingHandler = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The content textarea only exists on the Write tab; (re)attach the paste
        // handler whenever it becomes available and detach when leaving Write.
        if (!_loading && _activeTab == "write" && !_pasteRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("brainyNoteEditor.registerPasteHandler", "ned-content-area", _dotNetRef);
            _pasteRegistered = true;
        }
        else if (_activeTab != "write" && _pasteRegistered)
        {
            _pasteRegistered = false;
        }
    }

    /// <summary>
    /// Invoked from JavaScript when an image is pasted into the editor. Pulls the image
    /// bytes via a stream reference, stores them in the database, and inserts the Markdown
    /// reference at the caret.
    /// </summary>
    [JSInvokable]
    public async Task OnImagePastedAsync(string contentType, string fileName)
    {
        try
        {
            var streamRef = await JS.InvokeAsync<IJSStreamReference?>("brainyNoteEditor.getPastedImageBytes");
            if (streamRef is null)
                return;

            byte[] bytes;
            await using (var stream = await streamRef.OpenReadStreamAsync(INoteImageService.MaxSizeBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            await JS.InvokeVoidAsync("brainyNoteEditor.clearPastedImage");

            var saved = await NoteImageService.UploadAsync(
                new UploadNoteImageDto(bytes, contentType, fileName, NoteId));
            _pendingImageIds.Add(saved.Id);

            var alt = string.IsNullOrWhiteSpace(saved.FileName) ? "image" : saved.FileName;
            var markdown = $"\n![{alt}](/api/note-images/{saved.Id})\n";

            var newValue = await JS.InvokeAsync<string?>(
                "brainyNoteEditor.insertTextAtCursor", "ned-content-area", markdown);

            if (newValue is not null)
            {
                _model.Content = newValue;
                MarkDirty();
            }

            StateHasChanged();
            Snackbar.Add("Image added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add image: {ex.Message}", Severity.Error);
        }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!_isDirty) return;

        var confirmed = await DialogService.ShowMessageBox(
            "Unsaved Changes",
            "You have unsaved changes that will be lost. Leave anyway?",
            yesText: "Leave", cancelText: "Stay");

        if (confirmed != true)
            context.PreventNavigation();
    }

    private void MarkDirty()
    {
        _saved = false;
        if (_isDirty) return;
        _isDirty = true;
        _ = JS.InvokeVoidAsync("brainyNoteEditor.addBeforeunloadWarning");
    }

    private async Task ToggleFavoriteAsync()
    {
        if (_originalNote is null) return;
        try
        {
            _originalNote = await NoteService.ToggleFavoriteAsync(_originalNote.Id);
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Could not update favorite.", Severity.Error);
        }
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        _model.Title = e.Value?.ToString() ?? string.Empty;
        _titleError  = string.IsNullOrWhiteSpace(_model.Title);
        MarkDirty();
        ScheduleRelatedRefresh();
    }

    private void OnContentInput(ChangeEventArgs e)
    {
        _model.Content = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
        ScheduleRelatedRefresh();
    }

    private void OnParaCategoryChanged(ParaCategory value)
    {
        _model.ParaCategory = value;
        MarkDirty();
    }

    private void OnStatusChanged(NoteStatus value)
    {
        _model.Status = value;
        MarkDirty();
    }

    private async Task InsertMarkdownAsync(string prefix, string suffix, string placeholder)
    {
        var newValue = await JS.InvokeAsync<string?>(
            "brainyNoteEditor.insertMarkdown",
            "ned-content-area", prefix, suffix, placeholder);

        if (newValue is not null)
        {
            _model.Content = newValue;
            MarkDirty();
        }
    }

    private void HintPasteImage() =>
        Snackbar.Add("Copy an image, then paste it (Ctrl+V) into the editor to embed it.", Severity.Info);

    private async Task SaveAsync()
    {
        _titleError = string.IsNullOrWhiteSpace(_model.Title);
        if (_titleError)
        {
            Snackbar.Add("Please enter a title for the note.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            NoteDto saved;
            if (NoteId.HasValue)
            {
                saved = await NoteService.UpdateAsync(new UpdateNoteDto(
                    NoteId.Value,
                    _model.Title,
                    _model.Content,
                    _originalNote!.AiSummary,
                    _model.Status,
                    _model.ParaCategory,
                    _originalNote.ProjectId,
                    _originalNote.AreaId,
                    _originalNote.ResourceId));
                _originalNote = saved;
            }
            else
            {
                saved = await NoteService.CreateAsync(new CreateNoteDto(
                    _model.Title,
                    _model.Content,
                    _model.ParaCategory));
            }

            // Link any images pasted before the note was first saved.
            if (_pendingImageIds.Count > 0)
            {
                await NoteImageService.AssociateWithNoteAsync(saved.Id, _pendingImageIds);
                _pendingImageIds.Clear();
            }

            _isDirty = false;
            _saved   = true;
            await CleanupJsAsync();

            Snackbar.Add(NoteId.HasValue ? "Note saved." : "Note created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (_isDirty)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Unsaved Changes",
                "You have unsaved changes that will be lost. Leave anyway?",
                yesText: "Leave", cancelText: "Stay");

            if (confirmed != true) return;
        }

        await CleanupJsAsync();
        MudDialog.Cancel();
    }

    private MarkupString RenderMarkdown()
    {
        if (string.IsNullOrWhiteSpace(_model.Content))
            return new MarkupString(
                "<p class='note-editor__preview-empty'>Nothing to preview yet — switch to <strong>Write</strong> to add content.</p>");

        return new MarkupString(Markdown.ToHtml(_model.Content, _pipeline));
    }

