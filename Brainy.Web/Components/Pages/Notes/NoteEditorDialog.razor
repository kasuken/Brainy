    // ── Related notes helpers ─────────────────────────────────────────────────

    private void ScheduleRelatedRefresh()
    {
        if (!NoteId.HasValue) return;
        _relatedCts?.Cancel();
        _relatedCts = new CancellationTokenSource();
        _ = ExecuteRelatedRefreshAsync(_relatedCts.Token);
    }

    private async Task ExecuteRelatedRefreshAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(1500, ct);
            if (ct.IsCancellationRequested) return;

            _relatedLoading = true;
            StateHasChanged();

            _relatedNotes   = await RelatedNotesService.GetRelatedByContentAsync(
                NoteId!.Value, _model.Title, _model.Content, 5, ct);

            _relatedLoading = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch
        {
            _relatedLoading = false;
        }
    }

    private static string ScoreBar(double score)
    {
        // ▪ (filled blocks) as a visual indicator: 1-4 blocks
        var blocks = score switch
        {
            >= 0.20 => "████",
            >= 0.12 => "███░",
            >= 0.07 => "██░░",
            _       => "█░░░"
        };
        return blocks;
    }

