    // ── Relationship helpers ──────────────────────────────────────────────────

    private async Task OpenLinkPickerAsync()
    {
        if (!NoteId.HasValue) return;

        var excluded = _links.Select(l => l.LinkedNoteId);
        var parameters = new DialogParameters<NoteLinkPickerDialog>
        {
            { x => x.CurrentNoteId,   NoteId.Value },
            { x => x.ExcludedNoteIds, excluded     }
        };

        var opts = new DialogOptions
        {
            MaxWidth      = MaxWidth.Small,
            FullWidth     = true,
            BackdropClick = true,
            CloseButton   = false
        };
        var dialog = await DialogService.ShowAsync<NoteLinkPickerDialog>("", parameters, opts);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateNoteRelationshipDto dto })
        {
            _linksLoading = true;
            try
            {
                await RelationshipService.CreateAsync(dto);
                _links = await RelationshipService.GetForNoteAsync(NoteId.Value);
                Snackbar.Add("Note linked.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not link note: {ex.Message}", Severity.Error);
            }
            finally
            {
                _linksLoading = false;
            }
        }
    }

    private async Task RemoveLinkAsync(NoteRelationshipDto link)
    {
        if (!NoteId.HasValue) return;
        _linksLoading = true;
        try
        {
            await RelationshipService.DeleteAsync(link.Id);
            _links = await RelationshipService.GetForNoteAsync(NoteId.Value);
            Snackbar.Add("Link removed.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not remove link: {ex.Message}", Severity.Error);
        }
        finally
        {
            _linksLoading = false;
        }
    }

    private async Task OpenLinkedNoteAsync(Guid linkedNoteId)
    {
        var parameters = new DialogParameters<NoteEditorDialog>
        {
            { x => x.NoteId, linkedNoteId }
        };
        var opts = new DialogOptions
        {
            MaxWidth         = MaxWidth.Large,
            FullWidth        = true,
            BackdropClick    = false,
            CloseOnEscapeKey = false,
            CloseButton      = false
        };
        await DialogService.ShowAsync<NoteEditorDialog>("", parameters, opts);
    }

