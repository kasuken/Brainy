    private async Task OpenActionEditorAsync(ActionItemDto? action)
    {
        if (!NoteId.HasValue) return;

        var parameters = new DialogParameters<ActionItemEditorDialog>
        {
            { dialog => dialog.NoteId, NoteId.Value },
            { dialog => dialog.Item, action }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = true,
        };
        var dialog = await DialogService.ShowAsync<ActionItemEditorDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _actions = await ActionItemService.GetByNoteAsync(NoteId.Value);
            Snackbar.Add(action is null ? "Action added." : "Action updated.", Severity.Success);
