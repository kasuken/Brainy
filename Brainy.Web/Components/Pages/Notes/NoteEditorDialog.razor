    private async Task ToggleActionStatusAsync(ActionItemDto action)
    {
        _actionsLoading = true;
        try
        {
            var status = action.Status == ActionItemStatus.Done
                ? ActionItemStatus.Open
                : ActionItemStatus.Done;
            await ActionItemService.UpdateAsync(new UpdateActionItemDto(
                action.Id, action.Title, action.Description, status, action.RowVersion));
            _actions = await ActionItemService.GetByNoteAsync(action.NoteId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update action: {ex.Message}", Severity.Error);
        }
        finally
        {
            _actionsLoading = false;
        }
    }

    private async Task DeleteActionAsync(ActionItemDto action)
    {
        var detail = action.TaskItemId.HasValue
            ? "The promoted task will remain in its project."
            : "This cannot be undone.";
        var confirmed = await DialogService.ShowMessageBox(
            "Delete action",
            $"Delete \"{action.Title}\"? {detail}",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed is not true) return;

        _actionsLoading = true;
        try
        {
            await ActionItemService.DeleteAsync(action.Id);
            _actions = await ActionItemService.GetByNoteAsync(action.NoteId);
            Snackbar.Add("Action deleted.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete action: {ex.Message}", Severity.Error);
        }
        finally
        {
            _actionsLoading = false;
        }
    }

    private async Task ExtractActionsAsync()
    {
        if (!NoteId.HasValue) return;
        if (_isDirty)
        {
            Snackbar.Add("Save note changes before extracting actions.", Severity.Warning);
            return;
        }

        _actionsExtracting = true;
        try
        {
            var created = await ActionItemService.ExtractFromNoteAsync(NoteId.Value);
            _actions = await ActionItemService.GetByNoteAsync(NoteId.Value);
            Snackbar.Add(
                created.Count == 0 ? "No new actions were found." : $"Extracted {created.Count} action{(created.Count == 1 ? string.Empty : "s")}.",
                created.Count == 0 ? Severity.Info : Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not extract actions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _actionsExtracting = false;
        }
    }

