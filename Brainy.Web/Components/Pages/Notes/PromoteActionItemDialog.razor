@using Brainy.Application.DTOs.ActionItems
@using Brainy.Application.DTOs.Projects
@using Brainy.Application.Interfaces.Services

@inject IActionItemService ActionItemService
@inject IProjectService ProjectService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Promote to task</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Choose the active project where <strong>@Item.Title</strong> should become a task.
        </MudText>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_projects.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                No active project is available. Activate or create a project before promoting this action.
            </MudAlert>
        }
        else
        {
            <MudSelect T="Guid?"
                       @bind-Value="_projectId"
                       Label="Active project"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="Select a project"
                       AnchorOrigin="Origin.BottomLeft">
                @foreach (var project in _projects)
                {
                    <MudSelectItem T="Guid?" Value="project.Id">@project.Emoji @project.Name</MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.TaskAlt"
                   Disabled="_saving || !_projectId.HasValue"
                   OnClick="PromoteAsync">
            @(_saving ? "Promoting…" : "Create task")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public ActionItemDto Item { get; set; } = null!;

    private IReadOnlyList<ProjectDto> _projects = [];
    private Guid? _projectId;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await ProjectService.GetAllActiveAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PromoteAsync()
    {
        if (!_projectId.HasValue)
            return;

        _saving = true;
        try
        {
            var promoted = await ActionItemService.PromoteToTaskAsync(Item.Id, _projectId.Value);
            MudDialog.Close(DialogResult.Ok(promoted));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
