@page "/"
@layout MarketingLayout
@inject NavigationManager Navigation
@inject IStringLocalizer<LandingPage> Localizer

<HeadContent>
    <SeoHeadContent Path="/"
                    Title="@Localizer["SeoTitle"]"
                    Description="@Localizer["SeoDescription"]"
                    JsonLd="@JsonLd" />
</HeadContent>

<section class="mkt-hero">
    <div class="mkt-wrap mkt-hero__grid">
        <div>
            <span class="mkt-eyebrow mkt-rise">@Localizer["HeroEyebrow"]</span>
            <h1 class="mkt-title mkt-rise mkt-d1">@((MarkupString)Localizer["HeroTitle"].Value)</h1>
            <p class="mkt-lead mkt-rise mkt-d2">
                @Localizer["HeroLead"]
            </p>
            <div class="mkt-hero__cta mkt-rise mkt-d3">
                <a class="mkt-btn mkt-btn--primary" href="/Account/Register">@Localizer["HeroCtaPrimary"]</a>
                <a class="mkt-btn mkt-btn--ghost" href="/features">@Localizer["HeroCtaSecondary"]</a>
            </div>
            <p class="mkt-hero__note mkt-rise mkt-d4">@Localizer["HeroNote"]</p>
        </div>
        <div class="mkt-rise mkt-d3">
            <svg class="mkt-hero-art" viewBox="0 0 600 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <g>
                    <line x1="90" y1="90" x2="230" y2="180" />
                    <line x1="230" y1="180" x2="160" y2="330" />
                    <line x1="230" y1="180" x2="410" y2="140" />
                    <line x1="410" y1="140" x2="520" y2="250" />
                    <line x1="160" y1="330" x2="310" y2="400" />
                    <line x1="310" y1="400" x2="520" y2="250" />
                    <line x1="310" y1="400" x2="250" y2="510" />
                    <line x1="250" y1="510" x2="440" y2="470" />
                    <line x1="440" y1="470" x2="520" y2="250" />
                    <line x1="90" y1="90" x2="160" y2="330" />
                </g>
                <g>
                    <circle class="node" cx="90" cy="90" r="4" />
                    <circle class="node node--clay node--live" cx="230" cy="180" r="7" />
                    <circle class="node" cx="410" cy="140" r="4.5" />
                    <circle class="node node--gold node--live" cx="520" cy="250" r="6.5" />
                    <circle class="node" cx="160" cy="330" r="4.5" />
                    <circle class="node node--clay" cx="310" cy="400" r="6" />
                    <circle class="node" cx="250" cy="510" r="4" />
                    <circle class="node node--gold" cx="440" cy="470" r="5.5" />
                </g>
                <g>
                    <text x="248" y="172">@Localizer["CodeCapture"]</text>
                    <text x="330" y="392">@Localizer["CodeOrganize"]</text>
                    <text x="538" y="244">@Localizer["CodeDistill"]</text>
                    <text x="458" y="492">@Localizer["CodeExpress"]</text>
                </g>
            </svg>
        </div>
    </div>
</section>

<div class="mkt-strip">
    <div class="mkt-wrap mkt-strip__inner">
        <span>@((MarkupString)Localizer["ParaStripProjects"].Value)</span>
        <span>@((MarkupString)Localizer["ParaStripAreas"].Value)</span>
        <span>@((MarkupString)Localizer["ParaStripResources"].Value)</span>
        <span>@((MarkupString)Localizer["ParaStripArchives"].Value)</span>
        <span>@Localizer["ParaStripTagline"]</span>
    </div>
</div>

<section class="mkt-section">
    <div class="mkt-wrap">
        <div class="mkt-section__head">
            <span class="mkt-eyebrow">@Localizer["CodeEyebrow"]</span>
            <h2 class="mkt-title">@((MarkupString)Localizer["CodeSectionTitle"].Value)</h2>
        </div>
        <div class="mkt-code-grid">
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 01</span>
                <h3>@Localizer["CodeCapture"]</h3>
                <p>
                    @Localizer["Code01Body"]
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 02</span>
                <h3>@Localizer["CodeOrganize"]</h3>
                <p>
                    @Localizer["Code02Body"]
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 03</span>
                <h3>@Localizer["CodeDistill"]</h3>
                <p>
                    @Localizer["Code03Body"]
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 04</span>
                <h3>@Localizer["CodeExpress"]</h3>
                <p>
                    @Localizer["Code04Body"]
                </p>
            </article>
        </div>
    </div>
</section>

<section class="mkt-section mkt-para">
    <div class="mkt-wrap">
        <div class="mkt-section__head">
            <span class="mkt-eyebrow">@Localizer["ParaEyebrow"]</span>
            <h2 class="mkt-title">@((MarkupString)Localizer["ParaSectionTitle"].Value)</h2>
            <p class="mkt-lead">
                @Localizer["ParaSectionLead"]
            </p>
        </div>
        <div class="mkt-para-grid">
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">P</span>
                <h3>@Localizer["ParaCardProjectsTitle"]</h3>
                <p>@Localizer["ParaCardProjectsBody"]</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">A</span>
                <h3>@Localizer["ParaCardAreasTitle"]</h3>
                <p>@Localizer["ParaCardAreasBody"]</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">R</span>
                <h3>@Localizer["ParaCardResourcesTitle"]</h3>
                <p>@Localizer["ParaCardResourcesBody"]</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">A</span>
                <h3>@Localizer["ParaCardArchivesTitle"]</h3>
                <p>@Localizer["ParaCardArchivesBody"]</p>
            </article>
        </div>
    </div>
</section>

<section class="mkt-section">
    <div class="mkt-wrap mkt-split">
        <div>
            <span class="mkt-eyebrow">@Localizer["TodayEyebrow"]</span>
            <h2 class="mkt-title">@((MarkupString)Localizer["TodaySectionTitle"].Value)</h2>
            <p class="mkt-lead" style="margin-top: 1.1rem;">
                @Localizer["TodaySectionLead"]
            </p>
            <ul class="mkt-checklist">
                <li>@((MarkupString)Localizer["TodayChecklist1"].Value)</li>
                <li>@((MarkupString)Localizer["TodayChecklist2"].Value)</li>
                <li>@((MarkupString)Localizer["TodayChecklist3"].Value)</li>
                <li>@((MarkupString)Localizer["TodayChecklist4"].Value)</li>
            </ul>
        </div>
        <div>
            <div class="mkt-sheet" role="img" aria-label="@Localizer["TodaySheetAriaLabel"]">
                <div class="mkt-sheet__head">
                    <h4>@Localizer["TodayEyebrow"]</h4>
                    <span>@Localizer["TodaySheetEdition"]</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--clay"></span>
                    @Localizer["TodaySheetRow1"]
                    <span class="mkt-sheet__tag">@Localizer["TodaySheetRow1Tag"]</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--gold"></span>
                    @Localizer["TodaySheetRow2"]
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">@Localizer["TodaySheetRow2Tag"]</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--sage"></span>
                    @Localizer["TodaySheetRow3"]
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">@Localizer["TodaySheetRow3Tag"]</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--line"></span>
                    <s>@Localizer["TodaySheetRow4"]</s>
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">@Localizer["TodaySheetRow4Tag"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mkt-section mkt-nd">
    <div class="mkt-wrap">
        <div class="mkt-section__head">
            <span class="mkt-eyebrow">@Localizer["NdEyebrow"]</span>
            <h2 class="mkt-title">@((MarkupString)Localizer["NdSectionTitle"].Value)</h2>
            <p class="mkt-lead">
                @Localizer["NdSectionLead"]
            </p>
        </div>
        <div class="mkt-nd-grid">
            <article class="mkt-note-card">
                <h3>@Localizer["NdCard1Title"]</h3>
                <p>
                    @Localizer["NdCard1Body"]
                </p>
            </article>
            <article class="mkt-note-card">
                <h3>@Localizer["NdCard2Title"]</h3>
                <p>
                    @Localizer["NdCard2Body"]
                </p>
            </article>
            <article class="mkt-note-card">
                <h3>@Localizer["NdCard3Title"]</h3>
                <p>
                    @Localizer["NdCard3Body"]
                </p>
            </article>
            <article class="mkt-note-card">
                <h3>@Localizer["NdCard4Title"]</h3>
                <p>
                    @Localizer["NdCard4Body"]
                </p>
            </article>
        </div>
        <p class="mkt-nd__note">
            @((MarkupString)Localizer["NdFooterNote"].Value)
        </p>
    </div>
</section>

<section class="mkt-cta">
    <div class="mkt-wrap">
        <h2 class="mkt-title">@((MarkupString)Localizer["CtaTitle"].Value)</h2>
        <p>
            @Localizer["CtaBody"]
        </p>
        <div class="mkt-cta__actions">
            <a class="mkt-btn mkt-btn--onDark" href="/Account/Register">@Localizer["CtaPrimary"]</a>
            <a class="mkt-btn mkt-btn--ghost" href="/pricing">@Localizer["CtaSecondary"]</a>
        </div>
    </div>
</section>

@code {
    private string JsonLd => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "Brainy",
                ["url"] = Navigation.BaseUri.TrimEnd('/')
            },
            new Dictionary<string, object?>
            {
                ["@type"] = "WebSite",
                ["name"] = "Brainy",
                ["url"] = Navigation.BaseUri
            },
            new Dictionary<string, object?>
            {
                ["@type"] = "SoftwareApplication",
                ["name"] = "Brainy",
                ["applicationCategory"] = "ProductivityApplication",
                ["operatingSystem"] = "Web",
                ["description"] = Localizer["JsonLdDescription"].Value
            }
        }
    });

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Signed-in users skip marketing and land on their Today screen.
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/today");
        }
    }
}
