@page "/"
@layout MarketingLayout
@inject NavigationManager Navigation

<PageTitle>Brainy — A practical second brain for professionals</PageTitle>
<HeadContent>
    <meta name="description" content="Brainy turns scattered information into organized, reusable knowledge. Capture fast, organize with PARA, distill what matters, and turn what you know into real output." />
</HeadContent>

<section class="mkt-hero">
    <div class="mkt-wrap mkt-hero__grid">
        <div>
            <span class="mkt-eyebrow mkt-rise">Your second brain, on paper that thinks</span>
            <h1 class="mkt-title mkt-rise mkt-d1">Stop storing. Start <em>using</em> what you know.</h1>
            <p class="mkt-lead mkt-rise mkt-d2">
                Brainy helps professionals build a practical second brain — turning scattered
                notes, links, and meeting scraps into organized, reusable knowledge that
                shows up exactly when you work.
            </p>
            <div class="mkt-hero__cta mkt-rise mkt-d3">
                <a class="mkt-btn mkt-btn--primary" href="/Account/Register">Start capturing free</a>
                <a class="mkt-btn mkt-btn--ghost" href="/features">Explore the features</a>
            </div>
            <p class="mkt-hero__note mkt-rise mkt-d4">No credit card. Your notes stay yours.</p>
        </div>
        <div class="mkt-rise mkt-d3">
            <svg class="mkt-hero-art" viewBox="0 0 600 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <g>
                    <line x1="90" y1="90" x2="230" y2="180" />
                    <line x1="230" y1="180" x2="160" y2="330" />
                    <line x1="230" y1="180" x2="410" y2="140" />
                    <line x1="410" y1="140" x2="520" y2="250" />
                    <line x1="160" y1="330" x2="310" y2="400" />
                    <line x1="310" y1="400" x2="520" y2="250" />
                    <line x1="310" y1="400" x2="250" y2="510" />
                    <line x1="250" y1="510" x2="440" y2="470" />
                    <line x1="440" y1="470" x2="520" y2="250" />
                    <line x1="90" y1="90" x2="160" y2="330" />
                </g>
                <g>
                    <circle class="node" cx="90" cy="90" r="4" />
                    <circle class="node node--clay node--live" cx="230" cy="180" r="7" />
                    <circle class="node" cx="410" cy="140" r="4.5" />
                    <circle class="node node--gold node--live" cx="520" cy="250" r="6.5" />
                    <circle class="node" cx="160" cy="330" r="4.5" />
                    <circle class="node node--clay" cx="310" cy="400" r="6" />
                    <circle class="node" cx="250" cy="510" r="4" />
                    <circle class="node node--gold" cx="440" cy="470" r="5.5" />
                </g>
                <g>
                    <text x="248" y="172">Capture</text>
                    <text x="330" y="392">Organize</text>
                    <text x="538" y="244">Distill</text>
                    <text x="458" y="492">Express</text>
                </g>
            </svg>
        </div>
    </div>
</section>

<div class="mkt-strip">
    <div class="mkt-wrap mkt-strip__inner">
        <span><strong>P</strong>rojects</span>
        <span><strong>A</strong>reas</span>
        <span><strong>R</strong>esources</span>
        <span><strong>A</strong>rchives</span>
        <span>— The PARA method, built in</span>
    </div>
</div>

<section class="mkt-section">
    <div class="mkt-wrap">
        <div class="mkt-section__head">
            <span class="mkt-eyebrow">The CODE workflow</span>
            <h2 class="mkt-title">From scattered scraps to <em>finished work</em>, in four moves.</h2>
        </div>
        <div class="mkt-code-grid">
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 01</span>
                <h3>Capture</h3>
                <p>
                    Save notes, links, and meeting scraps the moment they appear.
                    No forms, no upfront filing — the Inbox catches everything.
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 02</span>
                <h3>Organize</h3>
                <p>
                    File items close to action with smart PARA suggestions —
                    project, area, resource, or archive. No deep folder mazes.
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 03</span>
                <h3>Distill</h3>
                <p>
                    Highlight what matters, extract action items and decisions,
                    and summarize progressively so notes stay useful for months.
                </p>
            </article>
            <article class="mkt-code-cell">
                <span class="mkt-code-cell__no">№ 04</span>
                <h3>Express</h3>
                <p>
                    Turn stored knowledge into blog posts, reports, specs, and
                    briefs. Knowledge is only valuable when it becomes output.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="mkt-section mkt-para">
    <div class="mkt-wrap">
        <div class="mkt-section__head">
            <span class="mkt-eyebrow">The PARA method</span>
            <h2 class="mkt-title">One home for everything, organized by <em>actionability</em>.</h2>
            <p class="mkt-lead">
                Every item answers one question: is this for a current project, an ongoing
                responsibility, future reference — or done and worth keeping?
            </p>
        </div>
        <div class="mkt-para-grid">
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">P</span>
                <h3>Projects</h3>
                <p>Short-term outcomes with deadlines. Tasks, notes, and priorities in one place.</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">A</span>
                <h3>Areas</h3>
                <p>Ongoing responsibilities without a fixed end. Standards you maintain over time.</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">R</span>
                <h3>Resources</h3>
                <p>Topics of interest and reference material, ready when a project needs them.</p>
            </article>
            <article class="mkt-para-card">
                <span class="mkt-para-card__letter">A</span>
                <h3>Archives</h3>
                <p>Inactive material kept — reversibly — for later. Out of your way, never lost.</p>
            </article>
        </div>
    </div>
</section>

<section class="mkt-section">
    <div class="mkt-wrap mkt-split">
        <div>
            <span class="mkt-eyebrow">Today</span>
            <h2 class="mkt-title">A front page for your <em>working day</em>.</h2>
            <p class="mkt-lead" style="margin-top: 1.1rem;">
                Today is where knowledge meets execution: the task you're on now,
                what's due, what's overdue, and what's next — never archived noise.
            </p>
            <ul class="mkt-checklist">
                <li><strong>Current task</strong> — the one thing you're actively working on.</li>
                <li><strong>High-priority project work</strong> — important tasks from priority projects.</li>
                <li><strong>Due &amp; overdue</strong> — deadlines for today, this week, and what slipped.</li>
                <li><strong>Next tasks</strong> — what's coming in the days and weeks ahead.</li>
            </ul>
        </div>
        <div>
            <div class="mkt-sheet" role="img" aria-label="Illustration of the Today screen with a current task and deadline queues">
                <div class="mkt-sheet__head">
                    <h4>Today</h4>
                    <span>Thu · Ed. № 47</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--clay"></span>
                    Draft Q3 product narrative
                    <span class="mkt-sheet__tag">Current</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--gold"></span>
                    Review onboarding research notes
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">Due today</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--sage"></span>
                    Distill customer interview #12
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">This week</span>
                </div>
                <div class="mkt-sheet__row">
                    <span class="mkt-sheet__dot mkt-sheet__dot--line"></span>
                    <s>Send launch brief to design</s>
                    <span class="mkt-sheet__tag mkt-sheet__tag--muted">Done</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mkt-cta">
    <div class="mkt-wrap">
        <h2 class="mkt-title">Think better. Work faster. <em>Create more</em> from what you already know.</h2>
        <p>
            Set up your second brain in minutes. Capture your first note today and
            let PARA keep it exactly where your future self will look.
        </p>
        <div class="mkt-cta__actions">
            <a class="mkt-btn mkt-btn--onDark" href="/Account/Register">Get started free</a>
            <a class="mkt-btn mkt-btn--ghost" href="/pricing">See pricing</a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Signed-in users skip marketing and land on their Today screen.
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/today");
        }
    }
}
