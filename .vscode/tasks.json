{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}\\Brainy.Web\\Brainy.Web.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run (watch)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}\\Brainy.Web\\Brainy.Web.csproj"
      ],
      "isBackground": true,
      "problemMatcher": ["$msCompile"],
      "group": "none"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\Brainy.Web\\Brainy.Web.csproj"
      ],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
