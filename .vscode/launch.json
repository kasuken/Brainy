{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Brainy.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}\\Brainy.Web\\bin\\Debug\\net10.0\\Brainy.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}\\Brainy.Web",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
